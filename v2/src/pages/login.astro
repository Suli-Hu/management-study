---
import Layout from '~/layouts/Layout.astro';

const user = Astro.locals.user;
if (user) return Astro.redirect('/');

const env = Astro.locals.runtime.env;
const mode = env.AUTH_MODE === 'password' ? 'password' : 'email';

const error = Astro.url.searchParams.get('error');
const errorMessages: Record<string, string> = {
  invalid_or_expired: '登录链接无效或已过期，请重新申请。',
  missing_token: '链接不完整，请重新申请。',
  bad_password: '密码不对。',
};
const errorMsg = error ? (errorMessages[error] ?? '登录出错，请重试。') : null;
---

<Layout title="登录">
  <main class="max-w-reading mx-auto px-4 py-10">
    <div class="max-w-md mx-auto">
      <header class="mb-6">
        <h1 class="text-2xl mb-2">登录</h1>
        {mode === 'password' ? (
          <p class="text-sm text-tertiary leading-relaxed">
            输入密码登录。考试期间使用简化登录，考完切回邮箱验证。
          </p>
        ) : (
          <p class="text-sm text-tertiary">输入邮箱，我们会发一条只能用一次的登录链接给你。</p>
        )}
      </header>

      {errorMsg && (
        <div class="mb-4 p-3 rounded-md bg-badge-limit text-accent-warning text-xs">
          {errorMsg}
        </div>
      )}

      {mode === 'password' ? (
        <form method="POST" action="/api/auth/password" class="space-y-3">
          <input
            type="password"
            name="password"
            required
            autofocus
            autocomplete="current-password"
            placeholder="密码"
            class="w-full px-3 py-2 rounded-md border border-bg-tertiary text-sm focus:outline-none focus:border-accent-strategy"
          />
          <button
            type="submit"
            class="w-full px-4 py-2 rounded-md bg-accent-strategy text-white text-sm font-semibold"
          >
            登录
          </button>
        </form>
      ) : (
        <form method="POST" action="/api/auth/login" class="space-y-3">
          <input
            type="email"
            name="email"
            required
            autocomplete="email"
            placeholder="you@example.com"
            class="w-full px-3 py-2 rounded-md border border-bg-tertiary text-sm focus:outline-none focus:border-accent-strategy"
          />
          <button
            type="submit"
            class="w-full px-4 py-2 rounded-md bg-accent-strategy text-white text-sm font-semibold"
          >
            发送登录链接
          </button>
        </form>
      )}

      <p class="text-xs text-quaternary mt-6 leading-relaxed">
        {mode === 'password'
          ? '访客密码仅可浏览，不保存任何操作；管理员密码可编辑。'
          : '我们只用你的邮箱识别你是谁 —— 不用密码，不会发推广邮件。'}
      </p>
    </div>
  </main>
</Layout>
