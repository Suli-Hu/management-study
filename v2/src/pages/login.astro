---
import Layout from '~/layouts/Layout.astro';
import Brand from '~/components/Brand.astro';
import { readFlash, FLASH_COOKIE } from '~/lib/flash';

const user = Astro.locals.user;
if (user) return Astro.redirect('/');

const env = Astro.locals.runtime.env;
const passwordMode = env.AUTH_MODE === 'password';

const flash = readFlash(Astro.request.headers.get('cookie'));
if (flash) Astro.cookies.delete(FLASH_COOKIE, { path: '/' });

const error = flash?.error ?? null;
const errorMessages: Record<string, string> = {
  invalid_or_expired: '登录链接无效或已过期，请重新申请。',
  missing_token: '链接不完整，请重新申请。',
  missing_code: '请输入 6 位 code。',
  bad_password: '密码不对。',
  bad_invite_code: '邀请码不对。',
};
const errorMsg = error ? (errorMessages[error] ?? '登录出错，请重试。') : null;
---

<Layout title="登录">
  <main class="max-w-reading mx-auto px-4 py-12">
    <div class="max-w-md mx-auto">
      <header class="mb-8 flex justify-center">
        <Brand href="/" variant="lockup" />
      </header>

      {errorMsg && (
        <div class="mb-4 p-3 rounded-md bg-badge-limit text-accent-warning text-xs">
          {errorMsg}
        </div>
      )}

      {passwordMode ? (
        <form method="POST" action="/api/auth/password" class="space-y-3">
          <input
            type="password"
            name="password"
            required
            autofocus
            autocomplete="current-password"
            placeholder="密码"
            class="w-full px-3 py-2 rounded-md border border-bg-tertiary text-sm focus:outline-none focus:border-accent-strategy"
          />
          <label class="flex items-center gap-2 text-xs text-tertiary cursor-pointer select-none">
            <input type="checkbox" name="remember" value="1" checked class="w-4 h-4 accent-accent-strategy cursor-pointer" />
            记住登录 30 天
          </label>
          <button type="submit" class="btn-ghost-strategy w-full">
            登录
          </button>
          <p class="text-xs text-quaternary text-center mt-4">访客密码仅可浏览；管理员密码可编辑。</p>
        </form>
      ) : (
        <div>
          {/* v0.5.82: 默认只显示密码（邀请码）表单，邮箱验证码 tab 收起来；
              入口在 footer 区域的小字 "邮箱登录" 链接（仅 admin 知道路径） */}

          {/* 密码（前身：邀请码）表单 */}
          <form method="POST" action="/api/auth/invite-code" data-login-pane="invite" class="space-y-3">
            <div>
              <label class="block text-xs text-tertiary mb-1">密码</label>
              <input
                type="password"
                name="code"
                required
                autocomplete="current-password"
                placeholder="请输入密码"
                class="w-full px-3 py-2.5 rounded-md border border-bg-tertiary text-sm focus:outline-none focus:border-accent-strategy"
              />
            </div>
            <input type="hidden" name="remember" value="1" />
            <button type="submit" class="btn-ghost-strategy w-full">
              继续
            </button>
          </form>

          {/* 邮箱验证码表单（默认隐藏，靠 footer 区域链接切到这里） */}
          <form method="POST" action="/api/auth/login" data-login-pane="email" class="space-y-3 hidden">
            <div>
              <label class="block text-xs text-tertiary mb-1">邮箱</label>
              <input
                type="email"
                name="email"
                required
                autocomplete="email"
                placeholder="you@gmail.com"
                class="w-full px-3 py-2.5 rounded-md border border-bg-tertiary text-sm focus:outline-none focus:border-accent-strategy"
              />
            </div>
            <label class="flex items-center gap-2 text-xs text-tertiary cursor-pointer select-none">
              <input type="checkbox" name="remember" value="1" checked class="w-4 h-4 accent-accent-strategy cursor-pointer" />
              记住登录 30 天
            </label>
            <button type="submit" class="btn-ghost-strategy w-full">
              发送验证码
            </button>
            <p class="text-xs text-quaternary text-center mt-4">白名单邮箱按既定权限进入</p>
          </form>

          {/* 模式切换 — 极简文字按钮，跟 footer 同视觉权重 */}
          <div class="mt-8 text-center text-xs text-quaternary">
            <span data-login-footer-prompt="invite">个人笔记，仅云端存储，非公开 · </span>
            <span data-login-footer-prompt="email" class="hidden">个人笔记，仅云端存储，非公开 · </span>
            <button
              type="button"
              data-login-switch="email"
              class="text-tertiary hover:text-primary underline-offset-2 hover:underline"
            >邮箱登录</button>
            <button
              type="button"
              data-login-switch="invite"
              class="hidden text-tertiary hover:text-primary underline-offset-2 hover:underline"
            >返回密码登录</button>
          </div>
        </div>
      )}
    </div>
  </main>
</Layout>

<script is:inline>
  // v0.5.82: 模式切换 — invite/email 表单 + footer prompt 同步
  document.querySelectorAll('[data-login-switch]').forEach((b) => {
    b.addEventListener('click', () => {
      const target = b.getAttribute('data-login-switch');   // 'invite' | 'email'
      document.querySelectorAll('[data-login-pane]').forEach((p) => {
        p.classList.toggle('hidden', p.getAttribute('data-login-pane') !== target);
      });
      document.querySelectorAll('[data-login-switch]').forEach((x) => {
        x.classList.toggle('hidden', x.getAttribute('data-login-switch') === target);
      });
      document.querySelectorAll('[data-login-footer-prompt]').forEach((s) => {
        s.classList.toggle('hidden', s.getAttribute('data-login-footer-prompt') === target);
      });
      // 焦点放进新 pane 的第一个 input
      const newPane = document.querySelector(`[data-login-pane="${target}"]`);
      const firstInput = newPane && newPane.querySelector('input:not([type=hidden]):not([type=checkbox])');
      if (firstInput) firstInput.focus();
    });
  });
</script>
