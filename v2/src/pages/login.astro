---
import Layout from '~/layouts/Layout.astro';
import Brand from '~/components/Brand.astro';
import { readFlash, FLASH_COOKIE } from '~/lib/flash';

const user = Astro.locals.user;
if (user) return Astro.redirect('/');

const env = Astro.locals.runtime.env;
const passwordMode = env.AUTH_MODE === 'password';

const flash = readFlash(Astro.request.headers.get('cookie'));
if (flash) Astro.cookies.delete(FLASH_COOKIE, { path: '/' });

const error = flash?.error ?? null;
const lastEmail = flash?.email ?? '';

const errorMessages: Record<string, string> = {
  // v0.7.3 password login
  bad_credentials: '邮箱或密码不对。',
  bad_credentials_locked: '尝试次数过多，账户已锁 30 分钟。请稍后再试，或走"忘记密码"重置。',
  // 邀请码 / password 模式（保留作演示通道 + 考试期 fallback）
  bad_password: '密码不对。',
  bad_invite_code: '邀请码不对。',
  // v0.7.4/5 复用：从 password-reset / change-email 跳回 /login 时的提示
  invalid_or_expired: '会话已失效，请重新登录。',
};
const errorMsg = error ? (errorMessages[error] ?? '登录出错，请重试。') : null;
---

<Layout title="登录">
  <main class="max-w-reading mx-auto px-4 py-8 min-h-[calc(100dvh-9rem)] flex items-center">
    <div class="w-full max-w-md mx-auto">
      <header class="mb-8 flex justify-center">
        <Brand href="/" variant="lockup" />
      </header>

      {errorMsg && (
        <div class="mb-4 p-3 rounded-md bg-badge-limit text-accent-warning text-xs">
          {errorMsg}
        </div>
      )}

      {passwordMode ? (
        <form method="POST" action="/api/auth/password" class="space-y-3">
          <input
            type="password"
            name="password"
            required
            autofocus
            autocomplete="current-password"
            placeholder="密码"
            class="w-full px-3 py-2 rounded-md border border-bg-tertiary text-sm focus:outline-none focus:border-accent-strategy"
          />
          <label class="flex items-center gap-2 text-xs text-tertiary cursor-pointer select-none">
            <input type="checkbox" name="remember" value="1" checked class="w-4 h-4 accent-accent-strategy cursor-pointer" />
            记住登录 30 天
          </label>
          <button type="submit" class="btn-ghost-strategy w-full">
            登录
          </button>
          <p class="text-xs text-quaternary text-center mt-4">访客密码仅可浏览；管理员密码可编辑。</p>
        </form>
      ) : (
        <div>
          {/* v0.7.3 默认入口：邮箱 + 密码（普通用户） */}
          <form method="POST" action="/api/auth/login-password" data-login-pane="password" class="space-y-3">
            <div>
              <label class="block text-xs text-tertiary mb-1">邮箱</label>
              <input
                type="email"
                name="email"
                data-login-email
                required
                autofocus
                autocomplete="email"
                value={lastEmail}
                placeholder="you@example.com"
                class="w-full px-3 py-2.5 rounded-md border border-bg-tertiary text-sm focus:outline-none focus:border-accent-strategy"
              />
            </div>
            <div>
              <label class="block text-xs text-tertiary mb-1">密码</label>
              <input
                type="password"
                name="password"
                required
                autocomplete="current-password"
                placeholder="登录密码"
                class="w-full px-3 py-2.5 rounded-md border border-bg-tertiary text-sm focus:outline-none focus:border-accent-strategy"
              />
            </div>
            <label class="flex items-center gap-2 text-xs text-tertiary cursor-pointer select-none">
              <input type="checkbox" name="remember" value="1" checked class="w-4 h-4 accent-accent-strategy cursor-pointer" />
              记住登录 30 天
            </label>
            <button type="submit" class="btn-ghost-strategy w-full">
              登录
            </button>
            <div class="flex justify-between text-xs text-quaternary mt-3">
              <a href="/signup" class="text-accent-strategy">还没账号？注册</a>
              <a href="/password-reset" class="text-accent-strategy">忘记密码？</a>
            </div>
          </form>

          {/* 邀请码登录（v0.7 决策 D1：保留作演示通道；UI 降级到 footer 链接切换） */}
          <form method="POST" action="/api/auth/invite-code" data-login-pane="invite" class="space-y-3 hidden">
            <input
              type="password"
              name="code"
              required
              autocomplete="off"
              placeholder="演示访问邀请码"
              class="w-full px-3 py-2.5 rounded-md border border-bg-tertiary text-sm focus:outline-none focus:border-accent-strategy"
            />
            <input type="hidden" name="remember" value="1" />
            <button type="submit" class="btn-ghost-strategy w-full">
              进入演示
            </button>
            <p class="text-xs text-quaternary text-center mt-3">仅可浏览，不能编辑。</p>
          </form>
        </div>
      )}
    </div>
  </main>
</Layout>

<script is:inline>
  // v0.7.3: footer 文案点击切换 password ↔ invite-code 表单
  // （v0.5.83 magic-link 切换替换为 invite-code 切换；password 是默认）
  (function () {
    const passwordPane = document.querySelector('[data-login-pane="password"]');
    const invitePane = document.querySelector('[data-login-pane="invite"]');
    if (!passwordPane || !invitePane) return;

    const EMAIL_STORAGE_KEY = 'management-study:last-login-email';
    const LOCAL_DEFAULT_EMAIL = 'husuli0623@gmail.com';
    const isLocalDev = ['localhost', '127.0.0.1', '::1'].includes(window.location.hostname);
    const emailInput = document.querySelector('[data-login-email]');

    function readRememberedEmail() {
      try {
        return localStorage.getItem(EMAIL_STORAGE_KEY) || (isLocalDev ? LOCAL_DEFAULT_EMAIL : '');
      } catch (_) {
        return isLocalDev ? LOCAL_DEFAULT_EMAIL : '';
      }
    }

    function rememberEmail(value) {
      const email = String(value || '').trim().toLowerCase();
      if (!email) return;
      try { localStorage.setItem(EMAIL_STORAGE_KEY, email); } catch (_) { /* ignore */ }
    }

    if (emailInput && !emailInput.value) {
      emailInput.value = readRememberedEmail();
    }

    passwordPane.addEventListener('submit', () => {
      if (emailInput) rememberEmail(emailInput.value);
    });

    const footerText = document.querySelector('[data-app-footer-text]');
    if (!footerText) return;
    footerText.style.cursor = 'pointer';
    footerText.setAttribute('title', '点击切换登录方式');
    footerText.addEventListener('click', () => {
      const passwordVisible = !passwordPane.classList.contains('hidden');
      passwordPane.classList.toggle('hidden', passwordVisible);
      invitePane.classList.toggle('hidden', !passwordVisible);
      const newPane = passwordVisible ? invitePane : passwordPane;
      const input = newPane.querySelector('input:not([type=hidden]):not([type=checkbox])');
      if (input) input.focus();
    });
  })();
</script>
