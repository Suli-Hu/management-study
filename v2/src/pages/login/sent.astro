---
import Layout from '~/layouts/Layout.astro';
import { readFlash, FLASH_COOKIE } from '~/lib/flash';

// v0.2.9: password 模式下不应到达这里
if (Astro.locals.runtime.env.AUTH_MODE === 'password') {
  return Astro.redirect('/login');
}

// v0.3.6: email + error 从 flash cookie 读（URL 不留痕）
const flash = readFlash(Astro.request.headers.get('cookie'));
if (flash) Astro.cookies.delete(FLASH_COOKIE, { path: '/' });

const email = flash?.email ?? '';
const err = flash?.error ?? null;
const errorMsg = err === 'invalid_code'
  ? 'Code 错了或已过期，检查邮件里的 6 位数字，或去 /login 重新发送。'
  : null;

const maskedEmail = email.replace(/^(.{2}).*(@.*)$/, '$1•••$2');
---

<Layout title="输入 code">
  <main class="max-w-reading mx-auto px-4 py-10">
    <div class="max-w-md mx-auto">
      <header class="mb-6">
        <h1 class="text-2xl mb-2">查收邮箱</h1>
        <p class="text-sm text-tertiary leading-relaxed">
          我们给 <strong class="text-secondary">{maskedEmail || '你的邮箱'}</strong> 发了一封登录邮件。
        </p>
      </header>

      {errorMsg && (
        <div class="mb-4 p-3 rounded-md bg-badge-limit text-accent-warning text-xs">
          {errorMsg}
        </div>
      )}

      <section class="mb-6">
        <p class="text-sm text-secondary mb-3">
          输入邮件里的 <strong>6 位 code</strong>：
        </p>
        <form id="code-form" method="POST" action="/api/auth/verify-code">
          <input type="hidden" name="email" value={email} />
          <input type="hidden" name="code" id="code-hidden" />
          <div class="flex gap-2 justify-center mb-3" id="otp-boxes">
            {Array.from({ length: 6 }).map((_, i) => (
              <input
                type="text"
                inputmode="numeric"
                autocomplete={i === 0 ? 'one-time-code' : 'off'}
                maxlength="1"
                data-otp-index={i}
                class="w-11 h-14 text-center text-xl font-mono font-semibold rounded-md border border-bg-tertiary focus:outline-none focus:border-accent-strategy"
              />
            ))}
          </div>
          <button type="submit" class="btn-ghost-strategy w-full">
            登录
          </button>
        </form>
      </section>

      <section class="p-4 rounded-md bg-bg-warm text-xs text-secondary leading-relaxed">
        <p class="mb-2 text-tertiary font-semibold">或者：直接在收到邮件的那台设备点击邮件里的「在当前设备登录」按钮。</p>
        <p class="text-quaternary">链接和 code 10 分钟内有效。没收到？检查垃圾邮件，或 <a href="/login" class="text-accent-strategy">重新申请</a>。</p>
      </section>
    </div>
  </main>
</Layout>

<script is:inline>
  (function () {
    const boxes = Array.from(document.querySelectorAll('[data-otp-index]'));
    const hidden = document.getElementById('code-hidden');
    const form = document.getElementById('code-form');
    if (!boxes.length || !hidden || !form) return;

    function sync() {
      hidden.value = boxes.map((b) => b.value).join('');
    }

    function focusBox(i) {
      const b = boxes[i];
      if (b) {
        b.focus();
        b.select();
      }
    }

    boxes.forEach((box, i) => {
      box.addEventListener('input', () => {
        box.value = box.value.replace(/\D/g, '').slice(0, 1);
        sync();
        if (box.value && i < boxes.length - 1) focusBox(i + 1);
        if (hidden.value.length === 6) form.submit();
      });

      box.addEventListener('keydown', (e) => {
        if (e.key === 'Backspace' && !box.value && i > 0) {
          focusBox(i - 1);
        } else if (e.key === 'ArrowLeft' && i > 0) {
          e.preventDefault();
          focusBox(i - 1);
        } else if (e.key === 'ArrowRight' && i < boxes.length - 1) {
          e.preventDefault();
          focusBox(i + 1);
        }
      });

      box.addEventListener('paste', (e) => {
        e.preventDefault();
        const raw = (e.clipboardData?.getData('text') || '').replace(/\D/g, '');
        if (!raw) return;
        const digits = raw.slice(0, 6 - i);
        for (let j = 0; j < digits.length; j++) {
          boxes[i + j].value = digits[j];
        }
        sync();
        const nextIdx = Math.min(i + digits.length, boxes.length - 1);
        focusBox(nextIdx);
        if (hidden.value.length === 6) form.submit();
      });

      box.addEventListener('focus', () => box.select());
    });

    // 首次进入聚焦第一格
    focusBox(0);
  })();
</script>
