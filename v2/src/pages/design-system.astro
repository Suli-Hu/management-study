    <script is:inline>
      // dark mode toggle —— 与 Layout.astro 同步：data-mode + html.dark 双写
      (function () {
        const btn = document.querySelector('[data-toggle-mode]');
        const icon = document.querySelector('[data-mode-icon]');
        const label = document.querySelector('[data-mode-label]');
        const root = document.documentElement;
        function refresh() {
          const isDark = root.classList.contains('dark');
          if (icon) icon.textContent = isDark ? '☾' : '◐';
          if (label) label.textContent = isDark ? 'Dark' : 'Light';
        }
        refresh();
        btn?.addEventListener('click', () => {
          const isDark = !root.classList.contains('dark');
          root.classList.toggle('dark', isDark);
          root.dataset.mode = isDark ? 'dark' : 'light';
          try { localStorage.setItem('theme', isDark ? 'dark' : 'light'); } catch {}
          refresh();
        });
      })();
    </script>
