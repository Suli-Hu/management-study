---
import Layout from '~/layouts/Layout.astro';
import { readFlash, FLASH_COOKIE } from '~/lib/flash';

const user = Astro.locals.user;
if (user) return Astro.redirect('/');

const env = Astro.locals.runtime.env;
if (env.AUTH_MODE === 'password') return Astro.redirect('/login');

const flash = readFlash(Astro.request.headers.get('cookie'));
if (flash) Astro.cookies.delete(FLASH_COOKIE, { path: '/' });

const email = flash?.email ?? '';
const maskedEmail = email.replace(/^(.{2}).*(@.*)$/, '$1•••$2');
---

<Layout title="重置链接已发送">
  <main class="max-w-reading mx-auto px-4 py-10">
    <div class="max-w-md mx-auto">
      <header class="mb-6">
        <h1 class="text-2xl mb-2">查收邮箱</h1>
        <p class="text-sm text-tertiary leading-relaxed">
          如果 <strong class="text-secondary">{maskedEmail || '该邮箱'}</strong> 已注册，我们已经发出重置链接。
        </p>
      </header>

      <section class="p-4 rounded-md bg-bg-warm text-xs text-secondary leading-relaxed mb-6">
        <p class="mb-2 text-tertiary font-semibold">下一步：</p>
        <ol class="list-decimal pl-4 space-y-1 text-quaternary">
          <li>打开邮箱（含垃圾邮件箱）找"重置密码"邮件</li>
          <li>点邮件里的"设置新密码"按钮</li>
          <li>设新密码（30 分钟内有效）</li>
        </ol>
      </section>

      <p class="text-xs text-quaternary text-center">
        没收到？<a href="/password-reset" class="text-accent-strategy">重新发送</a>
        <span class="mx-2">·</span>
        <a href="/login" class="text-accent-strategy">返回登录</a>
      </p>
    </div>
  </main>
</Layout>
