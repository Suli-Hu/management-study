---
/**
 * KP 新建页 v0.8 Stage 4 — 独立路由 (D6=A 决策)
 *
 * 与 edit.astro 同 shell，区别：
 *   - mode = 'new'
 *   - initialState = makeNewState
 *   - 保存按钮 → POST /api/kps?discipline=<key>，跳转到 edit 页
 *
 * 见 v2/docs/KP-EDITOR-V0.8-PRD.md §6.3 ("新建页 = 编辑页 layout 完全一致")
 */
import Layout from '~/layouts/Layout.astro';
import { getDb } from '~/lib/db';
import { parseFrom, fromLabel } from '~/lib/nav';
import { getMetadataForTenant } from '~/lib/metadata-api-store';
import type { EditorMetadata } from '~/lib/editor/state';
import { resolveAccentForSchool } from '~/lib/resolve-accent';

const { discipline } = Astro.params;
if (!discipline) return Astro.redirect('/404');
if (!Astro.locals.canEdit(discipline)) return Astro.redirect(`/${discipline}/kp`);

const fromPath = parseFrom(Astro.url.searchParams.get('from'), `/${discipline}/kp`);
const fromLbl = fromLabel(fromPath);

const db = getDb(Astro.locals.runtime.env);
const tenantRow = await db
  .prepare('SELECT id FROM tenant WHERE discipline_key = ? OR id = ?')
  .bind(discipline, discipline)
  .first<{ id: string }>();
if (!tenantRow) return Astro.redirect('/404');

const metadata = await getMetadataForTenant(db, { tenantId: tenantRow.id, discipline });
const disciplineLabel = metadata.discipline?.title.zh ?? discipline;

const editorMetadata: EditorMetadata = {
  schools: metadata.schools.map((s) => ({
    key: s.key,
    label: s.title.zh,
    // Use user-defined tag hex from discipline tag library (not token/hash colors).
    color: resolveAccentForSchool(
      { tags: s.tags },
      { tags: (metadata.tags as Array<{ key: string; color?: string }>).map((t) => ({ key: t.key, color: t.color ?? '' })) },
    ),
  })),
  scholars: metadata.scholars.map((s) => ({
    key: s.key,
    label: s.name.zh,
    sub: s.name.en ?? '',
  })),
  tags: (metadata.tags as Array<{ key: string; label: { zh: string }; color?: string }>).map((t) => ({
    key: t.key,
    label: t.label?.zh ?? t.key,
    color: t.color ?? null,
  })),
  disciplineLabel,
  disciplineKey: discipline,
  fromPath,
  fromLabel: fromLbl,
};

// preselect from query param (?school=xxx / ?scholar=yyy)
const preselectSchool = Astro.url.searchParams.get('school') ?? '';
const preselectScholar = Astro.url.searchParams.get('scholar') ?? '';
---

<Layout title={`新建 KP · ${disciplineLabel}`} currentDiscipline={discipline} currentSection="kps">
  <div class="kp-editor-v08" id="kp-editor-root" data-mode="new"></div>

  <script
    type="application/json"
    is:inline
    id="kp-editor-init"
    set:html={JSON.stringify({
      metadata: editorMetadata,
      preselectSchool,
      preselectScholar,
    })}
  ></script>
</Layout>

<script>
  import { makeNewState, type EditorMetadata } from '~/lib/editor/state';
  import { initEditor } from '~/lib/editor/index';

  const root = document.getElementById('kp-editor-root');
  const initJson = document.getElementById('kp-editor-init')?.textContent;
  if (!root || !initJson) {
    console.error('[kp-editor] init payload missing');
  } else {
    const { metadata, preselectSchool, preselectScholar } = JSON.parse(initJson) as {
      metadata: EditorMetadata;
      preselectSchool: string;
      preselectScholar: string;
    };
    const initialState = makeNewState(metadata.disciplineKey);
    if (preselectSchool) initialState.schools = [preselectSchool];
    if (preselectScholar) initialState.scholars = [preselectScholar];
    initEditor({
      root: root as HTMLElement,
      initialState,
      metadata,
      mode: 'new',
    });
  }
</script>
