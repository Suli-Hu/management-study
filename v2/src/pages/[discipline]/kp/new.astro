---
import Layout from '~/layouts/Layout.astro';
import { getDb } from '~/lib/db';

const { discipline } = Astro.params;

if (!Astro.locals.isAdmin) return Astro.redirect(`/${discipline}/kp`);

const db = getDb(Astro.locals.runtime.env);

const schoolsResult = await db
  .prepare('SELECT key, title_zh FROM school WHERE discipline = ? ORDER BY title_zh')
  .bind(discipline)
  .all<{ key: string; title_zh: string }>();
const allSchools = schoolsResult.results ?? [];

const scholarsResult = await db
  .prepare('SELECT key, name_zh, name_en FROM scholar WHERE discipline = ? ORDER BY key')
  .bind(discipline)
  .all<{ key: string; name_zh: string; name_en: string | null }>();
const allScholars = scholarsResult.results ?? [];

// 上下文：?school=X 时 pre-select；?scholar=Y 同
const ctxSchool = Astro.url.searchParams.get('school') ?? '';
const ctxScholar = Astro.url.searchParams.get('scholar') ?? '';
---

<Layout title="新增 KP" currentDiscipline={discipline} currentSection="kps">
  <main class="max-w-reading mx-auto px-4 py-6">
    <header class="mb-4">
      <a href={`/${discipline}/kp`} class="text-xs text-tertiary hover:underline">← 返回 KP 列表</a>
      <h1 class="text-2xl mt-2">新增 KP</h1>
      <p class="text-xs text-quaternary mt-1">id 一旦提交不可改（rename 走 worktree）。命名建议 <code>k</code> + 数字。</p>
    </header>

    <form id="kp-new-form" class="space-y-5" autocomplete="off" data-discipline={discipline}>
      <section>
        <label class="block text-xs font-semibold text-tertiary mb-1">id <span class="text-accent-warning">*</span></label>
        <input name="id" type="text" required pattern="[a-z]{1,3}[0-9]+" placeholder="k999" class="w-48 px-3 py-2 rounded-md border text-sm font-mono" />
        <span class="text-xs text-quaternary ml-2">小写字母前缀 + 数字</span>
      </section>

      <section>
        <label class="block text-xs font-semibold text-tertiary mb-1">中文标题 <span class="text-accent-warning">*</span></label>
        <input name="title_zh" type="text" required class="w-full px-3 py-2 rounded-md border text-sm" />
      </section>
      <section class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-semibold text-tertiary mb-1">English</label>
          <input name="title_en" type="text" class="w-full px-3 py-2 rounded-md border text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-tertiary mb-1">日本語</label>
          <input name="title_ja" type="text" class="w-full px-3 py-2 rounded-md border text-sm" />
        </div>
      </section>

      <section>
        <label class="block text-xs font-semibold text-tertiary mb-1">年份</label>
        <input name="year" type="text" class="w-48 px-3 py-2 rounded-md border text-sm" />
      </section>

      <section>
        <label class="block text-xs font-semibold text-tertiary mb-1">学派 <span class="text-accent-warning">*（≥1）</span></label>
        <div class="flex flex-wrap gap-1">
          {allSchools.map((s) => (
            <label class="inline-flex items-center gap-1 px-2 py-1 rounded border text-xs cursor-pointer hover:bg-bg-tertiary">
              <input type="checkbox" name="school" value={s.key} class="w-3 h-3" checked={s.key === ctxSchool} />
              <span>{s.title_zh}</span>
            </label>
          ))}
        </div>
      </section>

      <section>
        <label class="block text-xs font-semibold text-tertiary mb-1">学者</label>
        <div class="flex flex-wrap gap-1 max-h-40 overflow-y-auto p-1 border rounded">
          {allScholars.map((s) => (
            <label class="inline-flex items-center gap-1 px-2 py-1 rounded border text-xs cursor-pointer hover:bg-bg-tertiary">
              <input type="checkbox" name="scholar" value={s.key} class="w-3 h-3" checked={s.key === ctxScholar} />
              <span>{s.name_en ?? s.name_zh}</span>
            </label>
          ))}
        </div>
      </section>

      <section>
        <label class="block text-xs font-semibold text-tertiary mb-1">tags</label>
        <div class="flex gap-2">
          {['义', '限', '例', '应', '用', '喻'].map((t) => (
            <label class="inline-flex items-center gap-1 px-2 py-1 rounded border text-xs cursor-pointer">
              <input type="checkbox" name="tag" value={t} class="w-3 h-3" />
              <span>{t}</span>
            </label>
          ))}
        </div>
      </section>

      <section>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-3">
          <div id="body-editor-mount" class="border rounded-md p-3 bg-bg-primary"></div>
          <div class="border rounded-md p-3 bg-bg-secondary overflow-auto">
            <div class="text-xs text-quaternary mb-2" data-preview-label>预览</div>
            <div class="kp-body text-secondary text-sm" data-preview-html></div>
          </div>
        </div>
      </section>

      <footer class="sticky bottom-0 bg-bg-primary py-3 border-t flex items-center gap-3">
        <button type="submit" id="save-btn" class="px-4 py-2 rounded-md bg-accent-strategy text-white text-sm font-semibold disabled:opacity-50">
          创建（commit + 部署）
        </button>
        <span id="save-status" class="text-xs text-tertiary"></span>
      </footer>
    </form>
  </main>
</Layout>

<script>
  // v0.4.8: format-aware structured body editor
  import { renderBody } from '~/lib/render-body';
  import { mountBodyEditor } from '~/lib/body-editor-client';
  const form = document.getElementById('kp-new-form');
  const saveBtn = document.getElementById('save-btn');
  const saveStatus = document.getElementById('save-status');
  const editorMount = document.getElementById('body-editor-mount');
  const discipline = form.dataset.discipline;
  const PREVIEW_ACCENT = '#007AFF';

  let currentBodyZh = '';
  let currentBodyJa = '';
  let currentFormat = 'narrative';
  let activeLang = 'zh';

  function renderPreview() {
    const target = document.querySelector('[data-preview-html]');
    if (!target) return;
    const body = activeLang === 'zh' ? currentBodyZh : currentBodyJa;
    try {
      target.innerHTML = renderBody(body, PREVIEW_ACCENT);
    } catch (err) {
      target.innerHTML = `<div style="color:#FF3B30;font-size:11px">预览出错：${String(err).slice(0, 200)}</div>`;
    }
  }

  const editor = mountBodyEditor(editorMount, {
    initialFormat: 'narrative',
    initialZhBody: '',
    initialJaBody: '',
    onChange: (zh, ja, fmt) => {
      currentBodyZh = zh;
      currentBodyJa = ja;
      currentFormat = fmt;
      renderPreview();
    },
  });
  editorMount.addEventListener('click', (e) => {
    const btn = e.target.closest('button');
    if (!btn || !['中', '日'].includes(btn.textContent?.trim())) return;
    activeLang = btn.textContent.trim() === '中' ? 'zh' : 'ja';
    const lbl = document.querySelector('[data-preview-label]');
    if (lbl) lbl.textContent = activeLang === 'zh' ? '预览（中）' : 'プレビュー（日）';
    renderPreview();
  });

  function buildI18n(zh, en, ja) {
    const o = { zh: zh.trim() };
    if (en?.trim()) o.en = en.trim();
    if (ja?.trim()) o.ja = ja.trim();
    return o;
  }
  function buildBody(zh, ja) {
    const o = { zh };
    if (ja?.trim()) o.ja = ja;
    return o;
  }
  function collect() {
    const id = form.id.value.trim();
    const schools = [...document.querySelectorAll('input[name=school]:checked')].map((c) => c.value);
    const scholars = [...document.querySelectorAll('input[name=scholar]:checked')].map((c) => c.value);
    const tags = [...document.querySelectorAll('input[name=tag]:checked')].map((c) => c.value);
    const now = new Date().toISOString();
    return {
      id, discipline, schools, scholars,
      year: form.year.value.trim(),
      title: buildI18n(form.title_zh.value, form.title_en.value, form.title_ja.value),
      body: buildBody(currentBodyZh, currentBodyJa),
      tags,
      format: currentFormat,
      createdAt: now,
      updatedAt: now,
    };
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    saveBtn.disabled = true;
    saveStatus.textContent = '创建中...';
    const json = collect();
    const res = await fetch('/api/new/kp', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ json }),
    });
    const data = await res.json().catch(() => ({}));
    if (res.ok) {
      saveStatus.innerHTML = `✓ 已创建 commit <code>${data.commit_sha?.slice(0, 7)}</code>，~${data.deploy_eta_seconds}s 后跳转`;
      setTimeout(() => { location.href = `/${discipline}/kp/${json.id}`; }, 1500);
    } else if (res.status === 409) {
      saveStatus.innerHTML = `<span style="color:#FF3B30">id 已存在，请改 id 或去现有页编辑</span>`;
      saveBtn.disabled = false;
    } else if (res.status === 422) {
      saveStatus.innerHTML = `<span style="color:#FF3B30">schema 错：${JSON.stringify(data.detail).slice(0, 150)}</span>`;
      saveBtn.disabled = false;
    } else {
      saveStatus.innerHTML = `<span style="color:#FF3B30">${res.status} ${data.reason ?? 'error'}</span>`;
      saveBtn.disabled = false;
    }
  });
</script>
