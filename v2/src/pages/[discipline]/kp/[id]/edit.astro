---
/**
 * KP 编辑器 v0.8 Stage 4 — 整页重写
 *
 * server-side: canEdit check + 直读 D1（structured 列）+ render shell + inject JSON
 * client-side: hydrate via initEditor，与 v0.8 contract endpoint 对齐
 *
 * 见 v2/docs/KP-EDITOR-V0.8-PRD.md
 */
import Layout from '~/layouts/Layout.astro';
import { getDb } from '~/lib/db';
import { parseFrom, fromLabel } from '~/lib/nav';
import { getKpRecord, getKpStructured } from '~/lib/kp-api-store';
import { getMetadataForTenant } from '~/lib/metadata-api-store';
import type { ExistingKpInit, EditorMetadata } from '~/lib/editor/state';

const { discipline, id } = Astro.params;
if (!discipline || !id) return Astro.redirect('/404');
if (!Astro.locals.canEdit(discipline)) return Astro.redirect(`/${discipline}/kp/${id}`);

const fromPath = parseFrom(Astro.url.searchParams.get('from'), `/${discipline}/kp/${id}`);
const fromLbl = fromLabel(fromPath);

const db = getDb(Astro.locals.runtime.env);
const record = await getKpRecord(db, id);
if (!record || record.discipline !== discipline) return Astro.redirect('/404');

const structured = await getKpStructured(db, id);
if (!structured) {
  // 无 structured 列说明数据未跑 v0.8.0 Stage 1 backfill — Stage 3 之后理论不会发生
  return Astro.redirect(`/${discipline}/kp/${id}?editor_unavailable=structured_missing`);
}

const metadata = await getMetadataForTenant(db, { tenantId: record.tenant_id, discipline });
const disciplineLabel = metadata.discipline?.title.zh ?? discipline;

const initialState: ExistingKpInit = {
  id,
  discipline,
  title: record.title,
  body: structured.body,
  evaluations: structured.evaluations,
  schools: record.schools,
  scholars: record.scholars,
  tags: record.tags,
  year: record.year,
};

const editorMetadata: EditorMetadata = {
  schools: metadata.schools.map((s) => ({ key: s.key, label: s.title.zh })),
  scholars: metadata.scholars.map((s) => ({
    key: s.key,
    label: s.name.zh,
    sub: s.name.en ?? '',
  })),
  tags: (metadata.tags as Array<{ key: string; label: { zh: string }; color?: string }>).map((t) => ({
    key: t.key,
    label: t.label?.zh ?? t.key,
    color: t.color ?? null,
  })),
  disciplineLabel,
  disciplineKey: discipline,
  fromPath,
  fromLabel: fromLbl,
};
---

<Layout title={`编辑 · ${record.title.zh}`} currentDiscipline={discipline} currentSection="kps">
  <div class="kp-editor-v08" id="kp-editor-root" data-mode="edit"></div>

  <script type="application/json" is:inline id="kp-editor-init" set:html={JSON.stringify({ initialState, metadata: editorMetadata })}></script>
</Layout>

<script>
  import { makeEditingState, type ExistingKpInit, type EditorMetadata } from '~/lib/editor/state';
  import { initEditor } from '~/lib/editor/index';

  const root = document.getElementById('kp-editor-root');
  const initJson = document.getElementById('kp-editor-init')?.textContent;
  if (!root || !initJson) {
    console.error('[kp-editor] init payload missing');
  } else {
    const { initialState, metadata } = JSON.parse(initJson) as {
      initialState: ExistingKpInit;
      metadata: EditorMetadata;
    };
    initEditor({
      root: root as HTMLElement,
      initialState: makeEditingState(initialState),
      metadata,
      mode: 'edit',
    });
  }
</script>
