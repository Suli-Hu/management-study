---
import Layout from '~/layouts/Layout.astro';
import { getDb } from '~/lib/db';
import { renderBody } from '~/lib/render-body';

const { discipline, id } = Astro.params;
const db = getDb(Astro.locals.runtime.env);

const kp = await db
  .prepare('SELECT * FROM kp WHERE id = ? AND discipline = ?')
  .bind(id, discipline)
  .first<{
    id: string; discipline: string; year: string;
    title_zh: string; title_en: string | null; title_ja: string | null;
    body_zh: string; body_ja: string | null;
    tags_json: string; format: string;
  }>();

if (!kp) return Astro.redirect('/404');

const tags = JSON.parse(kp.tags_json) as string[];

// 关联学派 + 学者（含 accent，primary school 的 accent 给 body renderer 用）
const schoolsResult = await db
  .prepare(`
    SELECT s.key, s.title_zh, s.accent
    FROM school s
    INNER JOIN kp_school ks ON ks.school_key = s.key
    WHERE ks.kp_id = ?
    ORDER BY ks.position
  `)
  .bind(id)
  .all<{ key: string; title_zh: string; accent: string }>();
const schools = schoolsResult.results ?? [];

// accent key → hex color (tailwind.config.ts 的 accent 色板)
const ACCENT_MAP: Record<string, string> = {
  ob: '#34C759',
  classic: '#FF9500',
  strategy: '#007AFF',
  warning: '#FF3B30',
};
const accentKey = schools[0]?.accent ?? 'classic';
const accentHex = ACCENT_MAP[accentKey] ?? '#8a7a6a';

const scholarsResult = await db
  .prepare(`
    SELECT sc.key, sc.name_zh, sc.name_en
    FROM scholar sc
    INNER JOIN kp_scholar ks ON ks.scholar_key = sc.key
    WHERE ks.kp_id = ?
    ORDER BY ks.position
  `)
  .bind(id)
  .all<{ key: string; name_zh: string; name_en: string | null }>();
const scholars = scholarsResult.results ?? [];

// 当前显示语言（W1 简化：默认中文，?lang=ja 切日文）
const lang = (Astro.url.searchParams.get('lang') === 'ja' && kp.body_ja) ? 'ja' : 'zh';
const body = lang === 'ja' ? kp.body_ja! : kp.body_zh;
const title = lang === 'ja' ? (kp.title_ja ?? kp.title_zh) : kp.title_zh;
---

<Layout title={kp.title_zh} currentDiscipline={discipline} currentSection="kps">
  <main class="max-w-reading mx-auto px-4 py-6">
    <header class="mb-6 pb-4 border-b">
      <div class="flex items-start gap-3">
        <h1 class="text-2xl mb-2 flex-1">{title}</h1>
        {Astro.locals.isAdmin && (
          <a
            href={`/${discipline}/kp/${kp.id}/edit`}
            class="inline-flex shrink-0 mt-1 w-9 h-9 rounded-full items-center justify-center text-base text-quaternary hover:text-accent-strategy hover:bg-bg-tertiary transition-colors opacity-60 hover:opacity-100"
            aria-label="编辑此 KP"
            title="编辑此 KP"
          >
            ✎
          </a>
        )}
      </div>
      <div class="flex flex-wrap items-baseline gap-2 text-xs text-tertiary">
        {scholars.map((s) => (
          <a href={`/${discipline}/scholars/${s.key}`} class="font-semibold hover:underline">
            {s.name_en ?? s.name_zh}
          </a>
        ))}
        {kp.year && <span class="text-quaternary">'{kp.year}</span>}
      </div>
      {kp.title_en && <div class="text-xs text-quaternary italic mt-1">{kp.title_en}</div>}
      {kp.title_ja && lang === 'zh' && <div class="text-xs text-tertiary mt-1">{kp.title_ja}</div>}

      <div class="flex gap-2 mt-4">
        {kp.body_ja && (
          <a
            href={lang === 'zh' ? `?lang=ja` : Astro.url.pathname}
            class="chip border-quaternary"
          >
            {lang === 'zh' ? '日本語' : '中文'}
          </a>
        )}
        {schools.map((s) => (
          <a href={`/${discipline}/${s.key}`} class="chip border-quaternary">{s.title_zh}</a>
        ))}
      </div>
    </header>

    <article class="kp-body text-secondary" set:html={renderBody(body, accentHex)} />
  </main>
</Layout>
