---
import Layout from '~/layouts/Layout.astro';
import LangFab from '~/components/LangFab.astro';
import { getDb } from '~/lib/db';
import { renderBody, renderEvalModule, type KpFormat } from '~/lib/render-body';
import type { EvalContent } from '~/lib/eval-tag-defs';
import { editHref } from '~/lib/nav';
import { tagColor } from '~/lib/tag-color';
import { shortYear } from '~/lib/format-year';
import { lastName } from '~/lib/format-name';
import type { Tag } from '~/schemas/discipline';

const { discipline, id } = Astro.params;
const db = getDb(Astro.locals.runtime.env);

const kp = await db
  .prepare('SELECT * FROM kp WHERE id = ? AND discipline = ?')
  .bind(id, discipline)
  .first<{
    id: string; discipline: string; year: string;
    title_zh: string; title_en: string | null; title_ja: string | null;
    body_zh: string; body_ja: string | null;
    tags_json: string; format: KpFormat;
    eval_content_zh_json: string; eval_content_ja_json: string;
  }>();

if (!kp) return Astro.redirect('/404');

// KP 颜色 = kp.tags[0] → discipline.tags 库 → color（v0.5.0 标签化）
const discRow = await db
  .prepare('SELECT tags_json FROM discipline WHERE key = ?')
  .bind(discipline)
  .first<{ tags_json: string }>();
const tagLibrary = discRow?.tags_json ? JSON.parse(discRow.tags_json) as Tag[] : [];
const kpTags = JSON.parse(kp.tags_json) as string[];
const accentHex = tagColor({ tags: kpTags }, tagLibrary);

// 关联学派 + 学者
const schoolsResult = await db
  .prepare(`
    SELECT s.key, s.title_zh
    FROM school s
    INNER JOIN kp_school ks ON ks.school_key = s.key
    WHERE ks.kp_id = ?
    ORDER BY ks.position
  `)
  .bind(id)
  .all<{ key: string; title_zh: string }>();
const schools = schoolsResult.results ?? [];

const scholarsResult = await db
  .prepare(`
    SELECT sc.key, sc.name_zh, sc.name_en
    FROM scholar sc
    INNER JOIN kp_scholar ks ON ks.scholar_key = sc.key
    WHERE ks.kp_id = ?
    ORDER BY ks.position
  `)
  .bind(id)
  .all<{ key: string; name_zh: string; name_en: string | null }>();
const scholars = scholarsResult.results ?? [];

// 当前显示语言（W1 简化：默认中文，?lang=ja 切日文）
const lang = (Astro.url.searchParams.get('lang') === 'ja' && kp.body_ja) ? 'ja' : 'zh';
const body = lang === 'ja' ? kp.body_ja! : kp.body_zh;
const title = lang === 'ja' ? (kp.title_ja ?? kp.title_zh) : kp.title_zh;

// v0.5.47 evaluation 内容（义/限/例/应/用/喻）— 之前 standalone /kp/[id] 漏渲染，
// 手机/平板 < 1024px 右栏 hidden 时只能走 standalone 页，导致看不到评价。
let evalContent: EvalContent | null = null;
const evalRaw = lang === 'ja' ? kp.eval_content_ja_json : kp.eval_content_zh_json;
if (evalRaw) {
  try { evalContent = JSON.parse(evalRaw) as EvalContent; }
  catch { evalContent = null; }
}

// lang toggle href（保留其他 query 参数）
const langToggleParams = new URLSearchParams(Astro.url.search);
if (lang === 'zh') langToggleParams.set('lang', 'ja');
else langToggleParams.delete('lang');
const langToggleQs = langToggleParams.toString();
const langToggleHref = langToggleQs ? `${Astro.url.pathname}?${langToggleQs}` : Astro.url.pathname;
---

<Layout title={kp.title_zh} currentDiscipline={discipline} currentSection="kps">
  {/* v0.5.91: data-kp-id 让 just-edited highlight client 能定位到这页（保存后跳回有 ?just-edited） */}
  <main class="max-w-reading mx-auto px-4 py-6" data-kp-id={kp.id}>
    <header class="mb-6 pb-4 border-b">
      <div class="flex items-start gap-3">
        <h1 class="page-hero-title flex-1 mb-2">{title}</h1>
        {Astro.locals.canEdit(discipline) && (
          <a
            href={editHref(`/${discipline}/kp/${kp.id}/edit`, Astro.url.pathname)}
            data-edit-kp-link={kp.id}
            class="hero-icon-btn shrink-0"
            aria-label="编辑此 KP"
            title="编辑"
          >✎</a>
        )}
      </div>
      <div class="flex flex-wrap items-baseline gap-2 text-xs text-tertiary">
        {scholars.map((s) => (
          <a href={`/${discipline}/scholars/${s.key}`} class="font-semibold hover:underline">
            {lastName(s.name_en ?? s.name_zh)}
          </a>
        ))}
        {kp.year && <span class="text-quaternary">{shortYear(kp.year)}</span>}
      </div>
      {kp.title_en && <div class="text-xs text-quaternary italic mt-1">{kp.title_en}</div>}
      {kp.title_ja && lang === 'zh' && <div class="text-xs text-tertiary mt-1">{kp.title_ja}</div>}

      <div class="flex gap-2 mt-3 items-center">
        {kp.body_ja && (
          <a
            href={langToggleHref}
            class:list={['lang-toggle', lang === 'ja' && 'is-active']}
            data-lang-toggle
            style={`--accent:${accentHex}`}
            title="切换日语 / 中文 (Cmd/Ctrl + J)"
            aria-pressed={lang === 'ja'}
          >
            {lang === 'zh' ? '日本語' : '中文'}
          </a>
        )}
        {schools.map((s) => (
          <a href={`/${discipline}/${s.key}`} class="chip border-quaternary">{s.title_zh}</a>
        ))}
      </div>
    </header>

    <article class="kp-body text-secondary" set:html={renderBody({ fmt: kp.format, body, accentHex })} />
    {evalContent && <div set:html={renderEvalModule(evalContent)} />}
  </main>

  {/* v0.5.78：mobile 日语切换悬浮球（仅 KP 有 body_ja 时挂） */}
  {kp.body_ja && <LangFab lang={lang} accentHex={accentHex} />}
</Layout>

<script is:inline>
  // Cmd/Ctrl + J：切换日语 / 中文（V1 search.js:344 移植）
  (function () {
    function isEditableTarget(t) {
      if (!t) return false;
      var tag = t.tagName;
      if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT') return true;
      if (t.isContentEditable) return true;
      return false;
    }
    document.addEventListener('keydown', function (e) {
      if (!(e.metaKey || e.ctrlKey)) return;
      if (!e.key || e.key.toLowerCase() !== 'j') return;
      if (isEditableTarget(e.target)) return;
      var btn = document.querySelector('[data-lang-toggle]');
      if (!btn) return;
      e.preventDefault();
      // 视觉反馈：脉冲一下再跳转（V1 jaBtn.style.transform scale(1.2)）
      btn.classList.add('is-pulse');
      setTimeout(function () {
        btn.classList.remove('is-pulse');
        btn.click();
      }, 90);
    });
  })();
</script>
