---
import Layout from '~/layouts/Layout.astro';
import LangFab from '~/components/LangFab.astro';
import { getDb } from '~/lib/db';
import { renderStructuredBody, renderEvalModule } from '~/lib/render-body-structured';
import type { KpBody, KpEvaluationsLang } from '~/schemas/kp-body-structured';
import { editHref } from '~/lib/nav';
import { shortYear } from '~/lib/format-year';
import { lastName } from '~/lib/format-name';
import { resolveAccentForSchool } from '~/lib/resolve-accent';

const { discipline, id } = Astro.params;
const db = getDb(Astro.locals.runtime.env);

const kp = await db
  .prepare('SELECT * FROM kp WHERE id = ? AND discipline = ?')
  .bind(id, discipline)
  .first<{
    id: string; discipline: string; year: string;
    title_zh: string; title_en: string | null; title_ja: string | null;
    tags_json: string;
    // v0.8.10 Stage 5: 旧 body_zh / body_ja / format / eval_content_*_json 列已 drop
    body_zh_json: string; body_ja_json: string | null;
    evaluations_zh_json: string | null; evaluations_ja_json: string | null;
    body_format: string;
  }>();

if (!kp) return Astro.redirect('/404');

const bodyZh = JSON.parse(kp.body_zh_json) as KpBody;
const bodyJa = kp.body_ja_json ? JSON.parse(kp.body_ja_json) as KpBody : null;

// v0.8.20 三层原则 (PRD §6.2.3 final):
//   - 顶部 schools chip = page chrome accent (跨多学派 KP 区分有意义) → 学派色 hex
//   - 5 format render items numbering / cells / cols = page interior decoration → 中性 (var(--text-3))
//   - lang-toggle / LangFab = focus action → L1 var(--primary)

// 关联学派 + 学者；v0.8.20: pull tags_json 给 resolveAccentForSchool() 当 input
const schoolsResult = await db
  .prepare(`
    SELECT s.key, s.title_zh, s.tags_json
    FROM school s
    INNER JOIN kp_school ks ON ks.school_key = s.key
    WHERE ks.kp_id = ?
    ORDER BY ks.position
  `)
  .bind(id)
  .all<{ key: string; title_zh: string; tags_json: string | null }>();
// discipline.tags lookup
const discRow = await db
  .prepare('SELECT tags_json FROM discipline WHERE key = ?')
  .bind(discipline)
  .first<{ tags_json: string | null }>();
const tagDefs = JSON.parse(discRow?.tags_json ?? '[]') as Array<{ key: string; color: string }>;
const disciplineLookup = { tags: tagDefs };
const schools = (schoolsResult.results ?? []).map((s) => ({
  key: s.key,
  title_zh: s.title_zh,
  accentHex: resolveAccentForSchool(
    { tags: JSON.parse(s.tags_json || '[]') as string[] },
    disciplineLookup,
  ),
}));

const scholarsResult = await db
  .prepare(`
    SELECT sc.key, sc.name_zh, sc.name_en
    FROM scholar sc
    INNER JOIN kp_scholar ks ON ks.scholar_key = sc.key
    WHERE ks.kp_id = ?
    ORDER BY ks.position
  `)
  .bind(id)
  .all<{ key: string; name_zh: string; name_en: string | null }>();
const scholars = scholarsResult.results ?? [];

// 当前显示语言（W1 简化：默认中文，?lang=ja 切日文）
const lang = (Astro.url.searchParams.get('lang') === 'ja' && bodyJa) ? 'ja' : 'zh';
const renderedBody = lang === 'ja' ? bodyJa! : bodyZh;
const title = lang === 'ja' ? (kp.title_ja ?? kp.title_zh) : kp.title_zh;

// v0.5.47 evaluation 内容 — 选 zh/ja，整体读 v0.8 evaluations JSON
let evalContent: KpEvaluationsLang | null = null;
const evalRaw = lang === 'ja' ? kp.evaluations_ja_json : kp.evaluations_zh_json;
if (evalRaw) {
  try { evalContent = JSON.parse(evalRaw) as KpEvaluationsLang; }
  catch { evalContent = null; }
}

// lang toggle href（保留其他 query 参数）
const langToggleParams = new URLSearchParams(Astro.url.search);
if (lang === 'zh') langToggleParams.set('lang', 'ja');
else langToggleParams.delete('lang');
const langToggleQs = langToggleParams.toString();
const langToggleHref = langToggleQs ? `${Astro.url.pathname}?${langToggleQs}` : Astro.url.pathname;
---

<Layout title={kp.title_zh} currentDiscipline={discipline} currentSection="kps">
  {/* v0.5.91: data-kp-id 让 just-edited highlight client 能定位到这页（保存后跳回有 ?just-edited） */}
  <main class="kp-detail" data-kp-id={kp.id}>
    <header class="kp-head">
      <div class="kp-head-row">
        <h1 class="kp-title">{title}</h1>
        {Astro.locals.canEdit(discipline) && (
          <a
            href={editHref(`/${discipline}/kp/${kp.id}/edit`, Astro.url.pathname)}
            data-edit-kp-link={kp.id}
            class="kp-edit-btn"
            aria-label="编辑此 KP"
            title="编辑"
          >✎</a>
        )}
      </div>
      <div class="kp-meta">
        {scholars.map((s) => (
          <a href={`/${discipline}/scholars/${s.key}`} class="kp-scholar-link">
            {lastName(s.name_en ?? s.name_zh)}
          </a>
        ))}
        {kp.year && <span class="kp-year">{shortYear(kp.year)}</span>}
      </div>
      {kp.title_en && <div class="kp-title-en">{kp.title_en}</div>}
      {kp.title_ja && lang === 'zh' && <div class="kp-title-ja">{kp.title_ja}</div>}

      <div class="kp-chip-row">
        {bodyJa && (
          <a
            href={langToggleHref}
            class:list={['lang-toggle', lang === 'ja' && 'is-active']}
            data-lang-toggle
            title="切换日语 / 中文 (Cmd/Ctrl + J)"
            aria-pressed={lang === 'ja'}
          >
            {lang === 'zh' ? '日本語' : '中文'}
          </a>
        )}
        {schools.map((s) => (
          <a
            href={`/${discipline}/${s.key}`}
            class="kp-school-chip"
            data-accent-neutral={s.accentHex.startsWith('var(') ? 'true' : undefined}
            style={`--accent: ${s.accentHex}`}
          >{s.title_zh}</a>
        ))}
      </div>
    </header>

    <article class="kp-body" set:html={renderStructuredBody({
      body: renderedBody,
      accentHex: 'var(--text-3)',
    })} />
    {evalContent && <div set:html={renderEvalModule(evalContent)} />}
  </main>

  {/* v0.5.78：mobile 日语切换悬浮球（仅 KP 有 body_ja 时挂）
       v0.8.20: lang 切换是 focus action → L1 var(--primary) (PRD §6.2.3) */}
  {bodyJa && <LangFab lang={lang} accentHex="var(--primary)" />}
</Layout>

<script is:inline>
  // Cmd/Ctrl + J：切换日语 / 中文（V1 search.js:344 移植）
  (function () {
    function isEditableTarget(t) {
      if (!t) return false;
      var tag = t.tagName;
      if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT') return true;
      if (t.isContentEditable) return true;
      return false;
    }
    document.addEventListener('keydown', function (e) {
      if (!(e.metaKey || e.ctrlKey)) return;
      if (!e.key || e.key.toLowerCase() !== 'j') return;
      if (isEditableTarget(e.target)) return;
      var btn = document.querySelector('[data-lang-toggle]');
      if (!btn) return;
      e.preventDefault();
      // 视觉反馈：脉冲一下再跳转（V1 jaBtn.style.transform scale(1.2)）
      btn.classList.add('is-pulse');
      setTimeout(function () {
        btn.classList.remove('is-pulse');
        btn.click();
      }, 90);
    });
  })();
</script>

<style>
  /* v0.8.13 Stage 6 chip 2: KP 详情页 v1.0 design swap (sumi token)
     页面 chrome 全 token 化；body 内部 5 format / eval 复用 components.css 改造后 */
  .kp-detail {
    max-width: 720px;
    margin: 0 auto;
    padding: 32px 24px 96px;
    font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", system-ui, sans-serif;
  }
  @media (max-width: 720px) {
    .kp-detail { padding: 22px 16px 72px; }
  }

  /* ---- header ---- */
  .kp-head {
    margin-bottom: 24px;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--border);
  }
  .kp-head-row {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }
  .kp-title {
    flex: 1;
    margin: 0 0 8px;
    font-size: 24px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.005em;
    color: var(--text);
    word-break: break-word;
  }
  .kp-edit-btn {
    flex-shrink: 0;
    width: 36px; height: 36px;
    border-radius: 9999px;
    display: inline-flex; align-items: center; justify-content: center;
    font-size: 16px; line-height: 1;
    color: var(--text-3);
    background: transparent;
    border: 0;
    cursor: pointer;
    text-decoration: none;
    transition: background .14s, color .14s;
  }
  .kp-edit-btn:hover {
    background: var(--bg-soft);
    color: var(--text);
    opacity: 1;  /* 抵消 global a:hover { opacity: 0.8 } */
  }

  .kp-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px;
    font-size: 12px;
    color: var(--text-2);
  }
  .kp-scholar-link {
    font-weight: 600;
    color: var(--text-2);
    text-decoration: none;
  }
  .kp-scholar-link:hover {
    color: var(--text);
    text-decoration: underline;
    opacity: 1;
  }
  .kp-year {
    color: var(--text-3);
    font-variant-numeric: tabular-nums;
  }
  .kp-title-en {
    font-size: 12px;
    color: var(--text-3);
    font-style: italic;
    margin-top: 4px;
  }
  .kp-title-ja {
    font-size: 12px;
    color: var(--text-2);
    margin-top: 4px;
  }

  /* ---- chip row ---- */
  .kp-chip-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 14px;
    align-items: center;
  }
  .kp-school-chip {
    display: inline-flex;
    align-items: center;
    padding: 3px 10px;
    border-radius: 9999px;
    font-size: 12px;
    font-weight: 600;
    text-decoration: none;
    border: 1px solid var(--border);
    background: var(--bg-elev);
    color: var(--text-2);
    transition: border-color .14s, color .14s, background .14s;
  }
  .kp-school-chip:hover {
    border-color: var(--text-3);
    color: var(--text);
    opacity: 1;
  }
  /* v0.8.20: 学派 chip 着色 — 单条 oklch(from var(--accent) ...) 规则，accent 由 inline
     style={`--accent: ${hex}`} 注入 (resolveAccentForSchool 真实 hex)。 */
  .kp-school-chip[style*="--accent"]:not([data-accent-neutral]) {
    background: oklch(from var(--accent) l c h / 0.15);
    color: oklch(from var(--accent) calc(l - 0.40) c h);
    border-color: oklch(from var(--accent) l c h / 0.30);
  }
  /* Dark mode 提亮（base l ≈ 0.75，calc(l + 0.15) ≈ 0.90 在 dark bg 上对比足） */
  :global([data-mode="dark"]) .kp-school-chip[style*="--accent"]:not([data-accent-neutral]) {
    background: oklch(from var(--accent) l c h / 0.22);
    color: oklch(from var(--accent) calc(l + 0.15) c h);
    border-color: oklch(from var(--accent) l c h / 0.40);
  }

  /* ---- body wrapper ---- */
  .kp-body {
    color: var(--text-2);
  }
</style>
