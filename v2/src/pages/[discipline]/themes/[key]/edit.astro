---
import Layout from '~/layouts/Layout.astro';
import { parseFrom, fromLabel } from '~/lib/nav';
import { getDb } from '~/lib/db';
import type { Tag } from '~/schemas/discipline';

const { discipline, key } = Astro.params;
if (!Astro.locals.canEdit(discipline)) return Astro.redirect(`/${discipline}`);

const fromPath = parseFrom(Astro.url.searchParams.get('from'), `/${discipline}`);
const fromLbl = fromLabel(fromPath);

const db = getDb(Astro.locals.runtime.env);
const discRow = await db.prepare('SELECT tags_json FROM discipline WHERE key = ?').bind(discipline).first<{ tags_json: string }>();
const tagLibrary: Tag[] = discRow?.tags_json ? JSON.parse(discRow.tags_json) : [];
---

<Layout title={`编辑学派组 · ${key}`} currentDiscipline={discipline} currentSection="schools">
  <main class="max-w-reading mx-auto px-4 py-6">
    <header class="mb-4">
      <a href={fromPath} class="text-xs text-tertiary hover:underline">← 返回{fromLbl}</a>
      <h1 class="text-2xl mt-2">编辑学派组分组 <code class="text-base text-tertiary">{key}</code></h1>
      <p class="text-xs text-quaternary mt-1">key 不可改。schools[] 由首页拖动管理。</p>
    </header>

    <div id="status" class="hidden mb-4 p-3 rounded-md text-xs"></div>

    <form id="theme-edit-form" class="space-y-5 hidden" autocomplete="off" data-discipline={discipline} data-key={key}>
      <section>
        <label class="block text-xs font-semibold text-tertiary mb-1">中文标题 <span class="text-accent-warning">*</span></label>
        <input name="title_zh" type="text" required class="w-full px-3 py-2 rounded-md border text-sm" />
      </section>
      <section class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-semibold text-tertiary mb-1">English</label>
          <input name="title_en" type="text" class="w-full px-3 py-2 rounded-md border text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-tertiary mb-1">日本語</label>
          <input name="title_ja" type="text" class="w-full px-3 py-2 rounded-md border text-sm" />
        </div>
      </section>

      <section>
        <label class="block text-xs font-semibold text-tertiary mb-1">副标题（中文）</label>
        <input name="desc_zh" type="text" class="w-full px-3 py-2 rounded-md border text-sm" />
      </section>
      <section>
        <label class="block text-xs font-semibold text-tertiary mb-1">副标题（日文）</label>
        <input name="desc_ja" type="text" class="w-full px-3 py-2 rounded-md border text-sm" />
      </section>

      <section>
        <label class="block text-xs font-semibold text-tertiary mb-1">标签</label>
        {tagLibrary.length === 0 ? (
          <p class="text-xs text-quaternary">暂无标签可选 — 学科尚未配置标签库</p>
        ) : (
          <div class="flex gap-2 flex-wrap">
            {tagLibrary.map((t) => (
              <label class="inline-flex items-center gap-1 px-3 py-1.5 rounded border text-xs cursor-pointer">
                <input type="checkbox" name="tag" value={t.key} class="w-3 h-3" />
                <span>{t.label.zh ?? t.key}</span>
                <span class="inline-block w-3 h-3 rounded-full" style={`background:${t.color}`}></span>
              </label>
            ))}
          </div>
        )}
        <p class="text-xs text-quaternary mt-1">第一个勾选的标签决定卡片色，留空 = 中性灰</p>
      </section>

      <footer class="sticky bottom-0 bg-bg-primary py-3 border-t flex items-center gap-3">
        <button type="submit" id="save-btn" class="px-4 py-2 rounded-md bg-accent-strategy text-white text-sm font-semibold disabled:opacity-50">
          保存（commit + 部署）
        </button>
        <button
          type="button"
          id="delete-btn"
          disabled
          class="px-4 py-2 rounded-md bg-bg-primary border border-accent-warning text-accent-warning text-sm font-semibold ml-auto disabled:opacity-40 disabled:cursor-not-allowed"
          title="加载中..."
        >
          硬删此学派组
        </button>
        <span id="save-status" class="text-xs text-tertiary"></span>
      </footer>
    </form>
  </main>
</Layout>

<script>
  // @ts-nocheck — DOM form 类型推断弱，runtime 已验证
  import { formatZodIssues } from '~/lib/zod-errors-zh';
  import { watchDeploy } from '~/lib/deploy-progress-client';
  const $ = (s) => document.querySelector(s);
  const status = $('#status');
  const form = $('#theme-edit-form');
  const saveBtn = $('#save-btn');
  const deleteBtn = $('#delete-btn');
  const saveStatus = $('#save-status');
  const discipline = form.dataset.discipline;
  const key = form.dataset.key;
  let _deployWatcher = null;

  function setStatus(msg, kind = 'info') {
    status.textContent = msg;
    status.className = `mb-4 p-3 rounded-md text-xs ${
      kind === 'error' ? 'bg-badge-limit text-accent-warning' :
      kind === 'success' ? 'bg-badge-meaning' : 'bg-bg-secondary text-tertiary'
    }`;
    status.classList.remove('hidden');
  }

  function applyDeleteGate(schoolCount) {
    if (schoolCount === 0) {
      deleteBtn.disabled = false;
      deleteBtn.title = '删此学派组（进 git history 可 revert，~90s 后线上消失）';
    } else {
      deleteBtn.disabled = true;
      deleteBtn.title = `还有 ${schoolCount} 个学派归属此学派组。先把它们移到别的学派组或删掉，才能删此学派组。`;
    }
  }

  async function load() {
    setStatus('加载中...');
    const res = await fetch(`/api/edit/theme/${discipline}/${key}`);
    if (!res.ok) {
      const err = await res.json().catch(() => ({}));
      setStatus(`加载失败：${res.status} ${err.reason ?? ''}`, 'error');
      return;
    }
    const { json: t, school_count } = await res.json();
    form.title_zh.value = t.title?.zh ?? '';
    form.title_en.value = t.title?.en ?? '';
    form.title_ja.value = t.title?.ja ?? '';
    form.desc_zh.value = t.desc?.zh ?? '';
    form.desc_ja.value = t.desc?.ja ?? '';
    const themeTags = new Set(t.tags ?? []);
    document.querySelectorAll('input[name=tag]').forEach((c) => { c.checked = themeTags.has(c.value); });
    applyDeleteGate(school_count ?? 0);
    form.classList.remove('hidden');
    status.classList.add('hidden');
  }

  function buildI18n(zh, en, ja) {
    const o = { zh: zh.trim() };
    if (en?.trim()) o.en = en.trim();
    if (ja?.trim()) o.ja = ja.trim();
    return o;
  }
  function buildOptionalI18n(zh, ja) {
    if (!zh?.trim() && !ja?.trim()) return undefined;
    const o = {};
    if (zh?.trim()) o.zh = zh.trim();
    if (ja?.trim()) o.ja = ja.trim();
    return o;
  }

  async function save(e) {
    e.preventDefault();
    saveBtn.disabled = true;
    saveStatus.textContent = '保存中...';
    const checkedTags = Array.from(document.querySelectorAll('input[name=tag]:checked')).map((el) => el.value);
    const body = {
      title: buildI18n(form.title_zh.value, form.title_en.value, form.title_ja.value),
      desc: buildOptionalI18n(form.desc_zh.value, form.desc_ja.value),
      tags: checkedTags,
    };
    const res = await fetch(`/api/edit/theme/${discipline}/${key}`, {
      method: 'PUT',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify(body),
    });
    const data = await res.json().catch(() => ({}));
    if (res.ok) {
      if (_deployWatcher) _deployWatcher.stop();
      _deployWatcher = watchDeploy({ statusEl: saveStatus, commitSha: data.commit_sha, savedAtIso: new Date().toISOString() });
    } else if (res.status === 422) {
      const lines = formatZodIssues(data.detail);
      saveStatus.innerHTML = `<span style="color:#FF3B30">字段校验失败：<br>${lines.map((l) => '• ' + l).join('<br>')}</span>`;
    } else {
      saveStatus.innerHTML = `<span style="color:#FF3B30">${res.status} ${data.reason ?? 'error'}</span>`;
    }
    saveBtn.disabled = false;
  }

  async function del() {
    if (deleteBtn.disabled) return;
    if (!confirm(`确认硬删除学派组分组「${key}」？\n\n• 进 git history 可 revert\n• ~90s 后线上消失`)) return;
    deleteBtn.disabled = true;
    deleteBtn.textContent = '删除中...';
    const res = await fetch(`/api/edit/theme/${discipline}/${key}`, { method: 'DELETE' });
    const data = await res.json().catch(() => ({}));
    if (res.ok) {
      alert(`✓ 已删除 theme/${key}\ncommit ${data.commit_sha?.slice(0, 7)}`);
      location.href = `/${discipline}`;
    } else if (res.status === 409 && data.reason === 'has_dependents') {
      alert(`无法删除：${data.detail}`);
      deleteBtn.disabled = false;
      deleteBtn.textContent = '硬删此学派组';
    } else {
      alert(`删除失败：${res.status} ${data.reason}`);
      deleteBtn.disabled = false;
      deleteBtn.textContent = '硬删此学派组';
    }
  }

  form.addEventListener('submit', save);
  deleteBtn.addEventListener('click', del);
  load();
</script>
