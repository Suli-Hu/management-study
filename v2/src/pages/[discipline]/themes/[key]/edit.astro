---
/**
 * 学派组（theme）编辑页 v0.8 Stage 4.5 — 整页重写
 *
 * 见 v2/docs/SCHOOL-SCHOLAR-THEME-EDITOR-V0.8-PRD.md §5.3
 */
import Layout from '~/layouts/Layout.astro';
import { getDb } from '~/lib/db';
import { parseFrom, fromLabel } from '~/lib/nav';
import type { ExistingThemeInit, ThemeEditorMetadata } from '~/lib/editor/theme-state';

const { discipline, key } = Astro.params;
if (!discipline || !key) return Astro.redirect('/404');
if (!Astro.locals.canEdit(discipline)) return Astro.redirect(`/${discipline}`);

const fromPath = parseFrom(Astro.url.searchParams.get('from'), `/${discipline}`);
const fromLbl = fromLabel(fromPath);

const db = getDb(Astro.locals.runtime.env);
const discRow = await db
  .prepare('SELECT title_zh, themes_json, tags_json FROM discipline WHERE key = ?')
  .bind(discipline)
  .first<{ title_zh: string; themes_json: string; tags_json: string }>();
if (!discRow) return Astro.redirect('/404');

const themes: Array<{ key: string; title?: { zh?: string; ja?: string; en?: string }; desc?: { zh?: string; ja?: string }; tags?: string[] }> = discRow.themes_json
  ? JSON.parse(discRow.themes_json)
  : [];
const theme = themes.find((t) => t.key === key);
if (!theme) return Astro.redirect('/404');

const tagLibrary: Array<{ key: string; label?: { zh?: string }; color?: string }> = discRow.tags_json
  ? JSON.parse(discRow.tags_json)
  : [];

// v0.11.5: 计算该 theme 下 school 数（参 themes/[key].ts DELETE has_dependents gate）
const schoolCountRow = await db
  .prepare('SELECT COUNT(*) as n FROM school WHERE discipline = ? AND theme_key = ?')
  .bind(discipline, key)
  .first<{ n: number }>();
const schoolCount = schoolCountRow?.n ?? 0;

const initialState: ExistingThemeInit = {
  key,
  discipline,
  title: {
    zh: theme.title?.zh ?? '',
    ja: theme.title?.ja,
    en: theme.title?.en,
  },
  desc: theme.desc,
  tags: theme.tags ?? [],
};

const editorMetadata: ThemeEditorMetadata = {
  tags: tagLibrary.map((t) => ({
    key: t.key,
    label: t.label?.zh ?? t.key,
    color: t.color ?? null,
  })),
  disciplineLabel: discRow.title_zh,
  disciplineKey: discipline,
  fromPath,
  fromLabel: fromLbl,
  deleteGate: { schoolCount },
};
---

<Layout title={`编辑学派组 · ${theme.title?.zh ?? key}`} currentDiscipline={discipline} currentSection="schools">
  <div class="kp-editor-v08" id="theme-editor-root" data-mode="edit"></div>

  <script type="application/json" is:inline id="theme-editor-init" set:html={JSON.stringify({ initialState, metadata: editorMetadata })}></script>
</Layout>

<script>
  import { makeEditingThemeState, type ExistingThemeInit, type ThemeEditorMetadata } from '~/lib/editor/theme-state';
  import { initThemeEditor } from '~/lib/editor/theme-form';

  const root = document.getElementById('theme-editor-root');
  const initJson = document.getElementById('theme-editor-init')?.textContent;
  if (!root || !initJson) {
    console.error('[theme-editor] init payload missing');
  } else {
    const { initialState, metadata } = JSON.parse(initJson) as {
      initialState: ExistingThemeInit;
      metadata: ThemeEditorMetadata;
    };
    initThemeEditor({
      root: root as HTMLElement,
      initialState: makeEditingThemeState(initialState),
      metadata,
      mode: 'edit',
    });
  }
</script>
