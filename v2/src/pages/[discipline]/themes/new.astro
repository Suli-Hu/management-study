---
/**
 * 新增学派组（theme）页 v0.8 Stage 4.5 — 整页重写
 *
 * 见 v2/docs/SCHOOL-SCHOLAR-THEME-EDITOR-V0.8-PRD.md §5.3
 */
import Layout from '~/layouts/Layout.astro';
import { getDb } from '~/lib/db';
import type { ThemeEditorMetadata } from '~/lib/editor/theme-state';

const { discipline } = Astro.params;
if (!discipline) return Astro.redirect('/404');
if (!Astro.locals.canEdit(discipline)) return Astro.redirect(`/${discipline}`);

const db = getDb(Astro.locals.runtime.env);
const discRow = await db
  .prepare('SELECT title_zh, tags_json FROM discipline WHERE key = ?')
  .bind(discipline)
  .first<{ title_zh: string; tags_json: string }>();
if (!discRow) return Astro.redirect('/404');

const tagLibrary: Array<{ key: string; label?: { zh?: string }; color?: string }> = discRow.tags_json
  ? JSON.parse(discRow.tags_json)
  : [];

const editorMetadata: ThemeEditorMetadata = {
  tags: tagLibrary.map((t) => ({
    key: t.key,
    label: t.label?.zh ?? t.key,
    color: t.color ?? null,
  })),
  disciplineLabel: discRow.title_zh,
  disciplineKey: discipline,
  fromPath: `/${discipline}`,
  fromLabel: '学派概览',
};
---

<Layout title={`新增学派组 · ${discRow.title_zh}`} currentDiscipline={discipline} currentSection="schools">
  <div class="kp-editor-v08" id="theme-editor-root" data-mode="new"></div>

  <script type="application/json" is:inline id="theme-editor-init" set:html={JSON.stringify({ metadata: editorMetadata })}></script>
</Layout>

<script>
  import { makeNewThemeState, type ThemeEditorMetadata } from '~/lib/editor/theme-state';
  import { initThemeEditor } from '~/lib/editor/theme-form';

  const root = document.getElementById('theme-editor-root');
  const initJson = document.getElementById('theme-editor-init')?.textContent;
  if (!root || !initJson) {
    console.error('[theme-editor] init payload missing');
  } else {
    const { metadata } = JSON.parse(initJson) as { metadata: ThemeEditorMetadata };
    const initialState = makeNewThemeState(metadata.disciplineKey);
    initThemeEditor({
      root: root as HTMLElement,
      initialState,
      metadata,
      mode: 'new',
    });
  }
</script>
