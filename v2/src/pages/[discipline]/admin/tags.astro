---
/**
 * 标签库管理 · v0.5.27
 *
 * /[discipline]/admin/tags
 * 整页全量 PUT discipline.tags[]，被引用的 tag 删不了（has_dependents 阻断）。
 * UI: 折叠式 pill 列表（pill 本身就是预览 + 编辑器；色板走 popover）。
 */
import Layout from '~/layouts/Layout.astro';
import { getDb } from '~/lib/db';

const { discipline } = Astro.params;
if (!Astro.locals.canEdit(discipline)) return Astro.redirect(`/${discipline}`);

const db = getDb(Astro.locals.runtime.env);
const disc = await db
  .prepare('SELECT key, title_zh FROM discipline WHERE key = ?')
  .bind(discipline)
  .first<{ key: string; title_zh: string }>();
if (!disc) return Astro.redirect('/404');
---

<Layout title={`标签库 · ${disc.title_zh}`} currentDiscipline={discipline} currentSection="schools">
  <main class="max-w-reading mx-auto px-4 py-6">
    <header class="mb-4">
      <a href={`/${discipline}`} class="text-xs text-tertiary hover:underline">← 返回{disc.title_zh}</a>
      <h1 class="text-2xl mt-2">标签库</h1>
      <p class="text-xs text-quaternary mt-1">{disc.title_zh}</p>
    </header>

    <div id="status" class="hidden mb-4 p-3 rounded-md text-xs"></div>

    <div id="tags-mount" data-discipline={discipline}></div>

    <footer class="sticky bottom-0 bg-bg-primary py-3 border-t flex items-center gap-3 mt-6">
      <button type="button" id="add-btn" class="px-4 py-2 rounded-md bg-bg-primary border text-sm font-semibold">
        + 新建标签
      </button>
      <button type="button" id="save-btn" class="btn-ghost-strategy ml-auto">
        保存
      </button>
      <span id="save-status" class="text-xs text-tertiary"></span>
    </footer>
  </main>
</Layout>

<style is:global>
  .tag-row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 12px;
    margin-bottom: 6px;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: var(--color-bg-primary);
    transition: border-color .12s;
  }
  .tag-row:hover { border-color: var(--color-text-quaternary); }

  /* pill input — 既是预览又是编辑器 */
  .tag-pill-input {
    flex: 0 0 auto;
    width: 160px;
    padding: 4px 14px;
    border: 1px solid transparent;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 600;
    background: var(--tag-color);
    color: #fff;
    text-shadow: 0 1px 1px rgba(0, 0, 0, .15);
  }
  .tag-pill-input::placeholder { color: rgba(255, 255, 255, .7); font-weight: 500; }
  .tag-pill-input:focus {
    outline: none;
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--tag-color) 32%, transparent);
  }

  /* color trigger — 显示当前色 + hex */
  .cp-wrap { position: relative; flex: 0 0 auto; }
  .cp-trigger {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 4px 10px;
    border: 1px solid var(--color-border); border-radius: 6px;
    background: var(--color-bg-primary); cursor: pointer;
    font-size: 12px; font-variant-numeric: tabular-nums;
    color: var(--color-text-tertiary);
  }
  .cp-trigger:hover { border-color: var(--color-text-quaternary); }
  .cp-dot {
    width: 14px; height: 14px; border-radius: 50%;
    background: var(--tag-color);
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, .12);
  }
  .cp-chevron { color: var(--color-text-quaternary); font-size: 9px; }

  /* popover */
  .cp-popover {
    position: absolute; top: calc(100% + 6px); left: 0; z-index: 20;
    display: none;
    padding: 10px;
    background: var(--color-bg-primary);
    border: 1px solid var(--color-border); border-radius: 8px;
    box-shadow: 0 6px 20px rgba(0, 0, 0, .10);
    min-width: 220px;
  }
  .cp-popover.is-open { display: block; }
  .cp-presets {
    display: flex; gap: 8px; margin-bottom: 8px;
  }
  .cp-swatch {
    width: 24px; height: 24px; border-radius: 50%;
    border: none; cursor: pointer; padding: 0;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, .12);
  }
  .cp-swatch.is-active {
    box-shadow:
      inset 0 0 0 1px rgba(0, 0, 0, .12),
      0 0 0 2px var(--color-bg-primary),
      0 0 0 4px var(--color-text-secondary);
  }
  .cp-hex-input {
    width: 100%;
    padding: 4px 8px; border: 1px solid var(--color-border); border-radius: 4px;
    font-size: 12px; font-variant-numeric: tabular-nums;
    background: var(--color-bg-primary); color: var(--color-text-primary);
    box-sizing: border-box;
  }
  .cp-hex-input:focus { outline: none; border-color: var(--accent-strategy); }

  /* ref count + del */
  .ref-count {
    margin-left: auto;
    font-size: 11px; color: var(--color-text-quaternary);
    white-space: nowrap; font-variant-numeric: tabular-nums;
  }
  .del-btn {
    width: 28px; height: 28px; border-radius: 6px;
    border: 1px solid var(--color-border); background: transparent;
    color: var(--color-text-quaternary);
    font-size: 14px; line-height: 1; cursor: pointer;
    flex: 0 0 auto;
  }
  .del-btn:hover:not(:disabled) {
    border-color: var(--accent-warning); color: var(--accent-warning);
  }
  .del-btn:disabled { opacity: 0.4; cursor: not-allowed; }

  .empty-row {
    padding: 32px 12px; color: var(--color-text-quaternary);
    font-size: 13px; text-align: center;
    border: 1px dashed var(--color-border); border-radius: 8px;
  }
</style>

<script>
  // @ts-nocheck — DOM 类型推断弱，runtime 已验证
  import { TAG_COLOR_PRESETS } from '~/lib/color-picker-client';
  import { formatZodIssues } from '~/lib/zod-errors-zh';
  import { watchDeploy } from '~/lib/deploy-progress-client';

  const $ = (s) => document.querySelector(s);
  const mount = $('#tags-mount');
  const discipline = mount.dataset.discipline;
  const statusEl = $('#status');
  const saveBtn = $('#save-btn');
  const addBtn = $('#add-btn');
  const saveStatus = $('#save-status');

  let baseSha = null;
  let refCounts = {};
  // local model: { key, label_zh, color, _new?: true }
  let rows = [];
  let _deployWatcher = null;

  const HEX_RE = /^#[0-9A-Fa-f]{6}$/;
  function normalizeHex(s) {
    const v = (s || '').trim();
    if (!HEX_RE.test(v)) return null;
    return '#' + v.slice(1).toUpperCase();
  }

  function escAttr(s) {
    return String(s ?? '').replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;');
  }

  // 自动生成 tag key（admin 不需要手填）：t_ + 6 base36 chars
  function genUniqueKey() {
    const existing = new Set(rows.map((r) => r.key).filter(Boolean));
    for (let i = 0; i < 100; i++) {
      const k = 't_' + Math.random().toString(36).slice(2, 8).padEnd(6, '0');
      if (!existing.has(k)) return k;
    }
    return 't_' + Date.now().toString(36);
  }

  function setStatus(msg, kind = 'info') {
    statusEl.textContent = msg;
    statusEl.className = `mb-4 p-3 rounded-md text-xs ${
      kind === 'error' ? 'bg-badge-limit text-accent-warning' :
      kind === 'success' ? 'bg-badge-meaning' : 'bg-bg-secondary text-tertiary'
    }`;
    statusEl.classList.remove('hidden');
  }

  function clearStatus() { statusEl.classList.add('hidden'); }

  async function load() {
    setStatus('加载中...');
    const res = await fetch(`/api/edit/discipline/${discipline}/tags`);
    if (!res.ok) {
      const err = await res.json().catch(() => ({}));
      setStatus(`加载失败：${res.status} ${err.reason ?? ''}`, 'error');
      return;
    }
    const { tags, base_sha, ref_counts } = await res.json();
    baseSha = base_sha;
    refCounts = ref_counts ?? {};
    rows = (tags ?? []).map((t) => ({
      key: t.key,
      label_zh: t.label?.zh ?? t.key,
      color: t.color,
      _new: false,
    }));
    render();
    clearStatus();
  }

  function rowHTML(r, i) {
    const refs = r._new ? 0 : (refCounts[r.key] ?? 0);
    const canDelete = refs === 0;
    const delTitle = canDelete
      ? '删除此标签'
      : `还有 ${refs} 个引用。先把它们改掉再删。`;
    const refLabel = r._new ? '新建' : `引用 ${refs}`;
    const colorUpper = r.color.toUpperCase();
    const swatches = TAG_COLOR_PRESETS.map((p) => `
      <button type="button" class="cp-swatch ${p.hex.toUpperCase() === colorUpper ? 'is-active' : ''}"
              data-cp-preset="${p.hex}" aria-label="${p.label} ${p.hex}" title="${p.label} ${p.hex}"
              style="background:${p.hex}"></button>
    `).join('');
    return `
      <div class="tag-row" data-row="${i}" style="--tag-color:${r.color}">
        <input type="text" class="tag-pill-input" data-field="label_zh"
               value="${escAttr(r.label_zh)}" placeholder="标签名" />
        <div class="cp-wrap">
          <button type="button" class="cp-trigger" data-action="cp-toggle" aria-haspopup="true">
            <span class="cp-dot"></span>
            <span data-cp-hex>${r.color}</span>
            <span class="cp-chevron">▾</span>
          </button>
          <div class="cp-popover" data-cp-popover>
            <div class="cp-presets">${swatches}</div>
            <input type="text" class="cp-hex-input" data-cp-input
                   value="${r.color}" maxlength="7" placeholder="#RRGGBB" />
          </div>
        </div>
        <span class="ref-count">${refLabel}</span>
        <button type="button" class="del-btn" data-action="del"
                title="${delTitle}" ${canDelete ? '' : 'disabled'}>×</button>
      </div>
    `;
  }

  function render() {
    if (rows.length === 0) {
      mount.innerHTML = `<div class="empty-row">还没有标签。点底部「+ 新建标签」开始。</div>`;
      return;
    }
    mount.innerHTML = rows.map((r, i) => rowHTML(r, i)).join('');

    rows.forEach((r, i) => {
      const rowEl = mount.querySelector(`[data-row="${i}"]`);
      if (!rowEl) return;

      const labelInput = rowEl.querySelector('[data-field="label_zh"]');
      labelInput?.addEventListener('input', () => { r.label_zh = labelInput.value; });

      const cpTrigger = rowEl.querySelector('[data-action="cp-toggle"]');
      const cpPopover = rowEl.querySelector('[data-cp-popover]');
      cpTrigger?.addEventListener('click', (e) => {
        e.stopPropagation();
        document.querySelectorAll('.cp-popover.is-open').forEach((p) => {
          if (p !== cpPopover) p.classList.remove('is-open');
        });
        cpPopover.classList.toggle('is-open');
      });

      cpPopover?.querySelectorAll('[data-cp-preset]').forEach((sw) => {
        sw.addEventListener('click', (e) => {
          e.stopPropagation();
          const hex = sw.getAttribute('data-cp-preset');
          applyColor(r, rowEl, hex);
          cpPopover.classList.remove('is-open');
        });
      });

      const hexInput = cpPopover?.querySelector('[data-cp-input]');
      hexInput?.addEventListener('click', (e) => e.stopPropagation());
      hexInput?.addEventListener('input', () => {
        const norm = normalizeHex(hexInput.value);
        if (norm) applyColor(r, rowEl, norm);
      });
      hexInput?.addEventListener('blur', () => {
        if (!normalizeHex(hexInput.value)) hexInput.value = r.color;
      });

      const delBtn = rowEl.querySelector('[data-action="del"]');
      if (delBtn && !delBtn.disabled) {
        delBtn.addEventListener('click', () => {
          rows.splice(i, 1);
          render();
        });
      }
    });
  }

  function applyColor(r, rowEl, hex) {
    r.color = hex;
    rowEl.style.setProperty('--tag-color', hex);
    const hexLabel = rowEl.querySelector('[data-cp-hex]');
    if (hexLabel) hexLabel.textContent = hex;
    const cpInput = rowEl.querySelector('[data-cp-input]');
    if (cpInput && cpInput.value.toUpperCase() !== hex.toUpperCase()) cpInput.value = hex;
    rowEl.querySelectorAll('[data-cp-preset]').forEach((sw) => {
      sw.classList.toggle(
        'is-active',
        (sw.getAttribute('data-cp-preset') || '').toUpperCase() === hex.toUpperCase(),
      );
    });
  }

  function addRow() {
    rows.push({
      key: genUniqueKey(),
      label_zh: '',
      color: TAG_COLOR_PRESETS[0].hex,
      _new: true,
    });
    render();
    // 自动聚焦新增行的 label input
    const last = mount.querySelector(`[data-row="${rows.length - 1}"] [data-field="label_zh"]`);
    last?.focus();
  }

  async function save() {
    saveBtn.disabled = true;
    saveStatus.textContent = '保存中...';
    const body = {
      tags: rows.map((r) => ({
        key: r.key.trim(),
        label: { zh: r.label_zh.trim() },
        color: r.color,
      })),
      base_sha: baseSha,
    };
    const res = await fetch(`/api/edit/discipline/${discipline}/tags`, {
      method: 'PUT',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify(body),
    });
    const data = await res.json().catch(() => ({}));
    if (res.ok) {
      if (_deployWatcher) _deployWatcher.stop();
      _deployWatcher = watchDeploy({ statusEl: saveStatus, commitSha: data.commit_sha, savedAtIso: new Date().toISOString() });
      baseSha = data.new_blob_sha;
      // 保存后重新拉一次以刷新 ref_counts
      setTimeout(() => { load(); }, 500);
    } else if (res.status === 409 && data.reason === 'has_dependents') {
      saveStatus.innerHTML = `<span style="color:var(--s-danger)">${data.detail}</span>`;
    } else if (res.status === 409 && data.reason === 'sha_conflict') {
      saveStatus.innerHTML = `<span style="color:var(--s-danger)">冲突：discipline.json 已被其它修改，请刷新</span>`;
    } else if (res.status === 422) {
      const lines = formatZodIssues(data.detail);
      saveStatus.innerHTML = `<span style="color:var(--s-danger)">校验失败：<br>${lines.map((l) => '• ' + l).join('<br>')}</span>`;
    } else {
      saveStatus.innerHTML = `<span style="color:var(--s-danger)">${res.status} ${data.reason ?? 'error'}: ${String(data.detail ?? '').slice(0, 120)}</span>`;
    }
    saveBtn.disabled = false;
  }

  // 点 popover 外部 → 关掉所有 popover
  document.addEventListener('click', (e) => {
    if (!e.target.closest('.cp-wrap')) {
      document.querySelectorAll('.cp-popover.is-open').forEach((p) => p.classList.remove('is-open'));
    }
  });

  addBtn.addEventListener('click', addRow);
  saveBtn.addEventListener('click', save);
  load();
</script>
