            <div class="sl-field">
              <label class="sl-field-label">理解度自评</label>
              <div class="sl-rating" data-editor-rating>
                {[1,2,3,4,5].map((n) => (
                  <button type="button" data-rating-val={n} class="sl-rating-star">★</button>
