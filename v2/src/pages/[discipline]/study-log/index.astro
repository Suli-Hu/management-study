          <button type="button" class="sle-btn-ghost" data-export-close>取消</button>
          <button type="button" class="sle-btn-primary" data-export-submit>生成 PDF</button>
        </footer>
      </div>
    </div>

    {/* 打印渲染容器：屏幕隐藏，只在 @media print 时唯一可见 */}
    <div id="print-root" data-print-root></div>
  </main>
</Layout>

<script is:inline set:html={`window.__SL_TIERS__ = ${tierStatesJson};`}></script>
<script is:inline set:html={`window.__SL_KPS_GROUPED__ = ${kpGroupedJson};`}></script>

<script is:inline define:vars={{ TODAY, DISCIPLINE: discipline }} set:html={`window.__SL_SESSIONS__ = ${sessionsJson};`}></script>

<script is:inline define:vars={{ TODAY, DISCIPLINE_TITLE: disc.title_zh }}>
  // ============================================================
  // 数据模型 + 工具函数
  // ============================================================

  /** @type {Array<{id:string,date:string,start_time:string,duration_min:number,rating:number|null,note:string|null,kp_id:string|null,kp_title:string|null,school_key:string|null,school_title:string|null}>} */
  const ALL_SESSIONS = window.__SL_SESSIONS__ || [];

  function fmtDuration(min) {
    if (min >= 60) {
      const h = Math.floor(min / 60);
      const m = min % 60;
      return m > 0 ? `${h}h ${m}min` : `${h}h`;
    }
    return `${min}min`;
  }

  function parseDate(yyyymmdd) {
    const [y, m, d] = yyyymmdd.split('-').map(Number);
    return new Date(Date.UTC(y, m - 1, d));
  }

  function fmtMD(yyyymmdd) {
    const [, m, d] = yyyymmdd.split('-');
    return `${parseInt(m, 10)}-${d.padStart(2, '0')}`;
  }

  function chineseDay(yyyymmdd) {
    const dow = parseDate(yyyymmdd).getUTCDay();
    return ['周日', '周一', '周二', '周三', '周四', '周五', '周六'][dow];
  }

  function relativeDay(yyyymmdd, today = TODAY) {
    if (yyyymmdd === today) return '今天';
    const t = parseDate(today);
    const d = parseDate(yyyymmdd);
    const diff = Math.round((t - d) / 86_400_000);
    if (diff === 1) return '昨天';
    if (diff === 2) return '前天';
    return null;
  }

  function escapeHtml(s) {
    return String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c]));
  }

  function daysBetween(start, end) {
    return Math.round((parseDate(end) - parseDate(start)) / 86_400_000);
  }

  // ============================================================
  // 聚合
  // ============================================================

  /** 给 sessions 数组返回 byDate 字典 */
  function aggregateByDate(sessions) {
    const byDate = new Map();
    for (const s of sessions) {
      if (!byDate.has(s.date)) byDate.set(s.date, { total: 0, count: 0, items: [] });
      const e = byDate.get(s.date);
      e.total += s.duration_min;
      e.count += 1;
      e.items.push(s);
    }
    return byDate;
  }

  /** 时间范围内统计 */
  function computeStats(sessions, days, today) {
    const totalMin = sessions.reduce((s, x) => s + x.duration_min, 0);
    const dayKeys = new Set(sessions.map((s) => s.date));
    const studyDays = dayKeys.size;
    const avgPerStudyDay = studyDays > 0 ? Math.round(totalMin / studyDays) : 0;
    const coverage = days > 0 ? Math.round((studyDays / days) * 100) : 0;

    // 最长连续天数（在 today 倒数 days 范围内）
    let longest = 0;
    let cur = 0;
    const t = parseDate(today);
    for (let i = days - 1; i >= 0; i--) {
      const d = new Date(t);
      d.setUTCDate(d.getUTCDate() - i);
      const key = d.toISOString().slice(0, 10);
      if (dayKeys.has(key)) { cur++; longest = Math.max(longest, cur); }
      else cur = 0;
    }

    return { totalMin, studyDays, avgPerStudyDay, coverage, longest };
  }

  // ============================================================
  // 渲染：统计区
  // ============================================================

  function renderStats(days) {
    const fromDate = (() => {
      const d = parseDate(TODAY);
      d.setUTCDate(d.getUTCDate() - (days - 1));
      return d.toISOString().slice(0, 10);
    })();
    const inRange = ALL_SESSIONS.filter((s) => s.date >= fromDate && s.date <= TODAY);
    const stats = computeStats(inRange, days, TODAY);

    const h = Math.floor(stats.totalMin / 60);
    const m = stats.totalMin % 60;
    document.querySelector('[data-stat-label-left]').textContent = `近 ${days} 天累计`;
    document.querySelector('[data-stat-hours]').textContent = h > 0 ? String(h) : '0';
    document.querySelector('[data-stat-mins]').textContent = String(m);
    document.querySelector('[data-stat-sub-left]').textContent =
      `学习日平均 ${fmtDuration(stats.avgPerStudyDay)} / 天`;
    document.querySelector('[data-stat-days]').textContent = String(stats.studyDays);
    document.querySelector('[data-stat-sub-right]').textContent =
      `共 ${days} 天 · 覆盖 ${stats.coverage}% · 最长连续 ${stats.longest} 天`;
  }

  // ============================================================
  // 渲染：4 月并列日历热力图
  // ============================================================

  /** v0.7.23: 给 minutes 返回 0-5 等级（设计文档 6 档算法） */
  function heatLevel(min) {
    if (min <= 0) return 0;
    if (min < 15) return 1;
    if (min < 30) return 2;
    if (min < 60) return 3;
    if (min < 120) return 4;
    return 5;
  }

  function renderHeatmap() {
    const wrap = document.querySelector('[data-heatmap]');
    if (!wrap) return;
    const byDate = aggregateByDate(ALL_SESSIONS);

    // 取近 4 个月，从 today 往回
    const today = parseDate(TODAY);
    const months = [];
    for (let i = 3; i >= 0; i--) {
      const d = new Date(Date.UTC(today.getUTCFullYear(), today.getUTCMonth() - i, 1));
      months.push({ year: d.getUTCFullYear(), month: d.getUTCMonth() }); // 0-indexed
    }

    wrap.innerHTML = months.map(({ year, month }) => {
      const firstDow = new Date(Date.UTC(year, month, 1)).getUTCDay();
      // 调整为周一开始（0=周一, 6=周日）
      const offset = (firstDow + 6) % 7;
      const lastDay = new Date(Date.UTC(year, month + 1, 0)).getUTCDate();
      const cells = [];
      // 前置空格
      for (let i = 0; i < offset; i++) cells.push('<div class="sl-cal-empty"></div>');
      for (let day = 1; day <= lastDay; day++) {
        const dateStr = `${year}-${String(month + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
        const e = byDate.get(dateStr);
        const lvl = heatLevel(e?.total ?? 0);
        const isFuture = dateStr > TODAY;
        const isToday = dateStr === TODAY;
        const cls = [
          'sl-cal-day',
          `sl-heat-${lvl}`,
          isToday ? 'sl-cal-today' : '',
          isFuture ? 'sl-cal-future' : '',
        ].filter(Boolean).join(' ');
        const title = e ? `${dateStr} · ${fmtDuration(e.total)}（${e.count} 次）` : dateStr;
        cells.push(`<div class="${cls}" title="${title}">${day}</div>`);
      }
      return `
        <div class="sl-cal-month">
          <p class="sl-cal-month-label">${month + 1} 月</p>
          <div class="sl-cal-dow">
            <span>一</span><span>二</span><span>三</span><span>四</span><span>五</span><span>六</span><span>日</span>
          </div>
          <div class="sl-cal-grid">${cells.join('')}</div>
        </div>
      `;
    }).join('');
  }

  // ============================================================
  // 渲染：Session 列表（按日期分组）
  // ============================================================

  function renderList(days) {
    const fromDate = (() => {
      const d = parseDate(TODAY);
      d.setUTCDate(d.getUTCDate() - (days - 1));
      return d.toISOString().slice(0, 10);
    })();
    const inRange = ALL_SESSIONS.filter((s) => s.date >= fromDate && s.date <= TODAY);
    const list = document.querySelector('[data-session-list]');
    const empty = document.querySelector('[data-empty]');
    if (!list || !empty) return;

    if (inRange.length === 0) {
      list.innerHTML = '';
      empty.classList.remove('hidden');
      return;
    }
    empty.classList.add('hidden');

    // 按日期分组（已按 date DESC 排好序，sessions 顺序保留）
    const byDate = new Map();
    for (const s of inRange) {
      if (!byDate.has(s.date)) byDate.set(s.date, []);
      byDate.get(s.date).push(s);
    }

    const groupsHtml = [...byDate.entries()].map(([date, items]) => {
      const totalMin = items.reduce((sum, x) => sum + x.duration_min, 0);
      const rel = relativeDay(date);
      const head = `${rel ? rel + ' · ' : ''}${fmtMD(date)} ${chineseDay(date)} · ${items.length} 次 · ${fmtDuration(totalMin)}`;
      const rows = items.map((s) => {
        const kpTitle = escapeHtml(s.kp_title ?? (s.kp_id ? `[已删除] ${s.kp_id}` : '[KP 信息缺失]'));
        const schoolTitle = escapeHtml(s.school_title ?? '');
        const rating = s.rating ? '★'.repeat(s.rating) + '☆'.repeat(5 - s.rating) : '';
        const note = s.note ? escapeHtml(s.note) : '';
        return `
          <div class="sl-row" data-row data-id="${escapeHtml(s.id)}">
            <div class="sl-row-main">
              <span class="sl-row-time">${escapeHtml(s.start_time)}</span>
              <span class="sl-row-kp" title="${kpTitle}">${kpTitle}</span>
              ${schoolTitle ? `<span class="sl-row-school">${schoolTitle}</span>` : ''}
              ${note ? `<span class="sl-row-note-preview">${note.slice(0, 40)}${note.length > 40 ? '…' : ''}</span>` : '<span class="sl-row-note-preview sl-empty-note"></span>'}
              <span class="sl-row-dur">${fmtDuration(s.duration_min)}</span>
              ${rating ? `<span class="sl-row-rating">${rating}</span>` : '<span class="sl-row-rating sl-empty-rating"></span>'}
              <span class="sl-row-actions">
                <button type="button" class="sl-row-icon" data-row-edit title="编辑">✎</button>
                <button type="button" class="sl-row-icon" data-row-delete title="删除">✕</button>
              </span>
              <span class="sl-row-chevron">▾</span>
            </div>
            ${note ? `<div class="sl-row-note hidden" data-note>${note}</div>` : ''}
          </div>
        `;
      }).join('');
      return `
        <div class="sl-group">
          <p class="sl-group-head">${escapeHtml(head)}</p>
          <div class="sl-group-rows">${rows}</div>
        </div>
      `;
    }).join('');

    list.innerHTML = groupsHtml;

    // 行展开
    list.querySelectorAll('[data-row]').forEach((row) => {
      const note = row.querySelector('[data-note]');
      if (!note) return;
      row.style.cursor = 'pointer';
      row.addEventListener('click', () => {
        note.classList.toggle('hidden');
        row.querySelector('.sl-row-chevron').classList.toggle('sl-row-chevron-rot');
      });
    });
  }

  // ============================================================
  // 视图切换 + 时间筛选
  // ============================================================

  function setView(view) {
    document.querySelectorAll('[data-view-pane]').forEach((el) => {
      el.classList.toggle('hidden', el.getAttribute('data-view-pane') !== view);
    });
    document.querySelectorAll('[data-view]').forEach((btn) => {
      btn.classList.toggle('sl-seg-active', btn.getAttribute('data-view') === view);
    });
  }

  function setRange(days) {
    document.querySelectorAll('[data-range]').forEach((btn) => {
      btn.classList.toggle('sl-chip-active', btn.getAttribute('data-range') === String(days));
    });
    renderStats(days);
    renderList(days);
    if (typeof bindRowActions === 'function') bindRowActions();
  }

  // ============================================================
  // 视图 B · 知识点排行（v0.5.5 / v0.7.21 多维度排序）
  // ============================================================

  // 排序状态：默认按累计降序；点同列 toggle 方向，点不同列 reset 到 desc
  let rankSortField = 'totalMin';  // 'totalMin' | 'count' | 'avg' | 'lastDate'
  let rankSortDir = 'desc';        // 'desc' | 'asc'

  function setRankSort(field) {
    if (rankSortField === field) {
      rankSortDir = rankSortDir === 'desc' ? 'asc' : 'desc';
    } else {
      rankSortField = field;
      rankSortDir = 'desc';
    }
    renderRankList();
  }

  function rankSortValue(row, field) {
    if (field === 'avg') return row.ratingCount > 0 ? row.ratingSum / row.ratingCount : -1;
    if (field === 'lastDate') return row.lastDate || '';
    return row[field] ?? 0;
  }

  function renderRankList() {
    const list = document.querySelector('[data-rank-list]');
    const empty = document.querySelector('[data-rank-empty]');
    if (!list || !empty) return;

    if (ALL_SESSIONS.length === 0) {
      list.innerHTML = '';
      empty.classList.remove('hidden');
      return;
    }
    empty.classList.add('hidden');

    // 按 kp_id 聚合
    const byKp = new Map();
    for (const s of ALL_SESSIONS) {
      const key = s.kp_id ?? '__deleted__';
      if (!byKp.has(key)) {
        byKp.set(key, {
          kp_id: s.kp_id,
          kp_title: s.kp_title,
          school_title: s.school_title,
          totalMin: 0,
          count: 0,
          ratingSum: 0,
          ratingCount: 0,
          lastDate: '',
        });
      }
      const e = byKp.get(key);
      e.totalMin += s.duration_min;
      e.count += 1;
      if (s.rating) { e.ratingSum += s.rating; e.ratingCount += 1; }
      if (s.date > e.lastDate) e.lastDate = s.date;
    }

    // 先按当前 sort 字段排，进度条 maxMin 仍按累计取（条形图视觉与排序解耦）
    const ranked = [...byKp.values()].sort((a, b) => {
      const av = rankSortValue(a, rankSortField);
      const bv = rankSortValue(b, rankSortField);
      if (av < bv) return rankSortDir === 'desc' ? 1 : -1;
      if (av > bv) return rankSortDir === 'desc' ? -1 : 1;
      return 0;
    });
    const maxMin = Math.max(...ranked.map((r) => r.totalMin), 1);
    const totalAll = ranked.reduce((s, r) => s + r.totalMin, 0);

    function colHtml(label, field) {
      const active = rankSortField === field;
      const arrow = active ? (rankSortDir === 'desc' ? '↓' : '↑') : '';
      return `<button type="button" class="sl-rank-col-num sl-rank-col-btn${active ? ' is-active' : ''}" data-rank-sort="${field}">${escapeHtml(label)}<span class="sl-rank-arrow">${arrow}</span></button>`;
    }

    list.innerHTML = `
      <div class="sl-rank-head">
        <span class="sl-rank-col-title">知识点</span>
        ${colHtml('累计', 'totalMin')}
        ${colHtml('次数', 'count')}
        ${colHtml('平均评分', 'avg')}
        ${colHtml('最近', 'lastDate')}
      </div>
      ${ranked.map((r) => {
        const pct = Math.max(2, Math.round((r.totalMin / maxMin) * 100));
        const avg = r.ratingCount > 0 ? Math.round(r.ratingSum / r.ratingCount) : 0;
        const stars = avg > 0 ? '★'.repeat(avg) + '☆'.repeat(5 - avg) : '—';
        const kpDisplay = r.kp_title ?? (r.kp_id ? `[已删除] ${r.kp_id}` : '[KP 信息缺失]');
        const sharePct = totalAll > 0 ? ((r.totalMin / totalAll) * 100).toFixed(1) : '0';
        return `
          <div class="sl-rank-row" title="占总时长 ${sharePct}%">
            <div class="sl-rank-progress-bg" style="width:${pct}%"></div>
            <div class="sl-rank-content">
              <div class="sl-rank-title">
                <p class="sl-rank-kp">${escapeHtml(kpDisplay)}</p>
                ${r.school_title ? `<p class="sl-rank-school">${escapeHtml(r.school_title)}</p>` : ''}
              </div>
              <span class="sl-rank-num">${fmtDuration(r.totalMin)}</span>
              <span class="sl-rank-num">${r.count}</span>
              <span class="sl-rank-num sl-rank-stars">${stars}</span>
              <span class="sl-rank-num">${fmtMD(r.lastDate)}</span>
            </div>
          </div>
        `;
      }).join('')}
    `;
  }

  // ============================================================
  // 视图 C · 学派段位（v0.5.4）
  // ============================================================

  /** @type {Array<{schoolKey:string,schoolTitle:string,score:number,totalEarned:number,decayApplied:number,tier:string,peakTier:string,toNextTierScore:number|null,nextTierThreshold:number|null,lastActiveDate:string|null,daysSinceLastActive:number,sessionCount:number,timeline:number[]}>} */
  const ALL_TIERS = window.__SL_TIERS__ || [];

  let cExpanded = false;

  /** SVG sparkline 100x20 viewBox，points = number[] (30) */
  function sparklineSvg(points) {
    if (points.length === 0) return '';
    const w = 100, h = 20;
    const max = Math.max(...points, 1);
    const stepX = points.length > 1 ? w / (points.length - 1) : 0;
    const coords = points
      .map((p, i) => `${(i * stepX).toFixed(1)},${(h - (p / max) * h).toFixed(1)}`)
      .join(' ');
    const last = points[points.length - 1];
    const lastX = ((points.length - 1) * stepX).toFixed(1);
    const lastY = (h - (last / max) * h).toFixed(1);
    return `<svg class="sl-spark" viewBox="0 0 ${w} ${h}" preserveAspectRatio="none">
      <polyline points="${coords}" fill="none" stroke="#525252" stroke-width="1" />
      <circle cx="${lastX}" cy="${lastY}" r="1.6" fill="#0a0a0a" />
    </svg>`;
  }

  function renderTierRow(t, idx) {
    const tierLabel = t.tier;
    const peakBadge = (t.peakTier && t.peakTier !== t.tier)
      ? `<span class="sl-tier-peak">曾达 ${escapeHtml(t.peakTier)}</span>`
      : '';
    const progressPct = t.nextTierThreshold
      ? Math.min(100, Math.round((t.score / t.nextTierThreshold) * 100))
      : 100;
    const progressLabel = t.nextTierThreshold
      ? `${t.score} / ${t.nextTierThreshold}`
      : `${t.score} (顶段)`;
    const decayHint = t.daysSinceLastActive > 0
      ? `<span class="sl-tier-decay" title="距上次学习 ${t.daysSinceLastActive} 天，每天 −20 分">${t.daysSinceLastActive > 30 ? '30+' : t.daysSinceLastActive}d 未学</span>`
      : '';
    return `
      <div class="sl-tier-row sl-tier-row-${tierLabel.toLowerCase()}">
        <span class="sl-tier-rank">#${idx + 1}</span>
        <span class="sl-tier-badge sl-tier-badge-${tierLabel.toLowerCase()}">${tierLabel}</span>
        <div class="sl-tier-school">
          <p class="sl-tier-school-name">${escapeHtml(t.schoolTitle)}</p>
          <p class="sl-tier-school-meta">${peakBadge} ${decayHint}</p>
        </div>
        <div class="sl-tier-progress">
          <p class="sl-tier-progress-label">${progressLabel}</p>
          <div class="sl-tier-progress-bar">
            <div class="sl-tier-progress-fill" style="width:${progressPct}%"></div>
          </div>
        </div>
        <div class="sl-tier-spark-wrap">${sparklineSvg(t.timeline)}</div>
        <button type="button" class="sl-tier-quiz" disabled title="quiz 入口 (v0.6+ 即将)">练 →</button>
      </div>
    `;
  }

  function renderTierList() {
    const list = document.querySelector('[data-tier-list]');
    if (!list || !ALL_TIERS.length) return;

    // 排序：score 降序，相同分数按 schoolKey 字母（已在 SSR 排过 + computeTiers 内部又 sort 一次）
    const active = ALL_TIERS.filter((t) => t.score > 0 || t.totalEarned > 0);
    const cFresh = ALL_TIERS.filter((t) => t.score === 0 && t.totalEarned === 0);

    let html = '';
    if (active.length === 0) {
      html += '<p class="sl-empty">还没有任何学派有段位分数。</p>';
    } else {
      html += active.map((t, i) => renderTierRow(t, i)).join('');
    }

    if (cFresh.length > 0) {
      const visible = cExpanded ? cFresh : [];
      html += visible.map((t, i) => renderTierRow(t, active.length + i)).join('');
    }

    list.innerHTML = html;

    // C 段折叠按钮
    const toggle = document.querySelector('[data-tier-c-toggle]');
    const label = document.querySelector('[data-tier-c-label]');
    if (toggle && label) {
      if (cFresh.length > 0) {
        toggle.classList.remove('hidden');
        label.textContent = cExpanded
          ? '收起 0 学派'
          : `显示全部 ${cFresh.length} 个 0 学派 (C 段)`;
      } else {
        toggle.classList.add('hidden');
      }
    }
  }

  // ============================================================
  // 启动
  // ============================================================

  document.querySelectorAll('[data-view]').forEach((btn) => {
    btn.addEventListener('click', () => setView(btn.getAttribute('data-view')));
  });
  document.querySelectorAll('[data-range]').forEach((btn) => {
    btn.addEventListener('click', () => setRange(Number(btn.getAttribute('data-range'))));
  });
  document.querySelector('[data-tier-c-toggle]')?.addEventListener('click', () => {
    cExpanded = !cExpanded;
    renderTierList();
  });

  renderTierList();
  renderRankList();

  // 知识点排行 column header 排序：event delegation（list 内容会重渲染，header 也重渲染）
  document.querySelector('[data-rank-list]')?.addEventListener('click', (e) => {
    const btn = e.target.closest('[data-rank-sort]');
    if (!btn) return;
    setRankSort(btn.getAttribute('data-rank-sort'));
  });

  // ============================================================
  // SessionEditor (v0.5.5)
  // ============================================================

  const KPS_GROUPED = window.__SL_KPS_GROUPED__ || [];
  const overlay = document.querySelector('[data-editor-overlay]');
  const form = document.querySelector('[data-editor-form]');
  const titleEl = document.querySelector('[data-editor-title]');
  const idInput = document.querySelector('[data-editor-id]');
  const kpCombo = document.querySelector('[data-editor-kp-combo]');
  const kpInput = document.querySelector('[data-editor-kp-input]');
  const kpValue = document.querySelector('[data-editor-kp-value]');
  const kpList = document.querySelector('[data-editor-kp-list]');
  const kpClear = document.querySelector('[data-editor-kp-clear]');
  const dateInput = document.querySelector('[data-editor-date]');
  const timeInput = document.querySelector('[data-editor-time]');
  const durInput = document.querySelector('[data-editor-dur]');
  const ratingValueInput = document.querySelector('[data-editor-rating-value]');
  const noteInput = document.querySelector('[data-editor-note]');
  const submitBtn = document.querySelector('[data-editor-submit]');
  const errorBox = document.querySelector('[data-editor-error]');

  // KP combobox：搜索 + 学派分组 dropdown（替代原 native select）
  // 选项数据扁平化方便 keyboard nav；group label 渲染时插入
  const KP_FLAT = [];
  const KP_TITLE_BY_ID = new Map();
  for (const [group, items] of KPS_GROUPED) {
    for (const k of items) {
      KP_FLAT.push({ id: k.id, title: k.title_zh, group });
      KP_TITLE_BY_ID.set(k.id, k.title_zh);
    }
  }

  function renderKpList(query) {
    if (!kpList) return;
    const q = (query || '').trim().toLowerCase();
    const buckets = new Map();
    for (const k of KP_FLAT) {
      if (q && !k.title.toLowerCase().includes(q)) continue;
      if (!buckets.has(k.group)) buckets.set(k.group, []);
      buckets.get(k.group).push(k);
    }
    if (buckets.size === 0) {
      kpList.innerHTML = '<div class="sl-kp-empty">没找到匹配的知识点</div>';
      return;
    }
    let html = '';
    for (const [group, items] of buckets) {
      html += `<div class="sl-kp-group-label">${escapeHtml(group)}</div>`;
      for (const k of items) {
        const selected = kpValue.value === k.id;
        html += `<div class="sl-kp-option${selected ? ' is-selected' : ''}" role="option" data-kp-id="${escapeHtml(k.id)}" data-kp-title="${escapeHtml(k.title)}">${escapeHtml(k.title)}</div>`;
      }
    }
    kpList.innerHTML = html;
  }

  function openKpList() {
    if (!kpList) return;
    renderKpList(kpInput.value);
    kpList.classList.remove('hidden');
    kpInput.setAttribute('aria-expanded', 'true');
    // 滚到当前选中
    const sel = kpList.querySelector('.sl-kp-option.is-selected');
    if (sel) sel.scrollIntoView({ block: 'nearest' });
  }

  function closeKpList() {
    kpList?.classList.add('hidden');
    kpInput?.setAttribute('aria-expanded', 'false');
    clearHighlight();
  }

  function clearHighlight() {
    kpList?.querySelectorAll('.sl-kp-option.is-highlighted').forEach((el) => el.classList.remove('is-highlighted'));
  }

  function moveHighlight(dir) {
    if (!kpList || kpList.classList.contains('hidden')) {
      openKpList();
      return;
    }
    const opts = Array.from(kpList.querySelectorAll('.sl-kp-option'));
    if (opts.length === 0) return;
    const cur = kpList.querySelector('.sl-kp-option.is-highlighted');
    let idx = cur ? opts.indexOf(cur) : -1;
    idx = (idx + dir + opts.length) % opts.length;
    clearHighlight();
    opts[idx].classList.add('is-highlighted');
    opts[idx].scrollIntoView({ block: 'nearest' });
  }

  function setKp(id) {
    if (!kpInput || !kpValue || !kpClear) return;
    if (id) {
      kpValue.value = id;
      kpInput.value = KP_TITLE_BY_ID.get(id) ?? '';
      kpClear.classList.remove('hidden');
    } else {
      kpValue.value = '';
      kpInput.value = '';
      kpClear.classList.add('hidden');
    }
  }

  if (kpInput && kpList) {
    kpInput.addEventListener('focus', openKpList);
    kpInput.addEventListener('click', openKpList);
    kpInput.addEventListener('input', () => {
      // 用户输入 = 重新过滤；意味着当前 hidden value 不再匹配 → 清掉
      kpValue.value = '';
      kpClear.classList.toggle('hidden', !kpInput.value);
      renderKpList(kpInput.value);
      kpList.classList.remove('hidden');
      kpInput.setAttribute('aria-expanded', 'true');
    });
    kpInput.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') { e.preventDefault(); moveHighlight(1); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); moveHighlight(-1); }
      else if (e.key === 'Enter') {
        const cur = kpList.querySelector('.sl-kp-option.is-highlighted');
        if (cur) {
          e.preventDefault();
          setKp(cur.getAttribute('data-kp-id'));
          closeKpList();
        }
      } else if (e.key === 'Escape') {
        if (!kpList.classList.contains('hidden')) {
          e.preventDefault();
          closeKpList();
        }
      }
    });

    kpList.addEventListener('mousedown', (e) => {
      // mousedown 而非 click：避免 input blur 早于 click 关闭 dropdown
      const opt = e.target.closest('.sl-kp-option');
      if (!opt) return;
      e.preventDefault();
      setKp(opt.getAttribute('data-kp-id'));
      closeKpList();
    });

    kpClear.addEventListener('click', () => {
      setKp(null);
      kpInput.focus();
    });

    // 点外部关闭
    document.addEventListener('click', (e) => {
      if (!kpCombo.contains(e.target)) closeKpList();
    });
  }

  // Rating star 点击
  document.querySelectorAll('[data-rating-val]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const val = parseInt(btn.getAttribute('data-rating-val') || '0', 10);
      ratingValueInput.value = val ? String(val) : '';
      document.querySelectorAll('[data-rating-val]').forEach((b) => {
        const v = parseInt(b.getAttribute('data-rating-val') || '0', 10);
        b.classList.toggle('sl-rating-active', v > 0 && v <= val);
      });
    });
  });

  function nowHM() {
    const d = new Date();
    return `${String(d.getHours()).padStart(2, '0')}:${String(d.getMinutes()).padStart(2, '0')}`;
  }

  function openEditor(session) {
    if (!overlay || !form) return;
    errorBox.classList.add('hidden');
    errorBox.textContent = '';
    if (session) {
      titleEl.textContent = '编辑学习记录';
      idInput.value = session.id;
      setKp(session.kp_id ?? null);
      dateInput.value = session.date;
      timeInput.value = session.start_time;
      durInput.value = String(session.duration_min);
      ratingValueInput.value = session.rating ? String(session.rating) : '';
      noteInput.value = session.note ?? '';
      // 同步 rating star UI
      document.querySelectorAll('[data-rating-val]').forEach((b) => {
        const v = parseInt(b.getAttribute('data-rating-val') || '0', 10);
        b.classList.toggle('sl-rating-active', v > 0 && session.rating && v <= session.rating);
      });
    } else {
      titleEl.textContent = '新建学习记录';
      idInput.value = '';
      setKp(null);
      dateInput.value = TODAY;
      timeInput.value = nowHM();
      durInput.value = '30';
      ratingValueInput.value = '';
      noteInput.value = '';
      document.querySelectorAll('[data-rating-val]').forEach((b) => b.classList.remove('sl-rating-active'));
    }
    overlay.classList.remove('hidden');
    setTimeout(() => kpInput?.focus(), 50);
  }

  function closeEditor() {
    overlay?.classList.add('hidden');
  }

  // 多个元素都可能 trigger 编辑器（顶部按钮 + 手机 FAB），全部绑
  document.querySelectorAll('[data-editor-open]').forEach((el) => {
    el.addEventListener('click', () => openEditor(null));
  });
  document.querySelector('[data-editor-close]')?.addEventListener('click', closeEditor);
  document.querySelector('[data-editor-cancel]')?.addEventListener('click', closeEditor);
  // Esc 关闭
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !overlay?.classList.contains('hidden')) closeEditor();
  });

  // v0.5.6: bottom sheet 拖拽把手下滑关闭（仅手机视口）
  const handle = document.querySelector('[data-editor-handle]');
  const sheet = document.querySelector('[data-editor-sheet]');
  if (handle && sheet) {
    let dragStartY = 0;
    let currentY = 0;
    let dragging = false;
    handle.addEventListener('touchstart', (e) => {
      if (window.innerWidth > 768) return; // 仅手机
      dragStartY = e.touches[0].clientY;
      currentY = 0;
      dragging = true;
      sheet.style.transition = 'none';
    }, { passive: true });
    handle.addEventListener('touchmove', (e) => {
      if (!dragging) return;
      currentY = Math.max(0, e.touches[0].clientY - dragStartY);
      sheet.style.transform = `translateY(${currentY}px)`;
    }, { passive: true });
    handle.addEventListener('touchend', () => {
      if (!dragging) return;
      dragging = false;
      sheet.style.transition = '';
      if (currentY > 80) {
        // 滑下 ≥ 80px 关闭
        closeEditor();
        // 重置
        setTimeout(() => { sheet.style.transform = ''; }, 300);
      } else {
        sheet.style.transform = '';
      }
    });
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorBox.classList.add('hidden');
    submitBtn.disabled = true;
    submitBtn.textContent = '保存中…';

    const id = idInput.value.trim();
    const ratingVal = ratingValueInput.value.trim();
    const noteVal = noteInput.value.trim();
    const body = {
      kp_id: kpValue.value,
      date: dateInput.value,
      start_time: timeInput.value,
      duration_min: parseInt(durInput.value, 10),
      rating: ratingVal ? parseInt(ratingVal, 10) : null,
      note: noteVal || null,
    };
    let url, method;
    if (id) {
      url = `/api/study-sessions/${encodeURIComponent(id)}`;
      method = 'PUT';
    } else {
      url = '/api/study-sessions';
      method = 'POST';
      body.discipline = window.location.pathname.split('/')[1];
    }

    try {
      const res = await fetch(url, {
        method,
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(body),
      });
      const data = await res.json();
      if (res.ok && data.ok) {
        // 刷新页面拿最新 SSR 数据
        window.location.reload();
        return;
      }
      errorBox.textContent = `${data.reason ?? 'error'}${data.detail ? ': ' + (Array.isArray(data.detail) ? data.detail.join('; ') : data.detail) : ''}`;
      errorBox.classList.remove('hidden');
    } catch (err) {
      errorBox.textContent = '网络错误：' + (err?.message ?? err);
      errorBox.classList.remove('hidden');
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = '保存';
    }
  });

  // ============================================================
  // Session 行 hover: 编辑 / 删除按钮（在 renderList 后挂）
  // ============================================================

  function bindRowActions() {
    document.querySelectorAll('[data-row]').forEach((row) => {
      const id = row.getAttribute('data-id');
      // 已有 click 展开心得；编辑/删除用 button 阻止冒泡
      const editBtn = row.querySelector('[data-row-edit]');
      const delBtn = row.querySelector('[data-row-delete]');
      editBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        const s = ALL_SESSIONS.find((x) => x.id === id);
        if (s) openEditor(s);
      });
      delBtn?.addEventListener('click', async (e) => {
        e.stopPropagation();
        if (!confirm('确认删除这条学习记录？')) return;
        try {
          const r = await fetch(`/api/study-sessions/${encodeURIComponent(id)}`, { method: 'DELETE' });
          if (r.ok) { window.location.reload(); return; }
          alert('删除失败：' + r.status);
        } catch (err) {
          alert('网络错误：' + err.message);
        }
      });
    });
  }

  // 启动时已经 setRange(30) 在 init 段调过，但那时 bindRowActions 函数还没定义
  // → 这里手动 bind 一次
  bindRowActions();

  // 初次渲染：默认 30 天
  renderHeatmap();
  setRange(30);

  // ============================================================
  // Export PDF (v0.7.22) — dialog + window.print() 渲染
  // 数据复用 ALL_SESSIONS；不引入第三方 PDF 库（PRD §12 明确）
  // ============================================================

  (function setupExport() {
    const overlay = document.querySelector('[data-export-overlay]');
    const rangeGroup = document.querySelector('[data-export-range-group]');
    const rangeInfo = document.querySelector('[data-export-range-info]');
    const heatmapRow = document.querySelector('[data-export-heatmap-row]');
    const heatmapNote = document.querySelector('[data-export-heatmap-note]');
    const submitBtn = document.querySelector('[data-export-submit]');
    const printRoot = document.querySelector('[data-print-root]');
    if (!overlay || !rangeGroup || !submitBtn || !printRoot) return;

    let currentRange = 7;

    function getInclude() {
      const out = {};
      document.querySelectorAll('[data-export-include]').forEach((el) => {
        out[el.getAttribute('data-export-include')] = el.checked;
      });
      return out;
    }

    function refreshRangeInfo() {
      const startDate = sleAddDays(TODAY, -(currentRange - 1));
      const inRange = ALL_SESSIONS.filter((s) => s.date >= startDate && s.date <= TODAY);
      rangeInfo.textContent = `${startDate} ~ ${TODAY} · 共 ${inRange.length} 条记录`;
      const heatBox = heatmapRow.querySelector('input');
      if (currentRange >= 90) {
        heatmapRow.classList.add('is-disabled');
        heatBox.checked = false;
        heatBox.disabled = true;
        heatmapNote.textContent = '— 90 天范围太大，本次跳过';
      } else {
        heatmapRow.classList.remove('is-disabled');
        heatBox.disabled = false;
        heatmapNote.textContent = '';
      }
    }

    document.querySelectorAll('[data-export-open]').forEach((el) => {
      el.addEventListener('click', () => {
        overlay.classList.remove('hidden');
        refreshRangeInfo();
      });
    });
    document.querySelectorAll('[data-export-close]').forEach((el) => {
      el.addEventListener('click', () => overlay.classList.add('hidden'));
    });
    overlay.addEventListener('click', (e) => {
      if (e.target === overlay) overlay.classList.add('hidden');
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !overlay.classList.contains('hidden')) overlay.classList.add('hidden');
    });

    rangeGroup.addEventListener('click', (e) => {
      const btn = e.target.closest('[data-export-range]');
      if (!btn) return;
      currentRange = parseInt(btn.getAttribute('data-export-range'), 10);
      rangeGroup.querySelectorAll('[data-export-range]').forEach((b) => {
        b.classList.toggle('is-active', b === btn);
      });
      refreshRangeInfo();
    });

    submitBtn.addEventListener('click', () => {
      submitBtn.disabled = true;
      submitBtn.textContent = '生成中…';
      try {
        const startDate = sleAddDays(TODAY, -(currentRange - 1));
        printRoot.innerHTML = renderReport({
          startDate, endDate: TODAY, days: currentRange, include: getInclude(),
        });
        // 等 DOM paint 一帧再打印（避免 print 拿到空 root）
        setTimeout(() => {
          window.print();
          submitBtn.disabled = false;
          submitBtn.textContent = '生成 PDF';
          overlay.classList.add('hidden');
          // 用户取消打印或保存完成后清空 print-root，避免屏幕残留
          setTimeout(() => { printRoot.innerHTML = ''; }, 500);
        }, 300);
      } catch (err) {
        alert('生成失败：' + (err?.message ?? err));
        submitBtn.disabled = false;
        submitBtn.textContent = '生成 PDF';
      }
    });

    // ===== 报告渲染 helpers =====
    function sleAddDays(dateStr, n) {
      const [y, m, d] = dateStr.split('-').map(Number);
      const ms = Date.UTC(y, m - 1, d) + n * 86400000;
      const dt = new Date(ms);
      return dt.getUTCFullYear() + '-' + String(dt.getUTCMonth() + 1).padStart(2, '0') + '-' + String(dt.getUTCDate()).padStart(2, '0');
    }
    function sleFmtDate(dateStr) {
      const d = new Date(dateStr + 'T00:00:00');
      const wk = '日一二三四五六'[d.getDay()];
      return `${d.getMonth() + 1}月${d.getDate()}日 周${wk}`;
    }
    function sleFmtDur(min) {
      const h = Math.floor(min / 60);
      const m = min % 60;
      if (h === 0) return `${m} min`;
      if (m === 0) return `${h} h`;
      return `${h} h ${m} min`;
    }
    function heatLevel(min) {
      if (min === 0) return 0;
      if (min < 15) return 1;
      if (min < 30) return 2;
      if (min < 60) return 3;
      if (min < 120) return 4;
      return 5;
    }
    // v0.7.23: PDF 热力图也走 sumi --i-* token（CSS var 在 inline style 内 print 时正常解析）
    const HEAT_COLORS = ['var(--i-0)', 'var(--i-1)', 'var(--i-2)', 'var(--i-3)', 'var(--i-4)', 'var(--i-5)'];

    function renderReport({ startDate, endDate, days, include }) {
      const sessions = ALL_SESSIONS.filter((s) => s.date >= startDate && s.date <= endDate);

      // overview
      const totalMin = sessions.reduce((sum, s) => sum + s.duration_min, 0);
      const studiedDates = new Set(sessions.map((s) => s.date));
      const studiedDays = studiedDates.size;
      const avgPerDay = studiedDays > 0 ? Math.round(totalMin / studiedDays) : 0;
      let longestStreak = 0, cur = 0;
      for (let i = 0; i < days; i++) {
        const d = sleAddDays(startDate, i);
        if (studiedDates.has(d)) { cur++; longestStreak = Math.max(longestStreak, cur); }
        else cur = 0;
      }

      // by date desc
      const byDate = {};
      sessions.forEach((s) => {
        if (!byDate[s.date]) byDate[s.date] = [];
        byDate[s.date].push(s);
      });
      const dateGroups = Object.keys(byDate).sort((a, b) => b.localeCompare(a)).map((d) => ({
        date: d,
        items: byDate[d].sort((a, b) => (b.start_time || '').localeCompare(a.start_time || '')),
      }));

      // rank by KP
      const kpMap = {};
      sessions.forEach((s) => {
        const kid = s.kp_id ?? '__deleted__';
        if (!kpMap[kid]) kpMap[kid] = { kp_id: s.kp_id, kp_title: s.kp_title, school_title: s.school_title, totalMin: 0, count: 0 };
        kpMap[kid].totalMin += s.duration_min;
        kpMap[kid].count += 1;
      });
      const rankRows = Object.values(kpMap).sort((a, b) => b.totalMin - a.totalMin);

      // heatmap days
      const heatDays = [];
      for (let i = 0; i < days; i++) {
        const d = sleAddDays(startDate, i);
        const dayMin = (byDate[d] || []).reduce((s, x) => s + x.duration_min, 0);
        heatDays.push({ date: d, min: dayMin });
      }

      let h = '<div class="sle-report">';
      h += renderCover({ startDate, endDate, days, include, totalMin, studiedDays, avgPerDay, longestStreak });
      let secNum = 1;
      if (include.heatmap) { h += renderHeatmapSection({ heatDays, startDate, days, num: secNum++ }); }
      if (include.rank && rankRows.length > 0) { h += renderRankSection(rankRows, secNum++); }
      if (include.log && dateGroups.length > 0) { h += renderLogSection(dateGroups, sessions.length, secNum++); }
      h += '</div>';
      return h;
    }

    function renderCover({ startDate, endDate, days, include, totalMin, studiedDays, avgPerDay, longestStreak }) {
      let h = '<section class="sle-cover">';
      h += '<div>';
      h += `<p class="sle-cover-eyebrow">STUDY LOG · REPORT</p>`;
      h += `<h1 class="sle-cover-h1">学习记录</h1>`;
      h += `<p class="sle-cover-sub">${escapeHtml(DISCIPLINE_TITLE)}</p>`;
      h += '</div>';
      h += '<div class="sle-cover-range">';
      h += `<p class="sle-cover-range-label">报告区间</p>`;
      h += `<p class="sle-cover-range-val">${startDate} ~ ${endDate}</p>`;
      h += `<p class="sle-cover-range-days">共 ${days} 天</p>`;
      h += '</div>';
      if (include.overview) {
        const cov = days > 0 ? Math.round(studiedDays / days * 100) : 0;
        h += '<div class="sle-cover-stats">';
        h += `<div><p class="sle-stat-label">累计学习</p><p class="sle-stat-value">${sleFmtDur(totalMin)}</p></div>`;
        h += `<div><p class="sle-stat-label">学习天数</p><p class="sle-stat-value">${studiedDays} 天</p><p class="sle-stat-sub">共 ${days} 天 · 覆盖 ${cov}%</p></div>`;
        h += `<div><p class="sle-stat-label">日均（学习日）</p><p class="sle-stat-value">${sleFmtDur(avgPerDay)}</p></div>`;
        h += `<div><p class="sle-stat-label">最长连续</p><p class="sle-stat-value">${longestStreak} 天</p></div>`;
        h += '</div>';
      }
      h += `<div class="sle-cover-foot"><span>${escapeHtml(DISCIPLINE_TITLE)}</span><span class="sle-cover-foot-spacer"></span><span>导出于 ${endDate}</span></div>`;
      h += '</section>';
      return h;
    }

    function sectionHead(num, title, sub) {
      return `<div class="sle-section-head"><p class="sle-section-num">${String(num).padStart(2, '0')}</p><div class="sle-section-title-row"><h3>${escapeHtml(title)}</h3><span class="sle-section-sub">${escapeHtml(sub)}</span></div></div>`;
    }

    function renderHeatmapSection({ heatDays, startDate, days, num }) {
      const start = new Date(startDate + 'T00:00:00');
      const startDow = (start.getDay() + 6) % 7;
      const cells = [];
      for (let i = 0; i < startDow; i++) cells.push(null);
      cells.push(...heatDays);
      while (cells.length % 7 !== 0) cells.push(null);
      const weeks = [];
      for (let i = 0; i < cells.length; i += 7) weeks.push(cells.slice(i, i + 7));

      let h = '<section class="sle-section">';
      h += sectionHead(num, '日历热力图', `${days} 天 · 颜色越深表示学习越多`);
      h += '<div class="sle-heatmap-wrap"><div class="sle-heatmap-dows">';
      for (const d of ['一', '二', '三', '四', '五', '六', '日']) h += `<span>${d}</span>`;
      h += '</div><div class="sle-heatmap-grid">';
      for (const wk of weeks) {
        h += '<div class="sle-heatmap-week">';
        for (const c of wk) {
          if (c) {
            const lvl = heatLevel(c.min);
            const border = lvl === 0 ? 'border:1px solid #ececec;' : '';
            h += `<div class="sle-heatmap-cell" style="background:${HEAT_COLORS[lvl]};${border}" title="${c.date} · ${sleFmtDur(c.min)}"></div>`;
          } else {
            h += '<div class="sle-heatmap-empty"></div>';
          }
        }
        h += '</div>';
      }
      h += '</div></div>';
      h += '<div class="sle-heatmap-legend"><span>少</span>';
      for (let i = 0; i < HEAT_COLORS.length; i++) {
        const border = i === 0 ? 'border:1px solid #ececec;' : '';
        h += `<div class="sle-heatmap-legend-cell" style="background:${HEAT_COLORS[i]};${border}"></div>`;
      }
      h += '<span>多</span><span class="sle-heatmap-legend-spacer"></span><span class="sle-heatmap-legend-bands">0 · &lt;15min · 15-30 · 30-60 · 1-2h · 2h+</span></div>';
      h += '</section>';
      return h;
    }

    function renderRankSection(rows, num) {
      const max = rows[0].totalMin || 1;
      let h = '<section class="sle-section">';
      h += sectionHead(num, '知识点排行', `按累计时长排序 · 共 ${rows.length} 个`);
      rows.forEach((r, i) => {
        const pct = (r.totalMin / max) * 100;
        const kpDisplay = r.kp_title ?? (r.kp_id ? `[已删除] ${r.kp_id}` : '[KP 信息缺失]');
        h += '<div class="sle-rank-row">';
        h += `<div class="sle-rank-num">#${i + 1}</div>`;
        h += `<div class="sle-rank-kp-wrap"><div class="sle-rank-kp-name">${escapeHtml(kpDisplay)}</div>`;
        if (r.school_title) h += `<span class="sle-rank-school-chip">${escapeHtml(r.school_title)}</span>`;
        h += '</div>';
        h += `<div><div class="sle-rank-bar-bg"><div class="sle-rank-bar-fill" style="width:${pct}%"></div></div></div>`;
        h += `<div class="sle-rank-time">${sleFmtDur(r.totalMin)}</div>`;
        h += '</div>';
      });
      h += '</section>';
      return h;
    }

    function renderLogSection(groups, total, num) {
      let h = '<section class="sle-section">';
      h += sectionHead(num, '逐日记录', `共 ${total} 条 session`);
      for (const g of groups) {
        const dayMin = g.items.reduce((s, x) => s + x.duration_min, 0);
        h += `<div class="sle-log-day"><div class="sle-log-day-head"><span class="sle-log-day-title">${sleFmtDate(g.date)}</span><span class="sle-log-day-iso">${g.date}</span><span class="sle-log-day-spacer"></span><span class="sle-log-day-summary">${g.items.length} 条 · ${sleFmtDur(dayMin)}</span></div>`;
        for (const s of g.items) {
          const stars = s.rating ? '★'.repeat(s.rating) + '☆'.repeat(5 - s.rating) : '';
          const kpDisplay = s.kp_title ?? (s.kp_id ? `[已删除] ${s.kp_id}` : '[KP 信息缺失]');
          h += '<div class="sle-log-row">';
          h += `<div class="sle-log-time">${escapeHtml(s.start_time || '—')}</div>`;
          h += `<div class="sle-log-main"><div class="sle-log-row-head"><span class="sle-log-kp">${escapeHtml(kpDisplay)}</span>`;
          if (s.school_title) h += `<span class="sle-rank-school-chip">${escapeHtml(s.school_title)}</span>`;
          if (stars) h += `<span class="sle-log-rating">${stars}</span>`;
          h += '</div>';
          if (s.note) h += `<p class="sle-log-note">${escapeHtml(s.note)}</p>`;
          h += '</div>';
          h += `<div class="sle-log-dur">${sleFmtDur(s.duration_min)}</div>`;
          h += '</div>';
        }
        h += '</div>';
      }
      h += '</section>';
      return h;
    }
  })();
</script>

