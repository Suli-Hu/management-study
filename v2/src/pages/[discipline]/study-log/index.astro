          <div class="sl-field">
            <label class="sl-field-label" for="sl-note">心得（可选）</label>
            <textarea id="sl-note" name="note" rows="3" maxlength="2000" class="sl-field-input sl-field-textarea" placeholder="今天学到什么 · 卡在哪 · 下一步…" data-editor-note></textarea>
          </div>

          <div data-editor-error class="sl-editor-error hidden"></div>

          <footer class="sl-editor-foot">
            <button type="button" class="sl-editor-btn-ghost" data-editor-cancel>取消</button>
            <button type="submit" class="sl-editor-btn-primary" data-editor-submit>保存</button>
          </footer>
        </form>
      </div>
    </div>

    {/* ============================================================ */}
    {/* 视图 C · 学派段位（v0.5.4） */}
    {/* ============================================================ */}
    <section data-view-pane="tier" class="sl-view hidden">
      <div class="sl-tier-ladder">
        <p class="sl-tier-ladder-title">段位规则 · 1 min = 1 分，每天 0 点 −20，跌破阈值降级</p>
        <div class="sl-tier-ladder-chips">
          {tierLevels.map((t, i) => (
            <span class={`sl-tier-chip sl-tier-chip-${t.key.toLowerCase()}`}>
              <strong>{t.key}</strong>
