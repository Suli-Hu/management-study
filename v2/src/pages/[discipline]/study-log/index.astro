            <p class="sle-sub">生成可分享的学习记录报告</p>
          </div>
          <button type="button" class="sle-close" data-export-close aria-label="关闭">×</button>
        </header>
        <div class="sle-body">
          <div class="sle-field">
            <p class="sle-field-label">时间范围</p>
            <div class="sle-range-chips" role="radiogroup" data-export-range-group>
              <button type="button" class="sle-chip is-active" data-export-range="7">近 7 天</button>
              <button type="button" class="sle-chip" data-export-range="14">近 14 天</button>
              <button type="button" class="sle-chip" data-export-range="30">近 30 天</button>
              <button type="button" class="sle-chip" data-export-range="90">近 90 天</button>
