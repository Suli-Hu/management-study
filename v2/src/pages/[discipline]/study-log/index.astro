    white-space: nowrap;
  }
  .sl-add-btn:hover { background: #262626; }
  .sl-add-btn[disabled] {
    cursor: not-allowed;
    opacity: 0.4;
  }

  /* 视图切换器 */
  .sl-switcher {
    display: inline-flex;
