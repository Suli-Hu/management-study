  }
  .sl-unit {
    font-size: 14px;
    font-weight: 400;
    color: #525252;
    margin-left: 4px;
    margin-right: 12px;
  }
  .sl-stat-sub {
    font-size: 11.5px;
    color: #a3a3a3;
    margin: 0;
  }

  /* 日历热力图 */
  .sl-heatmap-wrap {
    padding: 20px 28px;
    border: 1px solid #ececec;
    border-radius: 12px;
    background: #fff;
    margin-bottom: 22px;
    position: relative;
  }
  .sl-heatmap-title {
    font-size: 12px;
    color: #525252;
    margin: 0 0 14px;
  }
  .sl-heatmap-title [data-title-mobile] { display: none; }
  .sl-heatmap-legend {
    position: absolute;
    top: 18px;
    right: 28px;
    font-size: 11px;
    color: #a3a3a3;
    display: inline-flex;
    align-items: center;
    gap: 3px;
  }
  .sl-heat {
    width: 10px;
    height: 10px;
    border-radius: 2px;
    display: inline-block;
  }
  .sl-heat-0 { background: #f5f5f4; }
  .sl-heat-1 { background: #dbe7f7; }
  .sl-heat-2 { background: #a8c6ed; }
  .sl-heat-3 { background: #5b8cd1; }
  .sl-heat-4 { background: #2f5a99; }

  .sl-heatmap {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }
  .sl-cal-month {
    min-width: 0;
  }
  .sl-cal-month-label {
    font-size: 12px;
    font-weight: 500;
    color: #525252;
    margin: 0 0 6px;
  }
  .sl-cal-dow {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 2px;
    margin-bottom: 4px;
  }
  .sl-cal-dow span {
    font-size: 10px;
    color: #a3a3a3;
    text-align: center;
  }
  .sl-cal-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 3px;
  }
  .sl-cal-day, .sl-cal-empty {
    aspect-ratio: 1;
    border-radius: 3px;
    font-size: 10px;
    color: #525252;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .sl-cal-day {
    cursor: default;
  }
  .sl-cal-day.sl-heat-3, .sl-cal-day.sl-heat-4 {
    color: #fff;
    font-weight: 500;
  }
  .sl-cal-today {
    box-shadow: inset 0 0 0 1.5px #0a0a0a;
  }
  .sl-cal-future {
    color: #d4d4d4;
    background: transparent !important;
    border: 1px dashed #ececec;
  }

  /* 时间筛选 chips */
  .sl-chips {
    display: flex;
    gap: 8px;
    margin-bottom: 16px;
  }
  .sl-chip {
    all: unset;
    cursor: pointer;
    padding: 6px 14px;
    border-radius: 999px;
    font-size: 12px;
    color: #525252;
    border: 1px solid #ececec;
    background: #fff;
    transition: all .12s;
  }
  .sl-chip:hover { border-color: #a3a3a3; }
  .sl-chip-active {
    background: #0a0a0a;
    color: #fff;
    border-color: #0a0a0a;
  }

  /* Session 列表 */
  .sl-list {
    border: 1px solid #ececec;
    border-radius: 12px;
    background: #fff;
    overflow: hidden;
  }
  .sl-group + .sl-group {
    border-top: 1px solid #f5f5f4;
  }
  .sl-group-head {
    font-size: 11.5px;
    color: #a3a3a3;
    margin: 0;
    padding: 12px 20px 6px;
    background: #fafaf9;
    letter-spacing: 0.02em;
  }
  .sl-group-rows {
    padding: 4px 0;
  }
  .sl-row {
    border-bottom: 1px solid #f5f5f4;
    transition: background .08s;
  }
  .sl-row:last-child { border-bottom: 0; }
  .sl-row:hover { background: #fafaf9; }
  .sl-row-main {
    display: grid;
    grid-template-columns: 56px minmax(120px, 1.4fr) auto minmax(0, 2fr) 70px 70px 50px 20px;
    gap: 14px;
    padding: 12px 20px;
    align-items: center;
    font-size: 13px;
  }
  .sl-row-actions {
    display: inline-flex;
    gap: 4px;
    opacity: 0;
    transition: opacity .12s;
  }
  .sl-row:hover .sl-row-actions { opacity: 1; }
  .sl-row-icon {
    all: unset;
    cursor: pointer;
    width: 22px;
    height: 22px;
    border-radius: 4px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #a3a3a3;
    font-size: 12px;
  }
  .sl-row-icon:hover { background: #ececec; color: #0a0a0a; }
  .sl-row-time {
    font-variant-numeric: tabular-nums;
    color: #a3a3a3;
    font-size: 12px;
  }
  .sl-row-kp {
    color: #0a0a0a;
    font-weight: 500;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .sl-row-school {
    font-size: 11px;
    color: #525252;
    background: #f5f5f4;
    padding: 2px 8px;
    border-radius: 4px;
    white-space: nowrap;
  }
  .sl-row-note-preview {
    color: #a3a3a3;
    font-size: 12px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .sl-row-dur {
    text-align: right;
    color: #0a0a0a;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }
  .sl-row-rating {
    text-align: right;
    color: #d4d4d4;
    font-size: 12px;
    letter-spacing: 1px;
  }
  .sl-row-chevron {
    color: #a3a3a3;
    transition: transform .15s;
    font-size: 11px;
    text-align: center;
  }
  .sl-row-chevron-rot {
    transform: rotate(180deg);
  }
  .sl-row-note {
    padding: 0 20px 12px 90px;
    font-size: 12.5px;
    color: #525252;
    line-height: 1.7;
    white-space: pre-wrap;
  }
  .sl-empty-note, .sl-empty-rating { /* 占位维持网格 */ }

  /* 空状态 */
  .sl-empty {
    text-align: center;
    color: #a3a3a3;
    font-size: 13px;
    padding: 40px 20px;
  }
  .sl-empty.hidden { display: none; }

  /* 占位视图 */
  .sl-placeholder {
    text-align: center;
    padding: 60px 20px;
    color: #525252;
    border: 1px dashed #ececec;
    border-radius: 12px;
    background: #fafaf9;
  }
  .sl-placeholder p:first-child {
    font-size: 16px;
    margin: 0 0 8px;
    color: #0a0a0a;
  }
  .sl-placeholder-sub {
    font-size: 12.5px;
    color: #a3a3a3;
    margin: 0;
  }

  /* ============================================================
     视图 B · 知识点排行（v0.5.5）
     ============================================================ */
  .sl-rank-hint {
    font-size: 11.5px;
    color: #a3a3a3;
    margin: 0 0 12px;
  }
  .sl-rank-list {
    border: 1px solid #ececec;
    border-radius: 12px;
    background: #fff;
    overflow: hidden;
  }
  .sl-rank-head {
    display: grid;
    grid-template-columns: minmax(200px, 1.6fr) 90px 60px 100px 60px;
    gap: 14px;
    padding: 10px 20px;
    background: #fafaf9;
    border-bottom: 1px solid #ececec;
    font-size: 11px;
    color: #a3a3a3;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .sl-rank-col-num { text-align: right; }
  .sl-rank-row {
    position: relative;
    border-bottom: 1px solid #f5f5f4;
  }
  .sl-rank-row:last-child { border-bottom: 0; }
  .sl-rank-row:hover .sl-rank-progress-bg { background: #ececec; }
  .sl-rank-progress-bg {
    position: absolute;
    inset: 0;
    background: #f5f5f4;
    transition: background .12s;
    z-index: 0;
  }
  .sl-rank-content {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(200px, 1.6fr) 90px 60px 100px 60px;
    gap: 14px;
    padding: 12px 20px;
    align-items: center;
    font-size: 13px;
  }
  .sl-rank-title { min-width: 0; }
  .sl-rank-kp {
    color: #0a0a0a;
    font-weight: 500;
    margin: 0 0 2px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .sl-rank-school {
    font-size: 11px;
    color: #525252;
    margin: 0;
  }
  .sl-rank-num {
    text-align: right;
    color: #0a0a0a;
    font-variant-numeric: tabular-nums;
  }
  .sl-rank-stars {
    color: #525252;
    letter-spacing: 1px;
    font-size: 12px;
  }

  /* ============================================================
     视图 C · 学派段位（v0.5.4）
     ============================================================ */
  .sl-tier-ladder {
    padding: 16px 20px;
    border: 1px solid #ececec;
    border-radius: 12px;
    background: #fff;
    margin-bottom: 16px;
  }
  .sl-tier-ladder-title {
    font-size: 11.5px;
    color: #a3a3a3;
    margin: 0 0 10px;
  }
  .sl-tier-ladder-chips {
    display: flex;
    gap: 6px;
    align-items: center;
  }
  .sl-tier-chip {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 3px 10px;
    border-radius: 999px;
    border: 1px solid #ececec;
    font-size: 11px;
    color: #525252;
    background: #fff;
  }
  .sl-tier-chip strong {
    color: #0a0a0a;
    font-weight: 600;
  }
  .sl-tier-chip em {
    font-style: normal;
    color: #a3a3a3;
    font-variant-numeric: tabular-nums;
  }
  /* 段位章颜色：单色 + 灰阶（无主题色） */
  .sl-tier-chip-c { background: #fafaf9; }
  .sl-tier-chip-b { background: #f5f5f4; border-color: #d4d4d4; }
  .sl-tier-chip-a { background: #ececec; border-color: #a3a3a3; }
  .sl-tier-chip-a strong { color: #0a0a0a; }

  /* 段位榜列表 */
  .sl-tier-list {
    border: 1px solid #ececec;
    border-radius: 12px;
    background: #fff;
    overflow: hidden;
  }
  .sl-tier-row {
    display: grid;
    grid-template-columns: 36px 44px minmax(140px, 1.6fr) 130px 100px 56px;
    gap: 14px;
    padding: 14px 20px;
    align-items: center;
    border-bottom: 1px solid #f5f5f4;
  }
  .sl-tier-row:last-child { border-bottom: 0; }
  .sl-tier-row:hover { background: #fafaf9; }

  .sl-tier-rank {
    font-size: 12px;
    color: #a3a3a3;
    font-variant-numeric: tabular-nums;
    text-align: right;
  }
  .sl-tier-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    font-weight: 700;
    font-size: 14px;
    color: #525252;
    background: #fafaf9;
    border: 1px solid #ececec;
  }
  .sl-tier-badge-c { color: #525252; background: #fafaf9; }
  .sl-tier-badge-b { color: #171717; background: #f5f5f4; border-color: #d4d4d4; }
  .sl-tier-badge-a { color: #ffffff; background: #0a0a0a; border-color: #0a0a0a; }

  .sl-tier-school { min-width: 0; }
  .sl-tier-school-name {
    font-size: 13px;
    color: #0a0a0a;
    margin: 0 0 2px;
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .sl-tier-school-meta {
    font-size: 11px;
    color: #a3a3a3;
    margin: 0;
    display: flex;
    gap: 6px;
    align-items: center;
  }
  .sl-tier-peak {
    color: #525252;
    background: #f5f5f4;
    padding: 1px 6px;
    border-radius: 3px;
  }
  .sl-tier-decay {
    color: #a3a3a3;
    font-variant-numeric: tabular-nums;
  }

  .sl-tier-progress { min-width: 0; }
  .sl-tier-progress-label {
    font-size: 11px;
    color: #525252;
    margin: 0 0 4px;
    font-variant-numeric: tabular-nums;
  }
  .sl-tier-progress-bar {
    height: 4px;
    background: #f5f5f4;
    border-radius: 2px;
    overflow: hidden;
  }
  .sl-tier-progress-fill {
    height: 100%;
    background: #0a0a0a;
    transition: width .2s;
  }

  .sl-tier-spark-wrap {
    width: 100px;
    height: 20px;
  }
  .sl-spark {
    width: 100%;
    height: 100%;
  }

  .sl-tier-quiz {
    all: unset;
    cursor: pointer;
    padding: 4px 10px;
    border-radius: 4px;
    border: 1px solid #ececec;
    color: #a3a3a3;
    font-size: 11px;
    text-align: center;
    background: #fff;
    transition: all .12s;
  }
  .sl-tier-quiz:hover:not([disabled]) {
    border-color: #0a0a0a;
    color: #0a0a0a;
  }
  .sl-tier-quiz[disabled] {
    cursor: not-allowed;
    opacity: 0.4;
  }

  .sl-tier-c-toggle {
    all: unset;
    cursor: pointer;
    display: block;
    width: 100%;
    text-align: center;
    padding: 12px;
    margin-top: 12px;
    border: 1px dashed #ececec;
    border-radius: 12px;
    color: #525252;
    font-size: 12px;
    background: #fafaf9;
    transition: all .12s;
  }
  .sl-tier-c-toggle:hover {
    border-color: #a3a3a3;
    color: #0a0a0a;
  }
  .sl-tier-c-toggle.hidden { display: none; }
  .sl-view .hidden, .sl-row-note.hidden { display: none; }

  /* ============================================================
     v0.5.6: FAB（手机版浮动 + 按钮）
     ============================================================ */
  .sl-fab {
    /* 桌面隐藏，仅 ≤ 768 显示（响应式段里 override） */
    display: none;
  }

  /* iOS Safari safe area + dvh */
  .study-log {
    min-height: 100dvh;
  }

  /* ============================================================
     SessionEditor modal（v0.5.5）/ Bottom sheet（v0.5.6 ≤ 768px）
     ============================================================ */
  .sl-editor-handle { display: none; /* 桌面隐藏 */ }
  .sl-editor-overlay {
    position: fixed;
    inset: 0;
    background: rgba(10, 10, 10, 0.18);
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
  }
  .sl-editor-overlay.hidden { display: none; }
  .sl-editor {
    width: 100%;
    max-width: 480px;
    background: #fff;
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 12px 40px rgba(0,0,0,.16);
  }
  .sl-editor-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 22px 14px;
    border-bottom: 1px solid #f5f5f4;
  }
  .sl-editor-title {
    font-size: 15px;
    font-weight: 600;
    color: #0a0a0a;
    margin: 0;
  }
  .sl-editor-close {
    all: unset;
    cursor: pointer;
    width: 28px;
    height: 28px;
    border-radius: 6px;
    color: #a3a3a3;
    font-size: 20px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .sl-editor-close:hover { background: #f5f5f4; color: #0a0a0a; }
  .sl-editor-body {
    padding: 18px 22px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .sl-field { display: flex; flex-direction: column; gap: 6px; }
  .sl-field-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .sl-field-label {
    font-size: 11.5px;
    color: #525252;
  }
  .sl-field-input {
    width: 100%;
    box-sizing: border-box;
    padding: 8px 10px;
    border: 1px solid #ececec;
    border-radius: 6px;
    font-size: 13px;
    font-family: inherit;
    color: #0a0a0a;
    background: #fff;
    outline: none;
    transition: border-color .12s;
  }
  .sl-field-input:focus { border-color: #0a0a0a; }
  .sl-field-textarea {
    resize: vertical;
    min-height: 60px;
    font-family: inherit;
  }

  /* Rating star */
  .sl-rating {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    padding: 4px 0;
  }
  .sl-rating-star {
    all: unset;
    cursor: pointer;
    color: #d4d4d4;
    font-size: 22px;
    line-height: 1;
    padding: 0 2px;
    transition: color .08s;
  }
  .sl-rating-star:hover, .sl-rating-star.sl-rating-active {
    color: #0a0a0a;
  }
  .sl-rating-clear {
    all: unset;
    cursor: pointer;
    margin-left: 8px;
    color: #a3a3a3;
    font-size: 11px;
    padding: 2px 6px;
    border: 1px solid #ececec;
    border-radius: 4px;
  }
  .sl-rating-clear:hover { color: #0a0a0a; border-color: #a3a3a3; }

  .sl-editor-error {
    padding: 8px 12px;
    background: #fff7f7;
    border: 1px solid #f0d5d5;
    border-radius: 6px;
    font-size: 12px;
    color: #c53030;
  }
  .sl-editor-error.hidden { display: none; }

  .sl-editor-foot {
    display: flex;
    justify-content: flex-end;
    gap: 8px;
    margin-top: 4px;
  }
  .sl-editor-btn-ghost {
    all: unset;
    cursor: pointer;
    padding: 8px 14px;
    border-radius: 6px;
    color: #525252;
    font-size: 13px;
  }
  .sl-editor-btn-ghost:hover { background: #f5f5f4; }
  .sl-editor-btn-primary {
    all: unset;
    cursor: pointer;
    padding: 8px 16px;
    border-radius: 6px;
    background: #0a0a0a;
    color: #fff;
    font-size: 13px;
    font-weight: 500;
  }
  .sl-editor-btn-primary:hover { background: #262626; }
  .sl-editor-btn-primary[disabled] {
    cursor: not-allowed;
    opacity: 0.5;
  }

  /* 响应式 */
  @media (max-width: 768px) {
    .study-log { padding: 24px 16px 80px; }
    .sl-stats { grid-template-columns: 1fr; gap: 16px; padding: 18px 20px; }
    .sl-stat-value { font-size: 32px; }
    .sl-heatmap { grid-template-columns: 1fr; }
    .sl-cal-month:not(:last-child) { display: none; }
    .sl-heatmap-title [data-title-desktop] { display: none; }
    .sl-heatmap-title [data-title-mobile] { display: inline; }
    .sl-heatmap-legend { display: none; }
    .sl-row-main {
      grid-template-columns: 1fr auto;
      gap: 6px;
      padding: 10px 16px;
    }
    .sl-row-time, .sl-row-school, .sl-row-note-preview, .sl-row-rating, .sl-row-chevron {
      grid-column: span 2;
      font-size: 11px;
      text-align: left;
    }
    .sl-row-time { color: #a3a3a3; }
    .sl-row-dur { font-size: 14px; }

    /* 段位榜窄屏：sparkline 隐藏，quiz chip 缩到右下 */
    .sl-tier-row {
      grid-template-columns: 28px 36px 1fr 56px;
      gap: 10px;
      padding: 12px 14px;
    }
    .sl-tier-progress {
      grid-column: span 4;
      grid-row: 2;
      margin-top: 6px;
    }
    .sl-tier-spark-wrap { display: none; }
    .sl-tier-quiz { padding: 3px 8px; font-size: 10px; }

    /* 排行榜窄屏：评分 / 最近 隐藏，留 KP / 累计 / 次数 */
    .sl-rank-head, .sl-rank-content {
      grid-template-columns: 1fr 70px 40px;
      gap: 10px;
      padding-left: 14px;
      padding-right: 14px;
    }
    .sl-rank-head .sl-rank-col-num:nth-child(4),
    .sl-rank-head .sl-rank-col-num:nth-child(5),
    .sl-rank-content .sl-rank-num:nth-child(4),
    .sl-rank-content .sl-rank-num:nth-child(5) { display: none; }

    /* v0.5.6: 顶部 "+ 新建记录" 按钮隐藏，FAB 替代 */
    .sl-add-btn { display: none; }
    .sl-fab {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      position: fixed;
      right: 18px;
      bottom: calc(18px + env(safe-area-inset-bottom, 0px));
      width: 56px;
      height: 56px;
      border-radius: 999px;
      background: #0a0a0a;
      color: #fff;
      border: none;
      cursor: pointer;
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.18), 0 1px 4px rgba(0, 0, 0, 0.24);
      z-index: 50;
      transition: transform .12s, box-shadow .12s;
      -webkit-tap-highlight-color: transparent;
    }
    .sl-fab:active {
      transform: scale(0.94);
      box-shadow: 0 3px 10px rgba(0, 0, 0, 0.18);
    }
    .sl-fab-plus {
      font-size: 28px;
      font-weight: 300;
      line-height: 1;
      margin-top: -2px; /* visually center */
    }

    /* v0.5.6: editor 改 bottom sheet —— 滑入 / 拖拽把手 / 88% 高 */
    .sl-editor-overlay {
      align-items: flex-end;
      padding: 0;
    }
    .sl-editor {
      max-width: 100%;
      width: 100%;
      max-height: 88dvh;
      border-radius: 14px 14px 0 0;
      animation: sl-sheet-in 260ms cubic-bezier(.16,.84,.3,1) both;
      padding-bottom: env(safe-area-inset-bottom, 0px);
      display: flex;
      flex-direction: column;
      touch-action: none; /* 防 iOS 拖拽误触系统手势 */
    }
    .sl-editor-handle {
      display: block;
      width: 36px;
      height: 4px;
      border-radius: 2px;
      background: #d4d4d4;
      margin: 8px auto 0;
