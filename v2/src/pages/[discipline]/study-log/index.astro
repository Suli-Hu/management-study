    padding: 7px 14px;
    border-radius: 7px;
    color: #525252;
    transition: all .12s;
    font-weight: 400;
  }
  .sl-seg:hover { color: #0a0a0a; }
  .sl-seg-active {
    background: #ffffff;
    color: #0a0a0a;
    font-weight: 600;
    box-shadow: 0 1px 2px rgba(0,0,0,.06);
  }

  /* ============================================================
     日志流视图
     ============================================================ */
  .sl-view.hidden { display: none; }

  /* 统计区 */
  .sl-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    padding: 24px 28px;
    border: 1px solid #ececec;
    border-radius: 12px;
    background: #fff;
    margin-bottom: 22px;
  }
  .sl-stat-label {
    font-size: 11.5px;
    color: #a3a3a3;
    margin: 0 0 8px;
  }
  .sl-stat-value {
    font-size: 38px;
    font-weight: 700;
    line-height: 1;
    margin: 0 0 8px;
    color: #0a0a0a;
    letter-spacing: -0.02em;
  }
  .sl-unit {
    font-size: 14px;
    font-weight: 400;
    color: #525252;
    margin-left: 4px;
    margin-right: 12px;
  }
  .sl-stat-sub {
    font-size: 11.5px;
    color: #a3a3a3;
    margin: 0;
  }

  /* 日历热力图 */
  .sl-heatmap-wrap {
    padding: 20px 28px;
    border: 1px solid #ececec;
    border-radius: 12px;
    background: #fff;
    margin-bottom: 22px;
    position: relative;
  }
  .sl-heatmap-title {
    font-size: 12px;
    color: #525252;
    margin: 0 0 14px;
  }
  .sl-heatmap-title [data-title-mobile] { display: none; }
  .sl-heatmap-legend {
    position: absolute;
    top: 18px;
    right: 28px;
    font-size: 11px;
    color: #a3a3a3;
    display: inline-flex;
    align-items: center;
    gap: 3px;
  }
  .sl-heat {
    width: 10px;
    height: 10px;
    border-radius: 2px;
    display: inline-block;
  }
  /* v0.7.23: 热力图 6 阶 → sumi --i-* token（旧 5 阶蓝色 hex 退役） */
  .sl-heat-0 { background: var(--i-0); }
  .sl-heat-1 { background: var(--i-1); }
  .sl-heat-2 { background: var(--i-2); }
  .sl-heat-3 { background: var(--i-3); }
  .sl-heat-4 { background: var(--i-4); }
  .sl-heat-5 { background: var(--i-5); }

  .sl-heatmap {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }
  .sl-cal-month {
    min-width: 0;
  }
  .sl-cal-month-label {
    font-size: 12px;
    font-weight: 500;
    color: #525252;
    margin: 0 0 6px;
  }
  .sl-cal-dow {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 2px;
    margin-bottom: 4px;
  }
  .sl-cal-dow span {
    font-size: 10px;
    color: #a3a3a3;
    text-align: center;
  }
  .sl-cal-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 3px;
  }
  .sl-cal-day, .sl-cal-empty {
    aspect-ratio: 1;
    border-radius: 3px;
    font-size: 10px;
    color: #525252;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .sl-cal-day {
    cursor: default;
  }
  /* v0.7.23: 高强度阶白字（4 / 5 档背景够深） */
  .sl-cal-day.sl-heat-4, .sl-cal-day.sl-heat-5 {
    color: #fff;
    font-weight: 500;
  }
  .sl-cal-today {
    box-shadow: inset 0 0 0 1.5px #0a0a0a;
  }
  .sl-cal-future {
    color: #d4d4d4;
    background: transparent !important;
    border: 1px dashed #ececec;
  }

  /* 时间筛选 chips */
  .sl-chips {
    display: flex;
    gap: 8px;
    margin-bottom: 16px;
  }
  .sl-chip {
    all: unset;
    cursor: pointer;
    padding: 6px 14px;
    border-radius: 999px;
    font-size: 12px;
    color: #525252;
    border: 1px solid #ececec;
    background: #fff;
    transition: all .12s;
  }
  .sl-chip:hover { border-color: #a3a3a3; }
  .sl-chip-active {
    background: #0a0a0a;
    color: #fff;
    border-color: #0a0a0a;
  }

  /* Session 列表 */
  .sl-list {
    border: 1px solid #ececec;
    border-radius: 12px;
    background: #fff;
    overflow: hidden;
  }
  .sl-group + .sl-group {
    border-top: 1px solid #f5f5f4;
  }
  .sl-group-head {
    font-size: 11.5px;
    color: #a3a3a3;
    margin: 0;
    padding: 12px 20px 6px;
    background: #fafaf9;
    letter-spacing: 0.02em;
  }
  .sl-group-rows {
    padding: 4px 0;
  }
  .sl-row {
    border-bottom: 1px solid #f5f5f4;
    transition: background .08s;
  }
  .sl-row:last-child { border-bottom: 0; }
  .sl-row:hover { background: #fafaf9; }
  .sl-row-main {
    display: grid;
    grid-template-columns: 56px minmax(120px, 1.4fr) auto minmax(0, 2fr) 70px 70px 50px 20px;
    gap: 14px;
    padding: 12px 20px;
    align-items: center;
    font-size: 13px;
  }
  .sl-row-actions {
    display: inline-flex;
    gap: 4px;
    opacity: 0;
    transition: opacity .12s;
  }
  .sl-row:hover .sl-row-actions { opacity: 1; }
  .sl-row-icon {
    all: unset;
    cursor: pointer;
    width: 22px;
    height: 22px;
    border-radius: 4px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #a3a3a3;
    font-size: 12px;
  }
  .sl-row-icon:hover { background: #ececec; color: #0a0a0a; }
  .sl-row-time {
    font-variant-numeric: tabular-nums;
    color: #a3a3a3;
    font-size: 12px;
  }
  .sl-row-kp {
    color: #0a0a0a;
    font-weight: 500;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .sl-row-school {
    font-size: 11px;
    color: #525252;
    background: #f5f5f4;
    padding: 2px 8px;
    border-radius: 4px;
    white-space: nowrap;
  }
  .sl-row-note-preview {
    color: #a3a3a3;
    font-size: 12px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .sl-row-dur {
    text-align: right;
    color: #0a0a0a;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }
  .sl-row-rating {
    text-align: right;
    color: #d4d4d4;
    font-size: 12px;
    letter-spacing: 1px;
  }
  .sl-row-chevron {
    color: #a3a3a3;
    transition: transform .15s;
    font-size: 11px;
    text-align: center;
  }
  .sl-row-chevron-rot {
    transform: rotate(180deg);
  }
  .sl-row-note {
    padding: 0 20px 12px 90px;
    font-size: 12.5px;
    color: #525252;
    line-height: 1.7;
    white-space: pre-wrap;
  }
  .sl-empty-note, .sl-empty-rating { /* 占位维持网格 */ }

  /* 空状态 */
  .sl-empty {
    text-align: center;
    color: #a3a3a3;
    font-size: 13px;
    padding: 40px 20px;
  }
  .sl-empty.hidden { display: none; }

  /* 占位视图 */
  .sl-placeholder {
    text-align: center;
    padding: 60px 20px;
    color: #525252;
    border: 1px dashed #ececec;
    border-radius: 12px;
    background: #fafaf9;
  }
  .sl-placeholder p:first-child {
    font-size: 16px;
    margin: 0 0 8px;
    color: #0a0a0a;
  }
  .sl-placeholder-sub {
    font-size: 12.5px;
    color: #a3a3a3;
    margin: 0;
  }

  /* ============================================================
     视图 B · 知识点排行（v0.5.5）
     ============================================================ */
  .sl-rank-hint {
    font-size: 11.5px;
    color: #a3a3a3;
    margin: 0 0 12px;
  }
  .sl-rank-list {
    border: 1px solid #ececec;
    border-radius: 12px;
    background: #fff;
    overflow: hidden;
  }
  .sl-rank-head {
    display: grid;
    grid-template-columns: minmax(200px, 1.6fr) 90px 60px 100px 60px;
    gap: 14px;
    padding: 10px 20px;
    background: #fafaf9;
    border-bottom: 1px solid #ececec;
    font-size: 11px;
    color: #a3a3a3;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .sl-rank-col-num { text-align: right; }
  .sl-rank-col-btn {
    all: unset;
    box-sizing: border-box;
    cursor: pointer;
    text-align: right;
    font: inherit;
    color: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    padding: 2px 0;
    user-select: none;
    transition: color .12s;
  }
  .sl-rank-col-btn:hover { color: #525252; }
  .sl-rank-col-btn.is-active { color: #0a0a0a; font-weight: 600; }
  .sl-rank-arrow {
    display: inline-block;
    margin-left: 3px;
    width: 8px;
    color: #0a0a0a;
  }
  .sl-rank-row {
    position: relative;
    border-bottom: 1px solid #f5f5f4;
  }
  .sl-rank-row:last-child { border-bottom: 0; }
  .sl-rank-row:hover .sl-rank-progress-bg { background: #ececec; }
  .sl-rank-progress-bg {
    position: absolute;
    inset: 0;
    background: #f5f5f4;
    transition: background .12s;
    z-index: 0;
  }
  .sl-rank-content {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(200px, 1.6fr) 90px 60px 100px 60px;
    gap: 14px;
    padding: 12px 20px;
    align-items: center;
    font-size: 13px;
  }
  .sl-rank-title { min-width: 0; }
  .sl-rank-kp {
    color: #0a0a0a;
    font-weight: 500;
    margin: 0 0 2px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .sl-rank-school {
    font-size: 11px;
    color: #525252;
    margin: 0;
  }
  .sl-rank-num {
    text-align: right;
    color: #0a0a0a;
    font-variant-numeric: tabular-nums;
  }
  .sl-rank-stars {
    color: #525252;
    letter-spacing: 1px;
    font-size: 12px;
  }

  /* ============================================================
     视图 C · 学派段位（v0.5.4）
     ============================================================ */
  .sl-tier-ladder {
    padding: 16px 20px;
    border: 1px solid #ececec;
    border-radius: 12px;
    background: #fff;
    margin-bottom: 16px;
  }
  .sl-tier-ladder-title {
    font-size: 11.5px;
    color: #a3a3a3;
    margin: 0 0 10px;
  }
  .sl-tier-ladder-chips {
    display: flex;
    gap: 6px;
    align-items: center;
  }
  .sl-tier-chip {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 3px 10px;
    border-radius: 999px;
    border: 1px solid #ececec;
    font-size: 11px;
    color: #525252;
    background: #fff;
  }
  .sl-tier-chip strong {
    color: #0a0a0a;
    font-weight: 600;
  }
  .sl-tier-chip em {
    font-style: normal;
    color: #a3a3a3;
    font-variant-numeric: tabular-nums;
  }
  /* 段位章颜色：单色 + 灰阶（无主题色） */
  /* v0.7.23: 段位说明带 chip — sumi --tier-* 弱底（15% alpha）+ 同色文字 */
  .sl-tier-chip-c {
    background: oklch(from var(--tier-c) l c h / 0.10);
    border-color: oklch(from var(--tier-c) l c h / 0.25);
  }
  .sl-tier-chip-c strong { color: var(--tier-c); }
  .sl-tier-chip-b {
    background: oklch(from var(--tier-b) l c h / 0.12);
    border-color: oklch(from var(--tier-b) l c h / 0.30);
  }
  .sl-tier-chip-b strong { color: var(--tier-b); }
  .sl-tier-chip-a {
    background: oklch(from var(--tier-a) l c h / 0.15);
    border-color: oklch(from var(--tier-a) l c h / 0.35);
  }
  .sl-tier-chip-a strong { color: var(--tier-a); }

  /* 段位榜列表 */
  .sl-tier-list {
    border: 1px solid #ececec;
    border-radius: 12px;
    background: #fff;
    overflow: hidden;
  }
  .sl-tier-row {
    display: grid;
    grid-template-columns: 36px 44px minmax(140px, 1.6fr) 130px 100px 56px;
    gap: 14px;
    padding: 14px 20px;
    align-items: center;
    border-bottom: 1px solid #f5f5f4;
  }
  .sl-tier-row:last-child { border-bottom: 0; }
  .sl-tier-row:hover { background: #fafaf9; }

  .sl-tier-rank {
    font-size: 12px;
    color: #a3a3a3;
    font-variant-numeric: tabular-nums;
    text-align: right;
  }
  .sl-tier-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    font-weight: 700;
    font-size: 14px;
    color: #525252;
    background: #fafaf9;
    border: 1px solid #ececec;
  }
  /* v0.7.23: 段位榜大徽章 — sumi --tier-* 实色 + 白字（C 用浅底深字保持低对比，B/A 实色白字渐进） */
  .sl-tier-badge-c {
    color: var(--tier-c);
    background: oklch(from var(--tier-c) l c h / 0.12);
    border-color: oklch(from var(--tier-c) l c h / 0.30);
  }
  .sl-tier-badge-b {
    color: #fff;
    background: var(--tier-b);
    border-color: var(--tier-b);
  }
  .sl-tier-badge-a {
    color: #fff;
    background: var(--tier-a);
    border-color: var(--tier-a);
  }

  .sl-tier-school { min-width: 0; }
  .sl-tier-school-name {
    font-size: 13px;
    color: #0a0a0a;
    margin: 0 0 2px;
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .sl-tier-school-meta {
    font-size: 11px;
    color: #a3a3a3;
    margin: 0;
    display: flex;
    gap: 6px;
    align-items: center;
  }
  .sl-tier-peak {
    color: #525252;
    background: #f5f5f4;
    padding: 1px 6px;
    border-radius: 3px;
  }
  .sl-tier-decay {
    color: #a3a3a3;
    font-variant-numeric: tabular-nums;
  }

  .sl-tier-progress { min-width: 0; }
  .sl-tier-progress-label {
    font-size: 11px;
    color: #525252;
    margin: 0 0 4px;
    font-variant-numeric: tabular-nums;
  }
  /* v0.7.23: 段位进度条 → sumi --p-track / --p-fill */
  .sl-tier-progress-bar {
    height: 4px;
    background: var(--p-track);
    border-radius: 2px;
    overflow: hidden;
  }
  .sl-tier-progress-fill {
    height: 100%;
    background: var(--p-fill);
    transition: width .2s;
  }

  .sl-tier-spark-wrap {
    width: 100px;
    height: 20px;
  }
  .sl-spark {
    width: 100%;
    height: 100%;
  }

  .sl-tier-quiz {
    all: unset;
    cursor: pointer;
    padding: 4px 10px;
    border-radius: 4px;
    border: 1px solid #ececec;
    color: #a3a3a3;
    font-size: 11px;
    text-align: center;
    background: #fff;
    transition: all .12s;
  }
  .sl-tier-quiz:hover:not([disabled]) {
    border-color: #0a0a0a;
    color: #0a0a0a;
  }
  .sl-tier-quiz[disabled] {
    cursor: not-allowed;
    opacity: 0.4;
  }

  .sl-tier-c-toggle {
    all: unset;
    cursor: pointer;
    display: block;
    width: 100%;
    text-align: center;
    padding: 12px;
    margin-top: 12px;
    border: 1px dashed #ececec;
    border-radius: 12px;
    color: #525252;
    font-size: 12px;
    background: #fafaf9;
    transition: all .12s;
  }
  .sl-tier-c-toggle:hover {
    border-color: #a3a3a3;
    color: #0a0a0a;
  }
  .sl-tier-c-toggle.hidden { display: none; }
  .sl-view .hidden, .sl-row-note.hidden { display: none; }

  /* ============================================================
     v0.5.6: FAB（手机版浮动 + 按钮）
     ============================================================ */
  .sl-fab {
    /* 桌面隐藏，仅 ≤ 768 显示（响应式段里 override） */
    display: none;
  }

  /* iOS Safari safe area + dvh */
  .study-log {
    min-height: 100dvh;
  }

  /* ============================================================
     SessionEditor modal（v0.5.5）/ Bottom sheet（v0.5.6 ≤ 768px）
     ============================================================ */
  .sl-editor-handle { display: none; /* 桌面隐藏 */ }
  .sl-editor-overlay {
    position: fixed;
    inset: 0;
    background: rgba(10, 10, 10, 0.18);
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
  }
  .sl-editor-overlay.hidden { display: none; }
  .sl-editor {
    width: 100%;
    max-width: 480px;
    background: #fff;
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 12px 40px rgba(0,0,0,.16);
  }
  .sl-editor-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 22px 14px;
    border-bottom: 1px solid #f5f5f4;
  }
  .sl-editor-title {
    font-size: 15px;
    font-weight: 600;
    color: #0a0a0a;
    margin: 0;
  }
  .sl-editor-close {
    all: unset;
    cursor: pointer;
    width: 28px;
    height: 28px;
    border-radius: 6px;
    color: #a3a3a3;
    font-size: 20px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .sl-editor-close:hover { background: #f5f5f4; color: #0a0a0a; }
  .sl-editor-body {
    padding: 18px 22px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .sl-field { display: flex; flex-direction: column; gap: 6px; }
  .sl-field-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .sl-field-label {
    font-size: 11.5px;
    color: #525252;
  }
  .sl-field-input {
    width: 100%;
    box-sizing: border-box;
    padding: 8px 10px;
    border: 1px solid #ececec;
    border-radius: 6px;
    font-size: 13px;
    font-family: inherit;
    color: #0a0a0a;
    background: #fff;
    outline: none;
    transition: border-color .12s;
  }
  .sl-field-input:focus { border-color: #0a0a0a; }
  .sl-field-textarea {
    resize: vertical;
    min-height: 60px;
    font-family: inherit;
  }

  /* KP combobox（v0.7.19） */
  .sl-kp-combo { position: relative; }
  .sl-kp-input { padding-right: 28px; }
  .sl-kp-clear {
    position: absolute;
    right: 6px;
    top: 50%;
    transform: translateY(-50%);
    width: 22px;
    height: 22px;
    border-radius: 999px;
    border: 0;
    background: #f5f5f4;
    color: #525252;
    font-size: 14px;
    line-height: 1;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .sl-kp-clear:hover { background: #e7e5e4; color: #0a0a0a; }
  .sl-kp-clear.hidden { display: none; }
  .sl-kp-list {
    position: absolute;
    top: calc(100% + 4px);
    left: 0;
    right: 0;
    z-index: 10;
    max-height: 240px;
    overflow-y: auto;
    background: #fff;
    border: 1px solid #ececec;
    border-radius: 8px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.08);
    padding: 4px 0;
  }
  .sl-kp-list.hidden { display: none; }
  .sl-kp-group-label {
    padding: 6px 12px 4px;
    font-size: 10.5px;
    color: #a3a3a3;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .sl-kp-option {
    padding: 7px 12px;
    font-size: 13px;
    color: #0a0a0a;
    cursor: pointer;
    line-height: 1.3;
  }
  .sl-kp-option:hover,
  .sl-kp-option.is-highlighted {
    background: #f5f5f4;
  }
  .sl-kp-option.is-selected {
    color: #0a0a0a;
    font-weight: 500;
  }
  .sl-kp-option.is-selected::before {
    content: '✓ ';
    color: #2563eb;
  }
  .sl-kp-empty {
    padding: 14px 12px;
    font-size: 12px;
    color: #a3a3a3;
    text-align: center;
