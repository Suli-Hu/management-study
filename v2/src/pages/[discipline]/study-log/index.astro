---
/**
 * /[discipline]/study-log — 学习记录主页（v0.5.3+ / v0.7.13+）
 *
 * 三视图（PRD v1.0 §5）：日志流（默认）/ 知识点排行 / 学派段位
 * - v0.5.3: 完整日志流
 * - v0.5.4: 学派段位视图（55 学派 / C-B-A 三级 / sparkline / quiz 占位）
 * - v0.5.5: 知识点排行 + 编辑器（即将）
 * - v0.7.18 (= v0.5.x +): mobile 日历只显示 1 个月（当月），desktop 仍 4 个月
 *
 * 视觉：用户决策"第一版不要颜色"，全中性灰 + 单一蓝色 accent（用于
 * 日历热力图 5 级阶梯 + active 状态）。
 *
 * 数据：SSR fetch 近 90 天 sessions（join KP title + 主学派 title），
 * 段位 view 用 lib/tier.ts 在 SSR 算 tier states + timelines。
 * client JS 处理 filter/group/expand/C 段折叠 —— 切换零延迟。
 */
import Layout from '~/layouts/Layout.astro';
import { getDb } from '~/lib/db';
import {
  computeTiers,
  computeTimeline,
  TIERS,
  DECAY_PER_DAY,
  type TierSession,
  type SchoolTierState,
} from '~/lib/tier';

const { discipline } = Astro.params;
if (!discipline) return Astro.redirect('/404');
if (!Astro.locals.user) return Astro.redirect('/login');
if (!Astro.locals.canRead(discipline)) return Astro.redirect('/');

const db = getDb(Astro.locals.runtime.env);

// ============================================================
// SSR fetch
// ============================================================

// discipline 元信息
const disc = await db
  .prepare('SELECT key, title_zh FROM discipline WHERE key = ?')
  .bind(discipline)
  .first<{ key: string; title_zh: string }>();
if (!disc) return Astro.redirect('/404');

// session + kp + 主学派 join。近 90 天足够覆盖 PRD 30 天主视图 + 4 月日历
// 用 LEFT JOIN：KP 删除后 session 仍保留 kp_id=NULL（migration 0016 保护）
const fromDate = (() => {
  const d = new Date();
  d.setDate(d.getDate() - 90);
  return d.toISOString().slice(0, 10);
})();

interface SessionRow {
  id: string;
  date: string;
  start_time: string;
  duration_min: number;
  rating: number | null;
  note: string | null;
  kp_id: string | null;
  kp_title: string | null;
  school_key: string | null;
  school_title: string | null;
}

const result = await db
  .prepare(
    `SELECT
       s.id, s.date, s.start_time, s.duration_min, s.rating, s.note, s.kp_id,
       k.title_zh as kp_title,
       (SELECT ks.school_key
        FROM kp_school ks
        WHERE ks.kp_id = s.kp_id
        ORDER BY ks.position
        LIMIT 1) as school_key,
       (SELECT sc.title_zh
        FROM kp_school ks
        INNER JOIN school sc ON sc.key = ks.school_key
        WHERE ks.kp_id = s.kp_id
        ORDER BY ks.position
        LIMIT 1) as school_title
     FROM study_session s
     LEFT JOIN kp k ON k.id = s.kp_id
     WHERE s.user_id = ? AND s.discipline = ? AND s.date >= ?
     ORDER BY s.date DESC, s.start_time DESC, s.id DESC
     LIMIT 1000`,
  )
  .bind(Astro.locals.user.id, discipline, fromDate)
  .all<SessionRow>();

const sessions = result.results ?? [];

// SSR 这里就把 sessions 序列化进 inline JSON，client JS 直接消费
const sessionsJson = JSON.stringify(sessions);

const TODAY = new Date().toISOString().slice(0, 10);

// ============================================================
// 学派段位视图数据（v0.5.4）
// ============================================================

interface SchoolMetaRow { key: string; title_zh: string; }
const allSchoolsResult = await db
  .prepare('SELECT key, title_zh FROM school WHERE discipline = ? ORDER BY key')
  .bind(discipline)
  .all<SchoolMetaRow>();
const allSchools = allSchoolsResult.results ?? [];
const schoolTitleByKey = new Map(allSchools.map((s) => [s.key, s.title_zh]));

// 把 sessions 映射到 TierSession（取 schools[0] 主学派 = session.school_key）
const tierSessions: TierSession[] = sessions
  .filter((s): s is SessionRow & { school_key: string } => s.school_key !== null)
  .map((s) => ({ schoolKey: s.school_key, date: s.date, durationMin: s.duration_min }));

const tierStates = computeTiers(tierSessions, TODAY, {
  allSchools: allSchools.map((s) => s.key),
});

// 给每个学派算 30 天 timeline（sparkline 用）
interface TierStateWithMeta extends SchoolTierState {
  schoolTitle: string;
  timeline: number[];   // 30 个数字（不含 date，节省 payload）
}
const tierStatesEnriched: TierStateWithMeta[] = tierStates.map((t) => ({
  ...t,
  schoolTitle: schoolTitleByKey.get(t.schoolKey) ?? t.schoolKey,
  timeline: computeTimeline(tierSessions, t.schoolKey, TODAY, 30).map((p) => p.score),
}));

const tierStatesJson = JSON.stringify(tierStatesEnriched);

// 段位章 / 阈值 SSR 渲染顶部说明
const tierLevels = TIERS.map((t) => ({ key: t.key, threshold: t.threshold }));

// ============================================================
// SessionEditor: 拉所有 KP（select 选项，按学派分组）
// ============================================================

interface KpOptionRow { id: string; title_zh: string; school_key: string | null; school_title: string | null; }
const kpOptionsResult = await db
  .prepare(`
    SELECT
      k.id, k.title_zh,
      (SELECT ks.school_key FROM kp_school ks WHERE ks.kp_id = k.id ORDER BY ks.position LIMIT 1) as school_key,
      (SELECT sc.title_zh FROM kp_school ks INNER JOIN school sc ON sc.key = ks.school_key WHERE ks.kp_id = k.id ORDER BY ks.position LIMIT 1) as school_title
    FROM kp k
    WHERE k.discipline = ?
    ORDER BY k.id
  `)
  .bind(discipline)
  .all<KpOptionRow>();
const kpOptions = kpOptionsResult.results ?? [];

// 按学派分组：Map<school_title, Array<{id, title_zh}>>
const kpByGroup = new Map<string, Array<{ id: string; title_zh: string }>>();
for (const k of kpOptions) {
  const group = k.school_title ?? '未分组';
  if (!kpByGroup.has(group)) kpByGroup.set(group, []);
  kpByGroup.get(group)!.push({ id: k.id, title_zh: k.title_zh });
}
const kpGroupedJson = JSON.stringify([...kpByGroup.entries()]);
---

<Layout title={`学习记录 · ${disc.title_zh}`} currentDiscipline={discipline} currentSection="study-log">
  <main class="study-log">
    <header class="sl-header">
      <div>
        <p class="sl-breadcrumb">
          <a href="/">全科笔记</a>
          <span class="sl-sep">›</span>
          <a href={`/${discipline}`}>{disc.title_zh}</a>
        </p>
        <h1 class="sl-title">学习记录</h1>
      </div>
      <button type="button" class="sl-add-btn" data-editor-open>+ 新建记录</button>
    </header>

    {/* v0.5.6: 手机版 FAB（仅 ≤ 768px 显示，桌面隐藏） */}
    <button type="button" class="sl-fab" data-editor-open aria-label="新建记录">
      <span class="sl-fab-plus">+</span>
    </button>

    <div class="sl-switcher" role="tablist">
      <button type="button" data-view="log" class="sl-seg sl-seg-active" role="tab">日志流</button>
      <button type="button" data-view="rank" class="sl-seg" role="tab">知识点排行</button>
      <button type="button" data-view="tier" class="sl-seg" role="tab">学派段位</button>
    </div>

    {/* ============================================================ */}
    {/* 视图 A · 日志流 */}
    {/* ============================================================ */}
    <section data-view-pane="log" class="sl-view">
      <div class="sl-stats">
        <div class="sl-stat">
          <p class="sl-stat-label" data-stat-label-left>近 30 天累计</p>
          <p class="sl-stat-value">
            <span data-stat-hours>—</span><span class="sl-unit">h</span>
            <span data-stat-mins>—</span><span class="sl-unit">min</span>
          </p>
          <p class="sl-stat-sub" data-stat-sub-left>—</p>
        </div>
        <div class="sl-stat">
          <p class="sl-stat-label">学习天数</p>
          <p class="sl-stat-value">
            <span data-stat-days>—</span><span class="sl-unit">天</span>
          </p>
          <p class="sl-stat-sub" data-stat-sub-right>—</p>
        </div>
      </div>

      <div class="sl-heatmap-wrap">
        <p class="sl-heatmap-title">
          <span data-title-desktop>近 4 个月</span><span data-title-mobile>近 1 个月</span>·每日学习时长
        </p>
        <div class="sl-heatmap-legend">
          少
          <span class="sl-heat sl-heat-0"></span>
          <span class="sl-heat sl-heat-1"></span>
          <span class="sl-heat sl-heat-2"></span>
          <span class="sl-heat sl-heat-3"></span>
          <span class="sl-heat sl-heat-4"></span>
          多
        </div>
        <div class="sl-heatmap" data-heatmap></div>
      </div>

      <div class="sl-chips">
        <button type="button" data-range="7" class="sl-chip">近 7 天</button>
        <button type="button" data-range="14" class="sl-chip">近 14 天</button>
        <button type="button" data-range="30" class="sl-chip sl-chip-active">近 30 天</button>
      </div>

      <div data-session-list class="sl-list">
        {/* client JS 渲染 */}
      </div>

      <p data-empty class="sl-empty hidden">这个时间段还没有学习记录。</p>
    </section>

    {/* ============================================================ */}
    {/* 视图 B · 知识点排行（v0.5.5） */}
    {/* ============================================================ */}
    <section data-view-pane="rank" class="sl-view hidden">
      <p class="sl-rank-hint">按累计学习时长降序排列；行底 progress 是该 KP 占总时长的百分比。</p>
      <div data-rank-list class="sl-rank-list">
        {/* client JS 渲染 */}
      </div>
      <p data-rank-empty class="sl-empty hidden">还没有任何学习记录。</p>
    </section>

    {/* ============================================================ */}
    {/* SessionEditor modal（v0.5.5） */}
    {/* ============================================================ */}
    <div data-editor-overlay class="sl-editor-overlay hidden" role="dialog" aria-modal="true" aria-labelledby="sl-editor-title">
      <div class="sl-editor" data-editor-sheet>
        {/* v0.5.6: bottom sheet 手机版的拖拽把手；桌面 modal 不显示 */}
        <div class="sl-editor-handle" data-editor-handle aria-hidden="true"></div>
        <header class="sl-editor-head">
          <h2 id="sl-editor-title" class="sl-editor-title" data-editor-title>新建学习记录</h2>
          <button type="button" class="sl-editor-close" data-editor-close aria-label="关闭">×</button>
        </header>
        <form data-editor-form class="sl-editor-body">
          <input type="hidden" name="id" data-editor-id />

          <div class="sl-field">
