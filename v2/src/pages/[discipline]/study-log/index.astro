          <p class="sl-stat-sub" data-stat-sub-left>—</p>
        </div>
        <div class="sl-stat">
          <p class="sl-stat-label">学习天数</p>
          <p class="sl-stat-value">
            <span data-stat-days>—</span><span class="sl-unit">天</span>
          </p>
          <p class="sl-stat-sub" data-stat-sub-right>—</p>
        </div>
