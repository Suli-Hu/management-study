  }

  /* ============================================================
     日志流视图
     ============================================================ */
  .sl-view.hidden { display: none; }

  /* 统计区 */
  .sl-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    padding: 24px 28px;
    border: 1px solid #ececec;
    border-radius: 12px;
