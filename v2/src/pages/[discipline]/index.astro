---
import Layout from '~/layouts/Layout.astro';
import { getDb } from '~/lib/db';
import { editHref } from '~/lib/nav';

const { discipline } = Astro.params;
const db = getDb(Astro.locals.runtime.env);

// 学科信息
const disc = await db
  .prepare('SELECT * FROM discipline WHERE key = ?')
  .bind(discipline)
  .first<{ key: string; title_zh: string; title_en: string | null; tagline_zh: string | null; accent: string; themes_json: string }>();

if (!disc) {
  return Astro.redirect('/404');
}

const themes = JSON.parse(disc.themes_json) as Array<{
  key: string;
  title: { zh: string; en?: string; ja?: string };
  desc?: { zh?: string; en?: string; ja?: string };
  accent: string;
  schools: string[];
}>;

// 学派列表（按 theme_key 分组）
const schoolsResult = await db
  .prepare(`
    SELECT key, title_zh, title_en, era, theme_key, accent,
      (SELECT COUNT(*) FROM kp_school WHERE school_key = school.key) as kp_count
    FROM school
    WHERE discipline = ?
  `)
  .bind(discipline)
  .all<{ key: string; title_zh: string; title_en: string | null; era: string; theme_key: string; accent: string; kp_count: number }>();

const schools = schoolsResult.results ?? [];
const schoolByKey = new Map(schools.map((s) => [s.key, s]));

// 按 themes[].schools 顺序整理
const themed = themes.map((t) => ({
  ...t,
  schoolList: t.schools.map((sk) => schoolByKey.get(sk)).filter(Boolean) as typeof schools,
}));

// 兜底：themes 没列出的学派（数据迁移可能漏的）
const accountedKeys = new Set(themes.flatMap((t) => t.schools));
const orphanSchools = schools.filter((s) => !accountedKeys.has(s.key));
---

<Layout title={disc.title_zh} currentDiscipline={discipline} currentSection="schools">
  <main class="max-w-panel mx-auto px-4 py-6">
    <header class="mb-8 flex items-baseline justify-between gap-3 group">
      <div>
        <h1 class="text-2xl mb-1">{disc.title_zh}</h1>
        <p class="text-xs text-quaternary">{disc.title_en}{disc.tagline_zh ? ` · ${disc.tagline_zh}` : ''}</p>
      </div>
      {Astro.locals.canEdit(discipline) && (
        <div class="shrink-0 flex items-center gap-2">
          <a
            href={editHref(`/${discipline}/themes/new`, Astro.url.pathname)}
            class="inline-flex opacity-50 hover:opacity-100 transition-opacity items-center px-3 py-1.5 rounded-full border border-accent-strategy text-accent-strategy text-xs no-underline hover:bg-accent-strategy hover:text-white"
            title="新增主题分组"
          >
            + 新增主题
          </a>
          <a
            href={editHref(`/${discipline}/schools/new`, Astro.url.pathname)}
            class="inline-flex opacity-50 hover:opacity-100 transition-opacity items-center px-3 py-1.5 rounded-full border border-accent-strategy text-accent-strategy text-xs no-underline hover:bg-accent-strategy hover:text-white"
            title="新增学派"
          >
            + 新增学派
          </a>
        </div>
      )}
    </header>

    {themed.map((t) => (
      <section class="mb-8">
        <div class="mb-3 flex items-baseline justify-between gap-3 group">
          <div>
            <h2 class="text-base font-semibold">{t.title.zh}</h2>
            {t.desc?.zh && <p class="text-xs text-tertiary mt-0.5">{t.desc.zh}</p>}
          </div>
          {Astro.locals.canEdit(discipline) && (
            <div class="shrink-0 flex items-center gap-1 opacity-30 group-hover:opacity-100 transition-opacity">
              <a
                href={editHref(`/${discipline}/themes/${t.key}/edit`, Astro.url.pathname)}
                class="w-7 h-7 rounded border bg-bg-primary text-tertiary hover:text-accent-strategy hover:border-accent-strategy flex items-center justify-center text-xs no-underline"
                title="编辑此主题"
                aria-label={`编辑 ${t.title.zh}`}
              >
                ✎
              </a>
            </div>
          )}
        </div>
        <div
          class="drag-reorder grid grid-cols-1 md:grid-cols-2 gap-2"
          data-reorder-kind="discipline-schools"
          data-theme-key={t.key}
        >
          {t.schoolList.map((s) => (
            <a
              href={`/${discipline}/${s.key}`}
              data-school-key={s.key}
              class="block p-3 rounded border bg-bg-primary hover:shadow-card transition-shadow"
            >
              <div class="flex items-baseline justify-between">
                <h3 class="text-sm font-semibold text-primary">{s.title_zh}</h3>
                <span class="text-xs text-quaternary">{s.kp_count}</span>
              </div>
              {s.title_en && <div class="text-xs text-tertiary mt-0.5">{s.title_en}</div>}
              {s.era && <div class="text-xs text-quaternary mt-0.5">{s.era}</div>}
            </a>
          ))}
        </div>
        {t.schoolList.length === 0 && (
          <p class="text-xs text-quaternary mt-2">暂无学派{Astro.locals.canEdit(discipline) ? '。Phase 2 上线后可拖学派进来。' : '。'}</p>
        )}
      </section>
    ))}

    {orphanSchools.length > 0 && (
      <section class="mb-8">
        <h2 class="text-base font-semibold mb-3 text-tertiary">未分组</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-2">
          {orphanSchools.map((s) => (
            <a href={`/${discipline}/${s.key}`} class="block p-3 rounded border bg-bg-primary hover:shadow-card transition-shadow">
              <div class="flex items-baseline justify-between">
                <h3 class="text-sm font-semibold text-primary">{s.title_zh}</h3>
                <span class="text-xs text-quaternary">{s.kp_count}</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}
  </main>
</Layout>

{Astro.locals.canEdit(discipline) && (
  <div data-reorder-bootstrap="discipline-schools" data-discipline={discipline} class="hidden"></div>
)}

<script>
  // @ts-nocheck — DOM 类型推断弱，runtime 已验证
  // v0.4.26 长按拖动重排（仅 admin 渲染了 bootstrap 标记才挂载）
  import { mountDragReorder } from '~/lib/drag-reorder-client';
  const bootstrap = document.querySelector('[data-reorder-bootstrap="discipline-schools"]');
  if (bootstrap) {
    const discipline = bootstrap.dataset.discipline;
    document.querySelectorAll('[data-reorder-kind="discipline-schools"]').forEach((grid) => {
      const themeKey = grid.dataset.themeKey;
      mountDragReorder(grid, {
        getId: (el) => el.getAttribute('data-school-key'),
        skipSelector: 'button',
        onReorder: async (schoolKeys) => {
          const res = await fetch('/api/edit/reorder/discipline-schools', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ discipline, themeKey, schoolKeys }),
          });
          if (!res.ok) {
            const data = await res.json().catch(() => ({}));
            alert(`保存顺序失败：${res.status} ${data.reason ?? 'error'}`);
          }
        },
      });
    });
  }
</script>
