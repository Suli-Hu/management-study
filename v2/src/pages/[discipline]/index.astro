---
/**
 * 学派列表页 — v0.5.66 视图系统重写
 *
 * 数据流：
 *   views 表（D1） → 选当前视图（?view= 优先 / isDefault=true 兜底）
 *   resolveView(view, schools) → groups[{ id,title,flow,schools[] }]
 *   每 group 渲染 GroupCardCluster + SchoolCard
 *
 * 设计稿对齐：bundle/template App + 各子组件
 *   - PageHeader：H1 fontSize 34 fontWeight 700 + 副标 fontSize 13 #737373
 *   - ViewSwitcher chip 行
 *   - ViewDescription 卡片
 *   - 分组容器 GroupCardCluster
 *
 * 用户明确：视图只决定本页学派的渲染，学者详情/学者编辑/KP 编辑读全集 school 表，无变化。
 */
import Layout from '~/layouts/Layout.astro';
import { getDb } from '~/lib/db';
import ViewSwitcher from '~/components/ViewSwitcher.astro';
import ViewDescription from '~/components/ViewDescription.astro';
import GroupCardCluster from '~/components/GroupCardCluster.astro';
import SchoolCard from '~/components/SchoolCard.astro';
import ViewToast from '~/components/ViewToast.astro';
import ViewMenu from '~/components/ViewMenu.astro';
import NewViewDrawer from '~/components/NewViewDrawer.astro';
import ViewEditor from '~/components/ViewEditor.astro';
import { resolveAccentForSchool } from '~/lib/resolve-accent';
import type { ViewGroup } from '~/schemas/view';

const { discipline } = Astro.params;
const db = getDb(Astro.locals.runtime.env);

const disc = await db
  .prepare('SELECT key, title_zh, title_en, tagline_zh, tags_json FROM discipline WHERE key = ?')
  .bind(discipline)
  .first<{ key: string; title_zh: string; title_en: string | null; tagline_zh: string | null; tags_json: string }>();
if (!disc) return Astro.redirect('/404');

// 标签库 — v0.8.20: 给 resolveAccentForSchool() 当 lookup
const tagDefs = JSON.parse(disc.tags_json || '[]') as Array<{ key: string; label: { zh?: string }; color: string }>;
const disciplineLookup = { tags: tagDefs };

// 全部视图（chip 行用）
const viewsResult = await db
  .prepare(`
    SELECT id, name, jp, icon, description, flow, is_default, position, groups_json
    FROM view
    WHERE discipline = ?
    ORDER BY position ASC, id ASC
  `)
  .bind(discipline)
  .all<{
    id: string; name: string; jp: string; icon: string; description: string; flow: string;
    is_default: number; position: number; groups_json: string;
  }>();
const allViews = viewsResult.results ?? [];

// 选当前视图（注意：requestedViewId && find 在 requestedViewId='' 时会落到 ''，
// TS 会把 currentView 推断成 string|... — 用三元 + ?? 严格走对象 / null）
const requestedViewId = Astro.url.searchParams.get('view');
const requestedView = requestedViewId
  ? allViews.find((v) => v.id === requestedViewId) ?? null
  : null;
const currentView =
  requestedView ??
  allViews.find((v) => v.is_default === 1) ??
  allViews[0] ??
  null;

// 全部学派（discipline 下，含 kp_count + tag_key）
const schoolsResult = await db
  .prepare(`
    SELECT key, title_zh, title_en, era, tags_json,
      (SELECT COUNT(*) FROM kp_school WHERE school_key = school.key) as kp_count
    FROM school
    WHERE discipline = ?
  `)
  .bind(discipline)
  .all<{
    key: string; title_zh: string; title_en: string | null; era: string;
    tags_json: string; kp_count: number;
  }>();

const schools = (schoolsResult.results ?? []).map((s) => {
  const tagKeys = JSON.parse(s.tags_json || '[]') as string[];
  return {
    key: s.key,
    cn: s.title_zh,
    en: s.title_en,
    meta: s.era,
    count: s.kp_count,
    /* v0.8.20 fix: page chrome accent = discipline.tags[school.tags[0]].color 真实 hex
       (chip 1 v0.8.12 hashToTagToken 路径错把 school.key hash 到 8 OKLCH token，
       ignore user-defined hex)。无 tag 退 'var(--text-3)' 中性。 */
    accentHex: resolveAccentForSchool({ tags: tagKeys }, disciplineLookup),
  };
});
const schoolByKey = new Map(schools.map((s) => [s.key, s]));
const totalSchools = schools.length;

// 解析当前视图的 groups（manual kind only）
type Resolved = { id: string; title: string; flow: string; schools: typeof schools };
let resolvedGroups: Resolved[] = [];
let viewSchoolCount = 0;
if (currentView) {
  const groups = JSON.parse(currentView.groups_json || '[]') as ViewGroup[];
  resolvedGroups = groups.map((g) => ({
    id: g.id,
    title: g.title,
    flow: g.flow ?? '',
    schools: g.schoolIds.map((id) => schoolByKey.get(id)).filter((x): x is NonNullable<typeof x> => Boolean(x)),
  }));
  viewSchoolCount = resolvedGroups.reduce((sum, g) => sum + g.schools.length, 0);
}

const canEdit = Astro.locals.canEdit(discipline);

// chip 行需要的轻数据
const chipViews = allViews.map((v) => ({
  id: v.id,
  name: v.name,
  icon: v.icon,
  isDefault: v.is_default === 1,
  position: v.position,
}));

// v0.8.9 Fix 3c: schools/new 创建后跳到这里 + 提示拖到正确分组
const justCreatedSchool = Astro.url.searchParams.get('just_created_school') ?? '';
const justCreatedTheme = Astro.url.searchParams.get('theme') ?? '';
const justCreatedSchoolTitle = justCreatedSchool
  ? schools.find((s) => s.key === justCreatedSchool)?.cn ?? justCreatedSchool
  : '';
let justCreatedThemeTitle = '';
if (justCreatedTheme) {
  const themes = JSON.parse(
    (await db.prepare('SELECT themes_json FROM discipline WHERE key = ?').bind(discipline).first<{ themes_json: string | null }>())
      ?.themes_json ?? '[]',
  ) as Array<{ key: string; title?: { zh?: string } }>;
  justCreatedThemeTitle = themes.find((t) => t.key === justCreatedTheme)?.title?.zh ?? justCreatedTheme;
}
const showJustCreatedFlash = Boolean(justCreatedSchool && justCreatedThemeTitle);
---

<Layout title={disc.title_zh} currentDiscipline={discipline} currentSection="schools">
  <main class="discipline-page">
    {/* === Page header === */}
    <header class="page-h">
      <h1 class="page-h-title">{disc.title_zh}</h1>
      <p class="page-h-sub">
        {disc.title_en}{disc.tagline_zh ? ` · ${disc.tagline_zh}` : ''}
      </p>
    </header>

    {/* v0.5.84 wrap：ViewSwitcher + ViewDescription 整块包成 [data-view-block]，
        ViewSwitcher 里的「视图」label 按钮 toggle data-collapsed → CSS 隐藏 chip + desc */}
    <div class="view-block" data-view-block>
      {/* === ViewSwitcher chip 行 === */}
      {chipViews.length > 0 ? (
        <ViewSwitcher
          views={chipViews}
          currentId={currentView?.id ?? ''}
          discipline={discipline!}
          canEdit={canEdit}
        />
      ) : canEdit ? (
        <div class="empty-views-cta">
          还没有视图。<button type="button" data-view-new class="empty-views-link">+ 新建视图</button>
        </div>
      ) : null}

      {/* === ViewDescription === */}
      {currentView && (
        <ViewDescription
          view={{
            id: currentView.id,
            name: currentView.name,
            icon: currentView.icon,
            description: currentView.description,
            flow: currentView.flow,
          }}
          count={viewSchoolCount}
          totalSchools={totalSchools}
          canEdit={canEdit}
        />
      )}
    </div>

    {/* === Resolved groups === */}
    {currentView && resolvedGroups.length > 0 && (
      <div class="groups-stack">
        {resolvedGroups.map((g) => (
          <GroupCardCluster
            title={g.title}
            flow={g.flow}
            count={g.schools.length}
            groupId={g.id}
          >
            {g.schools.map((s) => (
              <SchoolCard
                href={`/${discipline}/${s.key}`}
                cn={s.cn}
                en={s.en}
                meta={s.meta}
                count={s.count}
                accentHex={s.accentHex}
              />
            ))}
          </GroupCardCluster>
        ))}
      </div>
    )}

    {currentView && resolvedGroups.length === 0 && (
      <div class="empty-groups">
        当前视图暂无分组。{canEdit ? '点 chip 上 ··· 选择「编辑视图」开始建组。' : ''}
      </div>
    )}
  </main>

  {showJustCreatedFlash && (
    <div
      class="just-created-flash"
      data-just-created-school={justCreatedSchool}
      data-just-created-theme-title={justCreatedThemeTitle}
      data-just-created-school-title={justCreatedSchoolTitle}
    >
    </div>
  )}

  {/* === 编辑器们：仅 canEdit 时挂载，避免访客也加载 === */}
  {canEdit && (
    <Fragment>
      <ViewMenu discipline={discipline!} />
      <NewViewDrawer
        discipline={discipline!}
        existingViews={allViews.map((v) => ({ id: v.id, name: v.name, icon: v.icon, description: v.description }))}
      />
      <ViewEditor
        discipline={discipline!}
        allSchools={schools.map((s) => ({ key: s.key, cn: s.cn }))}
      />
    </Fragment>
  )}
  <ViewToast />

  {/* v0.8.9 Fix 3c: just_created_school flash + URL 清理 — 复用 ViewToast 通道 */}
  {showJustCreatedFlash && (
    <script is:inline>
      (() => {
        const el = document.querySelector('.just-created-flash');
        if (!el) return;
        const themeTitle = el.getAttribute('data-just-created-theme-title') || '';
        const schoolTitle = el.getAttribute('data-just-created-school-title') || '';
        document.dispatchEvent(new CustomEvent('view:toast', {
          detail: `已创建 ${schoolTitle}（暂在「${themeTitle}」），可拖动到正确分组`,
        }));
        // 清 URL query 防刷新重弹
        const url = new URL(window.location.href);
        url.searchParams.delete('just_created_school');
        url.searchParams.delete('theme');
        window.history.replaceState(null, '', url.toString());
      })();
    </script>
  )}
</Layout>

<style>
  .discipline-page {
    max-width: 1100px;
    margin: 0 auto;
    padding: 36px 32px 120px;
    font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", system-ui, sans-serif;
  }
  @media (max-width: 720px) {
    .discipline-page { padding: 24px 16px 80px; }
  }

  /* v0.5.84 折叠态：ViewSwitcher 的 label-btn 还显示，其它都收起 */
  .view-block[data-collapsed="1"] :global(.vs-chip),
  .view-block[data-collapsed="1"] :global(.vs-new),
  .view-block[data-collapsed="1"] :global(.view-desc),
  .view-block[data-collapsed="1"] .empty-views-cta {
    display: none;
  }
  /* 折叠时 view-switcher 行抹掉下边线，避免「孤零零一根线」突兀 */
  .view-block[data-collapsed="1"] :global(.view-switcher) {
    border-bottom: 0;
    margin-bottom: 6px;
    padding-bottom: 0;
  }

  /* v0.8.12 Stage 6 chip 1: discipline 首页 切 v1.0 token —
     标题 / 副标 / empty state 全部 token 化，dark mode 自动反相 */
  .page-h { margin-bottom: 8px; }
  .page-h-title {
    font-size: 34px;
    font-weight: 700;
    color: var(--text);
    margin: 0;
    letter-spacing: -0.015em;
    line-height: 1.1;
  }
  .page-h-sub {
    font-size: 13px;
    color: var(--text-2);
    margin: 6px 0 0;
  }

  .groups-stack {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .empty-views-cta {
    background: var(--bg-soft);
    border: 1px dashed var(--border);
    border-radius: 12px;
    padding: 24px;
    text-align: center;
    font-size: 13px;
    color: var(--text-2);
    margin: 18px 0;
  }
  .empty-views-link {
    all: unset;
    cursor: pointer;
    color: var(--text);
    font-weight: 500;
    text-decoration: underline;
  }

  .empty-groups {
    padding: 36px 16px;
    text-align: center;
    font-size: 13px;
    color: var(--text-3);
  }
</style>
