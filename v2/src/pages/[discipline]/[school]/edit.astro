---
import Layout from '~/layouts/Layout.astro';
import { getDb } from '~/lib/db';
import { parseFrom, fromLabel } from '~/lib/nav';

const { discipline, school } = Astro.params;

if (!Astro.locals.canEdit(discipline)) return Astro.redirect(`/${discipline}/${school}`);

const fromPath = parseFrom(Astro.url.searchParams.get('from'), `/${discipline}/${school}`);
const fromLbl = fromLabel(fromPath);

const db = getDb(Astro.locals.runtime.env);
const exists = await db
  .prepare('SELECT key, title_zh FROM school WHERE key = ? AND discipline = ?')
  .bind(school, discipline)
  .first<{ key: string; title_zh: string }>();
if (!exists) return Astro.redirect('/404');
---

<Layout title={`编辑 · ${exists.title_zh}`} currentDiscipline={discipline} currentSection="schools">
  <main class="max-w-reading mx-auto px-4 py-6">
    <header class="mb-4">
      <a href={fromPath} class="text-xs text-tertiary hover:underline">← 返回{fromLbl}</a>
      <h1 class="text-2xl mt-2">编辑学派</h1>
    </header>

    <div id="status" class="hidden mb-4 p-3 rounded-md text-xs"></div>

    <form id="school-edit-form" class="space-y-5 hidden" autocomplete="off" data-school-key={school} data-discipline={discipline}>
      <section>
        <label class="block text-xs font-semibold text-tertiary mb-1">中文标题</label>
        <input name="title_zh" type="text" required class="w-full px-3 py-2 rounded-md border text-sm" />
      </section>
      <section class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-semibold text-tertiary mb-1">English</label>
          <input name="title_en" type="text" class="w-full px-3 py-2 rounded-md border text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-tertiary mb-1">日本語</label>
          <input name="title_ja" type="text" class="w-full px-3 py-2 rounded-md border text-sm" />
        </div>
      </section>
      <section class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-semibold text-tertiary mb-1">时代</label>
          <input name="era" type="text" placeholder="1947– 变革管理理论传统" class="w-full px-3 py-2 rounded-md border text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-tertiary mb-1">学派组</label>
          <select name="themeKey" required class="w-full px-3 py-2 rounded-md border text-sm bg-bg-primary">
            <option value="">— 请选择 —</option>
          </select>
        </div>
      </section>

      <section>
        <label class="block text-xs font-semibold text-tertiary mb-1">标签</label>
        <div id="tag-picker"></div>
      </section>

      <section>
        <label class="block text-xs font-semibold text-tertiary mb-1">概述</label>
        <textarea name="summary_zh" required rows="8" class="w-full px-3 py-2 rounded-md border text-sm leading-relaxed"></textarea>
      </section>

      <footer class="sticky bottom-0 bg-bg-primary py-3 border-t flex items-center gap-3">
        <button type="submit" id="save-btn" class="px-4 py-2 rounded-md bg-accent-strategy text-white text-sm font-semibold disabled:opacity-50">
          保存
        </button>
        <button
          type="button"
          id="delete-btn"
          disabled
          class="px-4 py-2 rounded-md bg-bg-primary border border-accent-warning text-accent-warning text-sm font-semibold ml-auto disabled:opacity-40 disabled:cursor-not-allowed"
          title="加载中..."
        >
          删除
        </button>
        <span id="save-status" class="text-xs text-tertiary"></span>
      </footer>
    </form>
  </main>
</Layout>

<script>
  // @ts-nocheck — DOM form 类型推断弱，runtime 已验证
  import { formatZodIssues } from '~/lib/zod-errors-zh';
  import { watchDeploy } from '~/lib/deploy-progress-client';
  import { mountTagSinglePicker } from '~/lib/tag-single-picker-client';
  const $ = (s) => document.querySelector(s);
  const schoolKey = document.getElementById('school-edit-form').dataset.schoolKey;
  const discipline = document.getElementById('school-edit-form').dataset.discipline;
  let _deployWatcher = null;
  const status = $('#status');
  const form = $('#school-edit-form');
  const saveBtn = $('#save-btn');
  const deleteBtn = $('#delete-btn');
  const saveStatus = $('#save-status');
  let baseSha = null;
  let originalCreatedAt = null;
  let originalConcepts = [];
  let tagPicker = null;

  function setStatus(msg, kind = 'info') {
    status.textContent = msg;
    status.className = `mb-4 p-3 rounded-md text-xs ${
      kind === 'error' ? 'bg-badge-limit text-accent-warning' :
      kind === 'success' ? 'bg-badge-meaning' : 'bg-bg-secondary text-tertiary'
    }`;
    status.classList.remove('hidden');
  }

  function populateThemeOptions(themes) {
    const sel = form.themeKey;
    while (sel.options.length > 1) sel.remove(1);
    for (const t of themes ?? []) {
      const opt = document.createElement('option');
      opt.value = t.key;
      opt.textContent = t.title?.zh ?? t.key;
      sel.appendChild(opt);
    }
  }

  function applyDeleteGate(kpCount) {
    if (kpCount === 0) {
      deleteBtn.disabled = false;
      deleteBtn.title = '删此学派（进 git history 可 revert，~90s 后线上消失）';
    } else {
      deleteBtn.disabled = true;
      deleteBtn.title = `还有 ${kpCount} 个知识点关联此学派。先把它们移到别的学派或删掉，才能删此学派。`;
    }
  }

  async function load() {
    setStatus('加载中...');
    const res = await fetch(`/api/edit/school/${schoolKey}`);
    if (!res.ok) {
      const err = await res.json().catch(() => ({}));
      setStatus(`加载失败：${res.status} ${err.reason ?? ''}`, 'error');
      return;
    }
    const { json: s, base_sha, themes, tag_library, kp_count } = await res.json();
    baseSha = base_sha;
    originalCreatedAt = s.createdAt;
    originalConcepts = s.concepts ?? [];
    populateThemeOptions(themes);
    form.title_zh.value = s.title?.zh ?? '';
    form.title_en.value = s.title?.en ?? '';
    form.title_ja.value = s.title?.ja ?? '';
    form.era.value = s.era ?? '';
    form.themeKey.value = s.themeKey ?? '';
    form.summary_zh.value = s.summary?.zh ?? '';

    const initialTag = Array.isArray(s.tags) && s.tags.length > 0 ? s.tags[0] : null;
    tagPicker = mountTagSinglePicker(document.getElementById('tag-picker'), {
      options: (tag_library ?? []).map((t) => ({ key: t.key, label: t.label?.zh ?? t.key, color: t.color })),
      initial: initialTag,
    });

    applyDeleteGate(kp_count ?? 0);
    form.classList.remove('hidden');
    status.classList.add('hidden');
  }

  function buildI18n(zh, en, ja) {
    const o = { zh: zh.trim() };
    if (en?.trim()) o.en = en.trim();
    if (ja?.trim()) o.ja = ja.trim();
    return o;
  }
  function collect() {
    const tagKey = tagPicker?.getValue();
    return {
      key: schoolKey,
      discipline,
      title: buildI18n(form.title_zh.value, form.title_en.value, form.title_ja.value),
      era: form.era.value.trim(),
      summary: { zh: form.summary_zh.value },
      themeKey: form.themeKey.value.trim(),
      tags: tagKey ? [tagKey] : [],
      concepts: originalConcepts,
      createdAt: originalCreatedAt,
      updatedAt: new Date().toISOString(),
    };
  }

  async function save(e) {
    e.preventDefault();
    saveBtn.disabled = true;
    saveStatus.textContent = '保存中...';
    const res = await fetch(`/api/edit/school/${schoolKey}`, {
      method: 'PUT',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ json: collect(), base_sha: baseSha }),
    });
    const data = await res.json().catch(() => ({}));
    if (res.ok) {
      if (_deployWatcher) _deployWatcher.stop();
      _deployWatcher = watchDeploy({ statusEl: saveStatus, commitSha: data.commit_sha, savedAtIso: new Date().toISOString() });
      baseSha = data.new_blob_sha;
    } else if (res.status === 409) {
      saveStatus.innerHTML = `<span style="color:#FF3B30">冲突：current=${data.current_sha?.slice(0, 7)}，请刷新</span>`;
    } else if (res.status === 422) {
      const lines = formatZodIssues(data.detail);
      saveStatus.innerHTML = `<span style="color:#FF3B30">字段校验失败：<br>${lines.map((l) => '• ' + l).join('<br>')}</span>`;
    } else {
      saveStatus.innerHTML = `<span style="color:#FF3B30">${res.status} ${data.reason ?? 'error'}: ${String(data.detail).slice(0, 80)}</span>`;
    }
    saveBtn.disabled = false;
  }

  async function del() {
    if (deleteBtn.disabled) return;
    if (!confirm(`确认删除学派「${schoolKey}」？\n\n• 进 git history 可 revert\n• ~90s 后线上消失`)) return;
    deleteBtn.disabled = true;
    deleteBtn.textContent = '删除中...';
    const res = await fetch(`/api/edit/school/${schoolKey}`, {
      method: 'DELETE',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ base_sha: baseSha }),
    });
    const data = await res.json().catch(() => ({}));
    if (res.ok) {
      alert(`✓ 已删除 school/${schoolKey}\ncommit ${data.commit_sha?.slice(0, 7)}`);
      location.href = `/${discipline}`;
    } else if (res.status === 409 && data.reason === 'has_dependents') {
      alert(`无法删除：${data.detail}`);
      deleteBtn.disabled = false;
      deleteBtn.textContent = '删除';
    } else {
      alert(`删除失败：${res.status} ${data.reason}`);
      deleteBtn.disabled = false;
      deleteBtn.textContent = '删除';
    }
  }

  form.addEventListener('submit', save);
  deleteBtn.addEventListener('click', del);
  load();
</script>
