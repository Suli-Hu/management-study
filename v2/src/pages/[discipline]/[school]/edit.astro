---
import Layout from '~/layouts/Layout.astro';
import { getDb } from '~/lib/db';

const { discipline, school } = Astro.params;

if (!Astro.locals.isAdmin) return Astro.redirect(`/${discipline}/${school}`);

const db = getDb(Astro.locals.runtime.env);
const exists = await db
  .prepare('SELECT key, title_zh FROM school WHERE key = ? AND discipline = ?')
  .bind(school, discipline)
  .first<{ key: string; title_zh: string }>();
if (!exists) return Astro.redirect('/404');
---

<Layout title={`编辑 · ${exists.title_zh}`} currentDiscipline={discipline} currentSection="schools">
  <main class="max-w-reading mx-auto px-4 py-6">
    <header class="mb-4">
      <a href={`/${discipline}/${school}`} class="text-xs text-tertiary hover:underline">← 返回 {exists.title_zh}</a>
      <h1 class="text-2xl mt-2">编辑学派 <code class="text-base text-tertiary">{school}</code></h1>
      <p class="text-xs text-quaternary mt-1">key/discipline 不可改（rename 走 worktree）。学者关联请去学者编辑器改 schools[]。</p>
    </header>

    <div id="status" class="hidden mb-4 p-3 rounded-md text-xs"></div>

    <form id="school-edit-form" class="space-y-5 hidden" autocomplete="off">
      <section>
        <label class="block text-xs font-semibold text-tertiary mb-1">中文标题</label>
        <input name="title_zh" type="text" required class="w-full px-3 py-2 rounded-md border text-sm" />
      </section>
      <section class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-semibold text-tertiary mb-1">English</label>
          <input name="title_en" type="text" class="w-full px-3 py-2 rounded-md border text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-tertiary mb-1">日本語</label>
          <input name="title_ja" type="text" class="w-full px-3 py-2 rounded-md border text-sm" />
        </div>
      </section>
      <section class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-semibold text-tertiary mb-1">era</label>
          <input name="era" type="text" placeholder="1947– 变革管理理论传统" class="w-full px-3 py-2 rounded-md border text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-tertiary mb-1">themeKey</label>
          <input name="themeKey" type="text" required placeholder="individual / change / strategy_internal" class="w-full px-3 py-2 rounded-md border text-sm" />
        </div>
      </section>
      <section>
        <label class="block text-xs font-semibold text-tertiary mb-1">accent</label>
        <div class="flex gap-2">
          {['ob', 'classic', 'strategy', 'warning'].map((a) => (
            <label class="inline-flex items-center gap-1 px-3 py-1.5 rounded border text-xs cursor-pointer">
              <input type="radio" name="accent" value={a} class="w-3 h-3" />
              <span>{a}</span>
            </label>
          ))}
        </div>
      </section>

      <section>
        <label class="block text-xs font-semibold text-tertiary mb-1">概述（中文）</label>
        <textarea name="summary_zh" required rows="6" class="w-full px-3 py-2 rounded-md border text-sm leading-relaxed"></textarea>
      </section>
      <section>
        <label class="block text-xs font-semibold text-tertiary mb-1">概述（日本語）</label>
        <textarea name="summary_ja" rows="6" class="w-full px-3 py-2 rounded-md border text-sm leading-relaxed"></textarea>
      </section>

      <footer class="sticky bottom-0 bg-bg-primary py-3 border-t flex items-center gap-3">
        <button type="submit" id="save-btn" class="px-4 py-2 rounded-md bg-accent-strategy text-white text-sm font-semibold disabled:opacity-50">
          保存（commit + 部署）
        </button>
        <button type="button" id="delete-btn" class="px-4 py-2 rounded-md bg-bg-primary border border-accent-warning text-accent-warning text-sm font-semibold ml-auto">
          硬删此学派
        </button>
        <span id="save-status" class="text-xs text-tertiary"></span>
      </footer>
    </form>
  </main>
</Layout>

<script type="module" define:vars={{ schoolKey: school, discipline }}>
  const $ = (s) => document.querySelector(s);
  const status = $('#status');
  const form = $('#school-edit-form');
  const saveBtn = $('#save-btn');
  const deleteBtn = $('#delete-btn');
  const saveStatus = $('#save-status');
  let baseSha = null;
  let originalCreatedAt = null;
  let originalConcepts = [];

  function setStatus(msg, kind = 'info') {
    status.textContent = msg;
    status.className = `mb-4 p-3 rounded-md text-xs ${
      kind === 'error' ? 'bg-badge-limit text-accent-warning' :
      kind === 'success' ? 'bg-badge-meaning' : 'bg-bg-secondary text-tertiary'
    }`;
    status.classList.remove('hidden');
  }

  async function load() {
    setStatus('加载中...');
    const res = await fetch(`/api/edit/school/${schoolKey}`);
    if (!res.ok) {
      const err = await res.json().catch(() => ({}));
      setStatus(`加载失败：${res.status} ${err.reason ?? ''}`, 'error');
      return;
    }
    const { json: s, base_sha } = await res.json();
    baseSha = base_sha;
    originalCreatedAt = s.createdAt;
    originalConcepts = s.concepts ?? [];
    form.title_zh.value = s.title?.zh ?? '';
    form.title_en.value = s.title?.en ?? '';
    form.title_ja.value = s.title?.ja ?? '';
    form.era.value = s.era ?? '';
    form.themeKey.value = s.themeKey ?? '';
    form.summary_zh.value = s.summary?.zh ?? '';
    form.summary_ja.value = s.summary?.ja ?? '';
    document.querySelectorAll('input[name=accent]').forEach((r) => { r.checked = r.value === (s.accent ?? 'classic'); });
    form.classList.remove('hidden');
    status.classList.add('hidden');
  }

  function buildI18n(zh, en, ja) {
    const o = { zh: zh.trim() };
    if (en?.trim()) o.en = en.trim();
    if (ja?.trim()) o.ja = ja.trim();
    return o;
  }
  function buildBody(zh, ja) {
    const o = { zh };
    if (ja?.trim()) o.ja = ja;
    return o;
  }
  function collect() {
    return {
      key: schoolKey,
      discipline,
      title: buildI18n(form.title_zh.value, form.title_en.value, form.title_ja.value),
      era: form.era.value.trim(),
      summary: buildBody(form.summary_zh.value, form.summary_ja.value),
      themeKey: form.themeKey.value.trim(),
      accent: document.querySelector('input[name=accent]:checked')?.value ?? 'classic',
      concepts: originalConcepts,
      createdAt: originalCreatedAt,
      updatedAt: new Date().toISOString(),
    };
  }

  async function save(e) {
    e.preventDefault();
    saveBtn.disabled = true;
    saveStatus.textContent = '保存中...';
    const res = await fetch(`/api/edit/school/${schoolKey}`, {
      method: 'PUT',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ json: collect(), base_sha: baseSha }),
    });
    const data = await res.json().catch(() => ({}));
    if (res.ok) {
      saveStatus.innerHTML = `✓ commit <code>${data.commit_sha?.slice(0, 7)}</code>，~${data.deploy_eta_seconds}s 后生效`;
      baseSha = data.new_blob_sha;
    } else if (res.status === 409) {
      saveStatus.innerHTML = `<span style="color:#FF3B30">冲突：current=${data.current_sha?.slice(0, 7)}，请刷新</span>`;
    } else if (res.status === 422) {
      saveStatus.innerHTML = `<span style="color:#FF3B30">schema 错：${JSON.stringify(data.detail).slice(0, 120)}</span>`;
    } else {
      saveStatus.innerHTML = `<span style="color:#FF3B30">${res.status} ${data.reason ?? 'error'}: ${String(data.detail).slice(0, 80)}</span>`;
    }
    saveBtn.disabled = false;
  }

  async function del() {
    if (!confirm(`确认硬删除学派「${schoolKey}」？\n\n• 进 git history 可 revert\n• 该学派下的 KP 仍保留（需各自处理 schools 字段）\n• ~90s 后线上消失`)) return;
    deleteBtn.disabled = true;
    deleteBtn.textContent = '删除中...';
    const res = await fetch(`/api/edit/school/${schoolKey}`, {
      method: 'DELETE',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ base_sha: baseSha }),
    });
    const data = await res.json().catch(() => ({}));
    if (res.ok) {
      alert(`✓ 已删除 school/${schoolKey}\ncommit ${data.commit_sha?.slice(0, 7)}`);
      location.href = `/${discipline}`;
    } else {
      alert(`删除失败：${res.status} ${data.reason}`);
      deleteBtn.disabled = false;
      deleteBtn.textContent = '硬删此学派';
    }
  }

  form.addEventListener('submit', save);
  deleteBtn.addEventListener('click', del);
  load();
</script>
