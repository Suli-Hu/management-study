---
/**
 * 学派编辑页 v0.8 Stage 4.5 — 整页重写（mirror KP editor pattern）
 *
 * server-side: canEdit + 直读 D1 (school + discipline tags/themes) + render shell + inject JSON
 * client-side: hydrate via initSchoolEditor
 *
 * 见 v2/docs/SCHOOL-SCHOLAR-THEME-EDITOR-V0.8-PRD.md
 */
import Layout from '~/layouts/Layout.astro';
import { getDb } from '~/lib/db';
import { parseFrom, fromLabel } from '~/lib/nav';
import { getSchoolRecord } from '~/lib/school-api-store';
import type { ExistingSchoolInit, SchoolEditorMetadata } from '~/lib/editor/school-state';

const { discipline, school } = Astro.params;
if (!discipline || !school) return Astro.redirect('/404');
if (!Astro.locals.canEdit(discipline)) return Astro.redirect(`/${discipline}/${school}`);

const fromPath = parseFrom(Astro.url.searchParams.get('from'), `/${discipline}/${school}`);
const fromLbl = fromLabel(fromPath);

const db = getDb(Astro.locals.runtime.env);
const tenantRow = await db
  .prepare('SELECT id FROM tenant WHERE discipline_key = ? OR id = ?')
  .bind(discipline, discipline)
  .first<{ id: string }>();
if (!tenantRow) return Astro.redirect('/404');

const record = await getSchoolRecord(db, school, { tenantId: tenantRow.id, discipline });
if (!record) return Astro.redirect('/404');

const discRow = await db
  .prepare('SELECT title_zh, themes_json, tags_json FROM discipline WHERE key = ?')
  .bind(discipline)
  .first<{ title_zh: string; themes_json: string; tags_json: string }>();

const themes: Array<{ key: string; title?: { zh?: string } }> = discRow?.themes_json
  ? JSON.parse(discRow.themes_json)
  : [];
const tagLibrary: Array<{ key: string; label?: { zh?: string }; color?: string }> = discRow?.tags_json
  ? JSON.parse(discRow.tags_json)
  : [];

const initialState: ExistingSchoolInit = {
  key: record.key,
  discipline,
  title: record.title,
  era: record.era,
  summary: record.summary,
  themeKey: record.themeKey,
  tags: record.tags,
};

const editorMetadata: SchoolEditorMetadata = {
  themes: themes.map((t) => ({ key: t.key, label: t.title?.zh ?? t.key })),
  tags: tagLibrary.map((t) => ({
    key: t.key,
    label: t.label?.zh ?? t.key,
    color: t.color ?? null,
  })),
  disciplineLabel: discRow?.title_zh ?? discipline,
  disciplineKey: discipline,
  fromPath,
  fromLabel: fromLbl,
};
---

<Layout title={`编辑 · ${record.title.zh}`} currentDiscipline={discipline} currentSection="schools">
  <div class="kp-editor-v08" id="school-editor-root" data-mode="edit"></div>

  <script type="application/json" is:inline id="school-editor-init" set:html={JSON.stringify({ initialState, metadata: editorMetadata })}></script>
</Layout>

<script>
  import { makeEditingSchoolState, type ExistingSchoolInit, type SchoolEditorMetadata } from '~/lib/editor/school-state';
  import { initSchoolEditor } from '~/lib/editor/school-form';

  const root = document.getElementById('school-editor-root');
  const initJson = document.getElementById('school-editor-init')?.textContent;
  if (!root || !initJson) {
    console.error('[school-editor] init payload missing');
  } else {
    const { initialState, metadata } = JSON.parse(initJson) as {
      initialState: ExistingSchoolInit;
      metadata: SchoolEditorMetadata;
    };
    initSchoolEditor({
      root: root as HTMLElement,
      initialState: makeEditingSchoolState(initialState),
      metadata,
      mode: 'edit',
    });
  }
</script>
