---
/**
 * 学派详情页 — OptionA「紧凑密度」(v0.5.1 设计稿落地)
 *
 * 布局：split [380-420px 左] [1fr 右]
 *   左：optA-hero (3px accent border-left) → 概述(可折叠) → 代表学者(可折叠) → KP 列表
 *   右：3px accent strip → kp-head-bar → renderBodyForSchool → renderEvalModule
 *
 * 兼容保留：
 *   - split-pane.js (`.kp-list-item[data-kp-id]` + `[data-kp-link][data-kp-wide-href]`)
 *   - admin-tools.js (`[data-kp-delete][data-kp-id][data-kp-title]`)
 *   - drag-reorder-client (concepts 拖拽)
 *   - star toggle (localStorage)
 */
import Layout from '~/layouts/Layout.astro';
import EmptyRight from '~/components/EmptyRight.astro';
import LangFab from '~/components/LangFab.astro';
import { getDb } from '~/lib/db';
import { renderStructuredBody, renderEvalModule } from '~/lib/render-body-structured';
import type { KpBody, KpEvaluationsLang } from '~/schemas/kp-body-structured';
import { renderInlineHtml } from '~/lib/render-inline';
import { editHref } from '~/lib/nav';
import { shortYear } from '~/lib/format-year';
import { lastName, splitName } from '~/lib/format-name';
import { resolveAccentForSchool } from '~/lib/resolve-accent';

const { discipline, school } = Astro.params;
const db = getDb(Astro.locals.runtime.env);

// v0.5.57: ?partial=1 fast path — split-pane.js KP swap fetch 用，跳过左栏/学者重 query，
// 只 query selectedKp 完整 row，返回 raw <article> fragment（无 Layout/Nav/Footer）
const isPartial = Astro.url.searchParams.get('partial') === '1';

// v0.8.20: 加 tags_json 给 resolveAccentForSchool() 用 (page chrome accent)
const sch = await db
  .prepare('SELECT key, title_zh, title_en, era, summary_zh, tags_json FROM school WHERE key = ? AND discipline = ?')
  .bind(school, discipline)
  .first<{ key: string; title_zh: string; title_en: string | null; era: string; summary_zh: string; tags_json: string | null }>();
if (!sch) return Astro.redirect('/404');

// v0.8.20: discipline.tags_json → resolveAccentForSchool lookup
const discRow = await db
  .prepare('SELECT tags_json FROM discipline WHERE key = ?')
  .bind(discipline)
  .first<{ tags_json: string | null }>();
const tagDefs = JSON.parse(discRow?.tags_json ?? '[]') as Array<{ key: string; color: string }>;
const accentHex = resolveAccentForSchool(
  { tags: JSON.parse(sch.tags_json ?? '[]') as string[] },
  { tags: tagDefs },
);

// v0.6.14: 同 discipline 全部 schools 的 key→title_zh 映射，给 summary 里 <code>key</code>
//   跨学派引用 resolve 用（render-inline.ts 的 resolveCode callback）
const allSchoolsRes = await db
  .prepare('SELECT key, title_zh FROM school WHERE discipline = ?')
  .bind(discipline)
  .all<{ key: string; title_zh: string }>();
const schoolNameByKey = new Map((allSchoolsRes.results ?? []).map((s) => [s.key, s.title_zh]));

// v0.8.21 三层原则 (PRD §6.2.3 修正):
//   - 右栏顶 3px strip + 左栏 active KP 左侧色条 + 右栏 body items numbering / cells
//     全部 = page chrome accent → 学派色 hex (用户确认 page interior 也要 tag 色)
//   - lang-toggle / LangFab / Star = focus action → L1 var(--primary) (不变)
// 修正动机：v0.8.20 把 page interior 强制中性 (var(--text-3))，但 split-pane layout 中
// list 左侧 active 条 + body 圆数字 是同一 page 视觉延伸，全收成中性失去身份感。用户
// fb：三个地方应一致 tag 色。

type KpListItem = {
  id: string; title_zh: string; title_en: string | null; title_ja: string | null; year: string;
  // v0.8.10 Stage 5：旧列已 drop，仅保留新列 + evaluations JSON
  body_zh_json: string; body_ja_json: string | null;
  evaluations_zh_json: string | null; evaluations_ja_json: string | null;
  body_format: string;
  scholars_csv: string | null;
};

// 完整页用：list query（v0.5.49 的 fat 查询，给左栏 + mobile inline expand 用）
let kps: KpListItem[] = [];
let scholarByKey = new Map<string, { key: string; name_zh: string; name_en: string | null }>();
let schoolScholars: Array<{ key: string; name_zh: string; name_en: string | null; name_ja: string | null; first: string; last: string }> = [];

if (!isPartial) {
  // v0.8.23 跨学科隔离：补 k.discipline=? 防 kp_school 跨学科 link 时邻学科 KP 漏入。
  // scholars_csv 子查询补 scholar_discipline=k.discipline 过滤同名跨学科 scholar。
  const kpsResult = await db
    .prepare(`
      SELECT k.id, k.title_zh, k.title_en, k.title_ja, k.year,
        k.body_zh_json, k.body_ja_json, k.body_format,
        k.evaluations_zh_json, k.evaluations_ja_json,
        (SELECT GROUP_CONCAT(scholar_key, ',')
           FROM kp_scholar
           WHERE kp_id = k.id AND scholar_discipline = k.discipline
           ORDER BY position) as scholars_csv
      FROM kp k
      INNER JOIN kp_school ks ON ks.kp_id = k.id
      WHERE ks.school_key = ? AND k.discipline = ?
      ORDER BY ks.position, k.id
    `)
    .bind(school, discipline)
    .all<KpListItem>();
  kps = kpsResult.results ?? [];

  const scholarsLookupResult = await db
    .prepare('SELECT key, name_zh, name_en FROM scholar WHERE discipline = ?')
    .bind(discipline)
    .all<{ key: string; name_zh: string; name_en: string | null }>();
  scholarByKey = new Map((scholarsLookupResult.results ?? []).map((s) => [s.key, s]));

  // v0.8.23 跨学科隔离：scholar_school PK (scholar_discipline, scholar_key, school_key) —
  //   补 ss.scholar_discipline=? + sc.discipline=? 双重过滤防同名 scholar 跨学科泄露。
  const schoolScholarsResult = await db
    .prepare(`
      SELECT sc.key, sc.name_zh, sc.name_en, sc.name_ja
      FROM scholar sc
      INNER JOIN scholar_school ss
        ON ss.scholar_key = sc.key AND ss.scholar_discipline = sc.discipline
      WHERE ss.school_key = ? AND sc.discipline = ?
      ORDER BY ss.position, sc.key
    `)
    .bind(school, discipline)
    .all<{ key: string; name_zh: string; name_en: string | null; name_ja: string | null }>();
  schoolScholars = (schoolScholarsResult.results ?? [])
    .map((s) => ({ ...s, ...splitName(s.name_en ?? s.name_zh) }))
    .sort((a, b) => a.last.localeCompare(b.last, 'en') || a.first.localeCompare(b.first, 'en'));
}

// 选中 KP（?kp= 或 list[0]）
const requestedKpId = Astro.url.searchParams.get('kp');
const selectedKpId = requestedKpId ?? kps[0]?.id ?? null;

// 当前语言（?lang=ja 切日文，否则中文）
const langParam = Astro.url.searchParams.get('lang');

// selectedKp：完整页用 kps.find（v0.5.49）；partial 单独 query（kps 是空数组）
let selectedKp: KpListItem | null = null;
if (selectedKpId) {
  if (isPartial) {
    // v0.8.23 跨学科隔离：scholars_csv 子查询补 scholar_discipline=k.discipline。
    selectedKp = await db
      .prepare(`
        SELECT k.id, k.title_zh, k.title_en, k.title_ja, k.year,
          k.body_zh_json, k.body_ja_json, k.body_format,
          k.evaluations_zh_json, k.evaluations_ja_json,
          (SELECT GROUP_CONCAT(scholar_key, ',')
             FROM kp_scholar
             WHERE kp_id = k.id AND scholar_discipline = k.discipline
             ORDER BY position) as scholars_csv
        FROM kp k WHERE k.id = ? AND k.discipline = ?
      `)
      .bind(selectedKpId, discipline)
      .first<KpListItem>();
  } else {
    selectedKp = kps.find((k) => k.id === selectedKpId) ?? null;
  }
}

// v0.8.10 Stage 5: body / evaluations 都从 v0.8 列读
const selectedUseJa = !!(langParam === 'ja' && selectedKp?.body_ja_json);
let selectedEvalContent: KpEvaluationsLang | null = null;
if (selectedKp) {
  const raw = selectedUseJa ? selectedKp.evaluations_ja_json : selectedKp.evaluations_zh_json;
  if (raw) {
    try { selectedEvalContent = JSON.parse(raw) as KpEvaluationsLang; }
    catch { selectedEvalContent = null; }
  }
}

// selectedScholars：完整页走 scholarByKey lookup；partial 单独 query（key IN ?）
let selectedScholars: Array<{ key: string; name_zh: string; name_en: string | null }> = [];
if (selectedKp) {
  const scholarKeys = (selectedKp.scholars_csv ?? '').split(',').filter(Boolean);
  if (scholarKeys.length > 0) {
    if (isPartial) {
      const placeholders = scholarKeys.map(() => '?').join(',');
      // v0.6.8: scholar 复合 PK — 必须按 (discipline, key) 过滤防跨学科同名学者污染
      const scRes = await db
        .prepare(`SELECT key, name_zh, name_en FROM scholar WHERE discipline = ? AND key IN (${placeholders})`)
        .bind(discipline, ...scholarKeys)
        .all<{ key: string; name_zh: string; name_en: string | null }>();
      const lookup = new Map((scRes.results ?? []).map((s) => [s.key, s]));
      selectedScholars = scholarKeys.map((sk) => lookup.get(sk)).filter((s): s is NonNullable<typeof s> => Boolean(s));
    } else {
      selectedScholars = scholarKeys
        .map((sk) => scholarByKey.get(sk))
        .filter((s): s is NonNullable<typeof s> => Boolean(s));
    }
  }
}

// 选中 KP 的实际显示语言（仅当该 KP 有日文 body 时 ?lang=ja 才生效）
const selectedLang: 'zh' | 'ja' =
  langParam === 'ja' && selectedKp?.body_ja_json ? 'ja' : 'zh';
const selectedBody: KpBody | null = selectedKp
  ? (selectedLang === 'ja'
      ? JSON.parse(selectedKp.body_ja_json!) as KpBody
      : JSON.parse(selectedKp.body_zh_json) as KpBody)
  : null;
const selectedTitle: string | null = selectedKp
  ? (selectedLang === 'ja' ? (selectedKp.title_ja ?? selectedKp.title_zh) : selectedKp.title_zh)
  : null;

// 切换 href（保留 ?kp= 等其他 query）
const langToggleParams = new URLSearchParams(Astro.url.search);
if (selectedLang === 'zh') langToggleParams.set('lang', 'ja');
else langToggleParams.delete('lang');
const langToggleQs = langToggleParams.toString();
const langToggleHref = langToggleQs ? `${Astro.url.pathname}?${langToggleQs}` : Astro.url.pathname;

const canEdit = Astro.locals.canEdit(discipline);
---

{/* v0.5.57 partial=1：只输出 <article> 右栏片段（无 Layout/Nav/Footer/scripts），split-pane.js 用 */}
{isPartial && (
  <article class="right kp-detail-pane" id="kp-detail-pane" style="padding:0">
    {/* v0.8.20: page chrome accent strip — 表达学派 page 身份 (resolveAccentForSchool 真实 hex) */}
    <div class="kp-pane-accent-strip" style={`background:${accentHex}`} aria-hidden="true"></div>
    <div class="kp-pane-content">
      {selectedKp ? (
        <>
          <header class="kp-head-bar">
            <div class="kp-head-bar-body">
              <div class="flex items-center gap-3">
                <h2 class="text-xl font-semibold leading-tight flex-1">{selectedTitle}</h2>
                {selectedKp.body_ja_json && (
                  <a
                    href={langToggleHref}
                    class:list={['lang-toggle shrink-0', selectedLang === 'ja' && 'is-active']}
                    data-lang-toggle
                    title="切换日语 / 中文 (Cmd/Ctrl + J)"
                    aria-pressed={selectedLang === 'ja'}
                  >
                    {selectedLang === 'zh' ? '日本語' : '中文'}
                  </a>
                )}
                {canEdit && (
                  <a
                    href={editHref(`/${discipline}/kp/${selectedKp.id}/edit`, Astro.url.pathname)}
                    data-edit-kp-link={selectedKp.id}
                    class="hero-icon-btn shrink-0"
                    aria-label={`编辑 ${selectedTitle}`}
                    title="编辑"
                  >✎</a>
                )}
              </div>
              <div class="text-xs text-tertiary mt-2 flex flex-wrap items-baseline gap-2">
                {selectedScholars.map((s) => (
                  <a href={`/${discipline}/scholars/${s.key}`} class="font-semibold hover:underline">
                    {lastName(s.name_en ?? s.name_zh)}
                  </a>
                ))}
                {selectedKp.year && <span class="text-quaternary">{shortYear(selectedKp.year)}</span>}
              </div>
              {selectedKp.title_en && <div class="text-xs text-quaternary italic mt-1">{selectedKp.title_en}</div>}
              {selectedKp.title_ja && selectedLang === 'zh' && <div class="text-xs text-tertiary mt-1">{selectedKp.title_ja}</div>}
            </div>
          </header>
          <div class="mt-6" set:html={renderStructuredBody({
            body: selectedBody!,
            accentHex,
            variant: 'school',
          })} />
          <div set:html={renderEvalModule(selectedEvalContent)} />
        </>
      ) : (
        <div class="text-sm text-quaternary py-10"><p>选中左侧 KP 查看详情。</p></div>
      )}
    </div>
  </article>
)}

{!isPartial && (
<Fragment>
<Layout
  title={sch.title_zh}
  currentDiscipline={discipline}
  currentSection="schools"
  currentLeafTitle={sch.title_zh}
  fullHeight
>
  <div class="split">

    {/* ========== 左栏 ========== */}
    <aside class="left optA-stack">

      {/* v0.5.54 学派身份卡（demo spec）—— 大字 + en + meta；v0.5.55 ✎ 走共享 hero-actions */}
      <div class="optA-hero-v2">
        {canEdit && (
          <div class="optA-hero-actions-v2">
            <a
              href={editHref(`/${discipline}/${sch.key}/edit`, Astro.url.pathname)}
              class="hero-icon-btn"
              aria-label="编辑此学派"
              title="编辑"
            >✎</a>
          </div>
        )}
        <h1 class="optA-hero-v2-title">{sch.title_zh}</h1>
        {sch.title_en && <div class="optA-hero-v2-en">{sch.title_en}</div>}
        {sch.era && <div class="optA-hero-v2-meta">{sch.era}</div>}
      </div>

      {/* v0.5.52 3 tab nav（mobile + PC 共用，sticky 顶部）*/}
      <nav class="optA-tabs" role="tablist" aria-label="学派内容切换">
        {sch.summary_zh && (
          <button
            class="optA-tab-btn"
            type="button"
            data-tab-btn="overview"
            role="tab"
            aria-selected="false"
          >概述</button>
        )}
        <button
          class="optA-tab-btn"
          type="button"
          data-tab-btn="scholars"
          role="tab"
          aria-selected="false"
        >
          代表学者
          {schoolScholars.length > 0 && <span class="optA-tab-count">{schoolScholars.length}</span>}
        </button>
        <button
          class="optA-tab-btn"
          type="button"
          data-tab-btn="concepts"
          data-active
          role="tab"
          aria-selected="true"
        >
          核心概念
          {kps.length > 0 && <span class="optA-tab-count">{kps.length}</span>}
        </button>
      </nav>

      {/* Tab Panel: 概述 */}
      {sch.summary_zh && (
        <section class="optA-tab-panel" data-tab-panel="overview" hidden>
          <div class="optA-summary-v2" set:html={renderInlineHtml(sch.summary_zh, {
            resolveCode: (key) => {
              const title = schoolNameByKey.get(key);
              return title ? { text: title, href: `/${discipline}/${key}` } : null;
            },
          })} />
        </section>
      )}

      {/* Tab Panel: 代表学者 */}
      <section class="optA-tab-panel" data-tab-panel="scholars" hidden>
        {canEdit && (
          <div class="optA-tab-panel-actions">
            <a
              href={editHref(`/${discipline}/scholars/new?school=${sch.key}`, Astro.url.pathname)}
              class="optA-section-add"
              title="新增学者"
            >+ 新增</a>
          </div>
        )}
        <ul class="optA-scholars">
          {schoolScholars.length === 0 ? (
            <li class="text-xs text-quaternary px-2 py-3">暂无关联学者。</li>
          ) : schoolScholars.map((s, i) => (
            <li>
              <a
                href={`/${discipline}/scholars/${s.key}`}
                class:list={['optA-scholar-row', i === schoolScholars.length - 1 && 'is-last']}
              >
                <div class="optA-scholar-line1">
                  {s.first && <span class="optA-scholar-first">{s.first}</span>}
                  <span class="optA-scholar-last">{s.last}</span>
                  {s.name_zh && <span class="optA-scholar-zh">{s.name_zh}</span>}
                </div>
                {s.name_ja && <div class="optA-scholar-ja">{s.name_ja}</div>}
              </a>
            </li>
          ))}
        </ul>
      </section>

      {/* Tab Panel: 核心概念（默认 active）*/}
      <section class="optA-tab-panel" data-tab-panel="concepts">
        {canEdit && (
          <div class="optA-tab-panel-actions">
            <a
              href={editHref(`/${discipline}/kp/new?school=${sch.key}`, Astro.url.pathname)}
              class="optA-section-add"
              title="新增 KP"
            >+ 新增</a>
          </div>
        )}
        <ul
          class="optA-kps drag-reorder"
          data-reorder-kind="school-concepts"
          data-school-key={sch.key}
          style={`--accent: ${accentHex}`}
        >
          {kps.map((k) => {
            const scholarKeys = (k.scholars_csv ?? '').split(',').filter(Boolean);
            const scholarLabel = scholarKeys
              .map((sk) => lastName(scholarByKey.get(sk)?.name_en ?? scholarByKey.get(sk)?.name_zh ?? sk))
              .join(' · ');
            const isActive = selectedKpId === k.id;
            // v0.8.10: inline body 跟随页面 ?lang=；该 KP 没 ja JSON → 退回 zh
            const useJa = selectedLang === 'ja' && !!k.body_ja_json;
            const inlineBody = useJa
              ? JSON.parse(k.body_ja_json!) as KpBody
              : JSON.parse(k.body_zh_json) as KpBody;
            const inlineBodyHtml = renderStructuredBody({
              body: inlineBody,
              accentHex,
              variant: 'school',
            });
            const evalRaw = useJa ? k.evaluations_ja_json : k.evaluations_zh_json;
            let kpEval: KpEvaluationsLang | null = null;
            if (evalRaw) {
              try { kpEval = JSON.parse(evalRaw) as KpEvaluationsLang; }
              catch { kpEval = null; }
            }
            const inlineEvalHtml = renderEvalModule(kpEval);
            return (
              <li class="optA-kp-li" data-kp-id={k.id}>
                <details
                  class:list={['optA-kp kp-list-item', isActive && 'is-active']}
                >
                  <summary class="optA-kp-summary">
                    <a
                      href={`/${discipline}/kp/${k.id}`}
                      data-kp-link
                      data-kp-wide-href={`?kp=${k.id}`}
                      class="optA-kp-link"
                    >
                      <div class="optA-kp-body">
                        <div class="optA-kp-title">
                          {k.title_zh}
                          {scholarLabel && <span class="optA-kp-scholar">{scholarLabel}</span>}
                          {k.year && <span class="optA-kp-year">{shortYear(k.year)}</span>}
                        </div>
                        {k.title_ja && <div class="optA-kp-sub-ja">{k.title_ja}</div>}
                        {k.title_en && <div class="optA-kp-sub-en">{k.title_en}</div>}
                      </div>
                    </a>
                  </summary>
                  <div class="optA-kp-inline-body">
                    <div set:html={inlineBodyHtml} />
                    {inlineEvalHtml && <Fragment set:html={inlineEvalHtml} />}
                  </div>
                </details>
              </li>
            );
          })}
        </ul>
        {kps.length === 0 && (
          <p class="text-xs text-quaternary px-2 py-2">暂无核心概念。</p>
        )}
      </section>
    </aside>

    {/* ========== 右栏 ========== */}
    <article class="right kp-detail-pane" id="kp-detail-pane" style="padding:0">
      {/* v0.8.20: page chrome accent strip — 表达学派 page 身份 (resolveAccentForSchool 真实 hex) */}
      <div class="kp-pane-accent-strip" style={`background:${accentHex}`} aria-hidden="true"></div>
      <div class="kp-pane-content">
        {kps.length === 0 ? (
          <EmptyRight
            accentHex="var(--text-3)"
            kind="school"
            name={sch.title_zh}
            addHref={canEdit ? editHref(`/${discipline}/kp/new?school=${sch.key}`, Astro.url.pathname) : undefined}
          />
        ) : selectedKp ? (
          <>
            <header class="kp-head-bar">
              <div class="kp-head-bar-body">
                <div class="flex items-center gap-3">
                  <h2 class="text-xl font-semibold leading-tight flex-1">{selectedTitle}</h2>
                  {selectedKp.body_ja_json && (
                    <a
                      href={langToggleHref}
                      class:list={['lang-toggle shrink-0', selectedLang === 'ja' && 'is-active']}
                      data-lang-toggle
                      title="切换日语 / 中文 (Cmd/Ctrl + J)"
                      aria-pressed={selectedLang === 'ja'}
                    >
                      {selectedLang === 'zh' ? '日本語' : '中文'}
                    </a>
                  )}
                  {canEdit && (
                    <a
                      href={editHref(`/${discipline}/kp/${selectedKp.id}/edit`, Astro.url.pathname)}
                      data-edit-kp-link={selectedKp.id}
                      class="hero-icon-btn shrink-0"
                      aria-label={`编辑 ${selectedTitle}`}
                      title="编辑"
                    >✎</a>
                  )}
                </div>
                <div class="text-xs text-tertiary mt-2 flex flex-wrap items-baseline gap-2">
                  {selectedScholars.map((s) => (
                    <a href={`/${discipline}/scholars/${s.key}`} class="font-semibold hover:underline">
                      {lastName(s.name_en ?? s.name_zh)}
                    </a>
                  ))}
                  {selectedKp.year && <span class="text-quaternary">{shortYear(selectedKp.year)}</span>}
                </div>
                {selectedKp.title_en && <div class="text-xs text-quaternary italic mt-1">{selectedKp.title_en}</div>}
                {selectedKp.title_ja && selectedLang === 'zh' && <div class="text-xs text-tertiary mt-1">{selectedKp.title_ja}</div>}
              </div>
            </header>
            <div class="mt-6" set:html={renderStructuredBody({
              body: selectedBody!,
              accentHex,
              variant: 'school',
            })} />
            <div set:html={renderEvalModule(selectedEvalContent)} />
          </>
        ) : (
          <div class="text-sm text-quaternary py-10">
            <p>选中左侧 KP 查看详情。</p>
          </div>
        )}
      </div>
    </article>

  </div>

  {/* v0.5.78：mobile 日语切换悬浮球 — 仅当当前选中 KP 有日文 body 时挂
       v0.8.20: lang 切换是 focus action → L1 var(--primary) (PRD §6.2.3 三层原则) */}
  {selectedKp?.body_ja_json && <LangFab lang={selectedLang} accentHex="var(--primary)" />}
</Layout>

<script is:inline src="/split-pane.js"></script>
<script is:inline src="/admin-tools.js"></script>

<script is:inline>
  // Cmd/Ctrl + J：切换日语 / 中文（V1 search.js:344 移植）
  (function () {
    function isEditableTarget(t) {
      if (!t) return false;
      var tag = t.tagName;
      if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT') return true;
      if (t.isContentEditable) return true;
      return false;
    }
    document.addEventListener('keydown', function (e) {
      if (!(e.metaKey || e.ctrlKey)) return;
      if (!e.key || e.key.toLowerCase() !== 'j') return;
      if (isEditableTarget(e.target)) return;
      // 优先右栏（学派详情 split-pane）
      var btn = document.querySelector('.kp-detail-pane [data-lang-toggle]')
        || document.querySelector('[data-lang-toggle]');
      if (!btn) return;
      e.preventDefault();
      btn.classList.add('is-pulse');
      setTimeout(function () {
        btn.classList.remove('is-pulse');
        btn.click();
      }, 90);
    });
  })();
</script>

{canEdit && (
  <div data-reorder-bootstrap="school-concepts" class="hidden"></div>
)}

<script>
  // @ts-nocheck — DOM 类型推断弱
  // KP 列表长按拖动重排（保留 v0.4.26 行为）
  import { mountDragReorder } from '~/lib/drag-reorder-client';

  // ========== v0.5.52 tab nav 切换 ==========
  // 替代 v0.5.48 的概述/代表学者 collapse 机制 —— 现 3 段切 tab，默认 "concepts"
  document.querySelectorAll('[data-tab-btn]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = btn.dataset.tabBtn;
      document.querySelectorAll('[data-tab-panel]').forEach((p) => {
        p.toggleAttribute('hidden', p.dataset.tabPanel !== target);
      });
      document.querySelectorAll('[data-tab-btn]').forEach((b) => {
        b.toggleAttribute('data-active', b.dataset.tabBtn === target);
        b.setAttribute('aria-selected', b.dataset.tabBtn === target ? 'true' : 'false');
      });
    });
  });
  if (document.querySelector('[data-reorder-bootstrap="school-concepts"]')) {
    document.querySelectorAll('[data-reorder-kind="school-concepts"]').forEach((ul) => {
      const schoolKey = ul.dataset.schoolKey;
      mountDragReorder(ul, {
        getId: (el) => el.getAttribute('data-kp-id'),
        getContainerKey: () => schoolKey,
        skipSelector: '.kp-admin-edit, .kp-admin, button',
        onReorder: async (idsByContainer) => {
          const kpIds = idsByContainer.get(schoolKey) ?? [];
          if (kpIds.length === 0) return;
          const res = await fetch('/api/edit/reorder/school-concepts', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ schoolKey, kpIds }),
          });
          if (!res.ok) {
            const data = await res.json().catch(() => ({}));
            alert(`保存顺序失败：${res.status} ${data.reason ?? 'error'}`);
          }
        },
      });
    });
  }
</script>
</Fragment>
)}
