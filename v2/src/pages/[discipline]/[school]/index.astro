---
import Layout from '~/layouts/Layout.astro';
import { getDb } from '~/lib/db';
import { renderBody } from '~/lib/render-body';

const { discipline, school } = Astro.params;
const db = getDb(Astro.locals.runtime.env);

const sch = await db
  .prepare('SELECT * FROM school WHERE key = ? AND discipline = ?')
  .bind(school, discipline)
  .first<{ key: string; title_zh: string; title_en: string | null; era: string; summary_zh: string; accent: string }>();

if (!sch) return Astro.redirect('/404');

const kpsResult = await db
  .prepare(`
    SELECT k.id, k.title_zh, k.title_en, k.title_ja, k.year,
      (SELECT GROUP_CONCAT(scholar_key, ',') FROM kp_scholar WHERE kp_id = k.id ORDER BY position) as scholars_csv
    FROM kp k
    INNER JOIN kp_school ks ON ks.kp_id = k.id
    WHERE ks.school_key = ?
    ORDER BY ks.position, k.id
  `)
  .bind(school)
  .all<{ id: string; title_zh: string; title_en: string | null; title_ja: string | null; year: string; scholars_csv: string | null }>();
const kps = kpsResult.results ?? [];

const scholarsLookupResult = await db
  .prepare('SELECT key, name_zh, name_en FROM scholar WHERE discipline = ?')
  .bind(discipline)
  .all<{ key: string; name_zh: string; name_en: string | null }>();
const scholarByKey = new Map((scholarsLookupResult.results ?? []).map((s) => [s.key, s]));

// 该学派的代表学者（v0.4.4 part 1：补 v1 who 字段对应 UI）
const schoolScholarsResult = await db
  .prepare(`
    SELECT sc.key, sc.name_zh, sc.name_en
    FROM scholar sc
    INNER JOIN scholar_school ss ON ss.scholar_key = sc.key
    WHERE ss.school_key = ?
    ORDER BY ss.position, sc.key
  `)
  .bind(school)
  .all<{ key: string; name_zh: string; name_en: string | null }>();
const schoolScholars = schoolScholarsResult.results ?? [];

const ACCENT_MAP: Record<string, string> = {
  ob: '#34C759',
  classic: '#FF9500',
  strategy: '#007AFF',
  warning: '#FF3B30',
};
const schoolAccentHex = ACCENT_MAP[sch.accent] ?? '#8a7a6a';

// 未指定 ?kp= 时默认选第一个（v0.3.13）
const requestedKpId = Astro.url.searchParams.get('kp');
const selectedKpId = requestedKpId ?? kps[0]?.id ?? null;
let selectedKp: {
  id: string; title_zh: string; title_en: string | null; title_ja: string | null;
  year: string; body_zh: string; body_ja: string | null; tags_json: string;
} | null = null;
let selectedScholars: Array<{ key: string; name_zh: string; name_en: string | null }> = [];
let selectedTags: string[] = [];

if (selectedKpId) {
  const kpRow = await db
    .prepare('SELECT id, title_zh, title_en, title_ja, year, body_zh, body_ja, tags_json FROM kp WHERE id = ? AND discipline = ?')
    .bind(selectedKpId, discipline)
    .first<typeof selectedKp>();
  selectedKp = kpRow ?? null;
  if (selectedKp) {
    selectedTags = JSON.parse(selectedKp.tags_json) as string[];
    const scRes = await db
      .prepare(`
        SELECT sc.key, sc.name_zh, sc.name_en
        FROM scholar sc
        INNER JOIN kp_scholar ks ON ks.scholar_key = sc.key
        WHERE ks.kp_id = ?
        ORDER BY ks.position
      `)
      .bind(selectedKpId)
      .all<{ key: string; name_zh: string; name_en: string | null }>();
    selectedScholars = scRes.results ?? [];
  }
}
---

<Layout
  title={sch.title_zh}
  currentDiscipline={discipline}
  currentSection="schools"
  fullHeight
>
  <main
    class="h-full lg:h-full lg:grid lg:grid-cols-[minmax(440px,520px)_1fr]"
    style={`--accent:${schoolAccentHex}`}
    data-active-ring="ring-[color:var(--accent)]"
  >
    {/* 左栏：学派信息 + KP 列表 */}
    <aside class="lg:h-full lg:overflow-y-auto lg:border-r px-4 py-6">
      <section class="flex rounded-xl overflow-hidden border bg-bg-primary shadow-card mb-5">
        <div class="w-1.5 shrink-0" style={`background:${schoolAccentHex}`}></div>
        <div class="flex-1 p-5 flex items-start gap-3">
          <div class="flex-1 min-w-0">
            <h1 class="text-xl font-semibold leading-tight">{sch.title_zh}</h1>
            <div class="text-xs text-tertiary mt-1">
              {sch.title_en}
              {sch.era && <span class="text-quaternary">　·　{sch.era}</span>}
            </div>
          </div>
          <div class="shrink-0 -mr-1 -mt-1 flex items-center gap-0.5">
            {Astro.locals.isAdmin && (
              <a
                href={`/${discipline}/${sch.key}/edit`}
                class="hidden lg:inline-flex w-9 h-9 rounded-full items-center justify-center text-base text-quaternary hover:text-accent-strategy hover:bg-bg-tertiary transition-colors"
                aria-label="编辑此学派"
                title="编辑此学派"
              >
                ✎
              </a>
            )}
            <button
              id="school-star-toggle"
              type="button"
              data-school-key={sch.key}
              aria-label="收藏学派"
              aria-pressed="false"
              class="school-star w-9 h-9 rounded-full flex items-center justify-center text-xl leading-none text-quaternary hover:bg-bg-tertiary transition-colors"
            >
              <span aria-hidden="true">☆</span>
            </button>
          </div>
        </div>
      </section>

      <section class="mb-5 group">
        <h2 class="text-xs font-semibold text-tertiary mb-2 flex items-center gap-2">
          代表学者 ({schoolScholars.length})
          {Astro.locals.isAdmin && (
            <a
              href={`/${discipline}/scholars/new?school=${sch.key}`}
              class="hidden lg:inline-flex group-hover:opacity-100 opacity-0 transition-opacity items-center px-2 py-0.5 rounded-full border border-accent-strategy text-accent-strategy text-xs no-underline hover:bg-accent-strategy hover:text-white"
              title="新增学者并预选此学派"
            >
              + 新增
            </a>
          )}
        </h2>
        {schoolScholars.length > 0 ? (
          <div class="flex flex-wrap gap-1.5">
            {schoolScholars.map((s) => (
              <a
                href={`/${discipline}/scholars/${s.key}`}
                class="inline-flex items-center px-2.5 py-1 rounded-full border bg-bg-primary text-xs hover:shadow-card transition-shadow"
              >
                {s.name_en ?? s.name_zh}
              </a>
            ))}
          </div>
        ) : (
          <p class="text-xs text-quaternary">暂无关联学者。</p>
        )}
      </section>

      {sch.summary_zh && (
        <section class="mb-5">
          <h2 class="text-xs font-semibold text-tertiary mb-2">概述</h2>
          <p class="text-xs text-secondary leading-relaxed">{sch.summary_zh}</p>
        </section>
      )}

      <section class="group">
        <h2 class="text-xs font-semibold text-tertiary mb-3 flex items-center gap-2">
          核心概念 ({kps.length})
          {Astro.locals.isAdmin && (
            <a
              href={`/${discipline}/kp/new?school=${sch.key}`}
              class="hidden lg:inline-flex group-hover:opacity-100 opacity-0 transition-opacity items-center px-2 py-0.5 rounded-full border border-accent-strategy text-accent-strategy text-xs no-underline hover:bg-accent-strategy hover:text-white"
              title="新增 KP 并预选此学派"
            >
              + 新增
            </a>
          )}
        </h2>
        <ul class="space-y-2">
          {kps.map((k) => {
            const scholarKeys = (k.scholars_csv ?? '').split(',').filter(Boolean);
            const scholarLabel = scholarKeys
              .map((sk) => scholarByKey.get(sk)?.name_en ?? scholarByKey.get(sk)?.name_zh ?? sk)
              .filter(Boolean)
              .join(' · ');
            const isActive = selectedKpId === k.id;
            return (
              <li data-kp-id={k.id} class:list={['kp-list-item group relative', isActive && 'is-active']}>
                <a
                  href={`/${discipline}/kp/${k.id}`}
                  data-kp-link
                  data-kp-wide-href={`?kp=${k.id}`}
                  class:list={[
                    'block p-3 rounded border bg-bg-primary hover:shadow-card transition-shadow',
                    isActive && 'ring-2',
                  ]}
                  style={isActive ? `--tw-ring-color:${schoolAccentHex};border-color:${schoolAccentHex};background:${schoolAccentHex}14` : ''}
                >
                  <h3 class="text-sm font-semibold text-primary">{k.title_zh}</h3>
                  {(scholarLabel || k.year) && (
                    <div class="text-xs text-quaternary mt-0.5">
                      {scholarLabel}{scholarLabel && k.year ? ' · ' : ''}{k.year}
                    </div>
                  )}
                  {k.title_ja && <div class="text-xs text-tertiary mt-0.5">{k.title_ja}</div>}
                </a>
                {Astro.locals.isAdmin && (
                  <div class="kp-admin-tools hidden lg:flex absolute top-2 right-2 gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
                    <a
                      href={`/${discipline}/kp/${k.id}/edit`}
                      class="w-6 h-6 rounded bg-bg-primary border flex items-center justify-center text-xs text-tertiary hover:text-accent-strategy hover:border-accent-strategy"
                      aria-label={`编辑 ${k.title_zh}`}
                      title="编辑"
                      onclick="event.stopPropagation()"
                    >
                      ✎
                    </a>
                    <button
                      type="button"
                      data-kp-delete
                      data-kp-id={k.id}
                      data-kp-title={k.title_zh}
                      class="w-6 h-6 rounded bg-bg-primary border flex items-center justify-center text-xs text-tertiary hover:text-accent-warning hover:border-accent-warning"
                      aria-label={`删除 ${k.title_zh}`}
                      title="删除（硬删，进 git history）"
                    >
                      ✗
                    </button>
                  </div>
                )}
              </li>
            );
          })}
        </ul>
      </section>
    </aside>

    {/* 右栏：KP 详情 */}
    <article
      class="kp-detail-pane hidden lg:block lg:h-full lg:overflow-y-auto px-4 py-6"
      id="kp-detail-pane"
    >
      {selectedKp ? (
        <div class="max-w-reading mx-auto">
          <header class="mb-6 pb-4 border-b">
            <h2 class="text-xl font-semibold">{selectedKp.title_zh}</h2>
            <div class="flex flex-wrap items-baseline gap-2 text-xs text-tertiary mt-2">
              {selectedScholars.map((s) => (
                <a href={`/${discipline}/scholars/${s.key}`} class="font-semibold hover:underline">
                  {s.name_en ?? s.name_zh}
                </a>
              ))}
              {selectedKp.year && <span class="text-quaternary">'{selectedKp.year}</span>}
            </div>
            {selectedKp.title_en && <div class="text-xs text-quaternary italic mt-1">{selectedKp.title_en}</div>}
            {selectedKp.title_ja && <div class="text-xs text-tertiary mt-1">{selectedKp.title_ja}</div>}
          </header>
          <div class="kp-body text-secondary" set:html={renderBody(selectedKp.body_zh, schoolAccentHex)} />
          {selectedTags.length > 0 && (
            <footer class="mt-8 pt-4 border-t flex gap-2">
              {selectedTags.map((t) => (
                <span class={`badge ${t === '义' ? 'badge-meaning' : t === '限' ? 'badge-limit' : 'bg-badge-neutral text-tertiary'}`}>
                  {t}
                </span>
              ))}
            </footer>
          )}
        </div>
      ) : (
        <div class="text-sm text-quaternary py-10 px-4 max-w-reading mx-auto">
          <p>选中左侧 KP 查看详情，或按 <kbd class="px-1.5 py-0.5 text-xs rounded border bg-bg-secondary">↓</kbd> / <kbd class="px-1.5 py-0.5 text-xs rounded border bg-bg-secondary">↑</kbd> 切换</p>
        </div>
      )}
    </article>
  </main>
</Layout>

<script is:inline src="/split-pane.js"></script>
<script is:inline src="/admin-tools.js"></script>

<script is:inline define:vars={{ schoolKey: sch.key, accentHex: schoolAccentHex }}>
  // v0.3.15: 学派收藏星标（localStorage，访客/admin 同）
  (function () {
    const btn = document.getElementById('school-star-toggle');
    if (!btn) return;
    const KEY = `school-starred:${schoolKey}`;
    const iconSpan = btn.querySelector('span');
    function render() {
      const starred = localStorage.getItem(KEY) === '1';
      btn.setAttribute('aria-pressed', String(starred));
      if (iconSpan) iconSpan.textContent = starred ? '★' : '☆';
      btn.style.color = starred ? accentHex : '';
      btn.setAttribute('aria-label', starred ? '已收藏学派（点击取消）' : '收藏学派');
    }
    render();
    btn.addEventListener('click', () => {
      if (localStorage.getItem(KEY) === '1') localStorage.removeItem(KEY);
      else localStorage.setItem(KEY, '1');
      render();
    });
  })();
</script>
