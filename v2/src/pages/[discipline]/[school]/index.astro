---
import Layout from '~/layouts/Layout.astro';
import { getDb } from '~/lib/db';
import { renderBody } from '~/lib/render-body';

const { discipline, school } = Astro.params;
const db = getDb(Astro.locals.runtime.env);

const sch = await db
  .prepare('SELECT * FROM school WHERE key = ? AND discipline = ?')
  .bind(school, discipline)
  .first<{ key: string; title_zh: string; title_en: string | null; era: string; summary_zh: string; accent: string }>();

if (!sch) return Astro.redirect('/404');

// KP 列表
const kpsResult = await db
  .prepare(`
    SELECT k.id, k.title_zh, k.title_en, k.title_ja, k.year,
      (SELECT GROUP_CONCAT(scholar_key, ',') FROM kp_scholar WHERE kp_id = k.id ORDER BY position) as scholars_csv
    FROM kp k
    INNER JOIN kp_school ks ON ks.kp_id = k.id
    WHERE ks.school_key = ?
    ORDER BY ks.position, k.id
  `)
  .bind(school)
  .all<{ id: string; title_zh: string; title_en: string | null; title_ja: string | null; year: string; scholars_csv: string | null }>();
const kps = kpsResult.results ?? [];

// 学者名 lookup —— 按 discipline 一次拉（避免 IN 上限）
const scholarsLookupResult = await db
  .prepare('SELECT key, name_zh, name_en FROM scholar WHERE discipline = ?')
  .bind(discipline)
  .all<{ key: string; name_zh: string; name_en: string | null }>();
const scholarByKey = new Map((scholarsLookupResult.results ?? []).map((s) => [s.key, s]));

const ACCENT_MAP: Record<string, string> = {
  ob: '#34C759',
  classic: '#FF9500',
  strategy: '#007AFF',
  warning: '#FF3B30',
};

// v0.3.10 Split-pane: ?kp=X 时 SSR 渲染该 KP 详情到右栏
const selectedKpId = Astro.url.searchParams.get('kp');
let selectedKp: {
  id: string; title_zh: string; title_en: string | null; title_ja: string | null;
  year: string; body_zh: string; body_ja: string | null; tags_json: string;
} | null = null;
let selectedScholars: Array<{ key: string; name_zh: string; name_en: string | null }> = [];
let selectedTags: string[] = [];
const schoolAccentHex = ACCENT_MAP[sch.accent] ?? '#8a7a6a';

if (selectedKpId) {
  const kpRow = await db
    .prepare('SELECT id, title_zh, title_en, title_ja, year, body_zh, body_ja, tags_json FROM kp WHERE id = ? AND discipline = ?')
    .bind(selectedKpId, discipline)
    .first<typeof selectedKp>();
  selectedKp = kpRow ?? null;
  if (selectedKp) {
    selectedTags = JSON.parse(selectedKp.tags_json) as string[];
    const scRes = await db
      .prepare(`
        SELECT sc.key, sc.name_zh, sc.name_en
        FROM scholar sc
        INNER JOIN kp_scholar ks ON ks.scholar_key = sc.key
        WHERE ks.kp_id = ?
        ORDER BY ks.position
      `)
      .bind(selectedKpId)
      .all<{ key: string; name_zh: string; name_en: string | null }>();
    selectedScholars = scRes.results ?? [];
  }
}
---

<Layout title={sch.title_zh} currentDiscipline={discipline} currentSection="schools">
  <main class="max-w-screen-2xl mx-auto px-4 py-6">
    <header class="mb-6">
      <h1 class="text-2xl mb-1">{sch.title_zh}</h1>
      <div class="text-xs text-tertiary">
        {sch.title_en}
        {sch.era && <span class="text-quaternary">　·　{sch.era}</span>}
      </div>
      {sch.summary_zh && <p class="text-body text-secondary mt-3 leading-relaxed max-w-reading">{sch.summary_zh}</p>}
    </header>

    {/* v0.3.10: lg (≥1024px) 双栏；窄屏单栏（左列 KP list，右列 KP detail） */}
    <div class="grid lg:grid-cols-[340px_1fr] gap-6">
      <aside class="kp-list lg:sticky lg:top-14 lg:max-h-[calc(100vh-80px)] lg:overflow-y-auto lg:pr-1">
        <h2 class="text-sm font-semibold text-tertiary mb-3">
          核心概念 (<span id="kp-count-total">{kps.length}</span>
          <span id="kp-count-known" class="hidden text-accent-classic"> · ★ <span data-known-count>0</span></span>)
        </h2>
        <ul class="space-y-2">
          {kps.map((k) => {
            const scholarKeys = (k.scholars_csv ?? '').split(',').filter(Boolean);
            const scholarLabel = scholarKeys
              .map((sk) => scholarByKey.get(sk)?.name_en ?? scholarByKey.get(sk)?.name_zh ?? sk)
              .filter(Boolean)
              .join(' · ');
            const isActive = selectedKpId === k.id;
            return (
              <li data-kp-id={k.id} class:list={['kp-list-item', isActive && 'is-active']}>
                {/* 窄屏默认走 /kp/[id]（全页）；宽屏 JS 拦截 → ?kp=X in-page swap */}
                <a
                  href={`/${discipline}/kp/${k.id}`}
                  data-kp-link
                  data-kp-wide-href={`?kp=${k.id}`}
                  class:list={[
                    'block p-3 rounded border bg-bg-primary hover:shadow-card transition-shadow',
                    isActive && 'ring-2 ring-accent-strategy border-accent-strategy',
                  ]}
                >
                  <h3 class="text-sm font-semibold text-primary">
                    <span class="kp-known-star hidden text-accent-classic mr-1" aria-hidden="true">★</span>
                    {k.title_zh}
                  </h3>
                  {(scholarLabel || k.year) && (
                    <div class="text-xs text-quaternary mt-0.5">
                      {scholarLabel}{scholarLabel && k.year ? ' · ' : ''}{k.year}
                    </div>
                  )}
                  {k.title_ja && <div class="text-xs text-tertiary mt-0.5">{k.title_ja}</div>}
                </a>
              </li>
            );
          })}
        </ul>
      </aside>

      {/* 右栏：KP 详情（仅宽屏可见；窄屏通过 media query hidden）*/}
      <article class="kp-detail-pane hidden lg:block" id="kp-detail-pane">
        {selectedKp ? (
          <div class="max-w-reading">
            <header class="mb-6 pb-4 border-b">
              <div class="flex items-start justify-between gap-3">
                <h2 class="text-xl font-semibold flex-1">{selectedKp.title_zh}</h2>
                <button
                  id="kp-known-toggle"
                  type="button"
                  data-kp-id={selectedKp.id}
                  aria-label="标记已会"
                  aria-pressed="false"
                  class="kp-star shrink-0 mt-1 w-9 h-9 rounded-full flex items-center justify-center text-xl leading-none text-quaternary hover:text-accent-classic hover:bg-bg-tertiary transition-colors"
                >
                  <span aria-hidden="true">☆</span>
                </button>
              </div>
              <div class="flex flex-wrap items-baseline gap-2 text-xs text-tertiary mt-2">
                {selectedScholars.map((s) => (
                  <a href={`/${discipline}/scholars/${s.key}`} class="font-semibold hover:underline">
                    {s.name_en ?? s.name_zh}
                  </a>
                ))}
                {selectedKp.year && <span class="text-quaternary">'{selectedKp.year}</span>}
              </div>
              {selectedKp.title_en && <div class="text-xs text-quaternary italic mt-1">{selectedKp.title_en}</div>}
              {selectedKp.title_ja && <div class="text-xs text-tertiary mt-1">{selectedKp.title_ja}</div>}
              <div class="mt-3">
                <a href={`/${discipline}/kp/${selectedKp.id}`} class="text-xs text-accent-strategy hover:underline">
                  在独立页面打开 →
                </a>
              </div>
            </header>
            <div class="kp-body text-secondary" set:html={renderBody(selectedKp.body_zh, schoolAccentHex)} />
            {selectedTags.length > 0 && (
              <footer class="mt-8 pt-4 border-t flex gap-2">
                {selectedTags.map((t) => (
                  <span class={`badge ${t === '义' ? 'badge-meaning' : t === '限' ? 'badge-limit' : 'bg-badge-neutral text-tertiary'}`}>
                    {t}
                  </span>
                ))}
              </footer>
            )}
          </div>
        ) : (
          <div class="text-sm text-quaternary py-10 px-4 text-center lg:text-left">
            <p>选中左侧 KP 查看详情，或按 <kbd class="px-1.5 py-0.5 text-xs rounded border bg-bg-secondary">↓</kbd> / <kbd class="px-1.5 py-0.5 text-xs rounded border bg-bg-secondary">↑</kbd> 切换</p>
          </div>
        )}
      </article>
    </div>
  </main>
</Layout>

<script is:inline>
  (function () {
    // ===== 已会星标（学派列表 + detail pane 共用）=====
    function renderKnownStars() {
      const items = document.querySelectorAll('[data-kp-id]');
      let known = 0;
      items.forEach((li) => {
        const id = li.getAttribute('data-kp-id');
        const isKnown = localStorage.getItem(`kp-known:${id}`) === '1';
        const star = li.querySelector('.kp-known-star');
        star?.classList.toggle('hidden', !isKnown);
        if (isKnown && li.tagName === 'LI') known++;
      });
      const badge = document.getElementById('kp-count-known');
      const countSpan = badge?.querySelector('[data-known-count]');
      if (badge && countSpan) {
        countSpan.textContent = String(known);
        badge.classList.toggle('hidden', known === 0);
      }
    }
    renderKnownStars();

    // ===== Detail pane 里的 ☆ toggle（事件委托 —— 支持 in-page swap 后仍然工作）=====
    function renderDetailStar() {
      const btn = document.getElementById('kp-known-toggle');
      if (!btn) return;
      const id = btn.getAttribute('data-kp-id');
      const known = localStorage.getItem(`kp-known:${id}`) === '1';
      btn.setAttribute('aria-pressed', String(known));
      const span = btn.querySelector('span');
      if (span) span.textContent = known ? '★' : '☆';
      btn.classList.toggle('text-accent-classic', known);
      btn.classList.toggle('text-quaternary', !known);
      btn.setAttribute('aria-label', known ? '已会（点击取消）' : '标记已会');
    }
    renderDetailStar();

    document.addEventListener('click', (e) => {
      const btn = e.target.closest?.('#kp-known-toggle');
      if (!btn) return;
      const id = btn.getAttribute('data-kp-id');
      if (!id) return;
      const key = `kp-known:${id}`;
      if (localStorage.getItem(key) === '1') localStorage.removeItem(key);
      else localStorage.setItem(key, '1');
      renderDetailStar();
      renderKnownStars();
    });

    // ===== 宽屏 split-pane 拦截：点 KP link → fetch 同路径 ?kp=X → 只换 detail pane =====
    const MQ = window.matchMedia('(min-width: 1024px)');
    const detailPane = document.getElementById('kp-detail-pane');

    async function showKpInPane(kpId) {
      if (!detailPane) return;
      const url = `${location.pathname}?kp=${encodeURIComponent(kpId)}`;
      detailPane.setAttribute('aria-busy', 'true');
      try {
        const res = await fetch(url);
        if (!res.ok) throw new Error('fetch failed: ' + res.status);
        const html = await res.text();
        const doc = new DOMParser().parseFromString(html, 'text/html');
        const newPane = doc.getElementById('kp-detail-pane');
        if (!newPane) throw new Error('no detail pane in response');
        detailPane.innerHTML = newPane.innerHTML;
        history.pushState(null, '', url);
        // 更新 list active state
        document.querySelectorAll('.kp-list-item').forEach((li) => {
          const isActive = li.getAttribute('data-kp-id') === kpId;
          li.classList.toggle('is-active', isActive);
          const a = li.querySelector('[data-kp-link]');
          a?.classList.toggle('ring-2', isActive);
          a?.classList.toggle('ring-accent-strategy', isActive);
          a?.classList.toggle('border-accent-strategy', isActive);
        });
        // 更新 title
        const newTitle = doc.querySelector('title')?.textContent;
        if (newTitle) document.title = newTitle;
        // 重绑 star state（detail pane 换了新 btn）
        renderDetailStar();
      } catch (err) {
        console.error('[split-pane] showKpInPane failed:', err);
      } finally {
        detailPane.removeAttribute('aria-busy');
      }
    }

    function interceptClicks() {
      document.querySelectorAll('[data-kp-link]').forEach((a) => {
        if (a.dataset.splitBound) return;
        a.dataset.splitBound = '1';
        a.addEventListener('click', (e) => {
          if (!MQ.matches) return; // 窄屏：默认跳 /kp/[id]
          if (e.metaKey || e.ctrlKey || e.shiftKey || e.button === 1) return; // 用户明确要新窗口
          e.preventDefault();
          const li = a.closest('[data-kp-id]');
          const id = li?.getAttribute('data-kp-id');
          if (id) showKpInPane(id);
        });
      });
    }
    interceptClicks();

    // ===== 键盘 ↑↓ 切换（宽屏生效；焦点在 input 里则跳过）=====
    document.addEventListener('keydown', (e) => {
      if (!MQ.matches) return;
      if (e.key !== 'ArrowUp' && e.key !== 'ArrowDown') return;
      const tag = e.target?.tagName;
      if (tag === 'INPUT' || tag === 'TEXTAREA' || e.target?.isContentEditable) return;
      const items = Array.from(document.querySelectorAll('.kp-list-item'));
      if (!items.length) return;
      e.preventDefault();
      const current = new URLSearchParams(location.search).get('kp');
      let idx = items.findIndex((el) => el.getAttribute('data-kp-id') === current);
      if (idx < 0) idx = e.key === 'ArrowDown' ? -1 : 0;
      idx += e.key === 'ArrowDown' ? 1 : -1;
      idx = Math.max(0, Math.min(items.length - 1, idx));
      const nextId = items[idx].getAttribute('data-kp-id');
      if (nextId && nextId !== current) {
        showKpInPane(nextId);
        items[idx].scrollIntoView({ block: 'nearest', behavior: 'smooth' });
      }
    });

    // ===== 进入页面时把 active 项滚入视口（宽屏）=====
    if (MQ.matches) {
      const active = document.querySelector('.kp-list-item.is-active');
      active?.scrollIntoView({ block: 'center' });
    }

    // ===== popstate（浏览器前进/后退）支持：重新拉对应 ?kp= =====
    window.addEventListener('popstate', () => {
      if (!MQ.matches) return;
      const id = new URLSearchParams(location.search).get('kp');
      if (id) showKpInPane(id);
    });
  })();
</script>
