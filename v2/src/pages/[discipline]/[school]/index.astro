---
/**
 * 学派详情页 — OptionA「紧凑密度」(v0.5.1 设计稿落地)
 *
 * 布局：split [380-420px 左] [1fr 右]
 *   左：optA-hero (3px accent border-left) → 概述(可折叠) → 代表学者(可折叠) → KP 列表
 *   右：3px accent strip → kp-head-bar → renderBodyForSchool → renderEvalModule
 *
 * 兼容保留：
 *   - split-pane.js (`.kp-list-item[data-kp-id]` + `[data-kp-link][data-kp-wide-href]`)
 *   - admin-tools.js (`[data-kp-delete][data-kp-id][data-kp-title]`)
 *   - drag-reorder-client (concepts 拖拽)
 *   - star toggle (localStorage)
 */
import Layout from '~/layouts/Layout.astro';
import EmptyRight from '~/components/EmptyRight.astro';
import { getDb } from '~/lib/db';
import { renderBodyForSchool, renderEvalModule } from '~/lib/render-body';
import { editHref } from '~/lib/nav';
import { tagColor } from '~/lib/tag-color';
import { shortYear } from '~/lib/format-year';
import type { Tag } from '~/schemas/discipline';
import type { EvalContent } from '~/lib/eval-tag-defs';

const { discipline, school } = Astro.params;
const db = getDb(Astro.locals.runtime.env);

// 标签库 + 学派 + KP 列表
const discRow = await db
  .prepare('SELECT tags_json FROM discipline WHERE key = ?')
  .bind(discipline)
  .first<{ tags_json: string }>();
const tagLibrary: Tag[] = discRow?.tags_json ? JSON.parse(discRow.tags_json) : [];

const sch = await db
  .prepare('SELECT key, title_zh, title_en, era, summary_zh, tags_json FROM school WHERE key = ? AND discipline = ?')
  .bind(school, discipline)
  .first<{ key: string; title_zh: string; title_en: string | null; era: string; summary_zh: string; tags_json: string }>();
if (!sch) return Astro.redirect('/404');

const schoolTags = JSON.parse(sch.tags_json) as string[];
const accentHex = tagColor({ tags: schoolTags }, tagLibrary);

const kpsResult = await db
  .prepare(`
    SELECT k.id, k.title_zh, k.title_en, k.title_ja, k.year,
      (SELECT GROUP_CONCAT(scholar_key, ',') FROM kp_scholar WHERE kp_id = k.id ORDER BY position) as scholars_csv
    FROM kp k
    INNER JOIN kp_school ks ON ks.kp_id = k.id
    WHERE ks.school_key = ?
    ORDER BY ks.position, k.id
  `)
  .bind(school)
  .all<{ id: string; title_zh: string; title_en: string | null; title_ja: string | null; year: string; scholars_csv: string | null }>();
const kps = kpsResult.results ?? [];

// 学者 lookup（KP meta 行用 EN 名）
const scholarsLookupResult = await db
  .prepare('SELECT key, name_zh, name_en FROM scholar WHERE discipline = ?')
  .bind(discipline)
  .all<{ key: string; name_zh: string; name_en: string | null }>();
const scholarByKey = new Map((scholarsLookupResult.results ?? []).map((s) => [s.key, s]));

// 该学派的代表学者（OptionA 用 row 形式展示）
const schoolScholarsResult = await db
  .prepare(`
    SELECT sc.key, sc.name_zh, sc.name_en, sc.name_ja
    FROM scholar sc
    INNER JOIN scholar_school ss ON ss.scholar_key = sc.key
    WHERE ss.school_key = ?
    ORDER BY ss.position, sc.key
  `)
  .bind(school)
  .all<{ key: string; name_zh: string; name_en: string | null; name_ja: string | null }>();
const schoolScholars = schoolScholarsResult.results ?? [];

// 选中 KP（?kp= 或 list[0]）
const requestedKpId = Astro.url.searchParams.get('kp');
const selectedKpId = requestedKpId ?? kps[0]?.id ?? null;

type SelectedKp = {
  id: string; title_zh: string; title_en: string | null; title_ja: string | null;
  year: string; body_zh: string; body_ja: string | null;
  format: string;
  eval_content_zh_json: string;
};
let selectedKp: SelectedKp | null = null;
let selectedScholars: Array<{ key: string; name_zh: string; name_en: string | null }> = [];
let selectedEvalContent: EvalContent | null = null;

if (selectedKpId) {
  const kpRow = await db
    .prepare('SELECT id, title_zh, title_en, title_ja, year, body_zh, body_ja, format, eval_content_zh_json FROM kp WHERE id = ? AND discipline = ?')
    .bind(selectedKpId, discipline)
    .first() as SelectedKp | null;
  selectedKp = kpRow ?? null;
  if (selectedKp) {
    try { selectedEvalContent = JSON.parse(selectedKp.eval_content_zh_json) as EvalContent; }
    catch { selectedEvalContent = null; }
    const scRes = await db
      .prepare(`
        SELECT sc.key, sc.name_zh, sc.name_en
        FROM scholar sc
        INNER JOIN kp_scholar ks ON ks.scholar_key = sc.key
        WHERE ks.kp_id = ?
        ORDER BY ks.position
      `)
      .bind(selectedKpId)
      .all<{ key: string; name_zh: string; name_en: string | null }>();
    selectedScholars = scRes.results ?? [];
  }
}

const canEdit = Astro.locals.canEdit(discipline);
---

<Layout
  title={sch.title_zh}
  currentDiscipline={discipline}
  currentSection="schools"
  fullHeight
>
  <div class="split" style={`--accent:${accentHex}`}>

    {/* ========== 左栏 ========== */}
    <aside class="left optA-stack">

      {/* Hero */}
      <div class="optA-hero">
        {canEdit && (
          <a
            href={editHref(`/${discipline}/${sch.key}/edit`, Astro.url.pathname)}
            class="hero-icon-btn optA-hero-edit"
            aria-label="编辑此学派"
            title="编辑"
          >✎</a>
        )}
        <div class="optA-eyebrow">学派</div>
        <h1 class="optA-hero-title">{sch.title_zh}</h1>
        <div class="optA-hero-sub">
          {sch.title_en}{sch.era ? ` · ${sch.era}` : ''}
        </div>
      </div>

      {/* 概述（可折叠 + sticky）*/}
      {sch.summary_zh && (
        <section class="optA-summary-wrap" data-collapse-section="summary">
          <button class="optA-section-head--btn" type="button" aria-expanded="true" data-collapse-toggle data-d-stick="summary">
            <h2>概述</h2>
            <span class="optA-collapse-chev">▾</span>
          </button>
          <div class="optA-summary" data-collapse-body>{sch.summary_zh}</div>
        </section>
      )}

      {/* 代表学者（可折叠 + sticky）*/}
      <section class="optA-block" data-collapse-section="scholars">
        <button class="optA-section-head--btn" type="button" aria-expanded="true" data-collapse-toggle data-d-stick="scholars">
          <h2>代表学者</h2>
          <span class="optA-count">{schoolScholars.length}</span>
          <span class="optA-collapse-chev">▾</span>
          {canEdit && (
            <a
              href={editHref(`/${discipline}/scholars/new?school=${sch.key}`, Astro.url.pathname)}
              class="optA-section-add"
              onclick="event.stopPropagation()"
              title="新增学者"
            >+ 新增</a>
          )}
        </button>
        <ul class="optA-scholars" data-collapse-body>
          {schoolScholars.length === 0 ? (
            <li class="text-xs text-quaternary px-2 py-1">暂无关联学者。</li>
          ) : schoolScholars.map((s) => (
            <li>
              <a href={`/${discipline}/scholars/${s.key}`} class="optA-scholar-row">
                <span class="optA-scholar-name">{s.name_en ?? s.name_zh}</span>
                {s.name_en && <span class="optA-scholar-zh">{s.name_zh}</span>}
                {s.name_ja && <span class="optA-scholar-ja">{s.name_ja}</span>}
                <span class="optA-arrow">↗</span>
              </a>
            </li>
          ))}
        </ul>
      </section>

      {/* 核心概念（不折叠，但 sticky）*/}
      <section class="optA-block">
        <div class="optA-section-head" data-d-stick="kps">
          <h2>核心概念</h2>
          <span class="optA-count">{kps.length}</span>
          {canEdit && (
            <a
              href={editHref(`/${discipline}/kp/new?school=${sch.key}`, Astro.url.pathname)}
              class="optA-section-add"
              title="新增 KP"
            >+ 新增</a>
          )}
        </div>
        <ul class="optA-kps drag-reorder" data-reorder-kind="school-concepts" data-school-key={sch.key}>
          {kps.map((k, i) => {
            const scholarKeys = (k.scholars_csv ?? '').split(',').filter(Boolean);
            const scholarLabel = scholarKeys
              .map((sk) => scholarByKey.get(sk)?.name_en ?? scholarByKey.get(sk)?.name_zh ?? sk)
              .join(' · ');
            const isActive = selectedKpId === k.id;
            return (
              <li
                data-kp-id={k.id}
                class:list={['optA-kp kp-list-item', isActive && 'is-active']}
              >
                <a
                  href={`/${discipline}/kp/${k.id}`}
                  data-kp-link
                  data-kp-wide-href={`?kp=${k.id}`}
                  class="contents"
                >
                  <div class="optA-kp-num">{String(i + 1).padStart(2, '0')}</div>
                  <div class="optA-kp-body">
                    <div class="optA-kp-title">
                      {k.title_zh}
                      {scholarLabel && <span class="optA-kp-scholar">{scholarLabel}</span>}
                      {k.year && <span class="optA-kp-year">{shortYear(k.year)}</span>}
                    </div>
                    {k.title_ja && <div class="optA-kp-sub-ja">{k.title_ja}</div>}
                    {k.title_en && <div class="optA-kp-sub-en">{k.title_en}</div>}
                  </div>
                </a>
                {canEdit && (
                  <a
                    class="kp-admin-edit"
                    href={editHref(`/${discipline}/kp/${k.id}/edit`, Astro.url.pathname)}
                    aria-label={`编辑 ${k.title_zh}`}
                    title="编辑"
                    onclick="event.stopPropagation()"
                  >✎</a>
                )}
              </li>
            );
          })}
        </ul>
        {kps.length === 0 && (
          <p class="text-xs text-quaternary px-2 py-2">暂无核心概念。</p>
        )}
      </section>
    </aside>

    {/* ========== 右栏 ========== */}
    <article class="right kp-detail-pane" id="kp-detail-pane" style="padding:0">
      <div style={`height:3px;background:${accentHex}`}></div>
      <div style="max-width:720px;padding:28px 28px 40px">
        {kps.length === 0 ? (
          <EmptyRight
            accentHex={accentHex}
            kind="school"
            name={sch.title_zh}
            addHref={canEdit ? editHref(`/${discipline}/kp/new?school=${sch.key}`, Astro.url.pathname) : undefined}
          />
        ) : selectedKp ? (
          <>
            <header class="kp-head-bar">
              <div class="kp-head-bar-body">
                <h2 class="text-xl font-semibold leading-tight">{selectedKp.title_zh}</h2>
                <div class="text-xs text-tertiary mt-2 flex flex-wrap items-baseline gap-2">
                  {selectedScholars.map((s) => (
                    <a href={`/${discipline}/scholars/${s.key}`} class="font-semibold hover:underline">
                      {s.name_en ?? s.name_zh}
                    </a>
                  ))}
                  {selectedKp.year && <span class="text-quaternary">'{selectedKp.year}</span>}
                </div>
                {selectedKp.title_en && <div class="text-xs text-quaternary italic mt-1">{selectedKp.title_en}</div>}
                {selectedKp.title_ja && <div class="text-xs text-tertiary mt-1">{selectedKp.title_ja}</div>}
              </div>
            </header>
            <div class="mt-6" set:html={renderBodyForSchool(selectedKp.format, selectedKp.body_zh, accentHex)} />
            <div set:html={renderEvalModule(selectedEvalContent)} />
          </>
        ) : (
          <div class="text-sm text-quaternary py-10">
            <p>选中左侧 KP 查看详情。</p>
          </div>
        )}
      </div>
    </article>

  </div>
</Layout>

<script is:inline src="/split-pane.js"></script>
<script is:inline src="/admin-tools.js"></script>

{canEdit && (
  <div data-reorder-bootstrap="school-concepts" class="hidden"></div>
)}

<script>
  // @ts-nocheck — DOM 类型推断弱
  // KP 列表长按拖动重排（保留 v0.4.26 行为）
  import { mountDragReorder } from '~/lib/drag-reorder-client';

  // ========== 累加 sticky：测量 hero/head 高度，写到 CSS 变量 ==========
  (function () {
    const left = document.querySelector('.optA-stack');
    if (!left) return;
    function measure() {
      const hero = left.querySelector('.optA-hero');
      const sumHead = left.querySelector('[data-d-stick="summary"]');
      const schHead = left.querySelector('[data-d-stick="scholars"]');
      left.style.setProperty('--hero-h', (hero?.offsetHeight ?? 80) + 'px');
      left.style.setProperty('--head-h-summary', (sumHead?.offsetHeight ?? 0) + 'px');
      left.style.setProperty('--head-h-scholars', (schHead?.offsetHeight ?? 0) + 'px');
    }
    measure();
    window.addEventListener('resize', measure);
  })();

  // ========== 概述/代表学者 折叠（默认全展开，不持久化）==========
  document.querySelectorAll('[data-collapse-section]').forEach((sec) => {
    const btn = sec.querySelector('[data-collapse-toggle]');
    const body = sec.querySelector('[data-collapse-body]');
    if (!btn || !body) return;
    btn.addEventListener('click', () => {
      const collapsed = sec.classList.toggle('is-collapsed');
      btn.setAttribute('aria-expanded', String(!collapsed));
      body.style.display = collapsed ? 'none' : '';
    });
  });
  if (document.querySelector('[data-reorder-bootstrap="school-concepts"]')) {
    document.querySelectorAll('[data-reorder-kind="school-concepts"]').forEach((ul) => {
      const schoolKey = ul.dataset.schoolKey;
      mountDragReorder(ul, {
        getId: (el) => el.getAttribute('data-kp-id'),
        getContainerKey: () => schoolKey,
        skipSelector: 'a, button, .kp-admin',
        onReorder: async (idsByContainer) => {
          const kpIds = idsByContainer.get(schoolKey) ?? [];
          if (kpIds.length === 0) return;
          const res = await fetch('/api/edit/reorder/school-concepts', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ schoolKey, kpIds }),
          });
          if (!res.ok) {
            const data = await res.json().catch(() => ({}));
            alert(`保存顺序失败：${res.status} ${data.reason ?? 'error'}`);
          }
        },
      });
    });
  }
</script>

