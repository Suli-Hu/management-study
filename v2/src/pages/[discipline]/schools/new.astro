---
/**
 * 新增学派页 v0.8 Stage 4.5 — 整页重写
 *
 * 见 v2/docs/SCHOOL-SCHOLAR-THEME-EDITOR-V0.8-PRD.md
 */
import Layout from '~/layouts/Layout.astro';
import { getDb } from '~/lib/db';
import type { SchoolEditorMetadata } from '~/lib/editor/school-state';

const { discipline } = Astro.params;
if (!discipline) return Astro.redirect('/404');
if (!Astro.locals.canEdit(discipline)) return Astro.redirect(`/${discipline}`);

const db = getDb(Astro.locals.runtime.env);
const discRow = await db
  .prepare('SELECT title_zh, themes_json, tags_json FROM discipline WHERE key = ?')
  .bind(discipline)
  .first<{ title_zh: string; themes_json: string; tags_json: string }>();
if (!discRow) return Astro.redirect('/404');

const themes: Array<{ key: string; title?: { zh?: string } }> = discRow.themes_json
  ? JSON.parse(discRow.themes_json)
  : [];
const tagLibrary: Array<{ key: string; label?: { zh?: string }; color?: string }> = discRow.tags_json
  ? JSON.parse(discRow.tags_json)
  : [];

// v0.8.9 Fix 3b: themeKey 不再前端选 — server 端注入 default。
// 优先级：URL ?theme=key（从主题 header ⊕ 入口） > themes[0].key > 引导建主题。
const requestedTheme = Astro.url.searchParams.get('theme') ?? '';
const requestedThemeValid = themes.some((t) => t.key === requestedTheme);
let defaultThemeKey = requestedThemeValid ? requestedTheme : (themes[0]?.key ?? '');

if (!defaultThemeKey) {
  // 整个 discipline 一个主题都没 → 引导先建主题
  return Astro.redirect(`/${discipline}/themes/new?after=schools`);
}

const editorMetadata: SchoolEditorMetadata = {
  themes: themes.map((t) => ({ key: t.key, label: t.title?.zh ?? t.key })),
  tags: tagLibrary.map((t) => ({
    key: t.key,
    label: t.label?.zh ?? t.key,
    color: t.color ?? null,
  })),
  disciplineLabel: discRow.title_zh,
  disciplineKey: discipline,
  fromPath: `/${discipline}`,
  fromLabel: '学派列表',
};
---

<Layout title={`新增学派 · ${discRow.title_zh}`} currentDiscipline={discipline} currentSection="schools">
  <div class="kp-editor-v08" id="school-editor-root" data-mode="new"></div>

  <script
    type="application/json"
    is:inline
    id="school-editor-init"
    set:html={JSON.stringify({ metadata: editorMetadata, defaultThemeKey })}
  ></script>
</Layout>

<script>
  import { makeNewSchoolState, type SchoolEditorMetadata } from '~/lib/editor/school-state';
  import { initSchoolEditor } from '~/lib/editor/school-form';

  const root = document.getElementById('school-editor-root');
  const initJson = document.getElementById('school-editor-init')?.textContent;
  if (!root || !initJson) {
    console.error('[school-editor] init payload missing');
  } else {
    const { metadata, defaultThemeKey } = JSON.parse(initJson) as {
      metadata: SchoolEditorMetadata;
      defaultThemeKey: string;
    };
    const initialState = makeNewSchoolState(metadata.disciplineKey, defaultThemeKey);
    initSchoolEditor({
      root: root as HTMLElement,
      initialState,
      metadata,
      mode: 'new',
    });
  }
</script>
