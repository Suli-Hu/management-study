---
import Layout from '~/layouts/Layout.astro';
import { getDb } from '~/lib/db';

const { discipline } = Astro.params;
if (!Astro.locals.canEdit(discipline)) return Astro.redirect(`/${discipline}`);

const db = getDb(Astro.locals.runtime.env);
const themesRow = await db.prepare('SELECT themes_json FROM discipline WHERE key = ?').bind(discipline).first<{ themes_json: string }>();
const themes: Array<{ key: string; title: { zh?: string }; tags?: string[] }> = themesRow?.themes_json
  ? JSON.parse(themesRow.themes_json) : [];

// v0.4.35：?theme=X 预选主题（从首页主题 header ⊕ 入口跳转携带）
const ctxTheme = Astro.url.searchParams.get('theme') ?? '';
---

<Layout title="新增学派" currentDiscipline={discipline} currentSection="schools">
  <main class="max-w-reading mx-auto px-4 py-6">
    <header class="mb-4">
      <a href={`/${discipline}`} class="text-xs text-tertiary hover:underline">← 返回学派列表</a>
      <h1 class="text-2xl mt-2">新增学派</h1>
      <p class="text-xs text-quaternary mt-1">key 一旦提交不可改。命名建议小写蛇形，如 <code>change_management</code>。</p>
    </header>

    <form id="school-new-form" class="space-y-5" autocomplete="off" data-discipline={discipline}>
      <section>
        <label class="block text-xs font-semibold text-tertiary mb-1">key <span class="text-accent-warning">*</span></label>
        <input name="key" type="text" required pattern="[a-z][a-z0-9_]*" placeholder="strategy_emergent" class="w-64 px-3 py-2 rounded-md border text-sm font-mono" />
      </section>

      <section>
        <label class="block text-xs font-semibold text-tertiary mb-1">中文标题 <span class="text-accent-warning">*</span></label>
        <input name="title_zh" type="text" required class="w-full px-3 py-2 rounded-md border text-sm" />
      </section>
      <section class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-semibold text-tertiary mb-1">English</label>
          <input name="title_en" type="text" class="w-full px-3 py-2 rounded-md border text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-tertiary mb-1">日本語</label>
          <input name="title_ja" type="text" class="w-full px-3 py-2 rounded-md border text-sm" />
        </div>
      </section>
      <section class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-semibold text-tertiary mb-1">时代</label>
          <input name="era" type="text" placeholder="1947–" class="w-full px-3 py-2 rounded-md border text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-tertiary mb-1">学派组 <span class="text-accent-warning">*</span></label>
          <select name="themeKey" required class="w-full px-3 py-2 rounded-md border text-sm bg-bg-primary">
            <option value="">— 请选择 —</option>
            {themes.map((t) => (
              <option value={t.key} selected={t.key === ctxTheme}>{t.title?.zh ?? t.key}</option>
            ))}
          </select>
          <p class="text-xs text-quaternary mt-1">决定首页所属章节。学派颜色由 tags 决定，新建后再配置。</p>
        </div>
      </section>

      <section>
        <div class="flex items-center gap-2 mb-1">
          <label class="text-xs font-semibold text-tertiary">概述 <span class="text-accent-warning">*</span></label>
          <div role="tablist" class="inline-flex border rounded overflow-hidden text-xs">
            <button type="button" data-lang-tab="zh" data-active class="px-2.5 py-0.5 hover:bg-bg-tertiary data-[active]:bg-accent-strategy data-[active]:text-white">中</button>
            <button type="button" data-lang-tab="ja" class="px-2.5 py-0.5 border-l hover:bg-bg-tertiary data-[active]:bg-accent-strategy data-[active]:text-white">日</button>
          </div>
        </div>
        <div data-lang-pane="zh">
          <textarea name="summary_zh" required rows="8" class="w-full px-3 py-2 rounded-md border text-sm leading-relaxed"></textarea>
        </div>
        <div data-lang-pane="ja" class="hidden">
          <textarea name="summary_ja" rows="8" class="w-full px-3 py-2 rounded-md border text-sm leading-relaxed"></textarea>
        </div>
      </section>

      <footer class="sticky bottom-0 bg-bg-primary py-3 border-t flex items-center gap-3">
        <button type="submit" id="save-btn" class="px-4 py-2 rounded-md bg-accent-strategy text-white text-sm font-semibold disabled:opacity-50">
          创建
        </button>
        <span id="save-status" class="text-xs text-tertiary"></span>
      </footer>
    </form>
  </main>
</Layout>

<script>
  // @ts-nocheck — DOM form 类型推断弱，runtime 已验证
  import { formatZodIssues } from '~/lib/zod-errors-zh';
  const form = document.getElementById('school-new-form');
  const discipline = form.dataset.discipline;
  const saveBtn = document.getElementById('save-btn');
  const saveStatus = document.getElementById('save-status');

  function buildI18n(zh, en, ja) {
    const o = { zh: zh.trim() };
    if (en?.trim()) o.en = en.trim();
    if (ja?.trim()) o.ja = ja.trim();
    return o;
  }
  function buildBody(zh, ja) {
    const o = { zh };
    if (ja?.trim()) o.ja = ja;
    return o;
  }
  function collect() {
    const now = new Date().toISOString();
    return {
      key: form.key.value.trim(),
      discipline,
      title: buildI18n(form.title_zh.value, form.title_en.value, form.title_ja.value),
      era: form.era.value.trim(),
      summary: buildBody(form.summary_zh.value, form.summary_ja.value),
      themeKey: form.themeKey.value.trim(),
      tags: [],
      concepts: [],
      createdAt: now,
      updatedAt: now,
    };
  }

  document.querySelectorAll('[data-lang-tab]').forEach((b) => {
    b.addEventListener('click', () => {
      document.querySelectorAll('[data-lang-tab]').forEach((x) => x.toggleAttribute('data-active', x.dataset.langTab === b.dataset.langTab));
      document.querySelectorAll('[data-lang-pane]').forEach((p) => p.classList.toggle('hidden', p.dataset.langPane !== b.dataset.langTab));
    });
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    saveBtn.disabled = true;
    saveStatus.textContent = '创建中...';
    const json = collect();
    const res = await fetch('/api/new/school', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ json }),
    });
    const data = await res.json().catch(() => ({}));
    if (res.ok) {
      saveStatus.innerHTML = `✓ commit <code>${data.commit_sha?.slice(0, 7)}</code>，跳转中...`;
      setTimeout(() => { location.href = `/${discipline}/${json.key}`; }, 1500);
    } else if (res.status === 409) {
      saveStatus.innerHTML = `<span style="color:#FF3B30">key 已存在</span>`;
      saveBtn.disabled = false;
    } else if (res.status === 422) {
      const lines = formatZodIssues(data.detail);
      saveStatus.innerHTML = `<span style="color:#FF3B30">字段校验失败：<br>${lines.map((l) => '• ' + l).join('<br>')}</span>`;
      saveBtn.disabled = false;
    } else {
      saveStatus.innerHTML = `<span style="color:#FF3B30">${res.status} ${data.reason ?? 'error'}</span>`;
      saveBtn.disabled = false;
    }
  });
</script>
