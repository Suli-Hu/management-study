---
import Layout from '~/layouts/Layout.astro';
import { getDb } from '~/lib/db';

const { discipline } = Astro.params;
if (!Astro.locals.isAdmin) return Astro.redirect(`/${discipline}/scholars`);

const db = getDb(Astro.locals.runtime.env);
const schoolsResult = await db
  .prepare('SELECT key, title_zh FROM school WHERE discipline = ? ORDER BY title_zh')
  .bind(discipline)
  .all<{ key: string; title_zh: string }>();
const allSchools = schoolsResult.results ?? [];

const ctxSchool = Astro.url.searchParams.get('school') ?? '';
---

<Layout title="新增学者" currentDiscipline={discipline} currentSection="scholars">
  <main class="max-w-reading mx-auto px-4 py-6">
    <header class="mb-4">
      <a href={`/${discipline}/scholars`} class="text-xs text-tertiary hover:underline">← 返回学者列表</a>
      <h1 class="text-2xl mt-2">新增学者</h1>
      <p class="text-xs text-quaternary mt-1">key 一旦提交不可改。命名建议英文姓氏小写，如 <code>lewin</code> / <code>kotter</code>。</p>
    </header>

    <form id="scholar-new-form" class="space-y-5" autocomplete="off">
      <section>
        <label class="block text-xs font-semibold text-tertiary mb-1">key <span class="text-accent-warning">*</span></label>
        <input name="key" type="text" required pattern="[a-z][a-z0-9_]*" placeholder="lewin" class="w-64 px-3 py-2 rounded-md border text-sm font-mono" />
      </section>

      <section>
        <label class="block text-xs font-semibold text-tertiary mb-1">中文名 <span class="text-accent-warning">*</span></label>
        <input name="name_zh" type="text" required class="w-full px-3 py-2 rounded-md border text-sm" />
      </section>
      <section class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-semibold text-tertiary mb-1">English</label>
          <input name="name_en" type="text" class="w-full px-3 py-2 rounded-md border text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-tertiary mb-1">日本語</label>
          <input name="name_ja" type="text" class="w-full px-3 py-2 rounded-md border text-sm" />
        </div>
      </section>

      <section>
        <label class="block text-xs font-semibold text-tertiary mb-1">所属学派 schools[]</label>
        <div class="flex flex-wrap gap-1 max-h-40 overflow-y-auto p-1 border rounded">
          {allSchools.map((s) => (
            <label class="inline-flex items-center gap-1 px-2 py-1 rounded border text-xs cursor-pointer hover:bg-bg-tertiary">
              <input type="checkbox" name="school" value={s.key} class="w-3 h-3" checked={s.key === ctxSchool} />
              <span>{s.title_zh}</span>
            </label>
          ))}
        </div>
      </section>

      <section class="grid grid-cols-3 gap-3">
        <div>
          <label class="block text-xs font-semibold text-tertiary mb-1">born</label>
          <input name="born" type="text" class="w-full px-3 py-2 rounded-md border text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-tertiary mb-1">died</label>
          <input name="died" type="text" class="w-full px-3 py-2 rounded-md border text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-tertiary mb-1">lifespan</label>
          <input name="lifespan" type="text" class="w-full px-3 py-2 rounded-md border text-sm" />
        </div>
      </section>
      <section class="grid grid-cols-3 gap-3">
        <div>
          <label class="block text-xs font-semibold text-tertiary mb-1">nationality</label>
          <input name="nationality" type="text" class="w-full px-3 py-2 rounded-md border text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-tertiary mb-1">flag</label>
          <input name="flag" type="text" class="w-full px-3 py-2 rounded-md border text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-tertiary mb-1">origin</label>
          <input name="origin" type="text" class="w-full px-3 py-2 rounded-md border text-sm" />
        </div>
      </section>
      <section class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-semibold text-tertiary mb-1">field</label>
          <input name="field" type="text" class="w-full px-3 py-2 rounded-md border text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-tertiary mb-1">accent (hex 可空)</label>
          <input name="accent" type="text" class="w-full px-3 py-2 rounded-md border text-sm" />
        </div>
      </section>
      <section>
        <label class="block text-xs font-semibold text-tertiary mb-1">institution</label>
        <input name="institution" type="text" class="w-full px-3 py-2 rounded-md border text-sm" />
      </section>

      <section>
        <label class="block text-xs font-semibold text-tertiary mb-1">contribution（中文） <span class="text-accent-warning">*</span></label>
        <textarea name="contribution_zh" required rows="6" class="w-full px-3 py-2 rounded-md border text-sm leading-relaxed"></textarea>
      </section>
      <section>
        <label class="block text-xs font-semibold text-tertiary mb-1">contribution（日本語）</label>
        <textarea name="contribution_ja" rows="6" class="w-full px-3 py-2 rounded-md border text-sm leading-relaxed"></textarea>
      </section>

      <section>
        <label class="block text-xs font-semibold text-tertiary mb-1">诺贝尔奖（可选）</label>
        <div class="grid grid-cols-3 gap-3">
          <input name="nobel_year" type="text" placeholder="年份（留空 = 无）" class="w-full px-3 py-2 rounded-md border text-sm" />
          <input name="nobel_detail" type="text" placeholder="授奖词" class="col-span-2 w-full px-3 py-2 rounded-md border text-sm" />
        </div>
      </section>

      <footer class="sticky bottom-0 bg-bg-primary py-3 border-t flex items-center gap-3">
        <button type="submit" id="save-btn" class="px-4 py-2 rounded-md bg-accent-strategy text-white text-sm font-semibold disabled:opacity-50">
          创建
        </button>
        <span id="save-status" class="text-xs text-tertiary"></span>
      </footer>
    </form>
  </main>
</Layout>

<script type="module" define:vars={{ discipline }}>
  const form = document.getElementById('scholar-new-form');
  const saveBtn = document.getElementById('save-btn');
  const saveStatus = document.getElementById('save-status');

  function buildI18n(zh, en, ja) {
    const o = { zh: zh.trim() };
    if (en?.trim()) o.en = en.trim();
    if (ja?.trim()) o.ja = ja.trim();
    return o;
  }
  function buildBody(zh, ja) {
    const o = { zh };
    if (ja?.trim()) o.ja = ja;
    return o;
  }
  function collect() {
    const now = new Date().toISOString();
    const schools = [...document.querySelectorAll('input[name=school]:checked')].map((c) => c.value);
    const nobelYear = form.nobel_year.value.trim();
    const nobel = nobelYear ? { year: nobelYear, detail: form.nobel_detail.value.trim() } : null;
    return {
      key: form.key.value.trim(),
      discipline,
      name: buildI18n(form.name_zh.value, form.name_en.value, form.name_ja.value),
      schools,
      contribution: buildBody(form.contribution_zh.value, form.contribution_ja.value),
      lifespan: form.lifespan.value.trim(),
      institution: form.institution.value.trim(),
      born: form.born.value.trim(),
      died: form.died.value.trim(),
      nationality: form.nationality.value.trim(),
      flag: form.flag.value.trim(),
      origin: form.origin.value.trim(),
      field: form.field.value.trim(),
      accent: form.accent.value.trim(),
      nobel,
      createdAt: now,
      updatedAt: now,
    };
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    saveBtn.disabled = true;
    saveStatus.textContent = '创建中...';
    const json = collect();
    const res = await fetch('/api/new/scholar', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ json }),
    });
    const data = await res.json().catch(() => ({}));
    if (res.ok) {
      saveStatus.innerHTML = `✓ commit <code>${data.commit_sha?.slice(0, 7)}</code>，跳转中...`;
      setTimeout(() => { location.href = `/${discipline}/scholars/${json.key}`; }, 1500);
    } else if (res.status === 409) {
      saveStatus.innerHTML = `<span style="color:#FF3B30">key 已存在</span>`;
      saveBtn.disabled = false;
    } else if (res.status === 422) {
      saveStatus.innerHTML = `<span style="color:#FF3B30">${JSON.stringify(data.detail).slice(0, 150)}</span>`;
      saveBtn.disabled = false;
    } else {
      saveStatus.innerHTML = `<span style="color:#FF3B30">${res.status} ${data.reason ?? 'error'}</span>`;
      saveBtn.disabled = false;
    }
  });
</script>
