---
import Layout from '~/layouts/Layout.astro';
import { getDb } from '~/lib/db';

const { discipline } = Astro.params;
if (!Astro.locals.isAdmin) return Astro.redirect(`/${discipline}/scholars`);

const db = getDb(Astro.locals.runtime.env);
const schoolsResult = await db
  .prepare('SELECT key, title_zh FROM school WHERE discipline = ? ORDER BY title_zh')
  .bind(discipline)
  .all<{ key: string; title_zh: string }>();
const allSchools = schoolsResult.results ?? [];

const ctxSchool = Astro.url.searchParams.get('school') ?? '';
---

<Layout title="新增学者" currentDiscipline={discipline} currentSection="scholars">
  <main class="max-w-reading mx-auto px-4 py-6">
    <header class="mb-4">
      <a href={`/${discipline}/scholars`} class="text-xs text-tertiary hover:underline">← 返回学者列表</a>
      <h1 class="text-2xl mt-2">新增学者</h1>
      <p class="text-xs text-quaternary mt-1">key 一旦提交不可改。命名建议英文姓氏小写，如 <code>lewin</code> / <code>kotter</code>。</p>
    </header>

    <form id="scholar-new-form" class="space-y-5" autocomplete="off" data-discipline={discipline}>
      <section>
        <label class="block text-xs font-semibold text-tertiary mb-1">key <span class="text-accent-warning">*</span></label>
        <input name="key" type="text" required pattern="[a-z][a-z0-9_]*" placeholder="lewin" class="w-64 px-3 py-2 rounded-md border text-sm font-mono" />
      </section>

      <section>
        <label class="block text-xs font-semibold text-tertiary mb-1">中文名 <span class="text-accent-warning">*</span></label>
        <input name="name_zh" type="text" required class="w-full px-3 py-2 rounded-md border text-sm" />
      </section>
      <section class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-semibold text-tertiary mb-1">English</label>
          <input name="name_en" type="text" class="w-full px-3 py-2 rounded-md border text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-tertiary mb-1">日本語</label>
          <input name="name_ja" type="text" class="w-full px-3 py-2 rounded-md border text-sm" />
        </div>
      </section>

      <section>
        <label class="block text-xs font-semibold text-tertiary mb-1">所属学派（可空 = 独立学者）</label>
        <div
          id="schools-multi"
          data-options={JSON.stringify(allSchools.map((s) => ({ key: s.key, label: s.title_zh })))}
          data-preselect={ctxSchool}
        ></div>
      </section>

      <section class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-semibold text-tertiary mb-1">出生年 <span class="text-accent-warning">*</span></label>
          <input name="born" type="text" required placeholder="1890年9月9日" class="w-full px-3 py-2 rounded-md border text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-tertiary mb-1">卒年</label>
          <input name="died" type="text" placeholder="（在世为空）" class="w-full px-3 py-2 rounded-md border text-sm" />
        </div>
      </section>
      <section class="grid grid-cols-3 gap-3">
        <div>
          <label class="block text-xs font-semibold text-tertiary mb-1">国籍</label>
          <input name="nationality" type="text" placeholder="德国/美国" class="w-full px-3 py-2 rounded-md border text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-tertiary mb-1">国旗</label>
          <input name="flag" type="text" placeholder="🇩🇪 🇺🇸" class="w-full px-3 py-2 rounded-md border text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-tertiary mb-1">研究领域 badge</label>
          <input name="field" type="text" placeholder="社会心理学 · 组织变革" class="w-full px-3 py-2 rounded-md border text-sm" />
        </div>
      </section>
      <section>
        <label class="block text-xs font-semibold text-tertiary mb-1">代表机构</label>
        <input name="institution" type="text" placeholder="Harvard Business School" class="w-full px-3 py-2 rounded-md border text-sm" />
      </section>

      <section>
        <div class="flex items-center gap-2 mb-1">
          <label class="text-xs font-semibold text-tertiary">contribution <span class="text-accent-warning">*</span></label>
          <div role="tablist" class="inline-flex border rounded overflow-hidden text-xs">
            <button type="button" data-lang-tab="zh" data-active class="px-2.5 py-0.5 hover:bg-bg-tertiary data-[active]:bg-accent-strategy data-[active]:text-white">中</button>
            <button type="button" data-lang-tab="ja" class="px-2.5 py-0.5 border-l hover:bg-bg-tertiary data-[active]:bg-accent-strategy data-[active]:text-white">日</button>
          </div>
        </div>
        <div data-lang-pane="zh">
          <textarea name="contribution_zh" required rows="8" class="w-full px-3 py-2 rounded-md border text-sm leading-relaxed"></textarea>
        </div>
        <div data-lang-pane="ja" class="hidden">
          <textarea name="contribution_ja" rows="8" class="w-full px-3 py-2 rounded-md border text-sm leading-relaxed"></textarea>
        </div>
      </section>

      <section>
        <label class="block text-xs font-semibold text-tertiary mb-1">诺贝尔奖（可选）</label>
        <div class="grid grid-cols-3 gap-3">
          <input name="nobel_year" type="text" placeholder="年份（留空 = 无）" class="w-full px-3 py-2 rounded-md border text-sm" />
          <input name="nobel_detail" type="text" placeholder="授奖词" class="col-span-2 w-full px-3 py-2 rounded-md border text-sm" />
        </div>
      </section>

      <footer class="sticky bottom-0 bg-bg-primary py-3 border-t flex items-center gap-3">
        <button type="submit" id="save-btn" class="px-4 py-2 rounded-md bg-accent-strategy text-white text-sm font-semibold disabled:opacity-50">
          创建
        </button>
        <span id="save-status" class="text-xs text-tertiary"></span>
      </footer>
    </form>
  </main>
</Layout>

<script>
  // v0.4.11: multi-select typeahead for schools
  import { mountMultiSelect } from '~/lib/multi-select-client';
  const form = document.getElementById('scholar-new-form');
  const saveBtn = document.getElementById('save-btn');
  const saveStatus = document.getElementById('save-status');
  const discipline = form.dataset.discipline;

  const schoolsMount = document.getElementById('schools-multi');
  const schoolsMS = mountMultiSelect(schoolsMount, {
    inputName: 'school',
    options: JSON.parse(schoolsMount.dataset.options ?? '[]'),
    selected: schoolsMount.dataset.preselect ? [schoolsMount.dataset.preselect] : [],
    placeholder: '搜索学派（可空 = 独立学者）',
  });

  function buildI18n(zh, en, ja) {
    const o = { zh: zh.trim() };
    if (en?.trim()) o.en = en.trim();
    if (ja?.trim()) o.ja = ja.trim();
    return o;
  }
  function buildBody(zh, ja) {
    const o = { zh };
    if (ja?.trim()) o.ja = ja;
    return o;
  }
  function collect() {
    const now = new Date().toISOString();
    const schools = schoolsMS.getSelected();
    const nobelYear = form.nobel_year.value.trim();
    const nobel = nobelYear ? { year: nobelYear, detail: form.nobel_detail.value.trim() } : null;
    return {
      key: form.key.value.trim(),
      discipline,
      name: buildI18n(form.name_zh.value, form.name_en.value, form.name_ja.value),
      schools,
      contribution: buildBody(form.contribution_zh.value, form.contribution_ja.value),
      // lifespan/origin/accent UI 移除（v0.4.19）— schema 字段保留，新建时填空，sync 时 accent 由学派派生
      lifespan: '',
      origin: '',
      accent: '',
      institution: form.institution.value.trim(),
      born: form.born.value.trim(),
      died: form.died.value.trim(),
      nationality: form.nationality.value.trim(),
      flag: form.flag.value.trim(),
      field: form.field.value.trim(),
      nobel,
      createdAt: now,
      updatedAt: now,
    };
  }

  document.querySelectorAll('[data-lang-tab]').forEach((b) => {
    b.addEventListener('click', () => {
      document.querySelectorAll('[data-lang-tab]').forEach((x) => x.toggleAttribute('data-active', x.dataset.langTab === b.dataset.langTab));
      document.querySelectorAll('[data-lang-pane]').forEach((p) => p.classList.toggle('hidden', p.dataset.langPane !== b.dataset.langTab));
    });
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    saveBtn.disabled = true;
    saveStatus.textContent = '创建中...';
    const json = collect();
    const res = await fetch('/api/new/scholar', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ json }),
    });
    const data = await res.json().catch(() => ({}));
    if (res.ok) {
      saveStatus.innerHTML = `✓ commit <code>${data.commit_sha?.slice(0, 7)}</code>，跳转中...`;
      setTimeout(() => { location.href = `/${discipline}/scholars/${json.key}`; }, 1500);
    } else if (res.status === 409) {
      saveStatus.innerHTML = `<span style="color:#FF3B30">key 已存在</span>`;
      saveBtn.disabled = false;
    } else if (res.status === 422) {
      saveStatus.innerHTML = `<span style="color:#FF3B30">${JSON.stringify(data.detail).slice(0, 150)}</span>`;
      saveBtn.disabled = false;
    } else {
      saveStatus.innerHTML = `<span style="color:#FF3B30">${res.status} ${data.reason ?? 'error'}</span>`;
      saveBtn.disabled = false;
    }
  });
</script>
