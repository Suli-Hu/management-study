---
/**
 * 新增学者页 v0.8 Stage 4.5 — 整页重写
 *
 * 见 v2/docs/SCHOOL-SCHOLAR-THEME-EDITOR-V0.8-PRD.md
 */
import Layout from '~/layouts/Layout.astro';
import { getDb } from '~/lib/db';
import type { ScholarEditorMetadata } from '~/lib/editor/scholar-state';

const { discipline } = Astro.params;
if (!discipline) return Astro.redirect('/404');
if (!Astro.locals.canEdit(discipline)) return Astro.redirect(`/${discipline}/scholars`);

const db = getDb(Astro.locals.runtime.env);
const discRow = await db
  .prepare('SELECT title_zh, tags_json FROM discipline WHERE key = ?')
  .bind(discipline)
  .first<{ title_zh: string; tags_json: string }>();
if (!discRow) return Astro.redirect('/404');

const tagLibrary: Array<{ key: string; label?: { zh?: string }; color?: string }> = discRow.tags_json
  ? JSON.parse(discRow.tags_json)
  : [];

const editorMetadata: ScholarEditorMetadata = {
  tags: tagLibrary.map((t) => ({
    key: t.key,
    label: t.label?.zh ?? t.key,
    color: t.color ?? null,
  })),
  disciplineLabel: discRow.title_zh,
  disciplineKey: discipline,
  fromPath: `/${discipline}/scholars`,
  fromLabel: '学者列表',
};
---

<Layout title={`新增学者 · ${discRow.title_zh}`} currentDiscipline={discipline} currentSection="scholars">
  <div class="kp-editor-v08" id="scholar-editor-root" data-mode="new"></div>

  <script
    type="application/json"
    is:inline
    id="scholar-editor-init"
    set:html={JSON.stringify({ metadata: editorMetadata })}
  ></script>
</Layout>

<script>
  import { makeNewScholarState, type ScholarEditorMetadata } from '~/lib/editor/scholar-state';
  import { initScholarEditor } from '~/lib/editor/scholar-form';

  const root = document.getElementById('scholar-editor-root');
  const initJson = document.getElementById('scholar-editor-init')?.textContent;
  if (!root || !initJson) {
    console.error('[scholar-editor] init payload missing');
  } else {
    const { metadata } = JSON.parse(initJson) as {
      metadata: ScholarEditorMetadata;
    };
    const initialState = makeNewScholarState(metadata.disciplineKey);
    initScholarEditor({
      root: root as HTMLElement,
      initialState,
      metadata,
      mode: 'new',
    });
  }
</script>
