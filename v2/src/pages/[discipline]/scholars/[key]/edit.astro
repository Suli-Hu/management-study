---
/**
 * 学者编辑页 v0.8 Stage 4.5 — 整页重写（4 section）
 *
 * 见 v2/docs/SCHOOL-SCHOLAR-THEME-EDITOR-V0.8-PRD.md §5.2 + §6.3
 */
import Layout from '~/layouts/Layout.astro';
import { getDb } from '~/lib/db';
import { parseFrom, fromLabel } from '~/lib/nav';
import { getScholarRecord } from '~/lib/scholar-api-store';
import type { ExistingScholarInit, ScholarEditorMetadata } from '~/lib/editor/scholar-state';

const { discipline, key } = Astro.params;
if (!discipline || !key) return Astro.redirect('/404');
if (!Astro.locals.canEdit(discipline)) return Astro.redirect(`/${discipline}/scholars/${key}`);

const fromPath = parseFrom(Astro.url.searchParams.get('from'), `/${discipline}/scholars/${key}`);
const fromLbl = fromLabel(fromPath);

const db = getDb(Astro.locals.runtime.env);
const tenantRow = await db
  .prepare('SELECT id FROM tenant WHERE discipline_key = ? OR id = ?')
  .bind(discipline, discipline)
  .first<{ id: string }>();
if (!tenantRow) return Astro.redirect('/404');

const record = await getScholarRecord(db, key, { tenantId: tenantRow.id, discipline });
if (!record) return Astro.redirect('/404');

const discRow = await db
  .prepare('SELECT title_zh, tags_json FROM discipline WHERE key = ?')
  .bind(discipline)
  .first<{ title_zh: string; tags_json: string }>();
const tagLibrary: Array<{ key: string; label?: { zh?: string }; color?: string }> = discRow?.tags_json
  ? JSON.parse(discRow.tags_json)
  : [];

const schoolsResult = await db
  .prepare('SELECT key, title_zh FROM school WHERE discipline = ? ORDER BY title_zh ASC, key ASC')
  .bind(discipline)
  .all<{ key: string; title_zh: string }>();
const allSchools = (schoolsResult.results ?? []).map((s) => ({ key: s.key, label: s.title_zh }));

const initialState: ExistingScholarInit = {
  key: record.key,
  discipline,
  name: record.name,
  schools: record.schools,
  contribution: record.contribution,
  institution: record.institution,
  born: record.born,
  died: record.died,
  nationality: record.nationality,
  flag: record.flag,
  origin: record.origin,
  field: record.field,
  tags: record.tags,
  nobel: record.nobel,
};

const editorMetadata: ScholarEditorMetadata = {
  schools: allSchools,
  tags: tagLibrary.map((t) => ({
    key: t.key,
    label: t.label?.zh ?? t.key,
    color: t.color ?? null,
  })),
  disciplineLabel: discRow?.title_zh ?? discipline,
  disciplineKey: discipline,
  fromPath,
  fromLabel: fromLbl,
};
---

<Layout title={`编辑 · ${record.name.zh}`} currentDiscipline={discipline} currentSection="scholars">
  <div class="kp-editor-v08" id="scholar-editor-root" data-mode="edit"></div>

  <script type="application/json" is:inline id="scholar-editor-init" set:html={JSON.stringify({ initialState, metadata: editorMetadata })}></script>
</Layout>

<script>
  import { makeEditingScholarState, type ExistingScholarInit, type ScholarEditorMetadata } from '~/lib/editor/scholar-state';
  import { initScholarEditor } from '~/lib/editor/scholar-form';

  const root = document.getElementById('scholar-editor-root');
  const initJson = document.getElementById('scholar-editor-init')?.textContent;
  if (!root || !initJson) {
    console.error('[scholar-editor] init payload missing');
  } else {
    const { initialState, metadata } = JSON.parse(initJson) as {
      initialState: ExistingScholarInit;
      metadata: ScholarEditorMetadata;
    };
    initScholarEditor({
      root: root as HTMLElement,
      initialState: makeEditingScholarState(initialState),
      metadata,
      mode: 'edit',
    });
  }
</script>
