---
import Layout from '~/layouts/Layout.astro';
import { getDb } from '~/lib/db';

const { discipline, key } = Astro.params;

if (!Astro.locals.isAdmin) return Astro.redirect(`/${discipline}/scholars/${key}`);

const db = getDb(Astro.locals.runtime.env);
const exists = await db
  .prepare('SELECT key, name_zh FROM scholar WHERE key = ? AND discipline = ?')
  .bind(key, discipline)
  .first<{ key: string; name_zh: string }>();
if (!exists) return Astro.redirect('/404');

const schoolsResult = await db
  .prepare('SELECT key, title_zh FROM school WHERE discipline = ? ORDER BY title_zh')
  .bind(discipline)
  .all<{ key: string; title_zh: string }>();
const allSchools = schoolsResult.results ?? [];
---

<Layout title={`编辑 · ${exists.name_zh}`} currentDiscipline={discipline} currentSection="scholars">
  <main class="max-w-reading mx-auto px-4 py-6">
    <header class="mb-4">
      <a href={`/${discipline}/scholars/${key}`} class="text-xs text-tertiary hover:underline">← 返回 {exists.name_zh}</a>
      <h1 class="text-2xl mt-2">编辑学者 <code class="text-base text-tertiary">{key}</code></h1>
      <p class="text-xs text-quaternary mt-1">key/discipline 不可改。schools[] 决定属于哪些学派。</p>
    </header>

    <div id="status" class="hidden mb-4 p-3 rounded-md text-xs"></div>

    <form id="scholar-edit-form" class="space-y-5 hidden" autocomplete="off">
      <section>
        <label class="block text-xs font-semibold text-tertiary mb-1">中文名</label>
        <input name="name_zh" type="text" required class="w-full px-3 py-2 rounded-md border text-sm" />
      </section>
      <section class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-semibold text-tertiary mb-1">English</label>
          <input name="name_en" type="text" class="w-full px-3 py-2 rounded-md border text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-tertiary mb-1">日本語</label>
          <input name="name_ja" type="text" class="w-full px-3 py-2 rounded-md border text-sm" />
        </div>
      </section>

      <section>
        <label class="block text-xs font-semibold text-tertiary mb-1">所属学派 schools[]</label>
        <div class="flex flex-wrap gap-1 max-h-40 overflow-y-auto p-1 border rounded">
          {allSchools.map((s) => (
            <label class="inline-flex items-center gap-1 px-2 py-1 rounded border text-xs cursor-pointer hover:bg-bg-tertiary">
              <input type="checkbox" name="school" value={s.key} class="w-3 h-3" />
              <span>{s.title_zh}</span>
            </label>
          ))}
        </div>
      </section>

      <section class="grid grid-cols-3 gap-3">
        <div>
          <label class="block text-xs font-semibold text-tertiary mb-1">born</label>
          <input name="born" type="text" placeholder="1890年9月9日" class="w-full px-3 py-2 rounded-md border text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-tertiary mb-1">died</label>
          <input name="died" type="text" placeholder="（在世为空）" class="w-full px-3 py-2 rounded-md border text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-tertiary mb-1">lifespan（兜底）</label>
          <input name="lifespan" type="text" placeholder="1890–1976" class="w-full px-3 py-2 rounded-md border text-sm" />
        </div>
      </section>

      <section class="grid grid-cols-3 gap-3">
        <div>
          <label class="block text-xs font-semibold text-tertiary mb-1">nationality</label>
          <input name="nationality" type="text" placeholder="德国/美国" class="w-full px-3 py-2 rounded-md border text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-tertiary mb-1">flag</label>
          <input name="flag" type="text" placeholder="🇩🇪 🇺🇸" class="w-full px-3 py-2 rounded-md border text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-tertiary mb-1">origin</label>
          <input name="origin" type="text" placeholder="出身/籍贯" class="w-full px-3 py-2 rounded-md border text-sm" />
        </div>
      </section>

      <section class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-semibold text-tertiary mb-1">field（badge）</label>
          <input name="field" type="text" placeholder="社会心理学 · 组织变革" class="w-full px-3 py-2 rounded-md border text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-tertiary mb-1">accent（hex 可空）</label>
          <input name="accent" type="text" placeholder="#FF9500" class="w-full px-3 py-2 rounded-md border text-sm" />
        </div>
      </section>

      <section>
        <label class="block text-xs font-semibold text-tertiary mb-1">institution</label>
        <input name="institution" type="text" placeholder="Harvard Business School" class="w-full px-3 py-2 rounded-md border text-sm" />
      </section>

      <section>
        <label class="block text-xs font-semibold text-tertiary mb-1">contribution（中文）</label>
        <textarea name="contribution_zh" required rows="8" class="w-full px-3 py-2 rounded-md border text-sm leading-relaxed"></textarea>
      </section>
      <section>
        <label class="block text-xs font-semibold text-tertiary mb-1">contribution（日本語）</label>
        <textarea name="contribution_ja" rows="8" class="w-full px-3 py-2 rounded-md border text-sm leading-relaxed"></textarea>
      </section>

      <section>
        <label class="block text-xs font-semibold text-tertiary mb-1">诺贝尔奖（可选）</label>
        <div class="grid grid-cols-3 gap-3">
          <input name="nobel_year" type="text" placeholder="年份（留空 = 无）" class="w-full px-3 py-2 rounded-md border text-sm" />
          <input name="nobel_detail" type="text" placeholder="授奖词" class="col-span-2 w-full px-3 py-2 rounded-md border text-sm" />
        </div>
      </section>

      <footer class="sticky bottom-0 bg-bg-primary py-3 border-t flex items-center gap-3">
        <button type="submit" id="save-btn" class="px-4 py-2 rounded-md bg-accent-strategy text-white text-sm font-semibold disabled:opacity-50">
          保存（commit + 部署）
        </button>
        <button type="button" id="delete-btn" class="px-4 py-2 rounded-md bg-bg-primary border border-accent-warning text-accent-warning text-sm font-semibold ml-auto">
          硬删此学者
        </button>
        <span id="save-status" class="text-xs text-tertiary"></span>
      </footer>
    </form>
  </main>
</Layout>

<script type="module" define:vars={{ scholarKey: key, discipline }}>
  const $ = (s) => document.querySelector(s);
  const status = $('#status');
  const form = $('#scholar-edit-form');
  const saveBtn = $('#save-btn');
  const deleteBtn = $('#delete-btn');
  const saveStatus = $('#save-status');
  let baseSha = null;
  let originalCreatedAt = null;

  function setStatus(msg, kind = 'info') {
    status.textContent = msg;
    status.className = `mb-4 p-3 rounded-md text-xs ${
      kind === 'error' ? 'bg-badge-limit text-accent-warning' :
      kind === 'success' ? 'bg-badge-meaning' : 'bg-bg-secondary text-tertiary'
    }`;
    status.classList.remove('hidden');
  }

  async function load() {
    setStatus('加载中...');
    const res = await fetch(`/api/edit/scholar/${scholarKey}`);
    if (!res.ok) {
      const err = await res.json().catch(() => ({}));
      setStatus(`加载失败：${res.status} ${err.reason ?? ''}`, 'error');
      return;
    }
    const { json: s, base_sha } = await res.json();
    baseSha = base_sha;
    originalCreatedAt = s.createdAt;
    form.name_zh.value = s.name?.zh ?? '';
    form.name_en.value = s.name?.en ?? '';
    form.name_ja.value = s.name?.ja ?? '';
    form.born.value = s.born ?? '';
    form.died.value = s.died ?? '';
    form.lifespan.value = s.lifespan ?? '';
    form.nationality.value = s.nationality ?? '';
    form.flag.value = s.flag ?? '';
    form.origin.value = s.origin ?? '';
    form.field.value = s.field ?? '';
    form.accent.value = s.accent ?? '';
    form.institution.value = s.institution ?? '';
    form.contribution_zh.value = s.contribution?.zh ?? '';
    form.contribution_ja.value = s.contribution?.ja ?? '';
    form.nobel_year.value = s.nobel?.year ?? '';
    form.nobel_detail.value = s.nobel?.detail ?? '';
    document.querySelectorAll('input[name=school]').forEach((cb) => {
      cb.checked = (s.schools ?? []).includes(cb.value);
    });
    form.classList.remove('hidden');
    status.classList.add('hidden');
  }

  function collect() {
    const schools = [...document.querySelectorAll('input[name=school]:checked')].map((c) => c.value);
    const nobelYear = form.nobel_year.value.trim();
    const nobel = nobelYear ? { year: nobelYear, detail: form.nobel_detail.value.trim() } : null;
    return {
      key: scholarKey,
      discipline,
      name: { zh: form.name_zh.value.trim(), en: form.name_en.value.trim(), ja: form.name_ja.value.trim() },
      schools,
      contribution: { zh: form.contribution_zh.value, ja: form.contribution_ja.value },
      lifespan: form.lifespan.value.trim(),
      institution: form.institution.value.trim(),
      born: form.born.value.trim(),
      died: form.died.value.trim(),
      nationality: form.nationality.value.trim(),
      flag: form.flag.value.trim(),
      origin: form.origin.value.trim(),
      field: form.field.value.trim(),
      accent: form.accent.value.trim(),
      nobel,
      createdAt: originalCreatedAt,
      updatedAt: new Date().toISOString(),
    };
  }

  async function save(e) {
    e.preventDefault();
    saveBtn.disabled = true;
    saveStatus.textContent = '保存中...';
    const res = await fetch(`/api/edit/scholar/${scholarKey}`, {
      method: 'PUT',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ json: collect(), base_sha: baseSha }),
    });
    const data = await res.json().catch(() => ({}));
    if (res.ok) {
      saveStatus.innerHTML = `✓ commit <code>${data.commit_sha?.slice(0, 7)}</code>，~${data.deploy_eta_seconds}s`;
      baseSha = data.new_blob_sha;
    } else if (res.status === 409) {
      saveStatus.innerHTML = `<span style="color:#FF3B30">冲突：current=${data.current_sha?.slice(0, 7)}，请刷新</span>`;
    } else if (res.status === 422) {
      saveStatus.innerHTML = `<span style="color:#FF3B30">schema 错：${JSON.stringify(data.detail).slice(0, 120)}</span>`;
    } else {
      saveStatus.innerHTML = `<span style="color:#FF3B30">${res.status} ${data.reason ?? 'error'}: ${String(data.detail).slice(0, 80)}</span>`;
    }
    saveBtn.disabled = false;
  }

  async function del() {
    if (!confirm(`确认硬删除学者「${scholarKey}」？\n\n• 进 git history 可 revert\n• 关联 KP 仍保留 scholars 字段中的 key（需各自处理）\n• ~90s 后线上消失`)) return;
    deleteBtn.disabled = true;
    const res = await fetch(`/api/edit/scholar/${scholarKey}`, {
      method: 'DELETE',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ base_sha: baseSha }),
    });
    const data = await res.json().catch(() => ({}));
    if (res.ok) {
      alert(`✓ 已删除 scholar/${scholarKey}\ncommit ${data.commit_sha?.slice(0, 7)}`);
      location.href = `/${discipline}/scholars`;
    } else {
      alert(`删除失败：${res.status} ${data.reason}`);
      deleteBtn.disabled = false;
    }
  }

  form.addEventListener('submit', save);
  deleteBtn.addEventListener('click', del);
  load();
</script>
