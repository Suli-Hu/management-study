---
import Layout from '~/layouts/Layout.astro';
import { getDb } from '~/lib/db';
import { renderBody } from '~/lib/render-body';

const { discipline, key } = Astro.params;
const db = getDb(Astro.locals.runtime.env);

const disc = await db
  .prepare('SELECT key, title_zh FROM discipline WHERE key = ?')
  .bind(discipline)
  .first<{ key: string; title_zh: string }>();
if (!disc) return Astro.redirect('/404');

const scholar = await db
  .prepare(`
    SELECT key, discipline, name_zh, name_en, name_ja,
      contribution_zh, contribution_ja,
      lifespan, institution,
      born, died, nationality, flag, origin, field, accent,
      nobel_year, nobel_detail
    FROM scholar
    WHERE key = ? AND discipline = ?
  `)
  .bind(key, discipline)
  .first<{
    key: string; discipline: string; name_zh: string; name_en: string | null; name_ja: string | null;
    contribution_zh: string; contribution_ja: string | null;
    lifespan: string; institution: string;
    born: string | null; died: string | null; nationality: string | null; flag: string | null;
    origin: string | null; field: string | null; accent: string | null;
    nobel_year: string | null; nobel_detail: string | null;
  }>();

if (!scholar) return Astro.redirect('/404');

// 关联学派
const schoolsResult = await db
  .prepare(`
    SELECT s.key, s.title_zh, s.accent, s.theme_key
    FROM school s
    INNER JOIN scholar_school ss ON ss.school_key = s.key
    WHERE ss.scholar_key = ?
    ORDER BY ss.position, s.key
  `)
  .bind(key)
  .all<{ key: string; title_zh: string; accent: string; theme_key: string }>();
const schools = schoolsResult.results ?? [];

// Accent 色：scholar.accent > 主 school.accent > fallback
const ACCENT_MAP: Record<string, string> = {
  ob: '#34C759',
  classic: '#FF9500',
  strategy: '#007AFF',
  warning: '#FF3B30',
};
const scholarAccentHex = (scholar.accent && scholar.accent.startsWith('#'))
  ? scholar.accent
  : (ACCENT_MAP[schools[0]?.accent ?? 'classic'] ?? '#8a7a6a');

// 代表理论
const kpsResult = await db
  .prepare(`
    SELECT k.id, k.title_zh, k.title_en, k.title_ja, k.year
    FROM kp k
    INNER JOIN kp_scholar ks ON ks.kp_id = k.id
    WHERE ks.scholar_key = ?
    ORDER BY
      CASE WHEN k.year = '' OR k.year IS NULL THEN 1 ELSE 0 END,
      k.year, k.id
  `)
  .bind(key)
  .all<{ id: string; title_zh: string; title_en: string | null; title_ja: string | null; year: string }>();
const kps = kpsResult.results ?? [];

// Split-pane ?kp=X —— 未指定时默认选中第一个 KP（v0.3.13）
const requestedKpId = Astro.url.searchParams.get('kp');
const selectedKpId = requestedKpId ?? kps[0]?.id ?? null;
let selectedKp: {
  id: string; title_zh: string; title_en: string | null; title_ja: string | null;
  year: string; body_zh: string; body_ja: string | null; tags_json: string;
} | null = null;
let selectedScholars: Array<{ key: string; name_zh: string; name_en: string | null }> = [];
let selectedTags: string[] = [];
if (selectedKpId) {
  const kpRow = await db
    .prepare('SELECT id, title_zh, title_en, title_ja, year, body_zh, body_ja, tags_json FROM kp WHERE id = ? AND discipline = ?')
    .bind(selectedKpId, discipline)
    .first<typeof selectedKp>();
  selectedKp = kpRow ?? null;
  if (selectedKp) {
    selectedTags = JSON.parse(selectedKp.tags_json) as string[];
    const scRes = await db
      .prepare(`
        SELECT sc.key, sc.name_zh, sc.name_en
        FROM scholar sc INNER JOIN kp_scholar ks ON ks.scholar_key = sc.key
        WHERE ks.kp_id = ? ORDER BY ks.position
      `)
      .bind(selectedKpId)
      .all<{ key: string; name_zh: string; name_en: string | null }>();
    selectedScholars = scRes.results ?? [];
  }
}

const lang = (Astro.url.searchParams.get('lang') === 'ja' && scholar.contribution_ja) ? 'ja' : 'zh';
const displayName = lang === 'ja' ? (scholar.name_ja ?? scholar.name_zh) : scholar.name_zh;
const contribution = lang === 'ja' ? scholar.contribution_ja! : scholar.contribution_zh;
const lifespanDisplay = (scholar.born && scholar.died)
  ? `${scholar.born} — ${scholar.died}`
  : (scholar.born || scholar.died || scholar.lifespan || '');
---

<Layout
  title={scholar.name_en ?? scholar.name_zh}
  currentDiscipline={discipline}
  currentSection="scholars"
  fullHeight
>
  {/* 整个 main = 视口剩余高度；左右两栏独立滚动（与 v1 view-detail 一致） */}
  <main
    class="h-full lg:h-full lg:grid lg:grid-cols-[minmax(440px,520px)_1fr]"
    style={`--accent:${scholarAccentHex}`}
    data-active-ring="ring-[color:var(--accent)]"
  >
    {/* 左栏：学者信息 + 代表理论 */}
    <aside class="lg:h-full lg:overflow-y-auto lg:border-r px-4 py-6">
      {/* Scholar hero with accent bar */}
      <section class="flex rounded-xl overflow-hidden border bg-bg-primary shadow-card mb-5">
        <div class="w-1.5 shrink-0" style={`background:${scholarAccentHex}`}></div>
        <div class="flex-1 p-5 flex items-start gap-3">
          <div class="flex-1 min-w-0">
            {scholar.field && (
              <div
                class="inline-block text-xs font-semibold px-2.5 py-0.5 rounded-full border mb-2"
                style={`color:${scholarAccentHex};border-color:${scholarAccentHex};background:${scholarAccentHex}14`}
              >
                {scholar.field}
              </div>
            )}
            <h1 class="text-xl font-semibold leading-tight">{displayName}</h1>
            {scholar.name_en && <div class="text-xs text-tertiary mt-1">{scholar.name_en}</div>}
            {scholar.name_ja && lang === 'zh' && <div class="text-xs text-quaternary mt-0.5">{scholar.name_ja}</div>}
          </div>
          <div class="shrink-0 -mr-1 -mt-1 flex items-center gap-0.5">
            {Astro.locals.isAdmin && (
              <a
                href={`/${discipline}/scholars/${scholar.key}/edit`}
                class="hidden lg:inline-flex w-9 h-9 rounded-full items-center justify-center text-base text-quaternary hover:text-accent-strategy hover:bg-bg-tertiary transition-colors"
                aria-label="编辑此学者"
                title="编辑此学者"
              >
                ✎
              </a>
            )}
            <button
              id="scholar-star-toggle"
              type="button"
              data-scholar-key={scholar.key}
              aria-label="收藏学者"
              aria-pressed="false"
              class="scholar-star w-9 h-9 rounded-full flex items-center justify-center text-xl leading-none text-quaternary hover:bg-bg-tertiary transition-colors"
            >
              <span aria-hidden="true">☆</span>
            </button>
          </div>
        </div>
      </section>

      {/* 基本信息（完整对齐 v1：生卒年 / 国籍 / 出身 / 获奖 / 任职） */}
      <section class="mb-5">
        <h2 class="text-xs font-semibold text-tertiary mb-2">基本信息</h2>
        <table class="w-full text-xs">
          <tbody>
            {lifespanDisplay && (
              <tr class="border-b">
                <td class="py-2 text-quaternary w-20 align-top">生卒年</td>
                <td class="py-2 text-secondary">{lifespanDisplay}</td>
              </tr>
            )}
            {(scholar.nationality || scholar.flag) && (
              <tr class="border-b">
                <td class="py-2 text-quaternary align-top">国籍</td>
                <td class="py-2 text-secondary">
                  {scholar.flag && <span class="mr-1">{scholar.flag}</span>}
                  {scholar.nationality}
                </td>
              </tr>
            )}
            {scholar.origin && (
              <tr class="border-b">
                <td class="py-2 text-quaternary align-top">出身/籍贯</td>
                <td class="py-2 text-secondary">{scholar.origin}</td>
              </tr>
            )}
            {scholar.nobel_year && (
              <tr class="border-b">
                <td class="py-2 text-quaternary align-top">获奖</td>
                <td class="py-2 font-semibold" style="color:#b07d20">🏅 {scholar.nobel_year}</td>
              </tr>
            )}
            {scholar.institution && (
              <tr class="border-b">
                <td class="py-2 text-quaternary align-top">主要任职</td>
                <td class="py-2 text-secondary leading-relaxed">{scholar.institution}</td>
              </tr>
            )}
            {schools.length > 0 && (
              <tr>
                <td class="py-2 text-quaternary align-top">所属学派</td>
                <td class="py-2">
                  <div class="flex flex-wrap gap-1">
                    {schools.map((s) => (
                      <a href={`/${discipline}/${s.key}`} class="chip border-quaternary text-xs">{s.title_zh}</a>
                    ))}
                  </div>
                </td>
              </tr>
            )}
          </tbody>
        </table>
      </section>

      {/* 代表理论 */}
      <section>
        <h2 class="text-xs font-semibold text-tertiary mb-3 flex items-center gap-2">
          代表理论 ({kps.length})
          {Astro.locals.isAdmin && (
            <a
              href={`/${discipline}/kp/new?scholar=${scholar.key}`}
              class="inline-flex items-center px-2 py-0.5 rounded-full border border-accent-strategy text-accent-strategy text-xs no-underline hover:bg-accent-strategy hover:text-white transition-colors"
              title="新增 KP 并预选此学者"
            >
              + 新增
            </a>
          )}
        </h2>
        {kps.length > 0 ? (
          <ul class="space-y-2">
            {kps.map((k) => {
              const isActive = selectedKpId === k.id;
              return (
                <li data-kp-id={k.id} class:list={['kp-list-item group relative', isActive && 'is-active']}>
                  <a
                    href={`/${discipline}/kp/${k.id}`}
                    data-kp-link
                    data-kp-wide-href={`?kp=${k.id}`}
                    class:list={[
                      'block p-3 rounded border bg-bg-primary hover:shadow-card transition-shadow',
                      isActive && 'ring-2',
                    ]}
                    style={isActive ? `--tw-ring-color:${scholarAccentHex};border-color:${scholarAccentHex};background:${scholarAccentHex}14` : ''}
                  >
                    <h3 class="text-sm font-semibold text-primary">{k.title_zh}</h3>
                    {k.title_ja && <div class="text-xs text-tertiary mt-0.5">{k.title_ja}</div>}
                    {k.title_en && <div class="text-xs text-quaternary italic mt-0.5">{k.title_en}</div>}
                    {k.year && <div class="text-xs text-quaternary mt-0.5">{k.year}</div>}
                  </a>
                  {Astro.locals.isAdmin && (
                    <div class="kp-admin-tools hidden lg:flex absolute top-2 right-2 gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
                      <a
                        href={`/${discipline}/kp/${k.id}/edit`}
                        class="w-6 h-6 rounded bg-bg-primary border flex items-center justify-center text-xs text-tertiary hover:text-accent-strategy hover:border-accent-strategy"
                        aria-label={`编辑 ${k.title_zh}`}
                        title="编辑"
                        onclick="event.stopPropagation()"
                      >
                        ✎
                      </a>
                      <button
                        type="button"
                        data-kp-delete
                        data-kp-id={k.id}
                        data-kp-title={k.title_zh}
                        class="w-6 h-6 rounded bg-bg-primary border flex items-center justify-center text-xs text-tertiary hover:text-accent-warning hover:border-accent-warning"
                        aria-label={`删除 ${k.title_zh}`}
                        title="删除（硬删，进 git history）"
                      >
                        ✗
                      </button>
                    </div>
                  )}
                </li>
              );
            })}
          </ul>
        ) : (
          <p class="text-xs text-quaternary">暂无关联知识点。</p>
        )}
      </section>

      {contribution && (
        <section class="mt-6 pt-6 border-t">
          <h2 class="text-xs font-semibold text-tertiary mb-2">
            学术贡献
            {scholar.contribution_ja && (
              <a
                href={lang === 'zh' ? `?lang=ja${selectedKpId ? `&kp=${selectedKpId}` : ''}` : Astro.url.pathname + (selectedKpId ? `?kp=${selectedKpId}` : '')}
                class="ml-2 text-xs text-accent-strategy"
              >
                {lang === 'zh' ? '日本語' : '中文'}
              </a>
            )}
          </h2>
          <article class="text-xs text-secondary leading-relaxed whitespace-pre-line" set:html={contribution} />
        </section>
      )}

      {scholar.nobel_detail && (
        <section class="mt-6 p-4 rounded-md bg-bg-warm text-xs text-secondary leading-relaxed">
          <div class="font-semibold mb-1" style="color:#b07d20">🏅 诺贝尔奖授奖词</div>
          <div class="whitespace-pre-line">{scholar.nobel_detail}</div>
        </section>
      )}
    </aside>

    {/* 右栏：KP 详情（窄屏隐藏；宽屏独占剩余空间并自滚动） */}
    <article
      class="kp-detail-pane hidden lg:block lg:h-full lg:overflow-y-auto px-4 py-6"
      id="kp-detail-pane"
    >
      {selectedKp ? (
        <div class="max-w-reading mx-auto">
          <header class="mb-6 pb-4 border-b">
            <h2 class="text-xl font-semibold">{selectedKp.title_zh}</h2>
            <div class="flex flex-wrap items-baseline gap-2 text-xs text-tertiary mt-2">
              {selectedScholars.map((s) => (
                <a href={`/${discipline}/scholars/${s.key}`} class="font-semibold hover:underline">
                  {s.name_en ?? s.name_zh}
                </a>
              ))}
              {selectedKp.year && <span class="text-quaternary">'{selectedKp.year}</span>}
            </div>
            {selectedKp.title_en && <div class="text-xs text-quaternary italic mt-1">{selectedKp.title_en}</div>}
            {selectedKp.title_ja && <div class="text-xs text-tertiary mt-1">{selectedKp.title_ja}</div>}
          </header>
          <div class="kp-body text-secondary" set:html={renderBody(selectedKp.body_zh, scholarAccentHex)} />
          {selectedTags.length > 0 && (
            <footer class="mt-8 pt-4 border-t flex gap-2">
              {selectedTags.map((t) => (
                <span class={`badge ${t === '义' ? 'badge-meaning' : t === '限' ? 'badge-limit' : 'bg-badge-neutral text-tertiary'}`}>
                  {t}
                </span>
              ))}
            </footer>
          )}
        </div>
      ) : (
        <div class="text-sm text-quaternary py-10 px-4 max-w-reading mx-auto">
          <p>选中左侧代表理论查看详情，或按 <kbd class="px-1.5 py-0.5 text-xs rounded border bg-bg-secondary">↓</kbd> / <kbd class="px-1.5 py-0.5 text-xs rounded border bg-bg-secondary">↑</kbd> 切换</p>
        </div>
      )}
    </article>
  </main>
</Layout>

<script is:inline src="/split-pane.js"></script>
<script is:inline src="/admin-tools.js"></script>

<script is:inline define:vars={{ scholarKey: scholar.key, accentHex: scholarAccentHex }}>
  // v0.3.15: 学者收藏星标（localStorage，访客/admin 同）
  (function () {
    const btn = document.getElementById('scholar-star-toggle');
    if (!btn) return;
    const KEY = `scholar-starred:${scholarKey}`;
    const iconSpan = btn.querySelector('span');
    function render() {
      const starred = localStorage.getItem(KEY) === '1';
      btn.setAttribute('aria-pressed', String(starred));
      if (iconSpan) iconSpan.textContent = starred ? '★' : '☆';
      btn.style.color = starred ? accentHex : '';
      btn.setAttribute('aria-label', starred ? '已收藏学者（点击取消）' : '收藏学者');
    }
    render();
    btn.addEventListener('click', () => {
      if (localStorage.getItem(KEY) === '1') localStorage.removeItem(KEY);
      else localStorage.setItem(KEY, '1');
      render();
    });
  })();
</script>
