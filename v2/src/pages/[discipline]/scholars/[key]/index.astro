---
/**
 * 学者详情页 — OptionA「紧凑双栏」(v0.5.6 设计稿落地)
 *
 * 与学派详情同骨架（split + optA-* + kp-head-bar + EvalModule）。
 * 左栏：学者 hero（学者 eyebrow + H1 EN + 中日 + lifespan + ✎/☆）
 *      → 基本信息 table（国籍/领域/机构/出身/获奖）
 *      → 所属学派 N（chip + 学派 dot）
 *      → 主要贡献（可折叠 + lang switch）
 *      → 知识贡献 N（KP 卡片列表，active state）
 * 右栏：3px 顶 strip + kp-head-bar + renderBodyForSchool + renderEvalModule
 */
import Layout from '~/layouts/Layout.astro';
import { getDb } from '~/lib/db';
import { renderBodyForSchool, renderEvalModule } from '~/lib/render-body';
import { editHref } from '~/lib/nav';
import { tagColor } from '~/lib/tag-color';
import type { Tag } from '~/schemas/discipline';
import type { EvalContent } from '~/lib/eval-tag-defs';

const { discipline, key } = Astro.params;
const db = getDb(Astro.locals.runtime.env);

const disc = await db
  .prepare('SELECT key, title_zh, tags_json FROM discipline WHERE key = ?')
  .bind(discipline)
  .first<{ key: string; title_zh: string; tags_json: string }>();
if (!disc) return Astro.redirect('/404');
const tagLibrary: Tag[] = disc.tags_json ? JSON.parse(disc.tags_json) : [];

const scholar = await db
  .prepare(`
    SELECT key, discipline, name_zh, name_en, name_ja,
      contribution_zh, contribution_ja,
      lifespan, institution,
      born, died, nationality, flag, origin, field, tags_json,
      nobel_year, nobel_detail
    FROM scholar
    WHERE key = ? AND discipline = ?
  `)
  .bind(key, discipline)
  .first<{
    key: string; discipline: string; name_zh: string; name_en: string | null; name_ja: string | null;
    contribution_zh: string; contribution_ja: string | null;
    lifespan: string; institution: string;
    born: string | null; died: string | null; nationality: string | null; flag: string | null;
    origin: string | null; field: string | null; tags_json: string;
    nobel_year: string | null; nobel_detail: string | null;
  }>();
if (!scholar) return Astro.redirect('/404');

const scholarTags = JSON.parse(scholar.tags_json) as string[];
const accentHex = tagColor({ tags: scholarTags }, tagLibrary);

// 关联学派
const schoolsResult = await db
  .prepare(`
    SELECT s.key, s.title_zh, s.title_en, s.theme_key
    FROM school s
    INNER JOIN scholar_school ss ON ss.school_key = s.key
    WHERE ss.scholar_key = ?
    ORDER BY ss.position, s.key
  `)
  .bind(key)
  .all<{ key: string; title_zh: string; title_en: string | null; theme_key: string }>();
const schools = schoolsResult.results ?? [];

// 学者关联 KP
const kpsResult = await db
  .prepare(`
    SELECT k.id, k.title_zh, k.title_en, k.title_ja, k.year
    FROM kp k
    INNER JOIN kp_scholar ks ON ks.kp_id = k.id
    WHERE ks.scholar_key = ?
    ORDER BY
      CASE WHEN k.year = '' OR k.year IS NULL THEN 1 ELSE 0 END,
      k.year, k.id
  `)
  .bind(key)
  .all<{ id: string; title_zh: string; title_en: string | null; title_ja: string | null; year: string }>();
const kps = kpsResult.results ?? [];

// 选中 KP（?kp= 或 list[0]）
const requestedKpId = Astro.url.searchParams.get('kp');
const selectedKpId = requestedKpId ?? kps[0]?.id ?? null;
type SelectedKp = {
  id: string; title_zh: string; title_en: string | null; title_ja: string | null;
  year: string; body_zh: string; body_ja: string | null;
  format: string;
  eval_content_zh_json: string;
};
let selectedKp: SelectedKp | null = null;
let selectedScholars: Array<{ key: string; name_zh: string; name_en: string | null }> = [];
let selectedEvalContent: EvalContent | null = null;
if (selectedKpId) {
  const kpRow = await db
    .prepare('SELECT id, title_zh, title_en, title_ja, year, body_zh, body_ja, format, eval_content_zh_json FROM kp WHERE id = ? AND discipline = ?')
    .bind(selectedKpId, discipline)
    .first() as SelectedKp | null;
  selectedKp = kpRow ?? null;
  if (selectedKp) {
    try { selectedEvalContent = JSON.parse(selectedKp.eval_content_zh_json) as EvalContent; }
    catch { selectedEvalContent = null; }
    const scRes = await db
      .prepare(`
        SELECT sc.key, sc.name_zh, sc.name_en
        FROM scholar sc INNER JOIN kp_scholar ks ON ks.scholar_key = sc.key
        WHERE ks.kp_id = ? ORDER BY ks.position
      `)
      .bind(selectedKpId)
      .all<{ key: string; name_zh: string; name_en: string | null }>();
    selectedScholars = scRes.results ?? [];
  }
}

const lang = (Astro.url.searchParams.get('lang') === 'ja' && scholar.contribution_ja) ? 'ja' : 'zh';
const contribution = lang === 'ja' ? scholar.contribution_ja! : scholar.contribution_zh;
const lifespanDisplay = (scholar.born && scholar.died)
  ? `${scholar.born} — ${scholar.died}`
  : (scholar.born || scholar.died || scholar.lifespan || '');

const canEdit = Astro.locals.canEdit(discipline);
---

<Layout
  title={scholar.name_en ?? scholar.name_zh}
  currentDiscipline={discipline}
  currentSection="scholars"
  fullHeight
>
  <div class="split" style={`--accent:${accentHex}`}>

    {/* ========== 左栏 ========== */}
    <aside class="left">

      {/* Hero */}
      <div class="optA-hero">
        <div class="flex items-baseline justify-between gap-3">
          <div class="flex-1 min-w-0">
            <div class="optA-eyebrow">学者</div>
            <h1 class="text-2xl font-semibold leading-tight">{scholar.name_en ?? scholar.name_zh}</h1>
            <div class="text-xs text-tertiary mt-1">
              {scholar.name_zh}
              {scholar.name_ja && <span class="text-quaternary"> · {scholar.name_ja}</span>}
            </div>
            {lifespanDisplay && (
              <div class="text-xs text-quaternary mt-1">{lifespanDisplay}</div>
            )}
          </div>
          <div class="shrink-0 flex items-center gap-0.5">
            {canEdit && (
              <a
                href={editHref(`/${discipline}/scholars/${scholar.key}/edit`, Astro.url.pathname)}
                class="hero-icon-btn"
                aria-label="编辑此学者"
                title="编辑"
              >✎</a>
            )}
            <button
              id="scholar-star-toggle"
              type="button"
              data-scholar-key={scholar.key}
              aria-label="收藏学者"
              aria-pressed="false"
              class="hero-icon-btn"
              title="收藏"
            ><span aria-hidden="true">☆</span></button>
          </div>
        </div>
      </div>

      {/* 基本信息 — info table */}
      {(lifespanDisplay || scholar.nationality || scholar.field || scholar.institution || scholar.origin || scholar.nobel_year) && (
        <section class="optA-block" style="padding:0 8px 12px">
          <table class="info-table">
            <tbody>
              {(scholar.nationality || scholar.flag) && (
                <tr>
                  <td class="label">国籍</td>
                  <td class="val">
                    {scholar.flag && <span class="mr-1">{scholar.flag}</span>}
                    {scholar.nationality}
                  </td>
                </tr>
              )}
              {scholar.field && (
                <tr>
                  <td class="label">领域</td>
                  <td class="val">{scholar.field}</td>
                </tr>
              )}
              {scholar.institution && (
                <tr>
                  <td class="label">机构</td>
                  <td class="val">{scholar.institution}</td>
                </tr>
              )}
              {scholar.origin && (
                <tr>
                  <td class="label">出身</td>
                  <td class="val">{scholar.origin}</td>
                </tr>
              )}
              {scholar.nobel_year && (
                <tr>
                  <td class="label">获奖</td>
                  <td class="val" style="color:#b07d20;font-weight:600">🏅 {scholar.nobel_year}</td>
                </tr>
              )}
            </tbody>
          </table>
        </section>
      )}

      {/* 所属学派 */}
      {schools.length > 0 && (
        <section class="optA-block">
          <div class="optA-section-head">
            <h2>所属学派</h2>
            <span class="optA-count">{schools.length}</span>
          </div>
          <div class="flex flex-wrap gap-1.5 px-2 pb-3">
            {schools.map((s) => (
              <a
                href={`/${discipline}/${s.key}`}
                class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md border bg-bg-primary text-xs hover:bg-bg-secondary transition-colors no-underline"
              >
                <span class="inline-block w-1.5 h-1.5 rounded-full" style={`background:${accentHex}`}></span>
                <span class="font-semibold text-primary">{s.title_zh}</span>
                {s.title_en && <span class="text-quaternary">{s.title_en}</span>}
              </a>
            ))}
          </div>
        </section>
      )}

      {/* 主要贡献（可折叠 + lang 切换）*/}
      {contribution && (
        <section class="optA-summary-wrap" data-collapse-section="contribution">
          <button class="optA-section-head--btn" type="button" aria-expanded="true" data-collapse-toggle>
            <h2>主要贡献</h2>
            {scholar.contribution_ja && (
              <a
                href={lang === 'zh'
                  ? `?lang=ja${selectedKpId ? `&kp=${selectedKpId}` : ''}`
                  : Astro.url.pathname + (selectedKpId ? `?kp=${selectedKpId}` : '')}
                class="ml-2 text-xs text-accent-strategy"
                onclick="event.stopPropagation()"
              >{lang === 'zh' ? '日本語' : '中文'}</a>
            )}
            <span class="optA-collapse-chev">▾</span>
          </button>
          <div class="optA-summary" data-collapse-body set:html={contribution} />
        </section>
      )}

      {scholar.nobel_detail && (
        <section class="optA-block">
          <div class="px-2 py-3 rounded-md bg-bg-warm text-xs leading-relaxed">
            <div class="font-semibold mb-1" style="color:#b07d20">🏅 诺贝尔奖授奖词</div>
            <div class="whitespace-pre-line">{scholar.nobel_detail}</div>
          </div>
        </section>
      )}

      {/* 知识贡献 */}
      <section class="optA-block">
        <div class="optA-section-head">
          <h2>知识贡献</h2>
          <span class="optA-count">{kps.length}</span>
          {canEdit && (
            <a
              href={editHref(`/${discipline}/kp/new?scholar=${scholar.key}`, Astro.url.pathname)}
              class="ml-auto text-xs text-quaternary hover:text-accent-strategy"
              title="新增 KP"
            >+ 新增</a>
          )}
        </div>
        {kps.length === 0 ? (
          <p class="text-xs text-quaternary px-2 py-2">暂无关联知识点。</p>
        ) : (
          <ul class="optA-kps">
            {kps.map((k, i) => {
              const isActive = selectedKpId === k.id;
              const schoolHint = schools[0]?.title_zh ?? '';
              return (
                <li
                  data-kp-id={k.id}
                  class:list={['optA-kp kp-list-item', isActive && 'is-active']}
                >
                  <a
                    href={`/${discipline}/kp/${k.id}`}
                    data-kp-link
                    data-kp-wide-href={`?kp=${k.id}`}
                    class="contents"
                  >
                    <div class="optA-kp-num">{String(i + 1).padStart(2, '0')}</div>
                    <div class="optA-kp-body">
                      <div class="optA-kp-title">{k.title_zh}</div>
                      {(schoolHint || k.year) && (
                        <div class="optA-kp-meta">
                          {schoolHint}{schoolHint && k.year ? ' · ' : ''}{k.year}
                        </div>
                      )}
                    </div>
                    <span class="optA-kp-chev">›</span>
                  </a>
                  {canEdit && (
                    <div class="kp-admin">
                      <button
                        class="kp-admin-trigger"
                        type="button"
                        aria-label="管理此 KP"
                        aria-haspopup="true"
                        aria-expanded="false"
                        data-kp-menu-trigger
                      >⋯</button>
                      <div class="kp-admin-menu hidden" role="menu">
                        <a
                          class="kp-admin-mi"
                          href={editHref(`/${discipline}/kp/${k.id}/edit`, Astro.url.pathname)}
                          role="menuitem"
                        >
                          <span class="kp-admin-mi-ic">✎</span>编辑
                        </a>
                        <button
                          type="button"
                          role="menuitem"
                          class="kp-admin-mi is-danger"
                          data-kp-delete
                          data-kp-id={k.id}
                          data-kp-title={k.title_zh}
                        >
                          <span class="kp-admin-mi-ic">✗</span>删除
                        </button>
                      </div>
                    </div>
                  )}
                </li>
              );
            })}
          </ul>
        )}
      </section>
    </aside>

    {/* ========== 右栏 ========== */}
    <article class="right kp-detail-pane" id="kp-detail-pane" style="padding:0">
      <div style={`height:3px;background:${accentHex}`}></div>
      <div style="max-width:720px;padding:28px 28px 40px">
        {selectedKp ? (
          <>
            <header class="kp-head-bar">
              <div class="kp-head-bar-body">
                <h2 class="text-xl font-semibold leading-tight">{selectedKp.title_zh}</h2>
                <div class="text-xs text-tertiary mt-2 flex flex-wrap items-baseline gap-2">
                  {selectedScholars.map((s) => (
                    <a href={`/${discipline}/scholars/${s.key}`} class="font-semibold hover:underline">
                      {s.name_en ?? s.name_zh}
                    </a>
                  ))}
                  {selectedKp.year && <span class="text-quaternary">'{selectedKp.year}</span>}
                </div>
                {selectedKp.title_en && <div class="text-xs text-quaternary italic mt-1">{selectedKp.title_en}</div>}
                {selectedKp.title_ja && <div class="text-xs text-tertiary mt-1">{selectedKp.title_ja}</div>}
              </div>
            </header>
            <div class="mt-6" set:html={renderBodyForSchool(selectedKp.format, selectedKp.body_zh, accentHex)} />
            <div set:html={renderEvalModule(selectedEvalContent)} />
          </>
        ) : (
          <div class="text-sm text-quaternary py-10">
            <p>选中左侧 KP 查看详情。</p>
          </div>
        )}
      </div>
    </article>

  </div>
</Layout>

<script is:inline src="/split-pane.js"></script>
<script is:inline src="/admin-tools.js"></script>

<script is:inline define:vars={{ scholarKey: scholar.key, accentHex: accentHex }}>
  // ========== 学者收藏星标 ==========
  (function () {
    const btn = document.getElementById('scholar-star-toggle');
    if (!btn) return;
    const KEY = `scholar-starred:${scholarKey}`;
    const iconSpan = btn.querySelector('span');
    function render() {
      const starred = localStorage.getItem(KEY) === '1';
      btn.setAttribute('aria-pressed', String(starred));
      if (iconSpan) iconSpan.textContent = starred ? '★' : '☆';
      btn.style.color = starred ? accentHex : '';
      btn.setAttribute('aria-label', starred ? '已收藏（点击取消）' : '收藏学者');
    }
    render();
    btn.addEventListener('click', () => {
      if (localStorage.getItem(KEY) === '1') localStorage.removeItem(KEY);
      else localStorage.setItem(KEY, '1');
      render();
    });
  })();

  // ========== 主要贡献折叠 ==========
  (function () {
    const KEY = `optA-scholar:${scholarKey}:collapsed`;
    let state = {};
    try { state = JSON.parse(localStorage.getItem(KEY) || '{}'); } catch { state = {}; }
    document.querySelectorAll('[data-collapse-section]').forEach((sec) => {
      const id = sec.getAttribute('data-collapse-section');
      const btn = sec.querySelector('[data-collapse-toggle]');
      const body = sec.querySelector('[data-collapse-body]');
      if (!btn || !body) return;
      function apply() {
        const collapsed = !!state[id];
        sec.classList.toggle('is-collapsed', collapsed);
        btn.setAttribute('aria-expanded', String(!collapsed));
        body.style.display = collapsed ? 'none' : '';
      }
      apply();
      btn.addEventListener('click', () => {
        state[id] = !state[id];
        try { localStorage.setItem(KEY, JSON.stringify(state)); } catch {}
        apply();
      });
    });
  })();

  // ========== KP ⋯ overflow 菜单 ==========
  (function () {
    let openTrigger = null;
    function closeAll() {
      document.querySelectorAll('[data-kp-menu-trigger]').forEach((t) => {
        t.classList.remove('is-open');
        t.setAttribute('aria-expanded', 'false');
        const menu = t.nextElementSibling;
        if (menu && menu.classList.contains('kp-admin-menu')) menu.classList.add('hidden');
      });
      openTrigger = null;
    }
    document.addEventListener('click', (e) => {
      const trigger = e.target.closest && e.target.closest('[data-kp-menu-trigger]');
      if (trigger) {
        e.preventDefault();
        e.stopPropagation();
        const wasOpen = trigger === openTrigger;
        closeAll();
        if (!wasOpen) {
          trigger.classList.add('is-open');
          trigger.setAttribute('aria-expanded', 'true');
          const menu = trigger.nextElementSibling;
          if (menu) menu.classList.remove('hidden');
          openTrigger = trigger;
        }
      } else if (!e.target.closest || !e.target.closest('.kp-admin-menu')) {
        closeAll();
      }
    });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeAll(); });
  })();
</script>
