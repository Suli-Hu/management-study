---
import Layout from '~/layouts/Layout.astro';
import { getDb } from '~/lib/db';

const { discipline, key } = Astro.params;
const db = getDb(Astro.locals.runtime.env);

const disc = await db
  .prepare('SELECT key, title_zh FROM discipline WHERE key = ?')
  .bind(discipline)
  .first<{ key: string; title_zh: string }>();
if (!disc) return Astro.redirect('/404');

const scholar = await db
  .prepare(`
    SELECT key, discipline, name_zh, name_en, name_ja,
      contribution_zh, contribution_ja,
      lifespan, institution, nobel_year, nobel_detail
    FROM scholar
    WHERE key = ? AND discipline = ?
  `)
  .bind(key, discipline)
  .first<{
    key: string;
    discipline: string;
    name_zh: string;
    name_en: string | null;
    name_ja: string | null;
    contribution_zh: string;
    contribution_ja: string | null;
    lifespan: string;
    institution: string;
    nobel_year: string | null;
    nobel_detail: string | null;
  }>();

if (!scholar) return Astro.redirect('/404');

const schoolsResult = await db
  .prepare(`
    SELECT s.key, s.title_zh, s.title_en, s.theme_key
    FROM school s
    INNER JOIN scholar_school ss ON ss.school_key = s.key
    WHERE ss.scholar_key = ?
    ORDER BY ss.position, s.key
  `)
  .bind(key)
  .all<{ key: string; title_zh: string; title_en: string | null; theme_key: string }>();
const schools = schoolsResult.results ?? [];

const kpsResult = await db
  .prepare(`
    SELECT
      k.id, k.title_zh, k.title_en, k.title_ja, k.year,
      (SELECT GROUP_CONCAT(school_key, ',') FROM kp_school WHERE kp_id = k.id ORDER BY position) as schools_csv
    FROM kp k
    INNER JOIN kp_scholar ks ON ks.kp_id = k.id
    WHERE ks.scholar_key = ?
    ORDER BY
      CASE WHEN k.year = '' OR k.year IS NULL THEN 1 ELSE 0 END,
      k.year,
      k.id
  `)
  .bind(key)
  .all<{
    id: string;
    title_zh: string;
    title_en: string | null;
    title_ja: string | null;
    year: string;
    schools_csv: string | null;
  }>();
const kps = kpsResult.results ?? [];

// 语言切换（与 KP 详情页保持一致的 ?lang=ja 约定）
const lang = (Astro.url.searchParams.get('lang') === 'ja' && scholar.contribution_ja) ? 'ja' : 'zh';
const displayName = lang === 'ja' ? (scholar.name_ja ?? scholar.name_zh) : scholar.name_zh;
const contribution = lang === 'ja' ? scholar.contribution_ja! : scholar.contribution_zh;
---

<Layout title={scholar.name_en ?? scholar.name_zh} currentDiscipline={discipline} currentSection="scholars">
  <main class="max-w-reading mx-auto px-4 py-6">
    <header class="mb-6 pb-4 border-b">
      <h1 class="text-2xl mb-1">{scholar.name_en ?? displayName}</h1>
      <div class="text-xs text-tertiary flex flex-wrap items-baseline gap-x-2 gap-y-1">
        {scholar.name_en && <span>{displayName}</span>}
        {scholar.name_ja && lang === 'zh' && <span class="text-quaternary">{scholar.name_ja}</span>}
        {scholar.lifespan && <span class="text-quaternary">· {scholar.lifespan}</span>}
        {scholar.institution && <span class="text-quaternary">· {scholar.institution}</span>}
      </div>
      {scholar.nobel_detail && (
        <div class="mt-3 inline-flex items-center gap-2 px-3 py-1.5 rounded-md bg-badge-meaning text-accent-classic text-xs">
          🏅 诺贝尔经济学奖{scholar.nobel_year ? ` · ${scholar.nobel_year}` : ''}
        </div>
      )}

      <div class="flex gap-2 mt-4 flex-wrap">
        {scholar.contribution_ja && (
          <a
            href={lang === 'zh' ? `?lang=ja` : Astro.url.pathname}
            class="chip border-quaternary"
          >
            {lang === 'zh' ? '日本語' : '中文'}
          </a>
        )}
        {schools.map((s) => (
          <a href={`/${discipline}/${s.key}`} class="chip border-quaternary">{s.title_zh}</a>
        ))}
      </div>
    </header>

    {contribution && (
      <section class="mb-10">
        <article class="prose prose-sm max-w-none text-secondary leading-relaxed whitespace-pre-line" set:html={contribution} />
        {scholar.nobel_detail && (
          <aside class="mt-6 p-4 rounded-md bg-bg-warm text-xs text-secondary leading-relaxed">
            <div class="text-accent-classic font-semibold mb-1">🏅 诺贝尔奖授奖词</div>
            <div class="whitespace-pre-line">{scholar.nobel_detail}</div>
          </aside>
        )}
      </section>
    )}

    <section>
      <h2 class="text-sm font-semibold text-tertiary mb-3">相关知识点 ({kps.length})</h2>
      {kps.length > 0 ? (
        <ul class="space-y-1">
          {kps.map((k) => (
            <li>
              <a
                href={`/${discipline}/kp/${k.id}`}
                class="block py-2 px-3 rounded hover:bg-bg-tertiary no-underline"
              >
                <div class="flex items-baseline justify-between gap-3">
                  <div class="min-w-0 flex-1">
                    <span class="text-sm font-semibold text-primary">{k.title_zh}</span>
                    {k.title_ja && <span class="text-xs text-tertiary ml-2">{k.title_ja}</span>}
                  </div>
                  {k.year && <span class="text-xs text-quaternary whitespace-nowrap shrink-0">{k.year}</span>}
                </div>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="text-sm text-tertiary">暂无关联知识点。</p>
      )}
    </section>
  </main>
</Layout>
