---
/**
 * 学者详情页 — v0.5.55 redesign（mirror 学派页 v0.5.54）
 *
 * 左栏：optA-hero-v2（name 大字 + zh/ja + lifespan，✎+☆ 绝对右上）
 *      → 4-tab nav sticky 顶部：个人资料 / 所属学派 / 学术成就 / 关联知识
 *      → 4 tab panels（default = 个人资料）
 *
 * 右栏：3px 顶 strip + kp-head-bar + renderStructuredBody (variant=school) + renderEvalModule
 *
 * 兼容保留：
 *   - split-pane.js (`.kp-list-item[data-kp-id]` + `[data-kp-link][data-kp-wide-href]`)
 *   - admin-tools.js
 *   - drag-reorder-client (scholar-kps)
 *   - star toggle (localStorage)
 *   - ?lang=ja 同时控制 contribution + 选中 KP body
 */
import Layout from '~/layouts/Layout.astro';
import EmptyRight from '~/components/EmptyRight.astro';
import LangFab from '~/components/LangFab.astro';
import { getDb } from '~/lib/db';
import { renderStructuredBody, renderEvalModule } from '~/lib/render-body-structured';
import type { KpBody, KpEvaluationsLang } from '~/schemas/kp-body-structured';
import { renderInlineHtml } from '~/lib/render-inline';
import { editHref } from '~/lib/nav';
import { shortYear } from '~/lib/format-year';
import { lastName } from '~/lib/format-name';
import { resolveAccentForSchool } from '~/lib/resolve-accent';
import { APP_VERSION } from '~/lib/version';

const { discipline, key } = Astro.params;
const db = getDb(Astro.locals.runtime.env);

// v0.5.57 partial=1 fast path（同 school 页）— 跳左栏 schools/kps 重 query，只 query selectedKp
const isPartial = Astro.url.searchParams.get('partial') === '1';

const disc = await db
  .prepare('SELECT key, title_zh FROM discipline WHERE key = ?')
  .bind(discipline)
  .first<{ key: string; title_zh: string }>();
if (!disc) return Astro.redirect('/404');

// v0.8.15 Stage 6 chip 4: drop scholar.lifespan SELECT — migration 0021 已 DROP 该列
// (v0.8.9 Stage 4.6 Q1=B)。本地 dev 直接 D1_ERROR 无法渲染；prod 推测同样断（无人触达）。
// fallback 由 born/died 即可，lifespan 显示已废弃 — minimalism 第 6 次贯彻。
// v0.8.23: 加 tags_json — schema scholar.ts:35 注 "scholar.tags[0] 决定学者卡片色"。
const scholar = await db
  .prepare(`
    SELECT key, discipline, name_zh, name_en, name_ja,
      contribution_zh, contribution_ja,
      institution,
      born, died, nationality, flag, origin, field,
      nobel_year, nobel_detail, tags_json
    FROM scholar
    WHERE key = ? AND discipline = ?
  `)
  .bind(key, discipline)
  .first<{
    key: string; discipline: string; name_zh: string; name_en: string | null; name_ja: string | null;
    contribution_zh: string; contribution_ja: string | null;
    institution: string;
    born: string | null; died: string | null; nationality: string | null; flag: string | null;
    origin: string | null; field: string | null;
    nobel_year: string | null; nobel_detail: string | null;
    tags_json: string | null;
  }>();
if (!scholar) return Astro.redirect('/404');

// v0.8.21 三层原则 (PRD §6.2.3 修正):
//   - 右栏顶 3px strip + 左栏 active KP 左侧色条 + 右栏 body items numbering / cells
//     全部 = page chrome accent → 学派色 hex (用户确认 page interior 也要 tag 色)
//   - lang-toggle / LangFab / Star = focus action → L1 var(--primary) (不变)
// v0.8.23: scholarAccentHex 解析顺序改 scholar.tags[0] 优先 → schools[0] → 中性。
// 原 schools[0] 优先逻辑在 schools 都没 tag 时退中性 (Ansoff 例 schools 全无 tag 但
// scholar.tags=['t_jg440q'] SM 蓝)，导致 page chrome 失色。

// v0.8.20: discipline.tags_json → resolveAccentForSchool lookup (always 需要 — partial 模式右栏 strip 也用)
const discRow = await db
  .prepare('SELECT tags_json FROM discipline WHERE key = ?')
  .bind(discipline)
  .first<{ tags_json: string | null }>();
const tagDefs = JSON.parse(discRow?.tags_json ?? '[]') as Array<{ key: string; color: string }>;
const disciplineLookup = { tags: tagDefs };

// v0.8.23: scholar 自己的 tag 解析（优先于 schools[0]）
const scholarOwnAccentHex = resolveAccentForSchool(
  { tags: JSON.parse(scholar.tags_json || '[]') as string[] },
  disciplineLookup,
);

let schools: Array<{ key: string; title_zh: string; title_en: string | null; theme_key: string; accentHex: string }> = [];
type KpListItem = {
  id: string; title_zh: string; title_en: string | null; title_ja: string | null; year: string;
  // v0.8.10 Stage 5: 旧列已 drop
  body_zh_json: string; body_ja_json: string | null;
  evaluations_zh_json: string | null; evaluations_ja_json: string | null;
  body_format: string;
  /** kp_school 中 position 最小的主学派（与编辑页 / tier 主学派一致），无关联则为 null */
  primary_school_title_zh: string | null;
  locked_at: string | null;
};
let kps: KpListItem[] = [];

// v0.8.20: schools query 移出 !isPartial — partial 模式右栏 page chrome strip 也需要 schools[0].accent
// 产品 B：所属学派不从 scholar_school 读，而从该学者关联 KP 的 kp_school 去重推导（与「仅能在 KP 上维护学派」一致）。
const schoolsResult = await db
  .prepare(`
    SELECT s.key, s.title_zh, s.title_en, s.theme_key, s.tags_json
    FROM school s
    WHERE s.discipline = ?
      AND s.key IN (
        SELECT kps.school_key
        FROM kp_school kps
        INNER JOIN kp k ON k.id = kps.kp_id AND k.discipline = ?
        INNER JOIN kp_scholar ks ON ks.kp_id = k.id
          AND ks.scholar_key = ?
          AND ks.scholar_discipline = ?
      )
    ORDER BY s.title_zh ASC, s.key ASC
  `)
  .bind(discipline, discipline, key, discipline)
  .all<{ key: string; title_zh: string; title_en: string | null; theme_key: string; tags_json: string | null }>();
schools = (schoolsResult.results ?? []).map((s) => ({
  key: s.key,
  title_zh: s.title_zh,
  title_en: s.title_en,
  theme_key: s.theme_key,
  /* v0.8.20 fix: chip + page chrome strip 用 user-defined hex (resolveAccentForSchool) */
  accentHex: resolveAccentForSchool(
    { tags: JSON.parse(s.tags_json || '[]') as string[] },
    disciplineLookup,
  ),
}));

// v0.8.23 学者 page chrome accent 解析顺序：
//   1. scholar.tags[0] (schema 第一定义 — Ansoff 例 schools 都没 tag 但 scholar 有 SM 蓝)
//   2. schools[0] tag (跨学派学者：选首学派色)
//   3. 中性灰 fallback
const scholarAccentHex = !scholarOwnAccentHex.startsWith('var(')
  ? scholarOwnAccentHex
  : (schools[0]?.accentHex ?? 'var(--text-3)');

if (!isPartial) {

  // v0.5.33: ORDER BY ks.position 让 scholar.kpsOrder（拖动后保存）生效
  // v0.8.10: pull v0.8 列做 inline 展开
  // v0.8.23 跨学科隔离：kp_scholar PK = (kp_id, scholar_discipline, scholar_key)，
  //   补 ks.scholar_discipline + k.discipline 双重 filter 防同名 scholar / KP 越界泄露。
  const kpsResult = await db
    .prepare(`
      SELECT k.id, k.title_zh, k.title_en, k.title_ja, k.year,
        k.body_zh_json, k.body_ja_json, k.body_format,
        k.evaluations_zh_json, k.evaluations_ja_json,
        k.locked_at,
        (
          SELECT s.title_zh
          FROM kp_school kps0
          INNER JOIN school s ON s.key = kps0.school_key AND s.discipline = k.discipline
          WHERE kps0.kp_id = k.id
          ORDER BY kps0.position ASC, kps0.school_key ASC
          LIMIT 1
        ) AS primary_school_title_zh
      FROM kp k
      INNER JOIN kp_scholar ks ON ks.kp_id = k.id
      WHERE ks.scholar_key = ?
        AND ks.scholar_discipline = ?
        AND k.discipline = ?
      ORDER BY ks.position,
        CASE WHEN k.year = '' OR k.year IS NULL THEN 1 ELSE 0 END,
        k.year, k.id
    `)
    .bind(key, discipline, discipline)
    .all<KpListItem>();
  kps = kpsResult.results ?? [];
}

const requestedKpId = Astro.url.searchParams.get('kp');
const selectedKpId = requestedKpId ?? kps[0]?.id ?? null;

// v0.8.35: 编辑 ✎ 链接的 from URL — 必须保留 ?kp=<id>，否则编辑器返回时
// fall back 到第一个 KP，丢失用户原本浏览的位置。
const editFromUrl = selectedKpId
  ? `${Astro.url.pathname}?kp=${selectedKpId}`
  : Astro.url.pathname;

type SelectedKp = KpListItem;
let selectedKp: SelectedKp | null = null;
let selectedScholars: Array<{ key: string; name_zh: string; name_en: string | null }> = [];
let selectedEvalContent: KpEvaluationsLang | null = null;
if (selectedKpId) {
  const kpRow = await db
    .prepare('SELECT id, title_zh, title_en, title_ja, year, body_zh_json, body_ja_json, body_format, evaluations_zh_json, evaluations_ja_json, locked_at FROM kp WHERE id = ? AND discipline = ?')
    .bind(selectedKpId, discipline)
    .first() as SelectedKp | null;
  selectedKp = kpRow ?? null;
  if (selectedKp) {
    // selectedEvalContent 推迟到下面 selectedLang 计算之后，按 lang 选 zh/ja json
    // v0.8.23 跨学科隔离：scholar PK (discipline, key) — 必 JOIN 双键防 ansoff (keiei) 误 join
    //   ansoff (marketing)。
    const scRes = await db
      .prepare(`
        SELECT sc.key, sc.name_zh, sc.name_en
        FROM scholar sc INNER JOIN kp_scholar ks
          ON ks.scholar_key = sc.key AND ks.scholar_discipline = sc.discipline
        WHERE ks.kp_id = ? AND sc.discipline = ?
        ORDER BY ks.position
      `)
      .bind(selectedKpId, discipline)
      .all<{ key: string; name_zh: string; name_en: string | null }>();
    selectedScholars = scRes.results ?? [];
  }
}

const langParam = Astro.url.searchParams.get('lang');
const lang = (langParam === 'ja' && scholar.contribution_ja) ? 'ja' : 'zh';
const contribution = lang === 'ja' ? scholar.contribution_ja! : scholar.contribution_zh;

// v0.5.39: ?lang= 同时控制学者贡献 + 选中 KP body
const selectedLang: 'zh' | 'ja' =
  langParam === 'ja' && selectedKp?.body_ja_json ? 'ja' : 'zh';
// v0.8.10: evalContent 跟 lang 切，整体读 v0.8 evaluations JSON
if (selectedKp) {
  const evalRaw = selectedLang === 'ja' ? selectedKp.evaluations_ja_json : selectedKp.evaluations_zh_json;
  if (evalRaw) {
    try { selectedEvalContent = JSON.parse(evalRaw) as KpEvaluationsLang; }
    catch { selectedEvalContent = null; }
  }
}
const selectedBody: KpBody | null = selectedKp
  ? (selectedLang === 'ja'
      ? JSON.parse(selectedKp.body_ja_json!) as KpBody
      : JSON.parse(selectedKp.body_zh_json) as KpBody)
  : null;
const selectedTitle: string | null = selectedKp
  ? (selectedLang === 'ja' ? (selectedKp.title_ja ?? selectedKp.title_zh) : selectedKp.title_zh)
  : null;
const langToggleParams = new URLSearchParams(Astro.url.search);
if (selectedLang === 'zh') langToggleParams.set('lang', 'ja');
else langToggleParams.delete('lang');
const langToggleQs = langToggleParams.toString();
const langToggleHref = langToggleQs ? `${Astro.url.pathname}?${langToggleQs}` : Astro.url.pathname;

// 学者贡献 lang 切换 href（独立于右栏 KP lang，因为 contribution 切换 ja 时 ?lang=ja
// 也会反过来改右栏 selectedLang。复用 selectedLang 切换 href）
const contributionLangHref = langToggleHref;

const lifespanDisplay = (scholar.born && scholar.died)
  ? `${scholar.born} — ${scholar.died}`
  : (scholar.born || scholar.died || '');

const heroSubLine = [scholar.name_zh, scholar.name_ja].filter(Boolean).join(' · ');
const hasProfileInfo = !!(scholar.nationality || scholar.flag || scholar.field || scholar.institution || scholar.origin || scholar.nobel_year || scholar.nobel_detail);

const canEdit = Astro.locals.canEdit(discipline);
---

{/* v0.5.57 partial=1：只输出 <article> 右栏片段（无 Layout/Nav/Footer/scripts），split-pane.js 用 */}
{isPartial && (
  <article class="right kp-detail-pane" id="kp-detail-pane" style="padding:0">
    {/* v0.8.20: page chrome accent strip — 表达学者首学派身份 (resolveAccentForSchool 真实 hex) */}
    <div class="kp-pane-accent-strip" style={`background:${scholarAccentHex}`} aria-hidden="true"></div>
    <div class="kp-pane-content">
      {selectedKp ? (
        <>
          <header class="kp-head-bar">
            <div class="kp-head-bar-body">
              <div class="flex items-center gap-3">
                <h2 class="text-xl font-semibold leading-tight flex-1">{selectedTitle}</h2>
                {selectedKp.body_ja_json && (
                  <a
                    href={langToggleHref}
                    class:list={['lang-toggle shrink-0', selectedLang === 'ja' && 'is-active']}
                    data-lang-toggle
                    title="切换日语 / 中文 (Cmd/Ctrl + J)"
                    aria-pressed={selectedLang === 'ja'}
                  >
                    {selectedLang === 'zh' ? '日本語' : '中文'}
                  </a>
                )}
                {canEdit && (
                  <button
                    type="button"
                    data-kp-lock-toggle
                    data-kp-id={selectedKp.id}
                    class:list={['kp-lock-toggle shrink-0', selectedKp.locked_at && 'is-locked']}
                    aria-label={selectedKp.locked_at ? '解锁' : '锁定'}
                    aria-pressed={selectedKp.locked_at ? 'true' : 'false'}
                    title={selectedKp.locked_at ? '点击解锁' : '点击锁定'}
                  >
                    <span class="kp-lock-emoji" aria-hidden="true">🔒</span>
                    <span class="kp-lock-text" aria-hidden="true">{selectedKp.locked_at ? '解锁' : '锁定'}</span>
                  </button>
                )}
                {canEdit && (selectedKp.locked_at ? (
                  <span class="hero-icon-btn shrink-0 is-disabled" aria-disabled="true" title="已锁定，无法编辑">✎</span>
                ) : (
                  <a
                    href={editHref(`/${discipline}/kp/${selectedKp.id}/edit`, editFromUrl)}
                    data-edit-kp-link={selectedKp.id}
                    class="hero-icon-btn shrink-0"
                    aria-label={`编辑 ${selectedTitle}`}
                    title="编辑"
                  >✎</a>
                ))}
              </div>
              <div class="text-xs text-tertiary mt-2 flex flex-wrap items-baseline gap-2">
                {selectedScholars.map((s) => (
                  <a href={`/${discipline}/scholars/${s.key}`} class="font-semibold hover:underline">
                    {lastName(s.name_en ?? s.name_zh)}
                  </a>
                ))}
                {selectedKp.year && <span class="text-quaternary">{shortYear(selectedKp.year)}</span>}
              </div>
              {selectedKp.title_en && <div class="text-xs text-quaternary italic mt-1">{selectedKp.title_en}</div>}
              {selectedKp.title_ja && selectedLang === 'zh' && <div class="text-xs text-tertiary mt-1">{selectedKp.title_ja}</div>}
            </div>
          </header>
          <div class="mt-6" set:html={renderStructuredBody({
            body: selectedBody!,
            accentHex: scholarAccentHex,
            variant: 'school',
          })} />
          <div set:html={renderEvalModule(selectedEvalContent)} />
        </>
      ) : (
        <div class="text-sm text-quaternary py-10"><p>选中左侧 KP 查看详情。</p></div>
      )}
    </div>
  </article>
)}

{!isPartial && (
<Fragment>
<Layout
  title={scholar.name_en ?? scholar.name_zh}
  currentDiscipline={discipline}
  currentSection="scholars"
  currentLeafTitle={scholar.name_zh}
  fullHeight
>
  <div class="split">

    {/* ========== 左栏 ========== */}
    <aside class="left optA-stack">

      {/* v0.5.55 学者身份卡 — name_en 大字 + zh/ja + lifespan，✎ + ☆ 绝对右上 */}
      <div class="optA-hero-v2">
        <div class="optA-hero-actions-v2">
          {canEdit && (
            <a
              href={editHref(`/${discipline}/scholars/${scholar.key}/edit`, editFromUrl)}
              class="hero-icon-btn"
              aria-label="编辑此学者"
              title="编辑"
            >✎</a>
          )}
          <button
            id="scholar-star-toggle"
            type="button"
            data-scholar-key={scholar.key}
            aria-label="收藏学者"
            aria-pressed="false"
            class="hero-icon-btn"
            title="收藏"
          ><span aria-hidden="true">☆</span></button>
        </div>
        <h1 class="optA-hero-v2-title">{scholar.name_en ?? scholar.name_zh}</h1>
        {heroSubLine && <div class="optA-hero-v2-en">{heroSubLine}</div>}
        {lifespanDisplay && <div class="optA-hero-v2-meta">{lifespanDisplay}</div>}
      </div>

      {/* v0.5.55 4-tab nav（mobile + PC 共用，sticky 顶部）*/}
      <nav class="optA-tabs" role="tablist" aria-label="学者内容切换">
        {hasProfileInfo && (
          <button
            class="optA-tab-btn"
            type="button"
            data-tab-btn="profile"
            data-active
            role="tab"
            aria-selected="true"
          >个人资料</button>
        )}
        <button
          class="optA-tab-btn"
          type="button"
          data-tab-btn="schools"
          role="tab"
          aria-selected="false"
        >
          所属学派
          {schools.length > 0 && <span class="optA-tab-count">{schools.length}</span>}
        </button>
        {contribution && (
          <button
            class="optA-tab-btn"
            type="button"
            data-tab-btn="contribution"
            role="tab"
            aria-selected="false"
          >学术成就</button>
        )}
        <button
          class="optA-tab-btn"
          type="button"
          data-tab-btn="kps"
          role="tab"
          aria-selected="false"
        >
          关联知识
          {kps.length > 0 && <span class="optA-tab-count">{kps.length}</span>}
        </button>
      </nav>

      {/* Tab Panel: 个人资料（default active）*/}
      {hasProfileInfo && (
        <section class="optA-tab-panel" data-tab-panel="profile">
          <div class="optA-profile-block">
            <table class="info-table">
              <tbody>
                {(scholar.nationality || scholar.flag) && (
                  <tr>
                    <td class="label">国籍</td>
                    <td class="val">
                      {scholar.flag && <span class="mr-1">{scholar.flag}</span>}
                      {scholar.nationality}
                    </td>
                  </tr>
                )}
                {scholar.field && (
                  <tr>
                    <td class="label">领域</td>
                    <td class="val">{scholar.field}</td>
                  </tr>
                )}
                {scholar.institution && (
                  <tr>
                    <td class="label">机构</td>
                    <td class="val">{scholar.institution}</td>
                  </tr>
                )}
                {scholar.origin && (
                  <tr>
                    <td class="label">出身</td>
                    <td class="val">{scholar.origin}</td>
                  </tr>
                )}
                {scholar.nobel_year && (
                  <tr>
                    <td class="label">获奖</td>
                    <td class="val is-nobel">🏅 {scholar.nobel_year}</td>
                  </tr>
                )}
              </tbody>
            </table>
          </div>
          {scholar.nobel_detail && (
            <div class="optA-nobel-detail">
              <div class="optA-nobel-title">🏅 诺贝尔奖授奖词</div>
              <div class="whitespace-pre-line">{scholar.nobel_detail}</div>
            </div>
          )}
        </section>
      )}

      {/* Tab Panel: 所属学派
          v0.8.20: chip 着色用 user-defined hex (resolveAccentForSchool) — 跨多学派学者
          chip 区分有意义。inline style={`--accent: ${hex}`}, CSS 用 oklch(from var(--accent) ...) */}
      <section class="optA-tab-panel" data-tab-panel="schools" hidden={hasProfileInfo}>
        {schools.length === 0 ? (
          <p class="text-xs text-quaternary px-4 py-3">暂无关联学派。</p>
        ) : (
          <div class="scholar-schools-chips">
            {schools.map((s) => (
              <a
                href={`/${discipline}/${s.key}`}
                class="scholar-school-chip"
                data-accent-neutral={s.accentHex.startsWith('var(') ? 'true' : undefined}
                style={`--accent: ${s.accentHex}`}
              >
                <span class="scholar-school-chip-zh">{s.title_zh}</span>
                {s.title_en && <span class="scholar-school-chip-en">{s.title_en}</span>}
              </a>
            ))}
          </div>
        )}
      </section>

      {/* Tab Panel: 学术成就（rich text + lang 切换）*/}
      {contribution && (
        <section class="optA-tab-panel" data-tab-panel="contribution" hidden>
          {scholar.contribution_ja && (
            <div class="optA-tab-panel-actions">
              <a href={contributionLangHref} class="optA-lang-link">
                {lang === 'zh' ? '日本語' : '中文'}
              </a>
            </div>
          )}
          {/* v0.5.79: data-scholar-contribution 让 in-place lang swap 能精准 swap 这块 */}
          <div class="optA-summary-v2 optA-contribution" data-scholar-contribution set:html={renderInlineHtml(contribution)} />
        </section>
      )}

      {/* Tab Panel: 关联知识（KP flat list）—— v0.11.28: "+ 新增" 移到列表末 add-cell */}
      <section class="optA-tab-panel" data-tab-panel="kps" hidden>
        {kps.length === 0 && !canEdit ? (
          <p class="text-xs text-quaternary px-2 py-2">暂无关联知识点。</p>
        ) : (
          <ul
            class:list={['optA-kps', canEdit && 'drag-reorder']}
            data-reorder-kind={canEdit ? 'scholar-kps' : undefined}
            data-scholar-key={canEdit ? scholar.key : undefined}
            style={`--accent: ${scholarAccentHex}`}
          >
            {kps.map((k) => {
              const isActive = selectedKpId === k.id;
              // 须按「本 KP 的主学派」显示，勿用学者 schools[0]（跨学派学者会全员错标成同一学派）
              const schoolHint = k.primary_school_title_zh ?? '';
              // v0.5.75：跟学派页一致 — <details>/<summary> 包裹，手机 inline 展开
              // 桌面 split-pane.js MQ ≥1024px 拦截点击改 fetch swap，inline body 由 CSS 隐藏
              // v0.5.78: inline body 跟随页面 ?lang=；该 KP 没 ja → 退回 zh
              const useJa = selectedLang === 'ja' && !!k.body_ja_json;
              const inlineBody = useJa
                ? JSON.parse(k.body_ja_json!) as KpBody
                : JSON.parse(k.body_zh_json) as KpBody;
              const inlineBodyHtml = renderStructuredBody({
                body: inlineBody,
                accentHex: scholarAccentHex,
                variant: 'school',
              });
              const evalRaw = useJa ? k.evaluations_ja_json : k.evaluations_zh_json;
              let kpEval: KpEvaluationsLang | null = null;
              if (evalRaw) {
                try { kpEval = JSON.parse(evalRaw) as KpEvaluationsLang; }
                catch { kpEval = null; }
              }
              const inlineEvalHtml = renderEvalModule(kpEval);
              return (
                <li class="optA-kp-li" data-kp-id={k.id}>
                  <details
                    class:list={['optA-kp kp-list-item', isActive && 'is-active']}
                  >
                    <summary class="optA-kp-summary">
                      <a
                        href={`/${discipline}/kp/${k.id}`}
                        data-kp-link
                        data-kp-wide-href={`?kp=${k.id}`}
                        class="optA-kp-link"
                      >
                        <div class="optA-kp-body">
                          <div class="optA-kp-title">
                            <span class="optA-kp-title-core">{k.title_zh}</span>
                            {schoolHint && (
                              <span class="optA-kp-scholar" title={schoolHint}>{schoolHint}</span>
                            )}
                            {k.year && <span class="optA-kp-year">{shortYear(k.year)}</span>}
                          </div>
                          {k.title_ja && <div class="optA-kp-sub-ja">{k.title_ja}</div>}
                          {k.title_en && <div class="optA-kp-sub-en">{k.title_en}</div>}
                        </div>
                      </a>
                    </summary>
                    <div class="optA-kp-inline-body">
                      <div set:html={inlineBodyHtml} />
                      {inlineEvalHtml && <Fragment set:html={inlineEvalHtml} />}
                    </div>
                  </details>
                </li>
              );
            })}
            {canEdit && (
              <li class="optA-kp-add-li">
                <a
                  href={editHref(`/${discipline}/kp/new?scholar=${scholar.key}`, editFromUrl)}
                  class="optA-kp-add"
                  title="新增 KP"
                >
                  <span class="optA-kp-add-icon" aria-hidden="true">+</span>
                  <span class="optA-kp-add-label">新增</span>
                </a>
              </li>
            )}
          </ul>
        )}
      </section>
    </aside>

    {/* ========== 右栏 ========== */}
    <article class="right kp-detail-pane" id="kp-detail-pane" style="padding:0">
      {/* v0.8.20: page chrome accent strip — 表达学者首学派身份 */}
      <div class="kp-pane-accent-strip" style={`background:${scholarAccentHex}`} aria-hidden="true"></div>
      <div class="kp-pane-content">
        {kps.length === 0 ? (
          <EmptyRight
            accentHex="var(--text-3)"
            kind="scholar"
            name={scholar.name_en ?? scholar.name_zh}
            addHref={canEdit ? editHref(`/${discipline}/kp/new?scholar=${scholar.key}`, editFromUrl) : undefined}
          />
        ) : selectedKp ? (
          <>
            <header class="kp-head-bar">
              <div class="kp-head-bar-body">
                <div class="flex items-center gap-3">
                  <h2 class="text-xl font-semibold leading-tight flex-1">{selectedTitle}</h2>
                  {selectedKp.body_ja_json && (
                    <a
                      href={langToggleHref}
                      class:list={['lang-toggle shrink-0', selectedLang === 'ja' && 'is-active']}
                      data-lang-toggle
                      title="切换日语 / 中文 (Cmd/Ctrl + J)"
                      aria-pressed={selectedLang === 'ja'}
                    >
                      {selectedLang === 'zh' ? '日本語' : '中文'}
                    </a>
                  )}
                  {canEdit && (
                    <button
                      type="button"
                      data-kp-lock-toggle
                      data-kp-id={selectedKp.id}
                      class:list={['kp-lock-toggle shrink-0', selectedKp.locked_at && 'is-locked']}
                      aria-label={selectedKp.locked_at ? '解锁' : '锁定'}
                      aria-pressed={selectedKp.locked_at ? 'true' : 'false'}
                      title={selectedKp.locked_at ? '点击解锁' : '点击锁定'}
                    >
                      <span class="kp-lock-emoji" aria-hidden="true">🔒</span>
                      <span class="kp-lock-text" aria-hidden="true">{selectedKp.locked_at ? '解锁' : '锁定'}</span>
                    </button>
                  )}
                  {canEdit && (selectedKp.locked_at ? (
                    <span class="hero-icon-btn shrink-0 is-disabled" aria-disabled="true" title="已锁定，无法编辑">✎</span>
                  ) : (
                    <a
                      href={editHref(`/${discipline}/kp/${selectedKp.id}/edit`, editFromUrl)}
                      class="hero-icon-btn shrink-0"
                      aria-label={`编辑 ${selectedTitle}`}
                      title="编辑"
                    >✎</a>
                  ))}
                </div>
                <div class="text-xs text-tertiary mt-2 flex flex-wrap items-baseline gap-2">
                  {selectedScholars.map((s) => (
                    <a href={`/${discipline}/scholars/${s.key}`} class="font-semibold hover:underline">
                      {lastName(s.name_en ?? s.name_zh)}
                    </a>
                  ))}
                  {selectedKp.year && <span class="text-quaternary">{shortYear(selectedKp.year)}</span>}
                </div>
                {selectedKp.title_en && <div class="text-xs text-quaternary italic mt-1">{selectedKp.title_en}</div>}
                {selectedKp.title_ja && selectedLang === 'zh' && <div class="text-xs text-tertiary mt-1">{selectedKp.title_ja}</div>}
              </div>
            </header>
            <div class="mt-6" set:html={renderStructuredBody({
              body: selectedBody!,
              accentHex: scholarAccentHex,
              variant: 'school',
            })} />
            <div set:html={renderEvalModule(selectedEvalContent)} />
          </>
        ) : (
          <div class="text-sm text-quaternary py-10">
            <p>选中左侧 KP 查看详情。</p>
          </div>
        )}
      </div>
    </article>

  </div>

  {/* v0.5.78：mobile 日语切换悬浮球 — 仅当当前选中 KP 有日文 body 时挂
       v0.8.20: lang 切换是 focus action → L1 var(--primary) (PRD §6.2.3 三层原则) */}
  {selectedKp?.body_ja_json && <LangFab lang={selectedLang} accentHex="var(--primary)" />}
</Layout>

<script is:inline src={`/split-pane.js?v=${APP_VERSION}`}></script>
<script is:inline src={`/admin-tools.js?v=${APP_VERSION}`}></script>
<script is:inline src={`/cmpc-flip.js?v=${APP_VERSION}`}></script>
<script is:inline src={`/kp-lock.js?v=${APP_VERSION}`}></script>

{canEdit && (
  <div data-reorder-bootstrap="scholar-kps" class="hidden"></div>
)}

<script>
  // @ts-nocheck — DOM 类型推断弱
  import { mountDragReorder } from '~/lib/drag-reorder-client';

  // ========== v0.5.55 4-tab nav 切换（与学派页 v0.5.52 同款）==========
  document.querySelectorAll('[data-tab-btn]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = btn.dataset.tabBtn;
      document.querySelectorAll('[data-tab-panel]').forEach((p) => {
        p.toggleAttribute('hidden', p.dataset.tabPanel !== target);
      });
      document.querySelectorAll('[data-tab-btn]').forEach((b) => {
        b.toggleAttribute('data-active', b.dataset.tabBtn === target);
        b.setAttribute('aria-selected', b.dataset.tabBtn === target ? 'true' : 'false');
      });
    });
  });

  // 学者页 KP 列表长按拖动重排（v0.5.33，姊妹于学派页 school-concepts）
  if (document.querySelector('[data-reorder-bootstrap="scholar-kps"]')) {
    document.querySelectorAll('[data-reorder-kind="scholar-kps"]').forEach((ul) => {
      const scholarKey = ul.dataset.scholarKey;
      mountDragReorder(ul, {
        getId: (el) => el.getAttribute('data-kp-id'),
        getContainerKey: () => scholarKey,
        skipSelector: '.kp-admin-edit, .kp-admin, button',
        onReorder: async (idsByContainer) => {
          const kpIds = idsByContainer.get(scholarKey) ?? [];
          if (kpIds.length === 0) return;
          const res = await fetch('/api/edit/reorder/scholar-kps', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            // v0.6.8: scholar 复合 PK — body 必传 discipline 才能 disambiguate
            body: JSON.stringify({ discipline, scholarKey, kpIds }),
          });
          if (!res.ok) {
            const data = await res.json().catch(() => ({}));
            alert(`保存顺序失败：${res.status} ${data.reason ?? 'error'}`);
          }
        },
      });
    });
  }
</script>

<script is:inline define:vars={{ scholarKey: scholar.key }}>
  // ========== 学者收藏星标 ==========
  // v0.8.19: starred 态用 ★ glyph 切换 + 默认 var(--text) 强对比即可，不再注入学派色
  //   (page chrome 已表达学者身份，accent 学派色 redundant)
  (function () {
    const btn = document.getElementById('scholar-star-toggle');
    if (!btn) return;
    const KEY = `scholar-starred:${scholarKey}`;
    const iconSpan = btn.querySelector('span');
    function render() {
      const starred = localStorage.getItem(KEY) === '1';
      btn.setAttribute('aria-pressed', String(starred));
      if (iconSpan) iconSpan.textContent = starred ? '★' : '☆';
      btn.setAttribute('aria-label', starred ? '已收藏（点击取消）' : '收藏学者');
    }
    render();
    btn.addEventListener('click', () => {
      if (localStorage.getItem(KEY) === '1') localStorage.removeItem(KEY);
      else localStorage.setItem(KEY, '1');
      render();
    });
  })();

  // Cmd/Ctrl + J: 切换日语/中文（与学派页同款，复用右栏 lang-toggle）
  (function () {
    function isEditableTarget(t) {
      if (!t) return false;
      var tag = t.tagName;
      if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT') return true;
      if (t.isContentEditable) return true;
      return false;
    }
    document.addEventListener('keydown', function (e) {
      if (!(e.metaKey || e.ctrlKey)) return;
      if (!e.key || e.key.toLowerCase() !== 'j') return;
      if (isEditableTarget(e.target)) return;
      var btn = document.querySelector('.kp-detail-pane [data-lang-toggle]')
        || document.querySelector('[data-lang-toggle]');
      if (!btn) return;
      e.preventDefault();
      btn.classList.add('is-pulse');
      setTimeout(function () {
        btn.classList.remove('is-pulse');
        btn.click();
      }, 90);
    });
  })();
</script>

<style>
  /*
   * v0.8.23: "所属学派" chip — Option B「solid filled tag」(用户 fb confirm)
   * 用户 fb：tinted-bg 公式在 dark mode 始终偏暗。改实底填色 + 白字 — 辨识度最高、
   * dark/light 一致、完全无对比问题。配套 KP 详情页 .kp-school-chip 同步改 (kp/[id].astro)。
   * accent 由 inline style={`--accent: ${hex}`} 注入。
   */
  .scholar-schools-chips {
    display: flex; flex-wrap: wrap; gap: 8px;
    padding: 12px 18px 18px;
  }
  .scholar-school-chip {
    display: inline-flex; align-items: baseline; gap: 6px;
    padding: 6px 12px;
    border-radius: 999px;
    background: var(--accent);
    border: 1px solid var(--accent);
    font-size: 13px;
    text-decoration: none;
    line-height: 1.3;
    transition: opacity .14s, transform .14s, box-shadow .14s;
  }
  /* fallback — accentHex='var(--text-3)' 时实底中性灰 + 白字仍可读 */
  .scholar-school-chip[data-accent-neutral] {
    background: var(--text-3);
    border-color: var(--text-3);
  }
  .scholar-school-chip:hover {
    opacity: 1;
    transform: translateY(-1px);
    box-shadow: 0 2px 8px oklch(from var(--accent) l c h / 0.25);
  }
  .scholar-school-chip-zh {
    font-weight: 600;
    color: #fff;
  }
  .scholar-school-chip-en {
    font-size: 11.5px;
    color: oklch(1 0 0 / 0.78);
    font-weight: 400;
  }
  :global([data-mode="dark"]) .scholar-school-chip:hover {
    box-shadow: 0 2px 10px oklch(from var(--accent) l c h / 0.45);
  }
</style>
</Fragment>
)}
