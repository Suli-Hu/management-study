---
import Layout from '~/layouts/Layout.astro';
import { getDb } from '~/lib/db';
import { editHref } from '~/lib/nav';

const { discipline } = Astro.params;
const db = getDb(Astro.locals.runtime.env);

const disc = await db
  .prepare('SELECT key, title_zh FROM discipline WHERE key = ?')
  .bind(discipline)
  .first<{ key: string; title_zh: string }>();
if (!disc) return Astro.redirect('/404');

// 按 key（学者英文姓氏 lowercased）排序 — 符合学界惯例（按姓氏）
const result = await db
  .prepare(`
    SELECT
      sc.key, sc.name_zh, sc.name_en, sc.name_ja,
      sc.lifespan, sc.institution,
      sc.nobel_year,
      (SELECT COUNT(*) FROM kp_scholar WHERE scholar_key = sc.key) as kp_count
    FROM scholar sc
    WHERE sc.discipline = ?
    ORDER BY sc.key
  `)
  .bind(discipline)
  .all<{
    key: string;
    name_zh: string;
    name_en: string | null;
    name_ja: string | null;
    lifespan: string;
    institution: string;
    nobel_year: string | null;
    kp_count: number;
  }>();

const scholars = result.results ?? [];

function initial(key: string): string {
  const c = key.trim().charAt(0).toUpperCase();
  return /[A-Z]/.test(c) ? c : '#';
}

const grouped = new Map<string, typeof scholars>();
for (const s of scholars) {
  const k = initial(s.key);
  if (!grouped.has(k)) grouped.set(k, []);
  grouped.get(k)!.push(s);
}
const groupKeys = Array.from(grouped.keys()).sort((a, b) => {
  if (a === '#') return 1;
  if (b === '#') return -1;
  return a.localeCompare(b);
});
---

<Layout title={`学者 · ${disc.title_zh}`} currentDiscipline={discipline} currentSection="scholars">
  <main class="max-w-panel mx-auto px-4 py-6">
    <header class="mb-6 flex items-baseline justify-between gap-3 group">
      <div>
        <h1 class="text-2xl mb-1">学者</h1>
        <p class="text-xs text-quaternary">{disc.title_zh} · 共 {scholars.length} 位</p>
      </div>
      {Astro.locals.isAdmin && (
        <a
          href={editHref(`/${discipline}/scholars/new`, Astro.url.pathname)}
          class="inline-flex shrink-0 opacity-50 hover:opacity-100 transition-opacity items-center px-3 py-1.5 rounded-full border border-accent-strategy text-accent-strategy text-xs no-underline hover:bg-accent-strategy hover:text-white"
        >
          + 新增学者
        </a>
      )}
    </header>

    {groupKeys.length > 0 && (
      <nav class="mb-6 flex flex-wrap items-center gap-1 text-xs">
        <span class="text-quaternary mr-2">按英文姓氏 A–Z：</span>
        {groupKeys.map((k) => (
          <a
            href={`#letter-${k}`}
            class="px-2 py-1 rounded text-tertiary hover:text-primary hover:bg-bg-tertiary no-underline"
          >
            {k}
          </a>
        ))}
      </nav>
    )}

    {groupKeys.map((k) => (
      <section id={`letter-${k}`} class="mb-8 scroll-mt-16">
        <h2 class="text-sm font-semibold text-quaternary mb-3 sticky top-12 bg-bg-primary/90 backdrop-blur-sm py-1 -mx-1 px-1">
          {k}
        </h2>
        <ul class="space-y-0.5">
          {grouped.get(k)!.map((s) => (
            <li>
              <a
                href={`/${discipline}/scholars/${s.key}`}
                class="flex items-baseline justify-between gap-3 py-2 px-1 border-b border-bg-tertiary hover:bg-bg-tertiary rounded-sm no-underline"
              >
                <div class="min-w-0 flex-1">
                  <div class="flex items-baseline gap-2 flex-wrap">
                    <span class="text-base font-semibold text-primary">
                      {s.name_en ?? s.name_zh}
                    </span>
                    {s.name_en && s.name_zh && (
                      <span class="text-xs text-tertiary">{s.name_zh}</span>
                    )}
                    {s.nobel_year && (
                      <span class="chip border-accent-classic text-accent-classic" title={`诺贝尔奖 ${s.nobel_year}`}>
                        🏅 {s.nobel_year}
                      </span>
                    )}
                  </div>
                  {(s.lifespan || s.institution) && (
                    <div class="text-xs text-quaternary mt-0.5">
                      {s.lifespan}
                      {s.lifespan && s.institution && ' · '}
                      {s.institution}
                    </div>
                  )}
                </div>
                <span class="text-xs text-quaternary whitespace-nowrap">{s.kp_count} KP</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}

    {scholars.length === 0 && (
      <p class="text-sm text-tertiary">暂无学者数据。</p>
    )}
  </main>
</Layout>
