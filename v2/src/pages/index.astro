---
import Layout from '~/layouts/Layout.astro';
import Brand from '~/components/Brand.astro';
import { getDb } from '~/lib/db';

// 从 D1 拉真实学科列表
const db = getDb(Astro.locals.runtime.env);
const result = await db
  .prepare(`
    SELECT
      d.key, d.title_zh, d.title_en, d.tagline_zh,
      (SELECT COUNT(*) FROM school WHERE discipline = d.key) as school_count,
      (SELECT COUNT(*) FROM kp     WHERE discipline = d.key) as kp_count
    FROM discipline d
    ORDER BY d.key
  `)
  .all<{ key: string; title_zh: string; title_en: string | null; tagline_zh: string | null; school_count: number; kp_count: number }>();

const disciplines = result.results ?? [];

// v0.5.56: upcoming 学科改成 D-状态卡（dashed border + warm 🌱 即将上线 badge）
// 当前只有心理学（marketing/sociology 已撒种到 D1）
const upcoming = [
  { key: 'psychology', title_zh: '心理学', title_en: 'Psychology', tagline_zh: '数据准备中' },
];
const upcomingFiltered = upcoming.filter((u) => !disciplines.some((d) => d.key === u.key));
---

<Layout title="全科笔记">
  <main class="max-w-reading mx-auto px-4 py-8">
    <header class="mb-10 flex flex-col items-start">
      {/* v0.5.58 #1 logo 替代旧 H1 文字 */}
      <Brand href="/" variant="lockup" class="mb-3" />
      <p class="text-tertiary text-sm">日本大学院入试备考知识库 · v2</p>
    </header>

    <section>
      <h2 class="text-xl mb-4">学科</h2>
      <div class="space-y-3">
        {disciplines.map((d) => {
          // v0.4.25 RBAC：A canEdit / B canRead-only / C !canRead（v0.5.56 visual = opacity dim）
          const canEdit = Astro.locals.canEdit(d.key);
          const canRead = Astro.locals.canRead(d.key);
          if (canRead) {
            return (
              <a
                href={`/${d.key}`}
                class="block p-4 rounded-lg border bg-bg-primary shadow-card transition-all hover:shadow-card-hover hover:-translate-y-px"
              >
                <div class="flex items-baseline justify-between mb-1 gap-3">
                  <h3 class="text-lg flex items-baseline gap-2 min-w-0">
                    <span class="truncate">{d.title_zh}</span>
                    <span class="text-xs text-quaternary font-normal">{d.title_en}</span>
                  </h3>
                  {canEdit ? (
                    <span class="shrink-0 text-xs px-1.5 py-0.5 rounded border border-accent-strategy text-accent-strategy">🖋️ 编辑</span>
                  ) : (
                    <span class="shrink-0 text-xs px-1.5 py-0.5 rounded border border-bg-tertiary text-tertiary">👁 只读</span>
                  )}
                </div>
                {d.tagline_zh && <div class="text-xs text-tertiary mb-1">{d.tagline_zh}</div>}
                <div class="text-xs text-quaternary">
                  {d.school_count} 学派 · {d.kp_count} 知识点
                </div>
              </a>
            );
          }
          // C: 无权限 — v0.5.56 改 v1 opacity dim 风格（demo 拍板）
          return (
            <div
              class="block p-4 rounded-lg border bg-bg-primary opacity-50 cursor-not-allowed"
              title="无权限。联系管理员申请。"
            >
              <div class="flex items-baseline justify-between mb-1 gap-3">
                <h3 class="text-lg flex items-baseline gap-2 min-w-0">
                  <span class="truncate">{d.title_zh}</span>
                  <span class="text-xs text-quaternary font-normal">{d.title_en}</span>
                </h3>
                <span class="shrink-0 text-xs px-1.5 py-0.5 rounded border border-bg-tertiary text-quaternary">🔒 无权限</span>
              </div>
              <div class="text-xs text-quaternary">联系管理员申请</div>
            </div>
          );
        })}

        {/* D: 即将上线（不在 D1）— v0.5.56 改 dashed card（demo 拍板）*/}
        {upcomingFiltered.map((u) => (
          <div
            class="block p-4 rounded-lg border border-dashed border-bg-tertiary bg-bg-secondary cursor-not-allowed"
            title="即将上线"
          >
            <div class="flex items-baseline justify-between mb-1 gap-3">
              <h3 class="text-lg flex items-baseline gap-2 min-w-0">
                <span class="truncate text-quaternary">{u.title_zh}</span>
                <span class="text-xs text-quaternary font-normal">{u.title_en}</span>
              </h3>
              <span
                class="shrink-0 text-xs px-1.5 py-0.5 rounded border"
                style="border-color: color-mix(in oklab, #b07d20 30%, transparent); color: #b07d20; background: color-mix(in oklab, #b07d20 9%, var(--color-bg-primary));"
              >🌱 即将上线</span>
            </div>
            {u.tagline_zh && <div class="text-xs text-quaternary">{u.tagline_zh}</div>}
          </div>
        ))}
      </div>
    </section>

  </main>
</Layout>
