---
import Layout from '~/layouts/Layout.astro';
import { getDb } from '~/lib/db';

// 从 D1 拉真实学科列表
const db = getDb(Astro.locals.runtime.env);
const result = await db
  .prepare(`
    SELECT
      d.key, d.title_zh, d.title_en, d.tagline_zh,
      (SELECT COUNT(*) FROM school WHERE discipline = d.key) as school_count,
      (SELECT COUNT(*) FROM kp     WHERE discipline = d.key) as kp_count
    FROM discipline d
    ORDER BY d.key
  `)
  .all<{ key: string; title_zh: string; title_en: string | null; tagline_zh: string | null; school_count: number; kp_count: number }>();

const disciplines = result.results ?? [];

// 占位：未来其他学科（learning 撒种后自动从 D1 出现）
const upcoming = [
  { key: 'marketing', title_zh: '市场营销', title_en: 'Marketing' },
  { key: 'sociology', title_zh: '社会学',   title_en: 'Sociology' },
];
const upcomingFiltered = upcoming.filter((u) => !disciplines.some((d) => d.key === u.key));
---

<Layout title="全学科学习笔记">
  <main class="max-w-reading mx-auto px-4 py-8">
    <header class="mb-10">
      <h1 class="text-3xl mb-2">全学科学习笔记</h1>
      <p class="text-tertiary text-sm">日本大学院入试备考知识库 · v2</p>
    </header>

    <section>
      <h2 class="text-xl mb-4">学科</h2>
      <div class="space-y-3">
        {disciplines.map((d) => {
          // v0.4.25 RBAC：按权限渲染 — admin 可写 / guest 只读 / 无权限灰锁
          const canEdit = Astro.locals.canEdit(d.key);
          const canRead = Astro.locals.canRead(d.key);
          if (canRead) {
            return (
              <a
                href={`/${d.key}`}
                class="block p-4 rounded-lg border bg-bg-primary shadow-card transition-all hover:shadow-card-hover hover:-translate-y-px"
              >
                <div class="flex items-baseline justify-between mb-1 gap-3">
                  <h3 class="text-lg flex items-baseline gap-2 min-w-0">
                    <span class="truncate">{d.title_zh}</span>
                    <span class="text-xs text-quaternary font-normal">{d.title_en}</span>
                  </h3>
                  {canEdit ? (
                    <span class="shrink-0 text-xs px-1.5 py-0.5 rounded border border-accent-strategy text-accent-strategy">✎ 可编辑</span>
                  ) : (
                    <span class="shrink-0 text-xs px-1.5 py-0.5 rounded border border-bg-tertiary text-tertiary">👁 只读</span>
                  )}
                </div>
                {d.tagline_zh && <div class="text-xs text-tertiary mb-1">{d.tagline_zh}</div>}
                <div class="text-xs text-quaternary">
                  {d.school_count} 学派 · {d.kp_count} 知识点
                </div>
              </a>
            );
          }
          // 无权限：灰锁卡片（不能点）
          return (
            <div
              class="block p-4 rounded-lg border bg-bg-primary shadow-card opacity-40 cursor-not-allowed"
              title="无权限。联系管理员申请。"
            >
              <div class="flex items-baseline justify-between mb-1 gap-3">
                <h3 class="text-lg flex items-baseline gap-2 min-w-0">
                  <span class="truncate">{d.title_zh}</span>
                  <span class="text-xs text-quaternary font-normal">{d.title_en}</span>
                </h3>
                <span class="shrink-0 text-xs px-1.5 py-0.5 rounded border border-bg-tertiary text-quaternary">🔒 无权限</span>
              </div>
              <div class="text-xs text-quaternary">联系管理员申请</div>
            </div>
          );
        })}

      </div>
      {/* v0.5.40: upcoming 学科改成单行弱提示，不再跟 active 学科卡视觉权重持平 */}
      {upcomingFiltered.length > 0 && (
        <p class="text-xs text-quaternary text-center mt-6">
          更多学科即将上线 · {upcomingFiltered.map((u) => u.title_zh).join(' · ')}
        </p>
      )}
    </section>

  </main>
</Layout>
