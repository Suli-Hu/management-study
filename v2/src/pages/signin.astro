---
/**
 * /signin — 账户登录入口（v0.7.9 起 C2 设计）
 *
 * 邮箱 + 密码登录，DOM 内只有 1 个 password input —— 浏览器 password
 * manager autofill 100% 工作（不被 Safari 多 password field heuristic 禁用）。
 *
 * 演示访问者走 /login（邀请码）；真账户用户书签 /signin。
 *
 * AUTH_MODE=password 应急模式 → redirect /login（password mode 走单一 form
 * 在 /login，避免重复）。
 */
import Layout from '~/layouts/Layout.astro';
import Brand from '~/components/Brand.astro';
import { readFlash, FLASH_COOKIE } from '~/lib/flash';

const user = Astro.locals.user;
if (user) return Astro.redirect('/');

const env = Astro.locals.runtime.env;
if (env.AUTH_MODE === 'password') return Astro.redirect('/login');

const flash = readFlash(Astro.request.headers.get('cookie'));
if (flash) Astro.cookies.delete(FLASH_COOKIE, { path: '/' });

const error = flash?.error ?? null;
const lastEmail = flash?.email ?? '';

const errorMessages: Record<string, string> = {
  bad_credentials: '邮箱或密码不对。',
  bad_credentials_locked: '尝试次数过多，账户已锁 30 分钟。请稍后再试，或走"忘记密码"重置。',
  invalid_or_expired: '会话已失效，请重新登录。',
};
const errorMsg = error ? (errorMessages[error] ?? '登录出错，请重试。') : null;
---

<Layout title="账号登录">
  <main class="max-w-reading mx-auto px-4 py-8 min-h-[calc(100dvh-9rem)] flex items-center">
    <div class="w-full max-w-md mx-auto">
      <header class="mb-8 flex justify-center">
        <Brand href="/" variant="lockup" />
      </header>

      {errorMsg && (
        <div class="mb-4 p-3 rounded-md bg-badge-limit text-accent-warning text-xs">
          {errorMsg}
        </div>
      )}

      <form method="POST" action="/api/auth/login-password" class="space-y-3">
        <div>
          <label class="block text-xs text-tertiary mb-1">邮箱</label>
          <input
            type="email"
            name="email"
            required
            autofocus
            autocomplete="email"
            value={lastEmail}
            placeholder="you@example.com"
            class="w-full px-3 py-2.5 rounded-md border border-bg-tertiary text-sm focus:outline-none focus:border-accent-strategy"
          />
        </div>
        <div>
          <label class="block text-xs text-tertiary mb-1">密码</label>
          <input
            type="password"
            name="password"
            required
            autocomplete="current-password"
            placeholder="登录密码"
            class="w-full px-3 py-2.5 rounded-md border border-bg-tertiary text-sm focus:outline-none focus:border-accent-strategy"
          />
        </div>
        <label class="flex items-center gap-2 text-xs text-tertiary cursor-pointer select-none">
          <input type="checkbox" name="remember" value="1" checked class="w-4 h-4 accent-accent-strategy cursor-pointer" />
          记住密码 30 天
        </label>
        <button type="submit" class="btn-ghost-strategy w-full">
          登录
        </button>
        <div class="flex justify-between text-xs text-quaternary mt-3">
          <a href="/signup" class="text-accent-strategy">还没账号？注册</a>
          <a href="/password-reset" class="text-accent-strategy">忘记密码？</a>
        </div>
        <p class="text-xs text-quaternary text-center mt-4 pt-3 border-t border-bg-tertiary">
          没有账号 / 想看一眼？<a href="/login" class="text-accent-strategy">演示访问 →</a>
        </p>
      </form>
    </div>
  </main>
</Layout>
