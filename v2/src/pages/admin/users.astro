---
/**
 * /admin/users — 用户权限管理 (v0.5.95)
 * super-admin only。SSR gate；UI 全 client-rendered fetch /api/admin/users。
 *
 * 设计 (frontend-design skill):
 *   - 单表格 layout，header (h1 + N 人 count)
 *   - 每行 user：accent 色头像（email hash → ob 绿/classic 橙/strategy 蓝）+ email + meta
 *   - 权限矩阵 = segmented toggle 三段 [无][只读][编辑]，1 tap 切换 + toast
 *   - 技术字段（user_id 后 6 位 / created_at）用 SF Mono
 *   - super-admin 行皇冠 icon + 全列锁死 ALL
 *   - iPad: 表格水平滚 + email 列 sticky + toggle ≥ 52px
 */
import Layout from '~/layouts/Layout.astro';

if (!Astro.locals.user) return Astro.redirect('/login');
if (!Astro.locals.isSuperAdmin) return Astro.redirect('/');
---

<Layout title="用户权限管理">
  <main class="max-w-reading mx-auto px-4 py-6">
    <header class="mb-6">
      <button type="button" class="users-back-btn" data-back>← 返回</button>
      <div class="flex items-baseline gap-3 mt-2">
        <h1 class="text-2xl font-semibold">用户权限管理</h1>
        <span class="text-xs text-quaternary" id="user-count"></span>
      </div>
      <p class="text-xs text-tertiary mt-1">每格点击切换 — 即时生效</p>
    </header>

    <div id="loading" class="space-y-2">
      {[1,2,3].map(() => (
        <div class="h-14 rounded-md bg-bg-secondary animate-pulse"></div>
      ))}
    </div>

    <div id="content" class="hidden">
      <div class="users-wrap">
        <table class="users-table" id="users-table">
          <thead>
            <tr>
              <th class="sticky-col">用户</th>
              {/* 学科列 client 注入 */}
              <th class="action-col">操作</th>
            </tr>
          </thead>
          <tbody></tbody>
        </table>
      </div>

      <div class="mt-6 p-3 rounded-md bg-bg-secondary text-xs text-tertiary leading-relaxed">
        <strong class="text-secondary">权限语义：</strong>
        <span class="inline-block mx-1.5 px-1.5 py-0.5 border rounded text-quaternary">无</span> 不能访问该学科 ·
        <span class="inline-block mx-1.5 px-1.5 py-0.5 border rounded text-accent-strategy" style="border-color: var(--accent-strategy)">只读</span> 可以查看 ·
        <span class="inline-block mx-1.5 px-1.5 py-0.5 border rounded text-accent-warning" style="border-color: var(--accent-warning)">编辑</span> 可以查看和修改
        <br>
        <strong class="text-secondary">ALL</strong> 表示超级管理员，不能在这里修改。
      </div>
    </div>
  </main>
</Layout>

<style is:global>
  .users-back-btn {
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-text-tertiary);
    font-size: 12px;
    font-family: inherit;
    cursor: pointer;
  }
  .users-back-btn:hover { color: var(--color-text-primary); }

  .users-wrap {
    overflow-x: auto;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: var(--color-bg-primary);
  }
  .users-table {
    width: 100%;
    border-collapse: collapse;
    min-width: 700px;
    font-size: 13px;
  }
  .users-table thead th {
    text-align: left;
    padding: 10px 14px;
    background: var(--color-bg-secondary);
    border-bottom: 1px solid var(--color-border);
    font-weight: 500;
    font-size: 11px;
    color: var(--color-text-quaternary);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .users-table thead th.sticky-col {
    position: sticky; left: 0; z-index: 2;
    min-width: 220px;
  }
  .users-table tbody td {
    padding: 10px 14px;
    border-bottom: 1px solid var(--color-bg-tertiary);
    vertical-align: middle;
  }
  .users-table tbody tr:last-child td { border-bottom: 0; }
  .users-table tbody td.sticky-col {
    position: sticky; left: 0;
    background: var(--color-bg-primary);
    z-index: 1;
  }
  .users-table tbody tr:hover td { background: var(--color-bg-secondary); }
  .users-table tbody tr:hover td.sticky-col { background: var(--color-bg-secondary); }

  /* user 身份单元（头像 + email + meta） */
  .user-cell { display: flex; align-items: center; gap: 10px; }
  .user-avatar {
    flex-shrink: 0;
    width: 32px; height: 32px;
    border-radius: 999px;
    display: inline-flex; align-items: center; justify-content: center;
    color: white;
    font-weight: 600;
    font-size: 13px;
    font-family: -apple-system, "SF Pro Text", "PingFang SC", sans-serif;
    position: relative;
  }
  .user-avatar.is-super::after {
    content: '👑';
    position: absolute;
    top: -6px; right: -6px;
    font-size: 11px;
    line-height: 1;
  }
  .user-info { display: flex; flex-direction: column; min-width: 0; }
  .user-email {
    font-weight: 500;
    color: var(--color-text-primary);
    font-size: 13px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 180px;
  }
  .user-meta {
    font-size: 10.5px;
    color: var(--color-text-quaternary);
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    margin-top: 2px;
    display: flex;
    gap: 6px;
  }

  /* 权限三段 toggle */
  .perm-toggle {
    display: inline-flex;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    overflow: hidden;
    background: var(--color-bg-primary);
    height: 32px;
  }
  .perm-toggle button {
    all: unset;
    cursor: pointer;
    padding: 0 10px;
    min-width: 52px;
    font-size: 12px;
    line-height: 1;
    color: var(--color-text-quaternary);
    text-align: center;
    background: var(--color-bg-primary);
    transition: background 100ms, color 100ms;
    font-weight: 500;
    border-right: 1px solid var(--color-border);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .perm-toggle button:last-child { border-right: 0; }
  .perm-toggle button:hover { background: var(--color-bg-secondary); }
  .perm-toggle button.is-active {
    background: var(--color-text-primary);
    color: var(--color-bg-primary);
  }
  .perm-toggle button[disabled] {
    cursor: not-allowed;
    opacity: 0.5;
  }
  .perm-toggle.is-locked {
    background: var(--color-bg-secondary);
  }
  .perm-toggle.is-locked button { cursor: not-allowed; }

  /* 锁定 cell（super-admin 全列 ALL） */
  .perm-lock {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 0 12px;
    height: 32px;
    border: 1px solid var(--color-bg-tertiary);
    border-radius: 6px;
    background: var(--color-bg-secondary);
    color: var(--color-text-quaternary);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.05em;
  }

  /* v0.7.7 删除用户列 */
  .users-table th.action-col,
  .users-table td.action-col {
    text-align: right;
    padding-right: 14px;
    width: 80px;
  }
  .delete-user-btn {
    all: unset;
    cursor: pointer;
    padding: 6px 10px;
    border: 1px solid var(--color-bg-tertiary);
    border-radius: 6px;
    background: var(--color-bg-primary);
    color: var(--color-text-quaternary);
    font-size: 12px;
    font-weight: 500;
    transition: all 100ms;
  }
  .delete-user-btn:hover {
    border-color: var(--accent-warning);
    color: var(--accent-warning);
    background: var(--color-bg-secondary);
  }
  .delete-user-btn[disabled] {
    cursor: not-allowed;
    opacity: 0.4;
  }

  @media (max-width: 640px) {
    .user-email { max-width: 130px; }
  }
</style>

<script>
  // @ts-nocheck
  const $ = (s) => document.querySelector(s);
  const ACCENT_PALETTE = ['#34C759', '#FF9500', '#007AFF']; // ob / classic / strategy

  document.querySelectorAll('[data-back]').forEach((el) => {
    el.addEventListener('click', () => {
      if (window.history.length > 1) window.history.back();
      else window.location.href = '/';
    });
  });

  /** 简单 string hash → palette index（同 email 跨页一致） */
  function pickAccent(email) {
    let h = 0;
    for (let i = 0; i < email.length; i++) h = ((h << 5) - h + email.charCodeAt(i)) | 0;
    return ACCENT_PALETTE[Math.abs(h) % ACCENT_PALETTE.length];
  }

  function shortId(id) { return id ? id.slice(-6) : '?'; }
  function escapeHtml(s) {
    return String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c]));
  }
  function formatDate(iso) {
    if (!iso) return '—';
    const d = new Date(iso);
    return `${d.getMonth() + 1}/${d.getDate()}`;
  }

  let state = { users: [], disciplines: [] };

  function disciplineTitle(key) {
    return state.disciplines.find((d) => d.key === key)?.title_zh ?? key;
  }

  async function load() {
    const res = await fetch('/api/admin/users');
    if (!res.ok) {
      window.toast?.error('加载失败：' + res.status);
      return;
    }
    const data = await res.json();
    state.users = data.users;
    state.disciplines = data.disciplines;
    render();
    $('#loading').classList.add('hidden');
    $('#content').classList.remove('hidden');
  }

  function render() {
    $('#user-count').textContent = `共 ${state.users.length} 人`;

    // header — sticky 用户列 + 学科列 + 操作列
    const thead = $('#users-table thead tr');
    thead.innerHTML = '<th class="sticky-col">用户</th>' +
      state.disciplines.map((d) => `<th>${escapeHtml(d.title_zh)}</th>`).join('') +
      '<th class="action-col">操作</th>';

    const tbody = $('#users-table tbody');
    tbody.innerHTML = state.users.map((u) => {
      const accent = pickAccent(u.email);
      const initial = (u.email[0] ?? '?').toUpperCase();
      const cells = state.disciplines.map((d) => {
        if (u.is_super_admin) {
          return `<td><span class="perm-lock">ALL</span></td>`;
        }
        const cur = u.permissions[d.key] ?? null; // null/'guest'/'admin'
        return `<td>${renderToggle(u.id, d.key, cur)}</td>`;
      }).join('');

      // v0.7.7 删除按钮：super-admin 自己不可删
      const actionCell = u.is_super_admin
        ? '<td class="action-col"><span class="perm-lock">—</span></td>'
        : `<td class="action-col"><button type="button" class="delete-user-btn" data-delete-user-id="${u.id}" data-delete-user-email="${escapeHtml(u.email)}">删除</button></td>`;

      return `
        <tr data-user-id="${u.id}">
          <td class="sticky-col">
            <div class="user-cell">
              <span class="user-avatar ${u.is_super_admin ? 'is-super' : ''}" style="background:${accent}">${initial}</span>
              <div class="user-info">
                <div class="user-email" title="${u.email}">${u.email}</div>
                <div class="user-meta"><span>${shortId(u.id)}</span><span>·</span><span>加入 ${formatDate(u.created_at)}</span></div>
              </div>
            </div>
          </td>
          ${cells}
          ${actionCell}
        </tr>
      `;
    }).join('');

    bindToggles();
    bindDeleteButtons();
  }

  function bindDeleteButtons() {
    document.querySelectorAll('[data-delete-user-id]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const userId = btn.getAttribute('data-delete-user-id');
        const email = btn.getAttribute('data-delete-user-email');
        if (!userId) return;

        const ok = window.confirm(
          `永久删除 ${email}？\n\n` +
          `这会同时清除该用户的所有权限、学习记录、笔记等关联数据，且不可恢复。\n\n` +
          `（用户可以重新走 /signup 注册一个新账号，但旧数据不会回来）`,
        );
        if (!ok) return;

        btn.setAttribute('disabled', '');
        const res = await fetch(`/api/admin/users/${encodeURIComponent(userId)}`, {
          method: 'DELETE',
          headers: { 'content-type': 'application/json' },
        });
        const data = await res.json().catch(() => ({}));
        if (res.ok) {
          // 从 state 移除 + re-render
          state.users = state.users.filter((u) => u.id !== userId);
          render();
          window.toast?.success(`已删除 ${email}`);
        } else {
          btn.removeAttribute('disabled');
          window.toast?.error(`${data.reason ?? 'error'}: ${data.detail ?? ''}`.slice(0, 100));
        }
      });
    });
  }

  function renderToggle(userId, discKey, cur) {
    const states = [
      { val: null,    label: '无', title: '无权限' },
      { val: 'guest', label: '只读', title: '只读' },
      { val: 'admin', label: '编辑', title: '编辑' },
    ];
    return `<div class="perm-toggle" data-user-id="${userId}" data-discipline="${discKey}">${
      states.map((s) =>
        `<button type="button" data-role="${s.val ?? ''}" class="${cur === s.val ? 'is-active' : ''}" title="${s.title}">${s.label}</button>`,
      ).join('')
    }</div>`;
  }

  function bindToggles() {
    document.querySelectorAll('.perm-toggle').forEach((wrap) => {
      const userId = wrap.dataset.userId;
      const disc = wrap.dataset.discipline;
      wrap.querySelectorAll('button').forEach((btn) => {
        btn.addEventListener('click', async () => {
          if (btn.classList.contains('is-active')) return;
          const role = btn.dataset.role || null;
          // optimistic
          wrap.querySelectorAll('button').forEach((b) => b.classList.remove('is-active'));
          btn.classList.add('is-active');

          const res = await fetch(`/api/admin/users/${encodeURIComponent(userId)}/permission`, {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ discipline: disc, role: role || null }),
          });
          const data = await res.json().catch(() => ({}));
          if (res.ok) {
            // update local state
            const u = state.users.find((x) => x.id === userId);
            if (u) {
              if (role) u.permissions[disc] = role;
              else delete u.permissions[disc];
            }
            const u2 = state.users.find((x) => x.id === userId);
            const label = role === 'admin' ? '编辑权' : role === 'guest' ? '只读权' : '无权限';
            window.toast?.success(`${u2.email.split('@')[0]} · ${disciplineTitle(disc)} · ${label}`);
          } else {
            window.toast?.error(`${data.reason ?? 'error'}: ${data.detail ?? ''}`.slice(0, 80));
            // 失败 → 回滚 UI（重 render 这一格）
            const cur = state.users.find((x) => x.id === userId)?.permissions[disc] ?? null;
            wrap.querySelectorAll('button').forEach((b) => {
              b.classList.toggle('is-active', (b.dataset.role || null) === cur);
            });
          }
        });
      });
    });
  }

  load();
</script>
