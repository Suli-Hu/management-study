---
import '~/styles/global.css';
import Nav from '~/components/Nav.astro';
import Footer from '~/components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  currentDiscipline?: string;
  currentSection?: 'schools' | 'scholars' | 'kps' | 'search';
  /** 第三段面包屑（v0.5.52 学派 / v0.5.55 学者）— Nav 渲染时无视语义只填字 */
  currentLeafTitle?: string;
  /** 宽屏 split-pane 页用：让 main 独占视口剩余高度，右栏能真的占满。窄屏自动回退到正常滚动。 */
  fullHeight?: boolean;
}

const {
  title = '全学科学习笔记',
  description = '日本大学院入试备考知识库',
  currentDiscipline,
  currentSection,
  currentLeafTitle,
  fullHeight = false,
} = Astro.props;
const fullTitle = title === '全学科学习笔记' ? title : `${title} · 全学科学习笔记`;
---

<!doctype html>
<html lang="zh">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1a1a1c" media="(prefers-color-scheme: dark)" />
    <title>{fullTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      // v0.3.9 夜间模式：无闪烁初始化（在 body 渲染前确定 html.dark）
      (function () {
        try {
          const saved = localStorage.getItem('theme');
          const prefersDark = matchMedia('(prefers-color-scheme: dark)').matches;
          const isDark = saved ? saved === 'dark' : prefersDark;
          if (isDark) document.documentElement.classList.add('dark');
        } catch {}
      })();
    </script>
  </head>
  <body class:list={[
    'flex flex-col bg-bg-primary text-secondary',
    fullHeight ? 'h-screen lg:overflow-hidden' : 'min-h-screen',
  ]}>
    <Nav currentDiscipline={currentDiscipline} currentSection={currentSection} currentLeafTitle={currentLeafTitle} />
    <div class:list={['flex-1', fullHeight && 'lg:min-h-0 lg:overflow-hidden']}>
      <slot />
    </div>
    {!fullHeight && <Footer />}
  </body>
</html>
