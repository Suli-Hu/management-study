---
import '~/styles/global.css';
import Nav from '~/components/Nav.astro';
import Footer from '~/components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  currentDiscipline?: string;
  currentSection?: 'schools' | 'scholars' | 'kps' | 'search';
  /** 第三段面包屑（v0.5.52 学派 / v0.5.55 学者）— Nav 渲染时无视语义只填字 */
  currentLeafTitle?: string;
  /** 宽屏 split-pane 页用：让 main 独占视口剩余高度，右栏能真的占满。窄屏自动回退到正常滚动。 */
  fullHeight?: boolean;
}

const {
  title = 'sususu',
  description = '日本大学院入试备考知识库',
  currentDiscipline,
  currentSection,
  currentLeafTitle,
  fullHeight = false,
} = Astro.props;
const fullTitle = title === 'sususu' ? title : `${title} · sususu`;
---

<!doctype html>
<html lang="zh">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1a1a1c" media="(prefers-color-scheme: dark)" />
    <title>{fullTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {/* v0.5.98：sususu wordmark 用 Kalam 700 — 全站 preload 一次 */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Kalam:wght@700&display=swap" rel="stylesheet" />
    <script is:inline>
      // v0.3.9 夜间模式：无闪烁初始化（在 body 渲染前确定 html.dark）
      (function () {
        try {
          const saved = localStorage.getItem('theme');
          const prefersDark = matchMedia('(prefers-color-scheme: dark)').matches;
          const isDark = saved ? saved === 'dark' : prefersDark;
          if (isDark) document.documentElement.classList.add('dark');
        } catch {}
      })();
    </script>
  </head>
  <body class:list={[
    'flex flex-col bg-bg-primary text-secondary',
    fullHeight ? 'h-screen lg:overflow-hidden' : 'min-h-screen',
  ]}>
    <Nav currentDiscipline={currentDiscipline} currentSection={currentSection} currentLeafTitle={currentLeafTitle} />
    <div class:list={['flex-1', fullHeight && 'lg:min-h-0 lg:overflow-hidden']}>
      <slot />
    </div>
    {!fullHeight && <Footer />}

    {/* v0.5.88：全局 toast 系统 — 暴露 window.toast 给所有 inline script + module 用 */}
    <script>
      import { mountToastSystem } from '~/lib/toast-client';
      mountToastSystem();
    </script>

    {/* v0.5.91：编辑后两个 UX 收尾
        1) 编辑按钮 cooldown 拦截 — 90s 内同 KP 再点 → toast 阻断 + 倒计时
        2) just-edited 高亮 — 跳回带 ?just-edited=<id> 时，找卡 → 触发 ring 动效 */}
    <script>
      import { installEditButtonCooldownInterceptor, highlightJustEditedKp } from '~/lib/just-edited-client';
      installEditButtonCooldownInterceptor();
      highlightJustEditedKp();
    </script>

    {/* v0.5.92：站点更新感知 — 30s/次 polling sync_log，发现新版 toast 提示 */}
    <script>
      import { mountUpdateWatcher } from '~/lib/update-watcher-client';
      mountUpdateWatcher();
    </script>

    {/* v0.5.79：lang-toggle 全局拦截 — 把 ?lang=ja 链接的 click 改成 fetch + DOM 选择性 swap，
        保留滚动位置 + 已展开 <details>。FAB 与 Cmd+J 都 .click() anchor，自动经过此拦截。 */}
    <script>
      import { installLangToggleClickHook } from '~/lib/lang-toggle-client';
      installLangToggleClickHook();
    </script>
  </body>
</html>
