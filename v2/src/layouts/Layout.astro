---
import '~/styles/global.css';
import Nav from '~/components/Nav.astro';

interface Props {
  title?: string;
  description?: string;
  currentDiscipline?: string;
  currentSection?: 'schools' | 'scholars' | 'kps';
}

const {
  title = '全学科学习笔记',
  description = '日本大学院入试备考知识库',
  currentDiscipline,
  currentSection,
} = Astro.props;
const fullTitle = title === '全学科学习笔记' ? title : `${title} · 全学科学习笔记`;
---

<!doctype html>
<html lang="zh">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <title>{fullTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <Nav currentDiscipline={currentDiscipline} currentSection={currentSection} />
    <slot />
  </body>
</html>
