---
import { getDb } from '~/lib/db';
import Brand from '~/components/Brand.astro';
import Spotlight from '~/components/Spotlight.astro';

interface Props {
  currentDiscipline?: string;
  currentSection?: 'schools' | 'scholars' | 'kps' | 'search';
  currentLeafTitle?: string;
}

const { currentDiscipline, currentSection, currentLeafTitle } = Astro.props;
const user = Astro.locals.user;
const isGuest = Astro.locals.isGuest;

let disciplineTitle: string | null = null;
if (currentDiscipline) {
  const db = getDb(Astro.locals.runtime.env);
  const row = await db
    .prepare('SELECT title_zh FROM discipline WHERE key = ?')
    .bind(currentDiscipline)
    .first<{ title_zh: string }>();
  disciplineTitle = row?.title_zh ?? null;
}

const sections: Array<{ key: 'schools' | 'scholars' | 'kps'; label: string; href: string }> = currentDiscipline
  ? [
      { key: 'schools', label: '学派', href: `/${currentDiscipline}` },
      { key: 'scholars', label: '学者', href: `/${currentDiscipline}/scholars` },
      { key: 'kps', label: '知识点', href: `/${currentDiscipline}/kp` },
    ]
  : [];

const emailInitial = user?.email.charAt(0).toUpperCase() ?? '';

// v0.5.58 #7：brand link 智能 — 在学科内点 logo 回到该学科 overview（/{key}）
//                                 不在学科内（home）则保持 /
const brandHref = currentDiscipline ? `/${currentDiscipline}` : '/';
---

<nav class="sticky top-0 z-50 bg-bg-primary/90 backdrop-blur-sm border-b border-bg-tertiary">
  <div class="w-full pl-[18px] pr-4 h-12 flex items-center justify-between gap-3">
    <div class="flex items-center gap-1.5 text-sm shrink-0">
      <Brand href={brandHref} size="sm" />
      {/* v0.5.58 #5: 移动端只留 logo，所有面包屑（chev + discipline + leaf）在 < sm 全 hide */}
      {currentDiscipline && disciplineTitle && (
        <Fragment>
          <span class="text-quaternary text-xs hidden sm:inline">›</span>
          <a
            href={`/${currentDiscipline}`}
            class:list={[
              'text-xs no-underline hidden sm:inline',
              currentLeafTitle ? 'text-tertiary hover:text-primary' : 'text-primary font-medium',
            ]}
          >
            {disciplineTitle}
          </a>
        </Fragment>
      )}
      {currentLeafTitle && (
        <Fragment>
          <span class="text-quaternary text-xs hidden sm:inline">›</span>
          <span class="text-primary font-medium text-xs hidden sm:inline">
            {currentLeafTitle}
          </span>
        </Fragment>
      )}
    </div>

    {currentDiscipline && (
      <div class="flex flex-1 items-center justify-center gap-0.5 text-xs">
        {sections.map((s) => (
          <a
            href={s.href}
            class:list={[
              'px-2 py-1 rounded transition-colors no-underline',
              currentSection === s.key
                ? 'text-primary font-semibold bg-bg-tertiary'
                : 'text-tertiary hover:text-primary',
            ]}
          >
            {s.label}
          </a>
        ))}
      </div>
    )}

    <div class="flex items-center gap-1 text-xs shrink-0">
      {/* v0.5.59 #SearchModal: 搜索图标移到右侧（夜间模式按钮左侧），点开 Spotlight modal */}
      {currentDiscipline && (
        <button
          type="button"
          id="spotlight-trigger"
          aria-label="搜索 (⌘K / Ctrl+K)"
          title="搜索 (⌘K)"
          class="p-1 rounded text-tertiary hover:text-primary transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="7"></circle>
            <path d="m20 20-3.5-3.5"></path>
          </svg>
        </button>
      )}
      <button
        id="theme-toggle"
        type="button"
        aria-label="切换夜间模式"
        class="p-1 rounded text-tertiary hover:text-primary transition-colors"
        title="切换夜间模式"
      >
        <span data-theme-icon-light aria-hidden="true">☀︎</span>
        <span data-theme-icon-dark aria-hidden="true" class="hidden">☾</span>
      </button>
      {user ? (
        <div class="relative" id="user-menu-wrap">
          {isGuest ? (
            <button
              type="button"
              id="user-menu-trigger"
              aria-label="账户菜单"
              aria-haspopup="true"
              aria-expanded="false"
              title="访客（只读）— 点击打开菜单"
              class="inline-flex items-center px-2 py-0.5 rounded-full bg-bg-tertiary text-tertiary font-semibold cursor-pointer"
            >
              访客
            </button>
          ) : (
            <button
              type="button"
              id="user-menu-trigger"
              aria-label={`账户菜单 — ${user.email}`}
              aria-haspopup="true"
              aria-expanded="false"
              title={`${user.email} — 点击打开菜单`}
              class="inline-flex items-center justify-center w-7 h-7 rounded-full bg-accent-strategy text-white font-semibold text-xs cursor-pointer"
            >
              {emailInitial}
            </button>
          )}
          <div
            id="user-menu"
            role="menu"
            aria-labelledby="user-menu-trigger"
            class="hidden absolute right-0 top-full mt-1.5 min-w-[140px] rounded-md border bg-bg-primary shadow-card-hover overflow-hidden z-50"
          >
            <a
              href="/"
              role="menuitem"
              class="block px-3 py-2 text-xs text-secondary hover:bg-bg-secondary no-underline"
            >学科选择</a>
            <form method="POST" action="/api/auth/logout" class="block">
              <button
                type="submit"
                role="menuitem"
                class="block w-full text-left px-3 py-2 text-xs border-t border-bg-tertiary hover:bg-bg-secondary"
                style="color:#FF3B30"
              >退出登录</button>
            </form>
          </div>
        </div>
      ) : (
        <a
          href="/login"
          class="px-2 py-1 rounded text-tertiary hover:text-primary transition-colors no-underline"
        >
          登录
        </a>
      )}
    </div>
  </div>
</nav>

{currentDiscipline && (
  <Spotlight discipline={currentDiscipline} disciplineTitle={disciplineTitle ?? undefined} />
)}

<script is:inline>
  // v0.3.9 夜间模式 toggle
  (function () {
    const btn = document.getElementById('theme-toggle');
    if (!btn) return;
    const iconLight = btn.querySelector('[data-theme-icon-light]');
    const iconDark = btn.querySelector('[data-theme-icon-dark]');

    function render() {
      const isDark = document.documentElement.classList.contains('dark');
      iconLight?.classList.toggle('hidden', isDark);
      iconDark?.classList.toggle('hidden', !isDark);
      btn.setAttribute('aria-label', isDark ? '切换到日间模式' : '切换到夜间模式');
    }
    render();

    btn.addEventListener('click', () => {
      const next = !document.documentElement.classList.contains('dark');
      document.documentElement.classList.toggle('dark', next);
      localStorage.setItem('theme', next ? 'dark' : 'light');
      render();
    });
  })();

  // v0.5.59 Spotlight 触发按钮 → window.openSpotlight()（在 Spotlight.astro 里挂载）
  (function () {
    const btn = document.getElementById('spotlight-trigger');
    if (!btn) return;
    btn.addEventListener('click', () => {
      if (typeof window.openSpotlight === 'function') window.openSpotlight();
    });
  })();

  // v0.5.58 #6 用户菜单（学科选择 / 退出登录）
  (function () {
    const wrap = document.getElementById('user-menu-wrap');
    const trigger = document.getElementById('user-menu-trigger');
    const menu = document.getElementById('user-menu');
    if (!wrap || !trigger || !menu) return;

    function open() {
      menu.classList.remove('hidden');
      trigger.setAttribute('aria-expanded', 'true');
    }
    function close() {
      menu.classList.add('hidden');
      trigger.setAttribute('aria-expanded', 'false');
    }
    function toggle() {
      if (menu.classList.contains('hidden')) open(); else close();
    }

    trigger.addEventListener('click', (e) => {
      e.stopPropagation();
      toggle();
    });
    document.addEventListener('click', (e) => {
      if (!menu.classList.contains('hidden') && !wrap.contains(e.target)) close();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.classList.contains('hidden')) close();
    });
  })();
</script>
