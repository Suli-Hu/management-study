---
/**
 * SchoolCard — 视图系统学派卡（CardWhite 风格："Tinted Badge"）
 *
 * 设计稿对齐：bundle/9661d5b3 CardWhite
 *   - 白底 / 圆角 10 / border #ececec / padding 13×14
 *   - 学派名 fontSize 15 fontWeight 600 #171717 letterSpacing 0.01em
 *   - 英文名 fontSize 12 #525252（设计稿写 fontWeight 450，CSS 写 400 即可，weight 450 不是 valid keyword）
 *   - meta（era / count / 等）fontSize 11 #a3a3a3 lineHeight 1.5
 *   - 右上角 TintedBadge（minWidth 26 / height 19 / radius 999 / soft 底 deep 字）
 *   - hover：border #d4d4d4 + shadow
 */

import type { Tone } from '~/lib/tag-tone';

interface Props {
  href: string;
  cn: string;
  en?: string | null;
  meta?: string;
  count: number;
  tone: Tone;
}

const { href, cn, en, meta, count, tone } = Astro.props;
---

<a href={href} class="school-card" data-school-card>
  <div class="sc-body">
    <div class="sc-cn">{cn}</div>
    {en && <div class="sc-en">{en}</div>}
    {meta && <div class="sc-meta">{meta}</div>}
  </div>
  <span
    class="sc-badge"
    style={`background:${tone.soft};color:${tone.deep};`}
  >{count}</span>
</a>

<style>
  .school-card {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    background: #ffffff;
    border-radius: 10px;
    border: 1px solid #ececec;
    padding: 13px 14px;
    text-decoration: none;
    transition: border-color .14s, box-shadow .14s, transform .14s;
    cursor: pointer;
    font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", system-ui, sans-serif;
  }
  .school-card:hover {
    border-color: #d4d4d4;
    box-shadow: 0 1px 2px rgba(0,0,0,0.04), 0 4px 12px rgba(0,0,0,0.04);
    opacity: 1;          /* 抵消 global a:hover { opacity: 0.8 } */
  }
  :global(html.dark) .school-card {
    background: var(--color-bg-secondary);
    border-color: var(--color-border);
  }
  :global(html.dark) .school-card:hover {
    border-color: var(--color-text-quaternary);
    box-shadow: 0 1px 2px rgba(0,0,0,0.3), 0 4px 12px rgba(0,0,0,0.3);
  }
  .sc-body { flex: 1; min-width: 0; }
  .sc-cn {
    font-size: 15px;
    font-weight: 600;
    color: #171717;
    letter-spacing: 0.01em;
    line-height: 1.3;
  }
  :global(html.dark) .sc-cn { color: var(--color-text-primary); }
  .sc-en {
    font-size: 12px;
    color: #525252;
    margin-top: 4px;
    font-weight: 400;
  }
  :global(html.dark) .sc-en { color: var(--color-text-tertiary); }
  .sc-meta {
    font-size: 11px;
    color: #a3a3a3;
    margin-top: 4px;
    line-height: 1.5;
  }
  :global(html.dark) .sc-meta { color: var(--color-text-quaternary); }
  .sc-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 26px;
    height: 19px;
    padding: 0 8px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.2px;
    font-variant-numeric: tabular-nums;
    flex-shrink: 0;
  }
</style>
