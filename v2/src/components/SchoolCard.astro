---
/**
 * SchoolCard — 视图系统学派卡（CardWhite 风格："Tinted Badge"）
 *
 * v0.8.20 fix: 学派色 source 切到 user-defined hex (resolveAccentForSchool)
 *   - chip 1 (v0.8.12) 的 hashToTagToken 路径错 — 把 school.key hash 到 8 OKLCH token，
 *     ignore discipline.tags[].color 真实 hex
 *   - 现 accentHex 走 inline style={`--accent: ${hex}`}，CSS 用 oklch(from var(--accent) ...)
 *   - accentHex='var(--text-3)' (无 tag 学派 fallback) 时 oklch from var(--text-3) 退中性
 */

interface Props {
  href: string;
  /** v0.10.0: school key — 用于拖拽 reorder 时识别 (data-school-key) */
  schoolKey: string;
  cn: string;
  en?: string | null;
  meta?: string;
  count: number;
  /**
   * Page chrome accent hex (e.g. '#10B981') 或 'var(--text-3)' fallback。
   * 由 resolveAccentForSchool(school, discipline) 解析。
   */
  accentHex: string;
}

const { href, schoolKey, cn, en, meta, count, accentHex } = Astro.props;
const isNeutral = accentHex.startsWith('var(');
---

<a
  href={href}
  class="school-card"
  data-school-card
  data-school-key={schoolKey}
  data-accent-neutral={isNeutral ? 'true' : undefined}
  style={`--accent: ${accentHex}`}
>
  <div class="sc-body">
    <div class="sc-cn">{cn}</div>
    {en && <div class="sc-en">{en}</div>}
    {meta && <div class="sc-meta">{meta}</div>}
  </div>
  <span class="sc-badge">{count}</span>
</a>

<style>
  .school-card {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    background: var(--bg-elev);
    border-radius: 10px;
    border: 1px solid var(--border);
    padding: 13px 14px;
    text-decoration: none;
    transition: border-color .14s, box-shadow .14s, transform .14s;
    cursor: pointer;
    font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", system-ui, sans-serif;
  }
  .school-card:hover {
    border-color: var(--text-3);
    box-shadow: 0 1px 2px rgba(0,0,0,0.04), 0 4px 12px rgba(0,0,0,0.04);
    opacity: 1;          /* 抵消 global a:hover { opacity: 0.8 } */
  }
  :global(html.dark) .school-card:hover,
  :global([data-mode="dark"]) .school-card:hover {
    box-shadow: 0 1px 2px rgba(0,0,0,0.3), 0 4px 12px rgba(0,0,0,0.3);
  }
  .sc-body { flex: 1; min-width: 0; }
  .sc-cn {
    font-size: 15px;
    font-weight: 600;
    color: var(--text);
    letter-spacing: 0.01em;
    line-height: 1.3;
  }
  .sc-en {
    font-size: 12px;
    color: var(--text-2);
    margin-top: 4px;
    font-weight: 400;
  }
  .sc-meta {
    font-size: 11px;
    color: var(--text-3);
    margin-top: 4px;
    line-height: 1.5;
  }
  .sc-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 26px;
    height: 19px;
    padding: 0 8px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.2px;
    font-variant-numeric: tabular-nums;
    flex-shrink: 0;
    /* 学派 tag 着色（v0.8.20: discipline.tags[].color hex via inline --accent） */
    background: oklch(from var(--accent) l c h / 0.18);
    color: oklch(from var(--accent) calc(l - 0.40) c h);
  }
  /* 无 tag 学派 fallback — accentHex='var(--text-3)' 不是 hex，oklch(from var(--text-3) ...) 计算
     L≈0.65 OKLCH 灰，calc(l - 0.40) 退到 ≈0.25 深灰；视觉跟原中性 fallback 一致。 */
  .school-card[data-accent-neutral] .sc-badge {
    background: var(--bg-soft);
    color: var(--text-2);
  }

  /* Dark mode badge 提亮（base l ≈ 0.75，calc(l + 0.15) ≈ 0.90 在 dark bg 上对比足） */
  :global([data-mode="dark"]) .school-card .sc-badge {
    background: oklch(from var(--accent) l c h / 0.22);
    color: oklch(from var(--accent) calc(l + 0.15) c h);
  }
  :global([data-mode="dark"]) .school-card[data-accent-neutral] .sc-badge {
    background: var(--bg-soft);
    color: var(--text-2);
  }
</style>
