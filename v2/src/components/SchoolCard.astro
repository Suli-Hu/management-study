---
/**
 * SchoolCard — 视图系统学派卡（CardWhite 风格："Tinted Badge"）
 *
 * v0.8.12 Stage 6 chip 1: 切 v1.0 token + tag-* data-attr 着色
 *   - 卡身：--bg-elev / --border / --text / --text-2 / --text-3（dark 自动反相）
 *   - badge 着色：data-tag={tagToken} → CSS 选择器 [data-tag="tag-mgmt"] etc.
 *     使用 oklch(from --tag-* l c h / 0.15) soft 底 + calc(l - 0.35) deep 字（v1.0 IMPLEMENTATION）
 *   - tagToken=null 时退中性灰
 */

interface Props {
  href: string;
  cn: string;
  en?: string | null;
  meta?: string;
  count: number;
  /** v1.0 tag token name (without `--`), e.g. 'tag-mgmt'. null = neutral gray. */
  tagToken?: string | null;
}

const { href, cn, en, meta, count, tagToken } = Astro.props;
---

<a
  href={href}
  class="school-card"
  data-school-card
  {...(tagToken ? { 'data-tag': tagToken } : {})}
>
  <div class="sc-body">
    <div class="sc-cn">{cn}</div>
    {en && <div class="sc-en">{en}</div>}
    {meta && <div class="sc-meta">{meta}</div>}
  </div>
  <span class="sc-badge">{count}</span>
</a>

<style>
  .school-card {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    background: var(--bg-elev);
    border-radius: 10px;
    border: 1px solid var(--border);
    padding: 13px 14px;
    text-decoration: none;
    transition: border-color .14s, box-shadow .14s, transform .14s;
    cursor: pointer;
    font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", system-ui, sans-serif;
  }
  .school-card:hover {
    border-color: var(--text-3);
    box-shadow: 0 1px 2px rgba(0,0,0,0.04), 0 4px 12px rgba(0,0,0,0.04);
    opacity: 1;          /* 抵消 global a:hover { opacity: 0.8 } */
  }
  :global(html.dark) .school-card:hover,
  :global([data-mode="dark"]) .school-card:hover {
    box-shadow: 0 1px 2px rgba(0,0,0,0.3), 0 4px 12px rgba(0,0,0,0.3);
  }
  .sc-body { flex: 1; min-width: 0; }
  .sc-cn {
    font-size: 15px;
    font-weight: 600;
    color: var(--text);
    letter-spacing: 0.01em;
    line-height: 1.3;
  }
  .sc-en {
    font-size: 12px;
    color: var(--text-2);
    margin-top: 4px;
    font-weight: 400;
  }
  .sc-meta {
    font-size: 11px;
    color: var(--text-3);
    margin-top: 4px;
    line-height: 1.5;
  }
  .sc-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 26px;
    height: 19px;
    padding: 0 8px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.2px;
    font-variant-numeric: tabular-nums;
    flex-shrink: 0;
    /* default neutral — 学派无 tag 时退中性灰 */
    background: var(--bg-soft);
    color: var(--text-2);
  }
  /* 学派 tag 着色（D6=A，按 discipline.tags[].key 映射 8 token） */
  .school-card[data-tag="tag-mgmt"]   .sc-badge { background: oklch(from var(--tag-mgmt)   l c h / 0.18); color: oklch(from var(--tag-mgmt)   calc(l - 0.40) c h); }
  .school-card[data-tag="tag-mkt"]    .sc-badge { background: oklch(from var(--tag-mkt)    l c h / 0.18); color: oklch(from var(--tag-mkt)    calc(l - 0.40) c h); }
  .school-card[data-tag="tag-soc"]    .sc-badge { background: oklch(from var(--tag-soc)    l c h / 0.18); color: oklch(from var(--tag-soc)    calc(l - 0.40) c h); }
  .school-card[data-tag="tag-purple"] .sc-badge { background: oklch(from var(--tag-purple) l c h / 0.18); color: oklch(from var(--tag-purple) calc(l - 0.40) c h); }
  .school-card[data-tag="tag-pink"]   .sc-badge { background: oklch(from var(--tag-pink)   l c h / 0.18); color: oklch(from var(--tag-pink)   calc(l - 0.40) c h); }
  .school-card[data-tag="tag-cyan"]   .sc-badge { background: oklch(from var(--tag-cyan)   l c h / 0.18); color: oklch(from var(--tag-cyan)   calc(l - 0.40) c h); }
  .school-card[data-tag="tag-blue"]   .sc-badge { background: oklch(from var(--tag-blue)   l c h / 0.18); color: oklch(from var(--tag-blue)   calc(l - 0.40) c h); }
  .school-card[data-tag="tag-orange"] .sc-badge { background: oklch(from var(--tag-orange) l c h / 0.18); color: oklch(from var(--tag-orange) calc(l - 0.40) c h); }

  /* Dark mode: badge 文字提亮（base l ≈ 0.75，calc(l + 0.15) ≈ 0.90 在 dark bg 18% alpha 上对比足）*/
  :global([data-mode="dark"]) .school-card[data-tag="tag-mgmt"]   .sc-badge { background: oklch(from var(--tag-mgmt)   l c h / 0.22); color: oklch(from var(--tag-mgmt)   calc(l + 0.15) c h); }
  :global([data-mode="dark"]) .school-card[data-tag="tag-mkt"]    .sc-badge { background: oklch(from var(--tag-mkt)    l c h / 0.22); color: oklch(from var(--tag-mkt)    calc(l + 0.15) c h); }
  :global([data-mode="dark"]) .school-card[data-tag="tag-soc"]    .sc-badge { background: oklch(from var(--tag-soc)    l c h / 0.22); color: oklch(from var(--tag-soc)    calc(l + 0.15) c h); }
  :global([data-mode="dark"]) .school-card[data-tag="tag-purple"] .sc-badge { background: oklch(from var(--tag-purple) l c h / 0.22); color: oklch(from var(--tag-purple) calc(l + 0.15) c h); }
  :global([data-mode="dark"]) .school-card[data-tag="tag-pink"]   .sc-badge { background: oklch(from var(--tag-pink)   l c h / 0.22); color: oklch(from var(--tag-pink)   calc(l + 0.15) c h); }
  :global([data-mode="dark"]) .school-card[data-tag="tag-cyan"]   .sc-badge { background: oklch(from var(--tag-cyan)   l c h / 0.22); color: oklch(from var(--tag-cyan)   calc(l + 0.15) c h); }
  :global([data-mode="dark"]) .school-card[data-tag="tag-blue"]   .sc-badge { background: oklch(from var(--tag-blue)   l c h / 0.22); color: oklch(from var(--tag-blue)   calc(l + 0.15) c h); }
  :global([data-mode="dark"]) .school-card[data-tag="tag-orange"] .sc-badge { background: oklch(from var(--tag-orange) l c h / 0.22); color: oklch(from var(--tag-orange) calc(l + 0.15) c h); }
</style>
