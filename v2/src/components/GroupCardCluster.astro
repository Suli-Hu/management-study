---
/**
 * GroupCardCluster — 视图分组容器（设计稿 LAYOUT A · 软灰底卡）
 *
 * 设计稿对齐：bundle/8547ef6c GroupCardCluster
 *   - 软灰底 #fafaf9 / border #f1f1f0 / radius 14 / padding 10 14 14
 *   - GroupHeader：chevron + title 13/600 #262626 + flow 11 #a3a3a3 + count badge 11 #a3a3a3 / bg #f5f5f4
 *   - 折叠用 grid-template-rows 0fr/1fr 过渡（保留 height 动画）
 *   - 内部 grid 2 列 gap 10 paddingTop 10
 *
 * 折叠状态用 <details> 实现（无 JS），open 默认。
 * Astro 静态 SSR：children = SchoolCard[]，由父页面拼好传入 slot。
 */

interface Props {
  title: string;
  flow?: string;
  count: number;
  groupId: string;
  columns?: number;       // 默认 2
  /** v0.10.0: editable mode → school grid 加 data-reorder-kind 让 drag-reorder-client 接管 */
  editable?: boolean;
}

const { title, flow, count, groupId, columns = 2, editable = false } = Astro.props;
---

<details class="group-cluster" open data-group-id={groupId}>
  <summary class="gc-header">
    <svg class="gc-chev" width="12" height="12" viewBox="0 0 12 12" fill="none">
      {/* v0.8.12 Stage 6 chip 1: stroke 用 currentColor，颜色由 .gc-chev color 控制 */}
      <path d="M4 2.5l3.5 3.5L4 9.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
    <div class="gc-titles">
      <div class="gc-title">{title}</div>
      {flow && <div class="gc-flow">{flow}</div>}
    </div>
    <span class="gc-count">{count}</span>
  </summary>
  <div
    class="gc-body"
    style={`--cols:${columns}`}
    data-reorder-kind={editable ? 'view-group-schools' : undefined}
    data-group-id={editable ? groupId : undefined}
  >
    <slot />
  </div>
</details>

<style>
  /* v0.8.12 Stage 6 chip 1: GroupCardCluster 切 v1.0 token */
  .group-cluster {
    background: var(--bg-soft);
    border: 1px solid var(--border-soft);
    border-radius: 14px;
    padding: 10px 14px 14px;
    font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", system-ui, sans-serif;
  }

  /* 隐藏默认 ▶ 三角 */
  .gc-header { list-style: none; cursor: pointer; }
  .gc-header::-webkit-details-marker { display: none; }
  .gc-header {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 4px;
    color: var(--text-2);
  }

  /* chevron 旋转：合上=0deg, 展开=90deg；颜色继承 .gc-header */
  .gc-chev {
    flex-shrink: 0;
    transform: rotate(0deg);
    transition: transform .18s ease;
  }
  .group-cluster[open] .gc-chev { transform: rotate(90deg); }

  .gc-titles { flex: 1; min-width: 0; }
  .gc-title {
    font-size: 13px;
    font-weight: 600;
    color: var(--text);
    letter-spacing: 0.02em;
  }
  .gc-flow {
    font-size: 11px;
    color: var(--text-3);
    margin-top: 2px;
    font-weight: 400;
  }
  .gc-count {
    font-size: 11px;
    color: var(--text-3);
    font-variant-numeric: tabular-nums;
    padding: 2px 8px;
    border-radius: 999px;
    background: var(--bg-elev);
  }

  .gc-body {
    display: grid;
    grid-template-columns: repeat(var(--cols, 2), 1fr);
    gap: 10px;
    padding-top: 10px;
  }
  /* 窄屏单列 */
  @media (max-width: 720px) {
    .gc-body { grid-template-columns: 1fr; }
  }
</style>
