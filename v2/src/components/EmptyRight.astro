---
/**
 * 学派详情 / 学者详情 split-pane 右栏空态。
 *
 * 当左栏 KP 列表为空（kps.length === 0）时占位。
 * 颜色随 accent 走（学派 / 学者各自的 accent token）。
 */
interface Props {
  accentHex: string;
  kind: 'school' | 'scholar';
  name: string;
  addHref?: string;
  hint?: string;
}

const { accentHex, kind, name, addHref, hint } = Astro.props;
const label = kind === 'school' ? '学派' : '学者';
const tip = hint ?? (kind === 'school'
  ? '这个学派下还没有添加任何知识点。'
  : '这位学者下还没有添加任何知识点。');
---

<div class="empty-right" style={`--accent:${accentHex}`}>
  <div class="empty-rings" aria-hidden="true">
    <div class="empty-ring r1"></div>
    <div class="empty-ring r2"></div>
    <div class="empty-ring r3"></div>
    <div class="empty-dot" style={`background:${accentHex}`}></div>
  </div>
  <div class="empty-meta">
    <div class="empty-eyebrow" style={`color:${accentHex}`}>
      <span class="empty-eyebrow-dot" style={`background:${accentHex}`}></span>
      {label} · 暂无知识点
    </div>
    {name && <div class="empty-name">{name}</div>}
    <p class="empty-tip">{tip}</p>
  </div>
  {addHref && (
    <a
      href={addHref}
      class="empty-cta"
      style={`border-color:${accentHex};color:${accentHex}`}
    >
      <span class="empty-cta-plus">+</span> 添加第一条知识点
    </a>
  )}
</div>
