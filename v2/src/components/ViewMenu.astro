---
/**
 * ViewMenu — 视图 chip ··· 弹出菜单（设计稿 bundle/25504af6 ViewMenu）
 *
 * 设计稿对齐：
 *   - 浮层：白底 / border #ececec / radius 10 / padding 4 / shadow 0 8 32 rgba(0,0,0,0.10)
 *   - minWidth 180 / fontSize 13
 *   - 项目：编辑视图 / 复制为新视图 / ── / 删除视图
 *   - active=auto kind 时禁 "编辑视图"（v0.5.66 我们没 auto，所以这条禁用规则不触发）
 *   - 默认视图禁 "删除"
 *   - 锚点：chip 右下方 top: rect.bottom+6, left: rect.left-80
 *
 * 触发：监听 document.dispatchEvent('view:menu', { detail: { viewId, viewName, isDefault, anchor }})
 */

interface Props {
  discipline: string;
}
const { discipline } = Astro.props;
---

<div id="view-menu-root" class="vm-root hidden" data-discipline={discipline}>
  <div class="vm-overlay" data-vm-close></div>
  <div class="vm-card" role="menu" aria-labelledby="vm-card-label">
    <button type="button" class="vm-item" data-vm-action="edit">编辑视图</button>
    <button type="button" class="vm-item" data-vm-action="editInfo">编辑视图说明</button>
    <button type="button" class="vm-item" data-vm-action="duplicate">复制为新视图</button>
    <div class="vm-sep"></div>
    <button type="button" class="vm-item vm-danger" data-vm-action="delete">删除视图</button>
  </div>
</div>

<style>
  .vm-root.hidden { display: none; }
  .vm-root { position: fixed; inset: 0; z-index: 90; }
  .vm-overlay { position: fixed; inset: 0; }
  .vm-card {
    position: fixed;
    background: #ffffff;
    border: 1px solid #ececec;
    border-radius: 10px;
    padding: 4px;
    box-shadow: 0 8px 32px rgba(0,0,0,0.10);
    min-width: 180px;
    font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", system-ui, sans-serif;
    font-size: 13px;
    z-index: 91;
  }
  :global(html.dark) .vm-card {
    background: var(--color-bg-secondary);
    border-color: var(--color-border);
    box-shadow: 0 8px 32px rgba(0,0,0,0.5);
  }
  .vm-item {
    all: unset;
    box-sizing: border-box;
    cursor: pointer;
    display: block;
    width: 100%;
    padding: 7px 10px;
    border-radius: 6px;
    color: #262626;
  }
  :global(html.dark) .vm-item { color: var(--color-text-primary); }
  .vm-item:hover { background: #f5f5f4; }
  :global(html.dark) .vm-item:hover { background: var(--color-bg-tertiary); }
  .vm-item[disabled] {
    cursor: not-allowed;
    color: #d4d4d4;
  }
  .vm-item[disabled]:hover { background: transparent; }
  :global(html.dark) .vm-item[disabled] { color: var(--color-border); }
  .vm-sep {
    height: 1px;
    background: #f1f1f0;
    margin: 4px 0;
  }
  :global(html.dark) .vm-sep { background: var(--color-border); }

  .vm-danger { color: #dc2626 !important; }
  .vm-danger:hover { background: #fef2f2 !important; }
  :global(html.dark) .vm-danger:hover { background: rgba(239,68,68,0.15) !important; }
</style>

<script is:inline>
  (() => {
    const root = document.getElementById('view-menu-root');
    if (!root) return;
    const card = root.querySelector('.vm-card');
    const overlay = root.querySelector('.vm-overlay');
    const discipline = root.getAttribute('data-discipline');
    let ctx = null;   // { viewId, viewName, isDefault }

    function open(detail) {
      if (!card) return;
      ctx = detail;
      // 先放好定位
      card.style.top = detail.anchor.top + 'px';
      card.style.left = detail.anchor.left + 'px';
      // 设置项目可用状态
      const editBtn = card.querySelector('[data-vm-action="edit"]');
      const editInfoBtn = card.querySelector('[data-vm-action="editInfo"]');
      const dupBtn = card.querySelector('[data-vm-action="duplicate"]');
      const delBtn = card.querySelector('[data-vm-action="delete"]');
      if (delBtn) {
        delBtn.toggleAttribute('disabled', !!detail.isDefault);
        delBtn.title = detail.isDefault ? '默认视图不能删除' : '';
      }
      // editInfo / edit / duplicate 都允许（auto kind 暂不存在）
      [editBtn, editInfoBtn, dupBtn].forEach((b) => b && b.removeAttribute('disabled'));
      root.classList.remove('hidden');
    }
    function close() {
      root.classList.add('hidden');
      ctx = null;
    }
    overlay && overlay.addEventListener('click', close);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !root.classList.contains('hidden')) close();
    });
    document.addEventListener('view:menu', (e) => {
      const d = e && e.detail;
      if (!d) return;
      open(d);
    });

    // 项目 click
    card && card.querySelectorAll('[data-vm-action]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        if (!ctx) return;
        const action = btn.getAttribute('data-vm-action');
        const { viewId, viewName, isDefault } = ctx;
        close();
        if (action === 'edit') {
          document.dispatchEvent(new CustomEvent('view:editor', { detail: { viewId } }));
        } else if (action === 'editInfo') {
          document.dispatchEvent(new CustomEvent('view:infoEditor', { detail: { viewId } }));
        } else if (action === 'duplicate') {
          await duplicateView(viewId, viewName);
        } else if (action === 'delete') {
          if (isDefault) return;   // 防御
          await deleteView(viewId, viewName);
        }
      });
    });

    async function duplicateView(viewId) {
      try {
        // 拿源视图 JSON
        const r = await fetch(`/api/edit/view/${discipline}/${viewId}`);
        if (!r.ok) {
          const data = await r.json().catch(() => ({}));
          alert(`复制失败：拉源视图 ${r.status} ${data.reason ?? ''}`);
          return;
        }
        const { json: src } = await r.json();
        const newId = `${src.id}-copy-${Date.now().toString(36).slice(-5)}`;
        const now = new Date().toISOString();
        const copy = {
          ...src,
          id: newId,
          name: src.name + ' 副本',
          isDefault: false,
          position: 9999,   // sync 时由 reorder 修正，先放尾巴
          createdAt: now,
          updatedAt: now,
        };
        const post = await fetch('/api/new/view', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ json: copy }),
        });
        if (!post.ok) {
          const data = await post.json().catch(() => ({}));
          alert(`复制失败：${post.status} ${data.reason ?? ''}`);
          return;
        }
        document.dispatchEvent(new CustomEvent('view:toast', { detail: '已复制为新视图（~90s 后线上生效）' }));
      } catch (err) {
        alert(`复制失败：${(err && err.message) || err}`);
      }
    }

    async function deleteView(viewId, viewName) {
      if (!confirm(`确认删除视图「${viewName}」？\n\n• 不影响学派本体\n• 可在 git history 找回\n• ~90s 后线上生效`)) return;
      try {
        // DELETE 需要 base_sha
        const g = await fetch(`/api/edit/view/${discipline}/${viewId}`);
        if (!g.ok) {
          const data = await g.json().catch(() => ({}));
          alert(`删除失败：${g.status} ${data.reason ?? ''}`);
          return;
        }
        const { base_sha } = await g.json();
        const d = await fetch(`/api/edit/view/${discipline}/${viewId}`, {
          method: 'DELETE',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ base_sha }),
        });
        if (!d.ok) {
          const data = await d.json().catch(() => ({}));
          alert(`删除失败：${d.status} ${data.reason ?? ''} ${data.detail ?? ''}`);
          return;
        }
        document.dispatchEvent(new CustomEvent('view:toast', { detail: '已删除视图' }));
        setTimeout(() => location.href = `/${discipline}`, 800);
      } catch (err) {
        alert(`删除失败：${(err && err.message) || err}`);
      }
    }
  })();
</script>
