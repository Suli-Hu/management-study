---
/**
 * ViewEditor — 视图编辑器（v0.5.81 重设计：select-group + search-check 模式）
 *
 * 旧模式：左分组 + 右"未包含"池子，HTML5 drag-drop 学派进分组。
 * 用户反馈：拖拽不直观、搜不了、移动端难操作。
 * 新模式：
 *   1. 左侧分组卡，点击选中（is-selected 高亮）。
 *   2. 右侧根据 selectedGroup 显示「向 X 添加学派」+ 搜索框 + 全 schools checkbox 列表。
 *   3. 勾选 → 学派进当前分组（如果已在另一分组，会自动从那移过来）；取消勾选 → 学派回到"未包含"。
 *   4. 列表项右侧 hint 显示状态：已加入 / 在 OO 分组 / 未包含。
 *   5. 分组卡内 chip 仍可见 + 单个 × 移除。
 *
 * 同时保留：
 *   - icon / 视图名 / 视图说明 编辑（顶部 head）
 *   - 添加分组 / 移除分组 按钮
 *   - Esc 关闭 / 取消保存
 *
 * Astro scope 防呆：所有 .ve-* 走 <style is:global> 配 `.ve-root` 前缀。
 */

interface Props {
  discipline: string;
  allSchools: Array<{ key: string; cn: string }>;
}
const { discipline, allSchools } = Astro.props;
---

<div id="view-editor" class="ve-root hidden" data-discipline={discipline}
     data-all-schools={JSON.stringify(allSchools)}>
  <div class="ve-overlay" data-ve-close></div>
  <div class="ve-modal">
    {/* === Header === */}
    <div class="ve-head">
      <div class="ve-head-row">
        <button type="button" class="ve-icon-trigger" data-ve-icon-trigger title="点击更换图标" aria-label="选择图标">📚</button>
        <div class="ve-head-name-block">
          <div class="ve-eyebrow">视图名称</div>
          <input class="ve-name-input" data-ve-name placeholder="例：组织论六阶段" />
        </div>
        <div class="ve-head-actions">
          <button type="button" class="ve-btn-ghost" data-ve-close>取消</button>
          <button type="button" class="ve-btn-primary" data-ve-save>保存</button>
        </div>
        <div class="ve-icon-pop hidden" data-ve-icon-pop>
          {['📚','🗺️','⏳','🌏','⭐','🎯','🧭','🔬','💡','📖','🏛️','🔖'].map((emoji) => (
            <button type="button" class="ve-icon-pick" data-ve-icon-pick={emoji}>{emoji}</button>
          ))}
        </div>
      </div>
      <div class="ve-desc-block">
        <div class="ve-eyebrow">视图说明</div>
        <textarea class="ve-desc-input" data-ve-desc rows="2"
          placeholder="一句话说明这个视图的用途 / 分类逻辑（如「按时代演进将组织论划分为六阶段」）"></textarea>
      </div>
    </div>

    {/* === Body: groups (left) | search-check (right) === */}
    <div class="ve-body">
      <div class="ve-left">
        <div class="ve-left-hint">点选左侧分组 → 在右侧搜索勾选学派</div>
        <div class="ve-groups" data-ve-groups>
          {/* 动态注入 */}
        </div>
        <button type="button" class="ve-add-group" data-ve-add-group>
          <span class="ve-add-group-plus">+</span> 添加分组
        </button>
      </div>
      <div class="ve-right">
        <div class="ve-right-empty" data-ve-right-empty>
          <div class="ve-right-empty-icon">←</div>
          <div class="ve-right-empty-text">选中左侧分组开始添加学派</div>
        </div>
        <div class="ve-right-active hidden" data-ve-right-active>
          <div class="ve-right-head">
            <div class="ve-eyebrow">向以下分组添加学派</div>
            <div class="ve-right-name" data-ve-right-name></div>
            <div class="ve-right-stat" data-ve-right-stat></div>
          </div>
          <div class="ve-right-search-wrap">
            <span class="ve-right-search-icon" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
            </span>
            <input class="ve-right-search" data-ve-right-search type="search" placeholder="搜索学派名（中文 / key）..." autocomplete="off" />
          </div>
          <div class="ve-right-list" data-ve-right-list>
            {/* 动态注入：checkbox 行列表 */}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style is:global>
  /* === v0.5.81：所有 .ve-* 走 is:global，因 dynamic innerHTML 元素拿不到 Astro cid。
     防泄漏靠 `.ve-root` 前缀 namespace。 === */

  .ve-root {
    position: fixed; inset: 0; z-index: 100;
    font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", system-ui, sans-serif;
  }
  .ve-root.hidden { display: none; }
  .ve-root .ve-overlay {
    position: absolute; inset: 0;
    background: rgba(10,10,10,0.45);
    -webkit-backdrop-filter: blur(2px);
    backdrop-filter: blur(2px);
  }
  .ve-root .ve-modal {
    position: absolute; inset: 40px;
    background: #fafaf9;
    border-radius: 16px;
    overflow: hidden;
    display: flex; flex-direction: column;
    box-shadow: 0 30px 80px rgba(0,0,0,0.25);
  }
  html.dark .ve-root .ve-modal { background: var(--color-bg-secondary); }
  @media (max-width: 720px) {
    .ve-root .ve-modal { inset: 8px; border-radius: 12px; }
  }

  /* === Header === */
  .ve-root .ve-head {
    padding: 14px 20px 16px;
    border-bottom: 1px solid #ececec;
    background: #fff;
    flex-shrink: 0;
  }
  html.dark .ve-root .ve-head {
    background: var(--color-bg-primary);
    border-bottom-color: var(--color-border);
  }
  .ve-root .ve-head-row {
    display: flex;
    align-items: center;
    gap: 12px;
    position: relative;
  }
  .ve-root .ve-icon-trigger {
    all: unset; cursor: pointer;
    width: 44px; height: 44px;
    border-radius: 10px;
    background: #fafaf9;
    border: 1px solid #ececec;
    display: inline-flex;
    align-items: center; justify-content: center;
    font-size: 22px;
    flex-shrink: 0;
    transition: background .12s, border-color .12s;
  }
  .ve-root .ve-icon-trigger:hover { background: #f5f5f4; border-color: #d4d4d4; }
  .ve-root .ve-icon-trigger.is-open { background: #fff; border-color: #171717; }
  html.dark .ve-root .ve-icon-trigger { background: var(--color-bg-secondary); border-color: var(--color-border); }

  .ve-root .ve-head-name-block { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4px; }
  .ve-root .ve-eyebrow {
    font-size: 11px;
    color: #a3a3a3;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-weight: 500;
  }
  html.dark .ve-root .ve-eyebrow { color: var(--color-text-quaternary); }

  .ve-root .ve-name-input {
    width: 100%; box-sizing: border-box;
    padding: 4px 0;
    border: none;
    border-bottom: 1.5px solid transparent;
    background: transparent;
    font-family: inherit;
    font-size: 17px;
    font-weight: 600;
    color: #0a0a0a;
    outline: none;
    transition: border-color .14s;
  }
  html.dark .ve-root .ve-name-input { color: var(--color-text-primary); }
  .ve-root .ve-name-input:hover { border-bottom-color: #ececec; }
  .ve-root .ve-name-input:focus { border-bottom-color: #171717; }
  html.dark .ve-root .ve-name-input:hover { border-bottom-color: var(--color-border); }
  html.dark .ve-root .ve-name-input:focus { border-bottom-color: var(--color-text-primary); }

  .ve-root .ve-head-actions { display: flex; gap: 8px; flex-shrink: 0; }
  .ve-root .ve-btn-ghost {
    all: unset; cursor: pointer; padding: 8px 14px; border-radius: 8px;
    color: #525252; font-size: 13px;
  }
  .ve-root .ve-btn-ghost:hover { background: #f5f5f4; }
  html.dark .ve-root .ve-btn-ghost { color: var(--color-text-tertiary); }
  html.dark .ve-root .ve-btn-ghost:hover { background: var(--color-bg-tertiary); }

  .ve-root .ve-btn-primary {
    all: unset; cursor: pointer; padding: 8px 18px; border-radius: 8px;
    background: #171717; color: #fff;
    font-size: 13px; font-weight: 600;
    transition: opacity .12s;
  }
  .ve-root .ve-btn-primary:hover { opacity: 0.88; }
  html.dark .ve-root .ve-btn-primary { background: var(--color-text-primary); color: var(--color-bg-primary); }

  .ve-root .ve-icon-pop {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    z-index: 10;
    background: #fff;
    border: 1px solid #ececec;
    border-radius: 10px;
    padding: 8px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.08);
    display: flex; flex-wrap: wrap; gap: 4px;
    max-width: 320px;
  }
  .ve-root .ve-icon-pop.hidden { display: none; }
  html.dark .ve-root .ve-icon-pop { background: var(--color-bg-secondary); border-color: var(--color-border); }
  .ve-root .ve-icon-pick {
    all: unset; cursor: pointer;
    width: 36px; height: 36px;
    display: inline-flex; align-items: center; justify-content: center;
    font-size: 20px;
    border-radius: 8px;
    border: 1px solid transparent;
    box-sizing: border-box;
  }
  .ve-root .ve-icon-pick:hover, .ve-root .ve-icon-pick.is-selected {
    background: #fafaf9; border-color: #171717;
  }
  html.dark .ve-root .ve-icon-pick:hover, html.dark .ve-root .ve-icon-pick.is-selected {
    background: var(--color-bg-tertiary); border-color: var(--color-text-primary);
  }

  .ve-root .ve-desc-block { margin-top: 12px; display: flex; flex-direction: column; gap: 4px; }
  .ve-root .ve-desc-input {
    width: 100%; box-sizing: border-box;
    padding: 8px 12px;
    font-family: inherit;
    font-size: 13px;
    line-height: 1.55;
    border: 1px solid #ececec;
    border-radius: 8px;
    background: #fff;
    color: #171717;
    outline: none;
    resize: vertical;
    min-height: 56px;
    transition: border-color .14s;
  }
  .ve-root .ve-desc-input:focus { border-color: #171717; }
  html.dark .ve-root .ve-desc-input {
    background: var(--color-bg-secondary);
    border-color: var(--color-border);
    color: var(--color-text-primary);
  }

  /* === Body two-pane === */
  .ve-root .ve-body {
    flex: 1;
    display: grid;
    grid-template-columns: 1fr 380px;
    overflow: hidden;
  }
  @media (max-width: 720px) {
    .ve-root .ve-body { grid-template-columns: 1fr; }
  }

  /* === Left rail === */
  .ve-root .ve-left {
    padding: 16px 20px 80px;
    overflow-y: auto;
  }
  .ve-root .ve-left-hint {
    font-size: 11px;
    color: #a3a3a3;
    margin-bottom: 12px;
    letter-spacing: 0.02em;
  }
  .ve-root .ve-groups { display: flex; flex-direction: column; gap: 12px; }

  .ve-root .ve-add-group {
    all: unset; cursor: pointer;
    display: flex; align-items: center; justify-content: center; gap: 6px;
    width: 100%;
    padding: 14px;
    border: 1px dashed #d4d4d4;
    border-radius: 12px;
    color: #737373;
    font-size: 13px;
    margin-top: 12px;
    box-sizing: border-box;
    transition: border-color .12s, color .12s, background .12s;
  }
  .ve-root .ve-add-group:hover {
    border-color: #171717; color: #171717; background: #fafaf9;
  }
  .ve-root .ve-add-group-plus {
    font-size: 15px; font-weight: 500; line-height: 1; margin-top: -1px;
  }
  html.dark .ve-root .ve-add-group { color: var(--color-text-tertiary); border-color: var(--color-border); }
  html.dark .ve-root .ve-add-group:hover {
    border-color: var(--color-text-primary);
    color: var(--color-text-primary);
    background: var(--color-bg-tertiary);
  }

  /* === Group card === */
  .ve-root .ve-group {
    background: #fff;
    border: 1.5px solid #ececec;
    border-radius: 12px;
    padding: 14px 16px;
    cursor: pointer;
    transition: border-color .14s, background .14s, box-shadow .14s;
  }
  .ve-root .ve-group:hover { border-color: #d4d4d4; }
  .ve-root .ve-group.is-selected {
    border-color: #171717;
    background: #fff;
    box-shadow: 0 0 0 4px rgba(23,23,23,0.04);
  }
  html.dark .ve-root .ve-group {
    background: var(--color-bg-primary);
    border-color: var(--color-border);
  }
  html.dark .ve-root .ve-group.is-selected {
    border-color: var(--color-text-primary);
    box-shadow: 0 0 0 4px rgba(255,255,255,0.06);
  }

  .ve-root .ve-group-head {
    display: flex; align-items: flex-start; gap: 10px; margin-bottom: 10px;
  }
  .ve-root .ve-group-titles {
    flex: 1; min-width: 0;
    display: flex; flex-direction: column; gap: 2px;
  }
  .ve-root .ve-group-title {
    width: 100%; box-sizing: border-box;
    border: none;
    border-bottom: 1.5px solid transparent;
    outline: none;
    padding: 2px 0;
    background: transparent;
    font-family: inherit;
    font-size: 14px;
    font-weight: 600;
    color: #171717;
    transition: border-color .14s;
    cursor: text;
  }
  .ve-root .ve-group-title:hover { border-bottom-color: #ececec; }
  .ve-root .ve-group-title:focus { border-bottom-color: #171717; }
  html.dark .ve-root .ve-group-title { color: var(--color-text-primary); }
  html.dark .ve-root .ve-group-title:hover { border-bottom-color: var(--color-border); }
  html.dark .ve-root .ve-group-title:focus { border-bottom-color: var(--color-text-primary); }

  .ve-root .ve-group-flow {
    width: 100%; box-sizing: border-box;
    border: none; outline: none;
    padding: 0;
    background: transparent;
    font-family: inherit;
    font-size: 12px;
    color: #737373;
    cursor: text;
  }
  .ve-root .ve-group-flow::placeholder { color: #d4d4d4; }
  html.dark .ve-root .ve-group-flow { color: var(--color-text-tertiary); }

  .ve-root .ve-group-remove {
    all: unset; cursor: pointer;
    width: 26px; height: 26px;
    border-radius: 6px;
    display: inline-flex; align-items: center; justify-content: center;
    color: #a3a3a3;
    flex-shrink: 0;
    transition: background .12s, color .12s;
  }
  .ve-root .ve-group-remove:hover { background: var(--s-danger-soft); color: var(--s-danger); }
  html.dark .ve-root .ve-group-remove:hover { background: var(--s-danger-soft); color: var(--s-danger); }

  /* chips inside group card — read-only-ish, click × to remove */
  .ve-root .ve-group-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    min-height: 0;
  }
  .ve-root .ve-group-chips-empty {
    font-size: 12px;
    color: #a3a3a3;
    padding: 6px 0;
  }

  .ve-root .ve-school-chip {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    padding: 4px 4px 4px 10px;
    border-radius: 999px;
    background: #f5f5f4;
    border: 1px solid transparent;
    font-size: 12.5px;
    color: #171717;
    user-select: none;
    -webkit-user-select: none;
    transition: background .12s, border-color .12s;
  }
  .ve-root .ve-group.is-selected .ve-school-chip {
    background: #fafaf9;
    border-color: #ececec;
  }
  html.dark .ve-root .ve-school-chip { background: var(--color-bg-tertiary); color: var(--color-text-primary); }
  html.dark .ve-root .ve-group.is-selected .ve-school-chip { background: var(--color-bg-secondary); border-color: var(--color-border); }

  .ve-root .ve-school-chip-x {
    all: unset; cursor: pointer;
    width: 20px; height: 20px;
    border-radius: 999px;
    display: inline-flex; align-items: center; justify-content: center;
    color: #a3a3a3;
    font-size: 14px;
    line-height: 1;
    transition: background .12s, color .12s;
  }
  .ve-root .ve-school-chip-x:hover {
    background: rgba(239,68,68,0.12);
    color: var(--s-danger);
  }

  /* === Right rail === */
  .ve-root .ve-right {
    border-left: 1px solid #ececec;
    background: #fff;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  html.dark .ve-root .ve-right {
    background: var(--color-bg-primary);
    border-left-color: var(--color-border);
  }
  @media (max-width: 720px) {
    .ve-root .ve-right { border-left: none; border-top: 1px solid #ececec; min-height: 320px; }
    html.dark .ve-root .ve-right { border-top-color: var(--color-border); }
  }

  /* empty state */
  .ve-root .ve-right-empty {
    flex: 1;
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    padding: 24px;
    color: #a3a3a3;
    text-align: center;
  }
  .ve-root .ve-right-empty.hidden { display: none; }
  .ve-root .ve-right-empty-icon { font-size: 24px; margin-bottom: 8px; opacity: 0.5; }
  .ve-root .ve-right-empty-text { font-size: 13px; }

  /* active state */
  .ve-root .ve-right-active {
    display: flex; flex-direction: column; flex: 1; min-height: 0;
  }
  .ve-root .ve-right-active.hidden { display: none; }

  .ve-root .ve-right-head {
    padding: 14px 16px 12px;
    border-bottom: 1px solid #f1f1f0;
    flex-shrink: 0;
  }
  html.dark .ve-root .ve-right-head { border-bottom-color: var(--color-border); }
  .ve-root .ve-right-name {
    margin-top: 4px;
    font-size: 14px;
    font-weight: 600;
    color: #171717;
    word-wrap: break-word;
  }
  html.dark .ve-root .ve-right-name { color: var(--color-text-primary); }
  .ve-root .ve-right-stat {
    margin-top: 4px;
    font-size: 11px;
    color: #a3a3a3;
  }

  /* search */
  .ve-root .ve-right-search-wrap {
    position: relative;
    padding: 10px 12px;
    flex-shrink: 0;
  }
  .ve-root .ve-right-search-icon {
    position: absolute;
    left: 22px; top: 50%;
    transform: translateY(-50%);
    color: #a3a3a3;
    pointer-events: none;
  }
  .ve-root .ve-right-search {
    width: 100%; box-sizing: border-box;
    padding: 7px 10px 7px 32px;
    font-family: inherit;
    font-size: 13px;
    border: 1px solid #ececec;
    border-radius: 8px;
    background: #fafaf9;
    color: #171717;
    outline: none;
    transition: border-color .14s, background .14s;
  }
  .ve-root .ve-right-search::-webkit-search-cancel-button { -webkit-appearance: none; appearance: none; }
  .ve-root .ve-right-search:focus {
    border-color: #171717; background: #fff;
  }
  html.dark .ve-root .ve-right-search {
    background: var(--color-bg-secondary);
    border-color: var(--color-border);
    color: var(--color-text-primary);
  }
  html.dark .ve-root .ve-right-search:focus { background: var(--color-bg-primary); border-color: var(--color-text-primary); }

  /* checklist */
  .ve-root .ve-right-list {
    flex: 1; min-height: 0;
    overflow-y: auto;
    padding: 4px 8px 16px;
  }
  .ve-root .ve-right-list-empty {
    padding: 24px 16px;
    font-size: 12px;
    color: #a3a3a3;
    text-align: center;
  }

  .ve-root .ve-check-row {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 10px;
    border-radius: 7px;
    cursor: pointer;
    border: 1px solid transparent;
    transition: background .1s, border-color .1s;
    user-select: none;
    -webkit-user-select: none;
  }
  .ve-root .ve-check-row:hover {
    background: #fafaf9;
  }
  html.dark .ve-root .ve-check-row:hover { background: var(--color-bg-secondary); }
  .ve-root .ve-check-row.is-checked {
    background: rgba(23,23,23,0.04);
  }
  html.dark .ve-root .ve-check-row.is-checked { background: rgba(255,255,255,0.04); }

  .ve-root .ve-check-mark {
    width: 18px; height: 18px;
    border-radius: 5px;
    border: 1.5px solid #d4d4d4;
    display: flex; align-items: center; justify-content: center;
    color: #fff;
    flex-shrink: 0;
    background: #fff;
    transition: background .14s, border-color .14s;
  }
  .ve-root .ve-check-row.is-checked .ve-check-mark {
    background: #171717;
    border-color: #171717;
  }
  html.dark .ve-root .ve-check-mark { background: var(--color-bg-primary); border-color: var(--color-text-quaternary); }
  html.dark .ve-root .ve-check-row.is-checked .ve-check-mark {
    background: var(--color-text-primary);
    border-color: var(--color-text-primary);
    color: var(--color-bg-primary);
  }

  .ve-root .ve-check-name {
    flex: 1;
    font-size: 13px;
    color: #171717;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  html.dark .ve-root .ve-check-name { color: var(--color-text-primary); }

  .ve-root .ve-check-hint {
    font-size: 11px;
    color: #a3a3a3;
    flex-shrink: 0;
    white-space: nowrap;
    max-width: 110px;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .ve-root .ve-check-hint.is-already { color: #15803d; }
  .ve-root .ve-check-hint.is-elsewhere { color: #a16207; }
  html.dark .ve-root .ve-check-hint.is-already { color: #4ade80; }
  html.dark .ve-root .ve-check-hint.is-elsewhere { color: #fbbf24; }
</style>

<script is:inline>
  (() => {
    const root = document.getElementById('view-editor');
    if (!root) return;
    const discipline = root.getAttribute('data-discipline');
    const allSchools = JSON.parse(root.getAttribute('data-all-schools') || '[]');
    const schoolByKey = Object.fromEntries(allSchools.map((s) => [s.key, s]));

    const groupsEl = root.querySelector('[data-ve-groups]');
    const rightEmpty = root.querySelector('[data-ve-right-empty]');
    const rightActive = root.querySelector('[data-ve-right-active]');
    const rightName = root.querySelector('[data-ve-right-name]');
    const rightStat = root.querySelector('[data-ve-right-stat]');
    const rightList = root.querySelector('[data-ve-right-list]');
    const rightSearch = root.querySelector('[data-ve-right-search]');
    const nameEl = root.querySelector('[data-ve-name]');
    const descEl = root.querySelector('[data-ve-desc]');
    const iconTrigger = root.querySelector('[data-ve-icon-trigger]');
    const iconPop = root.querySelector('[data-ve-icon-pop]');
    const saveBtn = root.querySelector('[data-ve-save]');

    let baseSha = null;
    let snapshot = null;
    let groups = [];
    let pool = [];
    let icon = '📚';
    let selectedGroupId = null;
    let searchQ = '';

    function setIcon(v) {
      icon = v;
      if (iconTrigger) iconTrigger.textContent = v;
      iconPop && iconPop.querySelectorAll('[data-ve-icon-pick]').forEach((b) => {
        b.classList.toggle('is-selected', b.getAttribute('data-ve-icon-pick') === v);
      });
    }

    function close() { root.classList.add('hidden'); }
    root.querySelectorAll('[data-ve-close]').forEach((b) => b.addEventListener('click', close));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !root.classList.contains('hidden')) close();
    });

    iconTrigger && iconTrigger.addEventListener('click', () => {
      if (!iconPop) return;
      iconPop.classList.toggle('hidden');
      iconTrigger.classList.toggle('is-open');
    });
    iconPop && iconPop.querySelectorAll('[data-ve-icon-pick]').forEach((b) => {
      b.addEventListener('click', () => {
        setIcon(b.getAttribute('data-ve-icon-pick'));
        iconPop.classList.add('hidden');
        iconTrigger && iconTrigger.classList.remove('is-open');
      });
    });

    function renderGroups() {
      groupsEl.innerHTML = '';
      groups.forEach((g) => {
        const card = document.createElement('div');
        card.className = 've-group' + (g.id === selectedGroupId ? ' is-selected' : '');
        card.setAttribute('data-group-id', g.id);

        const head = document.createElement('div');
        head.className = 've-group-head';
        const titles = document.createElement('div');
        titles.className = 've-group-titles';

        const titleInp = document.createElement('input');
        titleInp.className = 've-group-title';
        titleInp.value = g.title || '';
        titleInp.placeholder = '分组标题';
        titleInp.addEventListener('input', (e) => { g.title = e.target.value; syncRightName(g); });
        titleInp.addEventListener('click', (e) => e.stopPropagation());   // 不切选
        titleInp.addEventListener('focus', () => selectGroup(g.id));
        titles.appendChild(titleInp);

        const flowInp = document.createElement('input');
        flowInp.className = 've-group-flow';
        flowInp.value = g.flow || '';
        flowInp.placeholder = '子流程描述（可选）';
        flowInp.addEventListener('input', (e) => { g.flow = e.target.value; });
        flowInp.addEventListener('click', (e) => e.stopPropagation());
        flowInp.addEventListener('focus', () => selectGroup(g.id));
        titles.appendChild(flowInp);

        head.appendChild(titles);

        const removeBtn = document.createElement('button');
        removeBtn.type = 'button';
        removeBtn.className = 've-group-remove';
        removeBtn.title = '移除此分组（学派回到右侧池子）';
        removeBtn.setAttribute('aria-label', '移除分组');
        removeBtn.innerHTML = '<svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M3.5 3.5l7 7M10.5 3.5l-7 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>';
        removeBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          pool = [...pool, ...g.schoolIds];
          groups = groups.filter((x) => x !== g);
          if (selectedGroupId === g.id) selectedGroupId = null;
          renderAll();
        });
        head.appendChild(removeBtn);
        card.appendChild(head);

        // chips
        const chipsEl = document.createElement('div');
        chipsEl.className = 've-group-chips';
        if (g.schoolIds.length === 0) {
          const empty = document.createElement('div');
          empty.className = 've-group-chips-empty';
          empty.textContent = g.id === selectedGroupId ? '右侧搜索勾选学派 →' : '点选此卡 → 右侧添加学派';
          chipsEl.appendChild(empty);
        } else {
          g.schoolIds.forEach((sid) => {
            const s = schoolByKey[sid];
            if (!s) return;
            const chip = document.createElement('span');
            chip.className = 've-school-chip';
            chip.innerHTML = `<span></span><button type="button" class="ve-school-chip-x" aria-label="从分组移除">×</button>`;
            chip.firstElementChild.textContent = s.cn;
            chip.querySelector('.ve-school-chip-x').addEventListener('click', (ev) => {
              ev.stopPropagation();
              g.schoolIds = g.schoolIds.filter((id) => id !== sid);
              if (!pool.includes(sid)) pool.push(sid);
              renderAll();
            });
            chipsEl.appendChild(chip);
          });
        }
        card.appendChild(chipsEl);

        // 整卡点击 = 选中
        card.addEventListener('click', () => selectGroup(g.id));

        groupsEl.appendChild(card);
      });
    }

    function selectGroup(id) {
      if (selectedGroupId === id) {
        renderRight();   // 已选中 → 仅刷新右栏（如分组刚 rename 时）
        return;
      }
      selectedGroupId = id;
      // 切 is-selected 类不全 re-render（避免 input 失焦）
      groupsEl.querySelectorAll('.ve-group').forEach((card) => {
        card.classList.toggle('is-selected', card.getAttribute('data-group-id') === id);
      });
      // 重置搜索
      searchQ = '';
      if (rightSearch) rightSearch.value = '';
      renderRight();
    }

    function syncRightName(g) {
      // 标题改了，右栏 head 同步
      if (selectedGroupId === g.id && rightName) {
        rightName.textContent = g.title || '（未命名分组）';
      }
    }

    function renderRight() {
      const g = groups.find((x) => x.id === selectedGroupId);
      if (!g) {
        rightEmpty.classList.remove('hidden');
        rightActive.classList.add('hidden');
        return;
      }
      rightEmpty.classList.add('hidden');
      rightActive.classList.remove('hidden');
      rightName.textContent = g.title || '（未命名分组）';
      rightStat.textContent = `已加入 ${g.schoolIds.length} 个 / 共 ${allSchools.length} 个学派`;

      const q = (searchQ || '').trim().toLowerCase();
      const matches = allSchools.filter((s) => {
        if (!q) return true;
        return s.cn.toLowerCase().includes(q) || s.key.toLowerCase().includes(q);
      });

      rightList.innerHTML = '';
      if (matches.length === 0) {
        const empty = document.createElement('div');
        empty.className = 've-right-list-empty';
        empty.textContent = '没有匹配的学派';
        rightList.appendChild(empty);
        return;
      }

      matches.forEach((s) => {
        const inThis = g.schoolIds.includes(s.key);
        const otherGroup = groups.find((gg) => gg.id !== g.id && gg.schoolIds.includes(s.key));

        const row = document.createElement('div');
        row.className = 've-check-row' + (inThis ? ' is-checked' : '');
        row.setAttribute('role', 'checkbox');
        row.setAttribute('aria-checked', inThis ? 'true' : 'false');
        row.setAttribute('tabindex', '0');

        const mark = document.createElement('span');
        mark.className = 've-check-mark';
        mark.innerHTML = inThis
          ? '<svg width="11" height="11" viewBox="0 0 11 11" fill="none"><path d="M2 5.5l2.5 2.5L9 3.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>'
          : '';
        row.appendChild(mark);

        const name = document.createElement('div');
        name.className = 've-check-name';
        name.textContent = s.cn;
        row.appendChild(name);

        const hint = document.createElement('div');
        hint.className = 've-check-hint';
        if (inThis) {
          hint.classList.add('is-already');
          hint.textContent = '已加入';
        } else if (otherGroup) {
          hint.classList.add('is-elsewhere');
          hint.textContent = `在「${otherGroup.title || '未命名'}」`;
        } else {
          hint.textContent = '未分配';
        }
        row.appendChild(hint);

        row.addEventListener('click', () => toggleInSelectedGroup(s.key));
        row.addEventListener('keydown', (ev) => {
          if (ev.key === ' ' || ev.key === 'Enter') {
            ev.preventDefault();
            toggleInSelectedGroup(s.key);
          }
        });
        rightList.appendChild(row);
      });
    }

    function toggleInSelectedGroup(schoolId) {
      const g = groups.find((x) => x.id === selectedGroupId);
      if (!g) return;
      if (g.schoolIds.includes(schoolId)) {
        // 取消勾选 → 移到 pool
        g.schoolIds = g.schoolIds.filter((id) => id !== schoolId);
        if (!pool.includes(schoolId)) pool.push(schoolId);
      } else {
        // 勾选 → 加入此分组（若在其它分组 / pool 也清掉）
        groups.forEach((gg) => { gg.schoolIds = gg.schoolIds.filter((id) => id !== schoolId); });
        pool = pool.filter((id) => id !== schoolId);
        g.schoolIds.push(schoolId);
      }
      // 只 re-render 右栏 + 当前分组的 chips（保 input focus 在右栏 search）
      renderGroups();
      renderRight();
      // 保 search input 焦点
      if (document.activeElement !== rightSearch && rightSearch) {
        // 不强制夺焦，让用户继续点
      }
    }

    function renderAll() {
      renderGroups();
      renderRight();
    }

    rightSearch && rightSearch.addEventListener('input', (e) => {
      searchQ = e.target.value || '';
      renderRight();
    });

    root.querySelector('[data-ve-add-group]').addEventListener('click', () => {
      const id = 'g' + Date.now().toString(36);
      groups.push({ id, title: '新分组', flow: '', schoolIds: [] });
      selectedGroupId = id;
      renderAll();
      const last = groupsEl.querySelector('.ve-group:last-child .ve-group-title');
      if (last) {
        last.focus();
        last.select && last.select();
      }
    });

    document.addEventListener('view:editor', async (e) => {
      const viewId = e && e.detail && e.detail.viewId;
      if (!viewId) return;
      const r = await fetch(`/api/edit/view/${discipline}/${viewId}`);
      if (!r.ok) {
        const data = await r.json().catch(() => ({}));
        alert(`加载视图失败：${r.status} ${data.reason ?? ''}`);
        return;
      }
      const { json: v, base_sha } = await r.json();
      baseSha = base_sha;
      snapshot = v;
      groups = (v.groups || []).map((g) => ({
        id: g.id, title: g.title, flow: g.flow || '', schoolIds: [...(g.schoolIds || [])],
      }));
      const used = new Set(groups.flatMap((g) => g.schoolIds));
      pool = allSchools.filter((s) => !used.has(s.key)).map((s) => s.key);
      setIcon(v.icon || '📚');
      if (nameEl) nameEl.value = v.name || '';
      if (descEl) descEl.value = v.description || '';
      // 默认选中第一个分组（用户来直接能用）
      selectedGroupId = groups[0]?.id ?? null;
      searchQ = '';
      if (rightSearch) rightSearch.value = '';
      renderAll();
      root.classList.remove('hidden');
    });

    saveBtn && saveBtn.addEventListener('click', async () => {
      if (!snapshot) return;
      const next = {
        ...snapshot,
        icon,
        name: (nameEl?.value || '').trim(),
        description: (descEl?.value || '').trim(),
        groups: groups.map((g) => ({
          id: g.id,
          title: (g.title || '').trim() || '（未命名）',
          flow: (g.flow || '').trim(),
          schoolIds: [...g.schoolIds],
        })),
      };
      if (!next.name) {
        alert('视图名称不能为空');
        return;
      }
      const r = await fetch(`/api/edit/view/${discipline}/${snapshot.id}`, {
        method: 'PUT',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ json: next, base_sha: baseSha }),
      });
      if (!r.ok) {
        const data = await r.json().catch(() => ({}));
        alert(`保存失败：${r.status} ${data.reason ?? ''} ${typeof data.detail === 'string' ? data.detail : ''}`);
        return;
      }
      close();
      document.dispatchEvent(new CustomEvent('view:toast', { detail: '视图已保存（~90s 后线上生效）' }));
    });
  })();
</script>
