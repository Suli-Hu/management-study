---
/**
 * ViewEditor — 视图编辑器（v0.5.80 重设计）
 *
 * 修两件事：
 * 1. CSS scope bug — Astro <style> 自动加 [data-astro-cid-XXX] 但 innerHTML 注入的元素
 *    没有 cid → 所有动态创建的 chip / group card / pool row 全失样式。
 *    解：<style is:global> + 用 .ve-root 前缀 namespace 防止泄漏。
 * 2. 视觉设计：
 *    - 输入框可见的下边框（不再像静态文字）
 *    - chip / pool row 真正像 chip
 *    - 重复的"拖动学派可在..."提示只在顶端显示一次
 *    - 分组卡有明显边界 + 移除按钮改 × 图标小按钮
 *    - 桌面/iPad split 1fr 360px；手机栈
 *
 * 触发：document.dispatchEvent('view:editor', { detail: { viewId } })
 * 提交：PUT /api/edit/view/[discipline]/[id]
 *
 * 用户角度："编辑视图说明" 不再单独提供，因为本编辑器顶部就有图标 / 名称 / 说明三件，
 *           跟 ViewMenu 里的 "编辑视图说明" 重复。
 */

interface Props {
  discipline: string;
  allSchools: Array<{ key: string; cn: string }>;
}
const { discipline, allSchools } = Astro.props;
---

<div id="view-editor" class="ve-root hidden" data-discipline={discipline}
     data-all-schools={JSON.stringify(allSchools)}>
  <div class="ve-overlay" data-ve-close></div>
  <div class="ve-modal">
    {/* === Header === */}
    <div class="ve-head">
      <div class="ve-head-row">
        <button type="button" class="ve-icon-trigger" data-ve-icon-trigger title="点击更换图标" aria-label="选择图标">📚</button>
        <div class="ve-head-name-block">
          <div class="ve-eyebrow">视图名称</div>
          <input class="ve-name-input" data-ve-name placeholder="例：组织论六阶段" />
        </div>
        <div class="ve-head-actions">
          <button type="button" class="ve-btn-ghost" data-ve-close>取消</button>
          <button type="button" class="ve-btn-primary" data-ve-save>保存</button>
        </div>
        <div class="ve-icon-pop hidden" data-ve-icon-pop>
          {['📚','🗺️','⏳','🌏','⭐','🎯','🧭','🔬','💡','📖','🏛️','🔖'].map((emoji) => (
            <button type="button" class="ve-icon-pick" data-ve-icon-pick={emoji}>{emoji}</button>
          ))}
        </div>
      </div>
      <div class="ve-desc-block">
        <div class="ve-eyebrow">视图说明</div>
        <textarea class="ve-desc-input" data-ve-desc rows="2"
          placeholder="一句话说明这个视图的用途 / 分类逻辑（如「按时代演进将组织论划分为六阶段」）"></textarea>
      </div>
    </div>

    {/* === Body: groups (left) | pool (right) === */}
    <div class="ve-body">
      <div class="ve-left">
        <div class="ve-left-hint">拖动学派可在分组间移动 · 点学派的 × 移到右侧池子</div>
        <div class="ve-groups" data-ve-groups>
          {/* 动态注入 */}
        </div>
        <button type="button" class="ve-add-group" data-ve-add-group>
          <span class="ve-add-group-plus">+</span> 添加分组
        </button>
      </div>
      <div class="ve-right" data-ve-pool data-drop-target="pool">
        <div class="ve-pool-head">
          <div class="ve-pool-title">未包含学派</div>
          <div class="ve-pool-sub" data-ve-pool-count>0 个 · 拖到左侧分组放入</div>
        </div>
        <div class="ve-pool-list" data-ve-pool-list>
          {/* 动态注入 */}
        </div>
      </div>
    </div>
  </div>
</div>

<style is:global>
  /* === v0.5.80 全部 .ve-* 都走 is:global，因为 dynamic innerHTML 元素拿不到 Astro cid。
     防泄漏靠 `.ve-root` 前缀 namespace。 === */

  .ve-root {
    position: fixed; inset: 0; z-index: 100;
    font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", system-ui, sans-serif;
  }
  .ve-root.hidden { display: none; }
  .ve-root .ve-overlay {
    position: absolute; inset: 0;
    background: rgba(10,10,10,0.45);
    -webkit-backdrop-filter: blur(2px);
    backdrop-filter: blur(2px);
  }
  .ve-root .ve-modal {
    position: absolute; inset: 40px;
    background: #fafaf9;
    border-radius: 16px;
    overflow: hidden;
    display: flex; flex-direction: column;
    box-shadow: 0 30px 80px rgba(0,0,0,0.25);
  }
  html.dark .ve-root .ve-modal { background: var(--color-bg-secondary); }
  @media (max-width: 720px) {
    .ve-root .ve-modal { inset: 8px; border-radius: 12px; }
  }

  /* === Header === */
  .ve-root .ve-head {
    padding: 14px 20px 16px;
    border-bottom: 1px solid #ececec;
    background: #fff;
    flex-shrink: 0;
  }
  html.dark .ve-root .ve-head {
    background: var(--color-bg-primary);
    border-bottom-color: var(--color-border);
  }
  .ve-root .ve-head-row {
    display: flex;
    align-items: center;
    gap: 12px;
    position: relative;
  }
  .ve-root .ve-icon-trigger {
    all: unset; cursor: pointer;
    width: 44px; height: 44px;
    border-radius: 10px;
    background: #fafaf9;
    border: 1px solid #ececec;
    display: inline-flex;
    align-items: center; justify-content: center;
    font-size: 22px;
    flex-shrink: 0;
    transition: background .12s, border-color .12s;
  }
  .ve-root .ve-icon-trigger:hover {
    background: #f5f5f4;
    border-color: #d4d4d4;
  }
  .ve-root .ve-icon-trigger.is-open {
    background: #fff;
    border-color: #171717;
  }
  html.dark .ve-root .ve-icon-trigger {
    background: var(--color-bg-secondary);
    border-color: var(--color-border);
  }

  .ve-root .ve-head-name-block {
    flex: 1;
    min-width: 0;
    display: flex; flex-direction: column; gap: 4px;
  }
  .ve-root .ve-eyebrow {
    font-size: 11px;
    color: #a3a3a3;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-weight: 500;
  }
  html.dark .ve-root .ve-eyebrow { color: var(--color-text-quaternary); }

  .ve-root .ve-name-input {
    width: 100%;
    box-sizing: border-box;
    padding: 4px 0;
    border: none;
    border-bottom: 1.5px solid transparent;
    background: transparent;
    font-family: inherit;
    font-size: 17px;
    font-weight: 600;
    color: #0a0a0a;
    outline: none;
    transition: border-color .14s;
  }
  html.dark .ve-root .ve-name-input { color: var(--color-text-primary); }
  .ve-root .ve-name-input:hover { border-bottom-color: #ececec; }
  .ve-root .ve-name-input:focus { border-bottom-color: #171717; }
  html.dark .ve-root .ve-name-input:hover { border-bottom-color: var(--color-border); }
  html.dark .ve-root .ve-name-input:focus { border-bottom-color: var(--color-text-primary); }

  .ve-root .ve-head-actions {
    display: flex; gap: 8px; flex-shrink: 0;
  }
  .ve-root .ve-btn-ghost {
    all: unset; cursor: pointer; padding: 8px 14px; border-radius: 8px;
    color: #525252; font-size: 13px;
  }
  .ve-root .ve-btn-ghost:hover { background: #f5f5f4; }
  html.dark .ve-root .ve-btn-ghost { color: var(--color-text-tertiary); }
  html.dark .ve-root .ve-btn-ghost:hover { background: var(--color-bg-tertiary); }

  .ve-root .ve-btn-primary {
    all: unset; cursor: pointer; padding: 8px 18px; border-radius: 8px;
    background: #171717; color: #fff;
    font-size: 13px; font-weight: 600;
    transition: opacity .12s;
  }
  .ve-root .ve-btn-primary:hover { opacity: 0.88; }
  html.dark .ve-root .ve-btn-primary {
    background: var(--color-text-primary);
    color: var(--color-bg-primary);
  }

  .ve-root .ve-icon-pop {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    z-index: 10;
    background: #fff;
    border: 1px solid #ececec;
    border-radius: 10px;
    padding: 8px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.08);
    display: flex; flex-wrap: wrap; gap: 4px;
    max-width: 320px;
  }
  .ve-root .ve-icon-pop.hidden { display: none; }
  html.dark .ve-root .ve-icon-pop {
    background: var(--color-bg-secondary);
    border-color: var(--color-border);
  }
  .ve-root .ve-icon-pick {
    all: unset; cursor: pointer;
    width: 36px; height: 36px;
    display: inline-flex; align-items: center; justify-content: center;
    font-size: 20px;
    border-radius: 8px;
    border: 1px solid transparent;
    box-sizing: border-box;
  }
  .ve-root .ve-icon-pick:hover, .ve-root .ve-icon-pick.is-selected {
    background: #fafaf9; border-color: #171717;
  }
  html.dark .ve-root .ve-icon-pick:hover, html.dark .ve-root .ve-icon-pick.is-selected {
    background: var(--color-bg-tertiary); border-color: var(--color-text-primary);
  }

  /* desc */
  .ve-root .ve-desc-block {
    margin-top: 12px;
    display: flex; flex-direction: column; gap: 4px;
  }
  .ve-root .ve-desc-input {
    width: 100%;
    box-sizing: border-box;
    padding: 8px 12px;
    font-family: inherit;
    font-size: 13px;
    line-height: 1.55;
    border: 1px solid #ececec;
    border-radius: 8px;
    background: #fff;
    color: #171717;
    outline: none;
    resize: vertical;
    min-height: 56px;
    transition: border-color .14s;
  }
  .ve-root .ve-desc-input:focus { border-color: #171717; }
  html.dark .ve-root .ve-desc-input {
    background: var(--color-bg-secondary);
    border-color: var(--color-border);
    color: var(--color-text-primary);
  }

  /* === Body two-pane === */
  .ve-root .ve-body {
    flex: 1;
    display: grid;
    grid-template-columns: 1fr 360px;
    overflow: hidden;
  }
  @media (max-width: 720px) {
    .ve-root .ve-body { grid-template-columns: 1fr; }
  }

  /* === Left rail === */
  .ve-root .ve-left {
    padding: 18px 20px 80px;
    overflow-y: auto;
  }
  .ve-root .ve-left-hint {
    font-size: 11px;
    color: #a3a3a3;
    margin-bottom: 12px;
    letter-spacing: 0.02em;
  }
  .ve-root .ve-groups {
    display: flex; flex-direction: column; gap: 12px;
  }
  .ve-root .ve-add-group {
    all: unset; cursor: pointer;
    display: flex;
    align-items: center; justify-content: center;
    gap: 6px;
    width: 100%;
    text-align: center;
    padding: 14px;
    border: 1px dashed #d4d4d4;
    border-radius: 12px;
    color: #737373;
    font-size: 13px;
    margin-top: 12px;
    box-sizing: border-box;
    transition: border-color .12s, color .12s, background .12s;
  }
  .ve-root .ve-add-group:hover {
    border-color: #171717;
    color: #171717;
    background: #fafaf9;
  }
  .ve-root .ve-add-group-plus {
    font-size: 15px; font-weight: 500; line-height: 1; margin-top: -1px;
  }
  html.dark .ve-root .ve-add-group { color: var(--color-text-tertiary); border-color: var(--color-border); }
  html.dark .ve-root .ve-add-group:hover {
    border-color: var(--color-text-primary);
    color: var(--color-text-primary);
    background: var(--color-bg-tertiary);
  }

  /* === Group card === */
  .ve-root .ve-group {
    background: #fff;
    border: 1px solid #ececec;
    border-radius: 12px;
    padding: 14px 16px;
    transition: box-shadow .14s, border-color .14s;
  }
  .ve-root .ve-group:hover { border-color: #d4d4d4; }
  html.dark .ve-root .ve-group {
    background: var(--color-bg-primary);
    border-color: var(--color-border);
  }

  .ve-root .ve-group-head {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin-bottom: 10px;
  }
  .ve-root .ve-group-titles {
    flex: 1; min-width: 0;
    display: flex; flex-direction: column; gap: 2px;
  }
  .ve-root .ve-group-title {
    width: 100%; box-sizing: border-box;
    border: none;
    border-bottom: 1.5px solid transparent;
    outline: none;
    padding: 2px 0;
    background: transparent;
    font-family: inherit;
    font-size: 14px;
    font-weight: 600;
    color: #171717;
    transition: border-color .14s;
  }
  .ve-root .ve-group-title:hover { border-bottom-color: #ececec; }
  .ve-root .ve-group-title:focus { border-bottom-color: #171717; }
  html.dark .ve-root .ve-group-title { color: var(--color-text-primary); }
  html.dark .ve-root .ve-group-title:hover { border-bottom-color: var(--color-border); }
  html.dark .ve-root .ve-group-title:focus { border-bottom-color: var(--color-text-primary); }

  .ve-root .ve-group-flow {
    width: 100%; box-sizing: border-box;
    border: none; outline: none;
    padding: 0;
    background: transparent;
    font-family: inherit;
    font-size: 12px;
    color: #737373;
  }
  .ve-root .ve-group-flow::placeholder { color: #d4d4d4; }
  html.dark .ve-root .ve-group-flow { color: var(--color-text-tertiary); }

  .ve-root .ve-group-remove {
    all: unset; cursor: pointer;
    width: 26px; height: 26px;
    border-radius: 6px;
    display: inline-flex; align-items: center; justify-content: center;
    color: #a3a3a3;
    flex-shrink: 0;
    transition: background .12s, color .12s;
  }
  .ve-root .ve-group-remove:hover {
    background: #fef2f2;
    color: #dc2626;
  }
  html.dark .ve-root .ve-group-remove:hover {
    background: rgba(239,68,68,0.15);
    color: #ef4444;
  }

  /* chips container */
  .ve-root .ve-group-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding: 10px;
    background: #fafaf9;
    border-radius: 8px;
    min-height: 56px;
    border: 1px dashed #ececec;
    transition: background .12s, border-color .12s;
  }
  html.dark .ve-root .ve-group-chips {
    background: var(--color-bg-secondary);
    border-color: var(--color-border);
  }
  .ve-root .ve-group-chips.is-drop-over {
    background: #f0f9ff;
    border-color: #60a5fa;
    border-style: solid;
  }
  html.dark .ve-root .ve-group-chips.is-drop-over {
    background: rgba(96,165,250,0.12);
    border-color: #60a5fa;
  }
  .ve-root .ve-group-chips-empty {
    font-size: 12px;
    color: #a3a3a3;
    align-self: center;
    padding: 4px 6px;
    width: 100%;
    text-align: center;
  }

  /* school chip */
  .ve-root .ve-school-chip {
    cursor: grab;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 5px 6px 5px 10px;
    border-radius: 999px;
    background: #fff;
    border: 1px solid #ececec;
    font-size: 12.5px;
    color: #171717;
    user-select: none;
    -webkit-user-select: none;
    transition: border-color .12s, background .12s, transform .12s;
  }
  .ve-root .ve-school-chip:active { cursor: grabbing; }
  .ve-root .ve-school-chip:hover {
    border-color: #d4d4d4;
    background: #fafaf9;
  }
  .ve-root .ve-school-chip.is-dragging {
    opacity: 0.4;
    transform: scale(0.96);
  }
  html.dark .ve-root .ve-school-chip {
    background: var(--color-bg-primary);
    border-color: var(--color-border);
    color: var(--color-text-primary);
  }
  html.dark .ve-root .ve-school-chip:hover {
    background: var(--color-bg-tertiary);
    border-color: var(--color-text-quaternary);
  }
  .ve-root .ve-school-chip-x {
    width: 18px; height: 18px;
    border-radius: 999px;
    display: inline-flex; align-items: center; justify-content: center;
    color: #a3a3a3;
    font-size: 14px;
    line-height: 1;
    margin-left: 2px;
    transition: background .12s, color .12s;
  }
  .ve-root .ve-school-chip:hover .ve-school-chip-x {
    background: #f5f5f4;
    color: #525252;
  }

  /* === Pool (right rail) === */
  .ve-root .ve-right {
    border-left: 1px solid #ececec;
    background: #fff;
    display: flex;
    flex-direction: column;
    transition: background .12s;
  }
  html.dark .ve-root .ve-right {
    background: var(--color-bg-primary);
    border-left-color: var(--color-border);
  }
  @media (max-width: 720px) {
    .ve-root .ve-right {
      border-left: none;
      border-top: 1px solid #ececec;
    }
    html.dark .ve-root .ve-right { border-top-color: var(--color-border); }
  }
  .ve-root .ve-right.is-drop-over { background: #f0f9ff; }
  html.dark .ve-root .ve-right.is-drop-over { background: rgba(96,165,250,0.12); }

  .ve-root .ve-pool-head {
    padding: 14px 16px;
    border-bottom: 1px solid #f1f1f0;
    flex-shrink: 0;
  }
  html.dark .ve-root .ve-pool-head { border-bottom-color: var(--color-border); }
  .ve-root .ve-pool-title {
    font-size: 13px;
    font-weight: 600;
    color: #171717;
  }
  html.dark .ve-root .ve-pool-title { color: var(--color-text-primary); }
  .ve-root .ve-pool-sub {
    font-size: 11px;
    color: #a3a3a3;
    margin-top: 3px;
  }

  .ve-root .ve-pool-list {
    flex: 1;
    overflow-y: auto;
    padding: 8px;
  }

  /* pool row — chip-style with drag handle */
  .ve-root .ve-pool-row {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 7px 10px;
    margin-bottom: 3px;
    border-radius: 8px;
    background: transparent;
    cursor: grab;
    border: 1px solid transparent;
    transition: background .1s, border-color .1s;
    user-select: none;
    -webkit-user-select: none;
  }
  .ve-root .ve-pool-row:hover {
    background: #fafaf9;
    border-color: #ececec;
  }
  .ve-root .ve-pool-row:active { cursor: grabbing; }
  .ve-root .ve-pool-row.is-dragging {
    opacity: 0.4;
    background: #f5f5f4;
  }
  html.dark .ve-root .ve-pool-row:hover {
    background: var(--color-bg-secondary);
    border-color: var(--color-border);
  }

  .ve-root .ve-pool-handle {
    color: #d4d4d4;
    font-size: 13px;
    line-height: 1;
    flex-shrink: 0;
  }
  .ve-root .ve-pool-name {
    flex: 1;
    font-size: 13px;
    color: #262626;
  }
  html.dark .ve-root .ve-pool-name { color: var(--color-text-primary); }

  .ve-root .ve-pool-empty {
    font-size: 12px;
    color: #a3a3a3;
    padding: 12px;
    text-align: center;
  }
</style>

<script is:inline>
  (() => {
    const root = document.getElementById('view-editor');
    if (!root) return;
    const discipline = root.getAttribute('data-discipline');
    const allSchools = JSON.parse(root.getAttribute('data-all-schools') || '[]');
    const schoolByKey = Object.fromEntries(allSchools.map((s) => [s.key, s]));

    const groupsEl = root.querySelector('[data-ve-groups]');
    const poolListEl = root.querySelector('[data-ve-pool-list]');
    const poolCountEl = root.querySelector('[data-ve-pool-count]');
    const poolEl = root.querySelector('[data-ve-pool]');
    const nameEl = root.querySelector('[data-ve-name]');
    const descEl = root.querySelector('[data-ve-desc]');
    const iconTrigger = root.querySelector('[data-ve-icon-trigger]');
    const iconPop = root.querySelector('[data-ve-icon-pop]');
    const saveBtn = root.querySelector('[data-ve-save]');

    let baseSha = null;
    let snapshot = null;
    let groups = [];
    let pool = [];
    let icon = '📚';
    let dragSchool = null;

    function setIcon(v) {
      icon = v;
      if (iconTrigger) iconTrigger.textContent = v;
      iconPop && iconPop.querySelectorAll('[data-ve-icon-pick]').forEach((b) => {
        b.classList.toggle('is-selected', b.getAttribute('data-ve-icon-pick') === v);
      });
    }

    function close() { root.classList.add('hidden'); }
    root.querySelectorAll('[data-ve-close]').forEach((b) => b.addEventListener('click', close));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !root.classList.contains('hidden')) close();
    });

    iconTrigger && iconTrigger.addEventListener('click', () => {
      if (!iconPop) return;
      iconPop.classList.toggle('hidden');
      iconTrigger.classList.toggle('is-open');
    });
    iconPop && iconPop.querySelectorAll('[data-ve-icon-pick]').forEach((b) => {
      b.addEventListener('click', () => {
        setIcon(b.getAttribute('data-ve-icon-pick'));
        iconPop.classList.add('hidden');
        iconTrigger && iconTrigger.classList.remove('is-open');
      });
    });

    function makeChip(s) {
      const chip = document.createElement('div');
      chip.className = 've-school-chip';
      chip.setAttribute('draggable', 'true');
      chip.setAttribute('data-school-id', s.key);
      chip.title = '拖到其他分组 · 点击移到右侧池子';
      chip.innerHTML = `<span>${s.cn}</span><span class="ve-school-chip-x">×</span>`;
      chip.addEventListener('dragstart', (e) => {
        dragSchool = s.key;
        chip.classList.add('is-dragging');
        if (e.dataTransfer) e.dataTransfer.effectAllowed = 'move';
      });
      chip.addEventListener('dragend', () => {
        chip.classList.remove('is-dragging');
        dragSchool = null;
        clearDropTargets();
      });
      chip.addEventListener('click', () => moveToPool(s.key));
      return chip;
    }

    function renderGroups() {
      groupsEl.innerHTML = '';
      groups.forEach((g) => {
        const card = document.createElement('div');
        card.className = 've-group';
        card.setAttribute('data-group-id', g.id);

        const head = document.createElement('div');
        head.className = 've-group-head';
        const titles = document.createElement('div');
        titles.className = 've-group-titles';

        const titleInp = document.createElement('input');
        titleInp.className = 've-group-title';
        titleInp.value = g.title || '';
        titleInp.placeholder = '分组标题';
        titleInp.addEventListener('input', (e) => { g.title = e.target.value; });
        titles.appendChild(titleInp);

        const flowInp = document.createElement('input');
        flowInp.className = 've-group-flow';
        flowInp.value = g.flow || '';
        flowInp.placeholder = '子流程描述（可选）';
        flowInp.addEventListener('input', (e) => { g.flow = e.target.value; });
        titles.appendChild(flowInp);

        head.appendChild(titles);

        const removeBtn = document.createElement('button');
        removeBtn.type = 'button';
        removeBtn.className = 've-group-remove';
        removeBtn.title = '移除此分组（学派回到右侧池子）';
        removeBtn.setAttribute('aria-label', '移除分组');
        removeBtn.innerHTML = '<svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M3.5 3.5l7 7M10.5 3.5l-7 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>';
        removeBtn.addEventListener('click', () => {
          pool = [...pool, ...g.schoolIds];
          groups = groups.filter((x) => x !== g);
          renderGroups();
          renderPool();
        });
        head.appendChild(removeBtn);

        card.appendChild(head);

        const chipsEl = document.createElement('div');
        chipsEl.className = 've-group-chips';
        chipsEl.setAttribute('data-ve-group-chips', '');
        chipsEl.setAttribute('data-drop-target', g.id);
        if (g.schoolIds.length === 0) {
          const empty = document.createElement('div');
          empty.className = 've-group-chips-empty';
          empty.textContent = '从右侧拖学派进来 →';
          chipsEl.appendChild(empty);
        } else {
          g.schoolIds.forEach((sid) => {
            const s = schoolByKey[sid];
            if (!s) return;
            chipsEl.appendChild(makeChip(s));
          });
        }
        bindDropTarget(chipsEl, g.id);
        card.appendChild(chipsEl);

        groupsEl.appendChild(card);
      });
    }

    function renderPool() {
      poolListEl.innerHTML = '';
      poolCountEl.textContent = `${pool.length} 个 · 拖到左侧分组放入`;
      if (pool.length === 0) {
        const empty = document.createElement('div');
        empty.className = 've-pool-empty';
        empty.textContent = '所有学派都已加入视图';
        poolListEl.appendChild(empty);
        return;
      }
      pool.forEach((sid) => {
        const s = schoolByKey[sid];
        if (!s) return;
        const row = document.createElement('div');
        row.className = 've-pool-row';
        row.setAttribute('draggable', 'true');
        row.setAttribute('data-school-id', sid);
        row.title = '拖到左侧分组放入';
        const handle = document.createElement('span');
        handle.className = 've-pool-handle';
        handle.textContent = '⋮⋮';
        const name = document.createElement('div');
        name.className = 've-pool-name';
        name.textContent = s.cn;
        row.appendChild(handle);
        row.appendChild(name);
        row.addEventListener('dragstart', (e) => {
          dragSchool = sid;
          row.classList.add('is-dragging');
          if (e.dataTransfer) e.dataTransfer.effectAllowed = 'move';
        });
        row.addEventListener('dragend', () => {
          row.classList.remove('is-dragging');
          dragSchool = null;
          clearDropTargets();
        });
        poolListEl.appendChild(row);
      });
    }

    function clearDropTargets() {
      root.querySelectorAll('[data-drop-target]').forEach((el) => {
        el.classList.remove('is-drop-over');
      });
    }
    function bindDropTarget(el, groupId) {
      el.addEventListener('dragover', (e) => {
        e.preventDefault();
        if (!dragSchool) return;
        clearDropTargets();
        el.classList.add('is-drop-over');
      });
      el.addEventListener('dragleave', () => {
        el.classList.remove('is-drop-over');
      });
      el.addEventListener('drop', (e) => {
        e.preventDefault();
        clearDropTargets();
        if (!dragSchool) return;
        moveToGroup(dragSchool, groupId);
      });
    }

    if (poolEl) bindDropTarget(poolEl, 'pool');

    function moveToGroup(schoolId, targetGid) {
      groups = groups.map((g) => ({ ...g, schoolIds: g.schoolIds.filter((id) => id !== schoolId) }));
      pool = pool.filter((id) => id !== schoolId);
      if (targetGid === 'pool') {
        if (!pool.includes(schoolId)) pool = [...pool, schoolId];
      } else {
        const target = groups.find((g) => g.id === targetGid);
        if (target) target.schoolIds.push(schoolId);
      }
      renderGroups();
      renderPool();
    }
    function moveToPool(schoolId) {
      groups = groups.map((g) => ({ ...g, schoolIds: g.schoolIds.filter((id) => id !== schoolId) }));
      if (!pool.includes(schoolId)) pool = [...pool, schoolId];
      renderGroups();
      renderPool();
    }

    root.querySelector('[data-ve-add-group]').addEventListener('click', () => {
      const id = 'g' + Date.now().toString(36);
      groups.push({ id, title: '新分组', flow: '', schoolIds: [] });
      renderGroups();
      const last = groupsEl.querySelector('.ve-group:last-child .ve-group-title');
      if (last) {
        last.focus();
        last.select && last.select();
      }
    });

    document.addEventListener('view:editor', async (e) => {
      const viewId = e && e.detail && e.detail.viewId;
      if (!viewId) return;
      const r = await fetch(`/api/edit/view/${discipline}/${viewId}`);
      if (!r.ok) {
        const data = await r.json().catch(() => ({}));
        alert(`加载视图失败：${r.status} ${data.reason ?? ''}`);
        return;
      }
      const { json: v, base_sha } = await r.json();
      baseSha = base_sha;
      snapshot = v;
      groups = (v.groups || []).map((g) => ({
        id: g.id, title: g.title, flow: g.flow || '', schoolIds: [...(g.schoolIds || [])],
      }));
      const used = new Set(groups.flatMap((g) => g.schoolIds));
      pool = allSchools.filter((s) => !used.has(s.key)).map((s) => s.key);
      setIcon(v.icon || '📚');
      if (nameEl) nameEl.value = v.name || '';
      if (descEl) descEl.value = v.description || '';
      renderGroups();
      renderPool();
      root.classList.remove('hidden');
    });

    saveBtn && saveBtn.addEventListener('click', async () => {
      if (!snapshot) return;
      const next = {
        ...snapshot,
        icon,
        name: (nameEl?.value || '').trim(),
        description: (descEl?.value || '').trim(),
        groups: groups.map((g) => ({
          id: g.id,
          title: (g.title || '').trim() || '（未命名）',
          flow: (g.flow || '').trim(),
          schoolIds: [...g.schoolIds],
        })),
      };
      if (!next.name) {
        alert('视图名称不能为空');
        return;
      }
      const r = await fetch(`/api/edit/view/${discipline}/${snapshot.id}`, {
        method: 'PUT',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ json: next, base_sha: baseSha }),
      });
      if (!r.ok) {
        const data = await r.json().catch(() => ({}));
        alert(`保存失败：${r.status} ${data.reason ?? ''} ${typeof data.detail === 'string' ? data.detail : ''}`);
        return;
      }
      close();
      document.dispatchEvent(new CustomEvent('view:toast', { detail: '视图已保存（~90s 后线上生效）' }));
    });
  })();
</script>
