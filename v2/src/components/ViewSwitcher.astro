---
/**
 * ViewSwitcher — 视图切换器 chip 行
 *
 * 设计稿对齐：bundle/49edffcc
 *   - 行间 padding 14 0 6 / borderBottom #f1f1f0 / marginBottom 18
 *   - chip：radius 999 / 内 padding 6 4 6 12 / fontSize 13
 *     · active: 黑底 #171717 / 白字
 *     · inactive: 白底 / border #ececec / hover bg #fafaf9
 *     · 内含 icon emoji（fontSize 12 opacity 0.85）+ name + ··· 按钮
 *   - ··· 按钮 hover 显示，点击触发 onMenu
 *   - 末尾 "+ 新建视图" chip 虚线边框
 *   - 拖动重排（HTML5 drag/drop）：dragging opacity 0.4，dragOver translateX 4 + border #737373
 *   - 用户要求："chip 行右侧不要任何说明文字" → 不渲染 hint
 *
 * 行为：
 *   - chip 点击 → 切视图（更新 ?view= URL 参数 + push state，不全页跳转）
 *   - ··· 按钮 → 触发 viewmenu CustomEvent（父页 ViewMenu 监听）
 *   - + 新建 → 触发 newview CustomEvent
 *   - 拖动 reorder → POST /api/edit/reorder/views（仅 canEdit 时 draggable=true）
 */

interface ViewChip {
  id: string;
  name: string;
  icon: string;
  isDefault: boolean;
  position: number;
}

interface Props {
  views: ViewChip[];
  currentId: string;
  discipline: string;
  canEdit: boolean;
}

const { views, currentId, discipline, canEdit } = Astro.props;
---

<div
  class="view-switcher"
  data-view-switcher
  data-discipline={discipline}
  data-can-edit={canEdit ? '1' : '0'}
  data-current-id={currentId}
>
  <div class="vs-tabs" role="tablist" aria-label="视图切换">
    {views.map((v) => (
      <button
        type="button"
        class:list={['vs-tab', v.id === currentId && 'is-active']}
        role="tab"
        aria-selected={v.id === currentId ? 'true' : 'false'}
        data-view-tab
        data-view-id={v.id}
        data-view-name={v.name}
        data-view-default={v.isDefault ? '1' : '0'}
        draggable={canEdit ? 'true' : 'false'}
        title={canEdit ? '长按拖动可调整顺序' : undefined}
      >
        <span class="vs-tab-icon" aria-hidden="true">{v.icon}</span>
        <span class="vs-tab-name">{v.name}</span>
      </button>
    ))}
    {canEdit && (
      <button class="vs-new" type="button" data-view-new>
        <span class="vs-new-plus">+</span>
        <span>新建视图</span>
      </button>
    )}
  </div>

  <div class="vs-actions">
    <button type="button" class="vs-action" data-view-desc-toggle>说明</button>
    {canEdit && (
      <>
        <button type="button" class="vs-action" data-view-edit>编辑视图</button>
      </>
    )}
  </div>
</div>

<style>
  /* v0.8.12 Stage 6 chip 1: ViewSwitcher 切 v1.0 token；
     active chip 用 --primary（黑底/白字 = 焦点表达，符合 v1.0 决策树 L1） */
  .view-switcher {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: nowrap;
    padding: 14px 0 6px;
    border-bottom: 1px solid var(--border-soft);
    margin-bottom: 18px;
    font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", system-ui, sans-serif;
  }
  .vs-tabs {
    display: flex;
    align-items: center;
    gap: 2px;
    flex: 1;
    min-width: 0;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding: 2px 0;
  }
  .vs-tabs::-webkit-scrollbar { display: none; }

  /* removed: "视图" collapse label button */

  .vs-tab {
    all: unset;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 10px;
    border-radius: 10px;
    color: var(--text-2);
    font-size: 13px;
    font-weight: 500;
    user-select: none;
    -webkit-user-select: none;
    transition: background .12s, color .12s, transform .12s;
  }
  .vs-tab:hover { background: var(--primary-soft); color: var(--text); }
  .vs-tab.is-active {
    background: var(--primary-soft);
    color: var(--text);
    font-weight: 600;
  }
  /* iPad coarse pointer: keep hit area ≥44px without chunky visuals */
  @media (pointer: coarse) {
    .vs-tab { padding: 12px 12px; }
  }
  .vs-tab:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 3px;
  }
  .vs-tab.is-drag-over { transform: translateX(4px); }
  .vs-tab.is-dragging { opacity: 0.4; }

  .vs-tab-icon { font-size: 12px; opacity: 0.85; line-height: 1; }
  .vs-tab-name { line-height: 1; }

  .vs-new {
    all: unset;
    box-sizing: border-box;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    border-radius: 999px;
    border: 1px dashed var(--border);
    color: var(--text-2);
    font-size: 13px;
    font-weight: 500;
    transition: border-color .12s, color .12s;
  }
  .vs-new:hover { border-color: var(--text-2); color: var(--text); }
  .vs-new-plus { font-size: 14px; line-height: 1; margin-top: -1px; }

  .vs-actions {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }
  .vs-action {
    all: unset;
    cursor: pointer;
    padding: 8px 10px;
    border-radius: 10px;
    color: var(--text-2);
    font-size: 12px;
    font-weight: 500;
    transition: background .12s, color .12s, border-color .12s;
    border: 1px solid transparent;
  }
  .vs-action:hover { background: var(--bg-soft); color: var(--text); border-color: var(--border); }
  .vs-action:focus-visible { outline: 2px solid var(--focus); outline-offset: 3px; }
  @media (pointer: coarse) {
    .vs-action { padding: 12px 12px; }
  }
  /* removed: kebab menu button */
</style>

<script>
  // @ts-nocheck — 用 vanilla DOM 维护 chip 拖动 + 视图切换
  (() => {
    const root = document.querySelector('[data-view-switcher]');
    if (!root) return;
    const discipline = root.getAttribute('data-discipline');
    const canEdit = root.getAttribute('data-can-edit') === '1';

    function setUrlView(viewId) {
      const url = new URL(location.href);
      url.searchParams.set('view', viewId);
      // 跳转：让页面 SSR 重新渲染（视图切换时分组结构变了，partial swap 复杂度大于 navigate）
      location.href = url.toString();
    }

    // removed: collapse toggle (keep view area always visible)

    // tab 点击切换视图
    root.querySelectorAll('[data-view-tab]').forEach((tab) => {
      tab.addEventListener('click', () => {
        const id = tab.getAttribute('data-view-id');
        if (id) setUrlView(id);
      });
    });

    // 说明 toggle：只隐藏/显示 ViewDescription，不折叠整个视图区
    (function setupDescToggle() {
      const btn = root.querySelector('[data-view-desc-toggle]');
      const wrap = root.closest('[data-view-block]');
      if (!btn || !wrap) return;
      const KEY = 'view-desc-open:' + discipline;
      let open = false;
      try { open = localStorage.getItem(KEY) === '1'; } catch (_) {}
      if (open) wrap.setAttribute('data-desc-open', '1');
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        open = !wrap.hasAttribute('data-desc-open');
        if (open) wrap.setAttribute('data-desc-open', '1');
        else wrap.removeAttribute('data-desc-open');
        try { localStorage.setItem(KEY, open ? '1' : '0'); } catch (_) {}
      });
    })();

    // 编辑视图：走 ViewEditor（编辑视图页入口）
    (function setupEdit() {
      const editBtn = root.querySelector('[data-view-edit]');
      if (!editBtn) return;
      editBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        const id = root.getAttribute('data-current-id');
        if (!id) return;
        document.dispatchEvent(new CustomEvent('view:editor', { detail: { viewId: id } }));
      });
    })();

    // removed: view menu kebab trigger (menu actions live in edit page)

    // + 新建视图
    const newBtn = root.querySelector('[data-view-new]');
    if (newBtn) {
      newBtn.addEventListener('click', () => {
        document.dispatchEvent(new CustomEvent('view:new'));
      });
    }

    if (!canEdit) return;

    // === HTML5 drag-to-reorder（仅 canEdit 时） ===
    let dragId = null;
    const tabs = Array.from(root.querySelectorAll('[data-view-tab]'));
    tabs.forEach((tab) => {
      tab.addEventListener('dragstart', (e) => {
        dragId = tab.getAttribute('data-view-id');
        tab.classList.add('is-dragging');
        if (e.dataTransfer) {
          e.dataTransfer.effectAllowed = 'move';
          e.dataTransfer.setData('text/plain', dragId);
        }
      });
      tab.addEventListener('dragend', () => {
        tab.classList.remove('is-dragging');
        tabs.forEach((c) => c.classList.remove('is-drag-over'));
        dragId = null;
      });
      tab.addEventListener('dragover', (e) => {
        e.preventDefault();
        if (!dragId || tab.getAttribute('data-view-id') === dragId) return;
        tabs.forEach((c) => c.classList.toggle('is-drag-over', c === tab));
      });
      tab.addEventListener('dragleave', () => {
        tab.classList.remove('is-drag-over');
      });
      tab.addEventListener('drop', async (e) => {
        e.preventDefault();
        tab.classList.remove('is-drag-over');
        const droppedOnId = tab.getAttribute('data-view-id');
        if (!dragId || !droppedOnId || dragId === droppedOnId) return;
        // 计算新顺序
        const ids = tabs.map((c) => c.getAttribute('data-view-id'));
        const fromIdx = ids.indexOf(dragId);
        const toIdx = ids.indexOf(droppedOnId);
        if (fromIdx < 0 || toIdx < 0) return;
        const next = [...ids];
        const [moved] = next.splice(fromIdx, 1);
        next.splice(toIdx, 0, moved);
        // POST 给后端
        try {
          const res = await fetch('/api/edit/reorder/views', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ discipline, viewIds: next }),
          });
          if (!res.ok) {
            const data = await res.json().catch(() => ({}));
            alert(`视图顺序保存失败：${res.status} ${data.reason ?? 'error'}`);
            return;
          }
          // 触发 toast + 刷新（拿新 position）
          document.dispatchEvent(new CustomEvent('view:toast', { detail: '视图顺序已更新（~90s 后线上生效）' }));
          // 不立即 reload，避免覆盖 toast；交给用户决定何时刷新（或用户也可立即刷新）
        } catch (err) {
          alert(`视图顺序保存失败：${err.message ?? err}`);
        }
      });
    });
  })();
</script>
