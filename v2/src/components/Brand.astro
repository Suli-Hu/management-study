---
/**
 * v0.5.58 Brand mark — 全科笔记 / POLYMATH NOTES logo（纯 inline SVG，无 PNG 依赖）
 *
 * 设计：橙底圆角方块「学」徽 + 中文 wordmark + 英文 sub。深浅模式靠 CSS 变量 / currentColor 自适应。
 *
 * 用法：
 *   <Brand href="/" size="sm" />     ← Nav 顶（行高 28px）
 *   <Brand href="/" size="lg" />     ← 首页 hero（icon 48px + 大字）
 */

interface Props {
  href?: string;
  size?: 'sm' | 'lg';
  class?: string;
}

const { href = '/', size = 'sm', class: classProp = '' } = Astro.props;
---

<a
  href={href}
  class:list={['brand-mark', `brand-${size}`, classProp]}
  aria-label="全科笔记 · Polymath Notes"
  title="全科笔记"
>
  <span class="brand-icon" aria-hidden="true">
    <svg viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg">
      <rect width="32" height="32" rx="6" fill="#FF9500" />
      <text
        x="16" y="22"
        font-family="-apple-system, BlinkMacSystemFont, 'PingFang SC', 'Hiragino Sans', sans-serif"
        font-size="18" font-weight="600" fill="#fff" text-anchor="middle"
      >学</text>
    </svg>
  </span>
  <span class="brand-text">
    <span class="brand-cn">全科笔记</span>
    <span class="brand-en">POLYMATH NOTES</span>
  </span>
</a>

<style>
  .brand-mark {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    line-height: 1;
    color: var(--color-text-primary);
  }
  .brand-mark:hover { opacity: 0.85; }
  .brand-icon {
    display: inline-flex;
    flex: 0 0 auto;
  }
  .brand-icon svg { display: block; width: 100%; height: 100%; }
  .brand-text {
    display: inline-flex;
    flex-direction: column;
    gap: 1px;
    min-width: 0;
  }
  .brand-cn {
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-text-primary);
  }
  .brand-en {
    font-weight: 500;
    letter-spacing: 0.14em;
    color: var(--color-text-quaternary);
    text-transform: uppercase;
  }

  /* sm — Nav 顶（48px 行高内 28px logo）*/
  .brand-sm .brand-icon { width: 24px; height: 24px; }
  .brand-sm .brand-cn { font-size: 14px; }
  .brand-sm .brand-en { font-size: 8px; }

  /* lg — 首页 hero */
  .brand-lg { gap: 14px; }
  .brand-lg .brand-icon { width: 56px; height: 56px; }
  .brand-lg .brand-cn { font-size: 32px; }
  .brand-lg .brand-en { font-size: 11px; }
</style>
