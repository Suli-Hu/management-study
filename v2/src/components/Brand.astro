---
/**
 * v0.5.58 Brand mark — 全科笔记 / POLYMATH NOTES logo
 *
 * 资源（用户存到 v2/public/）：
 *   - logo-light.png — 浅底版本（黑字 + 灰副标）
 *   - logo-dark.png  — 深底版本（米白字 + 灰副标）
 *
 * 切换：用 v2 class-based dark mode（html.dark）— 两张 <img> 用 dark:block / dark:hidden 切。
 *
 * 用法：
 *   <Brand href="/" size="sm" />     ← Nav 顶（高 24~28px）
 *   <Brand href="/" size="lg" />     ← 首页 hero（高 80~120px）
 */

interface Props {
  href?: string;
  size?: 'sm' | 'lg';
  class?: string;
}

const { href = '/', size = 'sm', class: classProp = '' } = Astro.props;

// 高度走 token 化值，宽度自动按 PNG 比例（design 约 16:9）
const heights: Record<typeof size, string> = {
  sm: 'h-7',     // 28px — 卡 nav 48px 行高
  lg: 'h-20',    // 80px — 首页 hero
};
---

<a href={href} class:list={['brand-mark inline-flex items-center no-underline', classProp]} aria-label="全科笔记 · Polymath Notes" title="全科笔记">
  <img
    src="/logo-light.png"
    alt="全科笔记"
    class:list={['brand-img dark:hidden', heights[size]]}
    draggable="false"
  />
  <img
    src="/logo-dark.png"
    alt="全科笔记"
    class:list={['brand-img hidden dark:block', heights[size]]}
    draggable="false"
  />
</a>

<style>
  .brand-mark { line-height: 0; }
  .brand-img { width: auto; display: block; }
</style>
