---
/**
 * Brand — sususu wordmark 体系（v0.5.98 重做，替换原 quanke-mark / 全科笔记 / POLYMATH NOTES）
 *
 * 三种 variant：
 *   1. compact — nav / breadcrumb（28px sususu wordmark，无副标）
 *   2. lockup  — 首页 hero / 登录页（56px sususu wordmark + 灰色副标 "AI 学习云笔记工具"）
 *   3. mark    — 仅 SU 圆形 mark（favicon 同款，用于空状态 / 折叠 nav）
 *
 * 字体：Kalam 700（Google Font，Layout.astro 全站 preload）。fallback Trebuchet MS / system-ui。
 * 下划线：SVG quadratic bezier (M 3 8 Q 50 0, 97 6) 模拟手绘弧度。
 * 深色模式：html.dark → 文字 / mark 背景反色。
 *
 * 用法：
 *   <Brand href="/" variant="compact" />              ← nav
 *   <Brand href="/" variant="lockup" />               ← 首页 / 登录
 *   <Brand href="/" variant="lockup" wordmarkPx={80} /> ← hero 大字
 *   <Brand variant="mark" markSize={20} />            ← 仅 mark
 */

interface Props {
  href?: string;
  variant?: 'compact' | 'lockup' | 'mark';
  /** lockup wordmark 字号 px。默认 56 */
  wordmarkPx?: number;
  /** mark 边长 px（仅 variant=mark 用）。默认 24 */
  markSize?: number;
  class?: string;
}

const {
  href,
  variant = 'compact',
  wordmarkPx,
  markSize = 24,
  class: classProp = '',
} = Astro.props;

const _wordmarkPx = wordmarkPx ?? (variant === 'lockup' ? 56 : 28);

const Tag = href ? 'a' : 'span';
const ariaLabel = variant === 'lockup' ? 'sususu · AI 学习云笔记工具' : 'sususu';
---

<Tag
  {...(href ? { href } : {})}
  class:list={['brand', `brand-${variant}`, classProp]}
  aria-label={ariaLabel}
  title="sususu"
>
  {variant === 'mark' ? (
    <span class="su-mark" style={`width:${markSize}px; height:${markSize}px; font-size:${Math.round(markSize * 0.55)}px;`}>
      <span class="su-text">SU</span>
    </span>
  ) : (
    <span class="brand-wordmark" style={`font-size:${_wordmarkPx}px;`}>
      <span class="word">sususu</span>
      <svg class="underline" viewBox="0 0 100 10" preserveAspectRatio="none" aria-hidden="true">
        <path d="M 3 8 Q 50 0, 97 6" />
      </svg>
    </span>
  )}
  {variant === 'lockup' && (
    <span class="brand-tagline">AI 学习云笔记工具</span>
  )}
</Tag>

<style>
  .brand {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    line-height: 1;
    color: inherit;
    gap: 14px;
  }
  .brand-compact { gap: 0; }
  .brand:hover { opacity: 0.85; }

  /* === wordmark === */
  .brand-wordmark {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    line-height: 1;
    color: #0a0a0a;
  }
  :global(html.dark) .brand-wordmark { color: #fafaf9; }

  .brand-wordmark .word {
    font-family: "Kalam", "Trebuchet MS", system-ui, sans-serif;
    font-weight: 700;
    letter-spacing: 0.02em;
    line-height: 1;
    font-size: inherit;
  }

  /* underline 跟着 font-size 走 — 用 em 单位让它响应式缩放 */
  .brand-wordmark .underline {
    width: 92%;
    height: 0.18em;
    margin-top: -0.1em;
    overflow: visible;
  }
  .brand-wordmark .underline path {
    stroke: currentColor;
    stroke-width: 4;
    stroke-linecap: round;
    fill: none;
  }

  /* === lockup tagline === */
  .brand-tagline {
    font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", system-ui, sans-serif;
    font-size: 13px;
    color: #a3a3a3;
    letter-spacing: 0.06em;
    font-weight: 500;
    line-height: 1;
  }
  :global(html.dark) .brand-tagline { color: #737373; }

  /* === SU mark (圆形) === */
  .su-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: #0a0a0a;
    color: #fafaf9;
    flex-shrink: 0;
    font-family: "Kalam", "Trebuchet MS", system-ui, sans-serif;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.04em;
  }
  :global(html.dark) .su-mark {
    background: #fafaf9;
    color: #0a0a0a;
  }
  .su-mark .su-text {
    transform: translateY(-2%);
    text-transform: uppercase;
  }
</style>
