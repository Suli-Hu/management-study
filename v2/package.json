{
  "name": "management-study-v2",
  "type": "module",
  "version": "0.11.51",
  "private": true,
  "description": "Multi-discipline study notes SaaS — v2 (Astro + D1 + Tailwind)",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "typecheck": "astro check",
    "preview": "astro preview",
    "astro": "astro",
    "validate": "tsx scripts/validate-data.ts",
    "migrate:from-v1": "tsx scripts/migrations/migrate-from-v1.ts",
    "sync:d1": "node --import tsx scripts/ops/sync-to-d1.ts",
    "sync:d1:apply:local": "node --import tsx scripts/ops/apply-d1-sync.ts --local",
    "sync:d1:apply:remote": "node --import tsx scripts/ops/apply-d1-sync.ts --remote",
    "sync:d1:local": "pnpm sync:d1 && pnpm sync:d1:apply:local",
    "sync:d1:remote": "pnpm sync:d1 && pnpm sync:d1:apply:remote",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:learning-flow": "tsx scripts/dev/test-learning-flow.ts",
    "seed:study-log": "tsx scripts/ops/seed-study-log.ts",
    "setup:admin": "tsx scripts/ops/setup-admin.ts",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.0",
    "@astrojs/cloudflare": "^12.6.0",
    "@astrojs/tailwind": "^5.1.0",
    "astro": "^5.0.0",
    "tailwindcss": "^3.4.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260424.1",
    "@playwright/test": "^1.59.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^22.0.0",
    "better-sqlite3": "^12.9.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "wrangler": "^3.90.0"
  },
  "packageManager": "pnpm@9.0.0"
}
