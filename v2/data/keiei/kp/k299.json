  "year": "1954",
  "title": {
    "zh": "MBO目标管理制度",
    "en": "Management by Objectives",
    "ja": "MBO目標管理制度"
  },
  "body": {
    "zh": {
      "format": "accordion",
      "lead": "德鲁克（Drucker）1954年提出的绩效管理制度，上级与部下共同制定具体、可衡量的工作目标，以目标达成度作为评价基准。麦格雷戈基于Y理论将其推广至实践：",
      "groups": [
        {
          "title": "三种类型",
          "items": [
            {
              "name": "业绩目标管理",
              "desc": "以销售额、利润等业绩指标为目标"
            },
            {
              "name": "行动目标管理",
              "desc": "以具体行动计划的执行为目标"
            },
            {
              "name": "能力目标管理",
              "desc": "以技能习得和能力提升为目标"
            }
          ]
        },
        {
          "title": "管理循环",
          "items": [
            {
              "name": "目标设定",
              "desc": "上司与部下共同协商制定"
            },
            {
              "name": "中间面谈",
              "desc": "期中确认进度并调整"
            },
            {
              "name": "期末评价",
              "desc": "对照目标评估达成度"
            },
            {
              "name": "反馈",
              "desc": "将评价结果告知并指导改善"
            }
          ]
        },
        {
          "title": "优点（メリット）",
          "items": [
            {
              "name": "明确员工职责与期待",
              "desc": ""
            },
            {
              "name": "提升自主性与动机",
              "desc": ""
            },
            {
              "name": "上下级沟通改善",
              "desc": ""
            },
            {
              "name": "评价的客观性提高",
              "desc": ""
            }
          ]
        },
        {
          "title": "缺点（デメリット）",
          "items": [
            {
              "name": "过度关注可量化指标，忽视定性贡献",
              "desc": ""
            },
            {
              "name": "短期导向，轻视长期能力培养",
              "desc": ""
            },
            {
              "name": "目标设定博弈（刻意降低难度）",
              "desc": ""
            },
            {
              "name": "评价面谈流于形式",
              "desc": ""
            }
          ]
        },
        {
          "title": "日本企业中MBO的课题",
          "items": [
            {
              "name": "集体主义文化下个人目标设定困难",
              "desc": ""
            },
            {
              "name": "年功制与成果主义的矛盾",
              "desc": ""
            },
            {
              "name": "面子文化导致低评价难以给出",
              "desc": ""
            },
            {
              "name": "职务范围模糊使目标界定不清",
              "desc": ""
            }
          ]
        },
        {
          "title": "业绩提升的条件",
          "items": [
            {
              "name": "目标须具挑战性且可实现（SMART原则）",
              "desc": ""
            },
            {
              "name": "上司的持续支持与中间反馈",
              "desc": ""
            },
            {
              "name": "评价与报酬·晋升的公正联动",
              "desc": ""
            },
            {
              "name": "组织文化对失败的包容性",
              "desc": ""
            }
          ]
        }
      ]
    },
    "ja": {
      "format": "accordion",
      "lead": "——ドラッカー（1954）が提唱した業績管理制度。上司と部下が共同で具体的・測定可能な業務目標を設定し、達成度を評価基準とする。マグレガーがY理論に基づき実務展開を推進した：",
      "groups": [
        {
          "title": "三つの類型",
          "items": [
            {
              "name": "業績目標管理",
              "desc": "売上高・利益等の業績指標を目標とする"
            },
            {
              "name": "行動目標管理",
              "desc": "具体的な行動計画の実行を目標とする"
            },
            {
              "name": "能力目標管理",
              "desc": "スキル習得・能力向上を目標とする"
            }
          ]
        },
        {
          "title": "管理サイクル",
          "items": [
            {
              "name": "目標設定",
              "desc": "上司と部下が共同で協議・策定"
            },
            {
              "name": "中間面談",
              "desc": "期中に進捗を確認し調整"
            },
            {
              "name": "期末評価",
              "desc": "目標に照らして達成度を評価"
            },
            {
              "name": "フィードバック",
              "desc": "評価結果を伝達し改善を指導"
            }
          ]
        },
        {
          "title": "メリット",
          "items": [
            {
              "name": "従業員の職責と期待の明確化",
              "desc": ""
            },
            {
              "name": "自主性とモチベーションの向上",
              "desc": ""
            },
            {
              "name": "上下間コミュニケーションの改善",
              "desc": ""
            },
            {
              "name": "評価の客観性向上",
              "desc": ""
            }
          ]
        },
        {
          "title": "デメリット",
          "items": [
            {
              "name": "定量化可能な指標への過度の注目、定性的貢献の軽視",
              "desc": ""
            },
            {
              "name": "短期志向で長期的能力育成を軽視",
              "desc": ""
            },
            {
              "name": "目標設定の駆け引き（意図的な難易度の引き下げ）",
              "desc": ""
            },
            {
              "name": "評価面談の形骸化",
              "desc": ""
            }
          ]
        },
        {
          "title": "日本企業におけるMBOの課題",
          "items": [
            {
              "name": "集団主義文化における個人目標設定の困難",
              "desc": ""
            },
            {
              "name": "年功制と成果主義の矛盾",
              "desc": ""
            },
            {
              "name": "面子文化により低評価を付けにくい",
              "desc": ""
            },
            {
              "name": "職務範囲の曖昧さによる目標設定の困難",
              "desc": ""
            }
          ]
        },
        {
          "title": "業績向上の条件",
          "items": [
            {
              "name": "目標はチャレンジングかつ達成可能（SMART原則）",
              "desc": ""
            },
            {
              "name": "上司の継続的支援と中間フィードバック",
              "desc": ""
            },
            {
              "name": "評価と報酬・昇進の公正な連動",
              "desc": ""
            },
            {
              "name": "失敗に対する組織文化の寛容性",
              "desc": ""
            }
          ]
        }
      ]
    }
  },
