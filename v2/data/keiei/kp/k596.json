  "evaluations": {
    "zh": {
      "meaning": "第一次把冲突作为动态过程而非静态状态来研究，为冲突管理提供了时间轴上的分析框架。第五阶段「余波」最深刻——本次冲突的结束不是真正的结束，而是下一次冲突的起点",
      "limit": "五个阶段在现实中并非总是按顺序发生——有些冲突会跳过某些阶段，有些阶段会来回反复",
      "example": "",
      "response": "",
      "application": "",
      "analogy": ""
    },
    "ja": {
      "meaning": "",
      "limit": "五段階は現実には必ずしも順序通りに進行しない——段階を飛ばしたり前後に往復することもある",
